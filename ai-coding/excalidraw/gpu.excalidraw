      "y": 1258.962778993743,
      "width": 1095.0015478014577,
      "height": 76.64473886111908,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 1267742488,
      "version": 383,
      "versionNonce": 1856391192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788294140564,
      "link": null,
      "locked": false,
      "text": "Answer: My first hypothesis is GPU starvation. Falling GPU utilization combined with rising CPU utilization\ntells me the accelerator probably isn’t compute-bound; something on the host-side input path is preventing\nbatches from reaching it fast enough.",
      "fontSize": 20.438597029631755,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Answer: My first hypothesis is GPU starvation. Falling GPU utilization combined with rising CPU utilization tells me the accelerator probably isn’t compute-bound; something on the host-side input path is preventing batches from reaching it fast enough.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "xF5gjJNtiSq0e4mocGVSf",
      "type": "text",
      "x": 304.08496864811207,
      "y": 1354.5878004760466,
      "width": 614.9795532226562,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0w",
      "roundness": null,
      "seed": 681442920,
      "version": 133,
      "versionNonce": 1844261480,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788294736835,
      "link": null,
      "locked": false,
      "text": "*** Preprocessing bottleneck (transformation is expensive) ***\n\nraw image\n   ↓\ndecode\nresize\ncrop\naugmentation\nnormalize\n   ↓\nGPU",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Preprocessing bottleneck (transformation is expensive) ***\n\nraw image\n   ↓\ndecode\nresize\ncrop\naugmentation\nnormalize\n   ↓\nGPU",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PWz_TYfPTmvhRUL9WYA77",
      "type": "text",
      "x": 519.732770578819,
      "y": 1406.6775912875125,
      "width": 147.2798614501953,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0x",
      "roundness": null,
      "seed": 32061976,
