    },
    {
      "id": "zPKo46A_jR9QHEMpj2XWP",
      "type": "text",
      "x": 16.85033626158065,
      "y": 7824.403328050881,
      "width": 470.89836171849726,
      "height": 931.0505038208705,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b24",
      "roundness": null,
      "seed": 968441863,
      "version": 175,
      "versionNonce": 381726793,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788376541867,
      "link": null,
      "locked": false,
      "text": "class TopGPUs {\n  constructor(windowMs = 5 * 60 * 1000, k = 5) {\n    this.windowMs = windowMs;\n    this.k = k;\n\n    // gpuId -> { queue: [], head: number, sum: number }\n    this.gpus = new Map();\n  }\n\n  addMetric({ gpuId, timestamp, utilization }) {\n    if (!this.gpus.has(gpuId)) {\n      this.gpus.set(gpuId, {\n        queue: [],\n        head: 0,\n        sum: 0,\n      });\n    }\n\n    const state = this.gpus.get(gpuId);\n\n    state.queue.push({ timestamp, utilization });\n    state.sum += utilization;\n\n    this.evictExpired(state, timestamp);\n  }\n\n  evictExpired(state, now) {\n    const cutoff = now - this.windowMs;\n\n    while (\n      state.head < state.queue.length &&\n      state.queue[state.head].timestamp < cutoff\n    ) {\n      state.sum -= state.queue[state.head].utilization;\n      state.head++;\n    }\n\n    // occasional compaction\n    if (state.head > 1000 && state.head > state.queue.length / 2) {\n      state.queue = state.queue.slice(state.head);\n      state.head = 0;\n    }\n  }\n\n  getTop5(now) {\n    const top = [];\n\n    for (const [gpuId, state] of this.gpus) {\n      this.evictExpired(state, now);\n\n      const count = state.queue.length - state.head;\n\n      if (count === 0) continue;\n\n      const avg = state.sum / count;\n\n      top.push({\n        gpuId,\n        avgUtilization: avg,\n      });\n    }\n\n    top.sort((a, b) => b.avgUtilization - a.avgUtilization);\n\n    return top.slice(0, this.k);\n  }\n}",
      "fontSize": 11.117020941144723,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class TopGPUs {\n  constructor(windowMs = 5 * 60 * 1000, k = 5) {\n    this.windowMs = windowMs;\n    this.k = k;\n\n    // gpuId -> { queue: [], head: number, sum: number }\n    this.gpus = new Map();\n  }\n\n  addMetric({ gpuId, timestamp, utilization }) {\n    if (!this.gpus.has(gpuId)) {\n      this.gpus.set(gpuId, {\n        queue: [],\n        head: 0,\n        sum: 0,\n      });\n    }\n\n    const state = this.gpus.get(gpuId);\n\n    state.queue.push({ timestamp, utilization });\n    state.sum += utilization;\n\n    this.evictExpired(state, timestamp);\n  }\n\n  evictExpired(state, now) {\n    const cutoff = now - this.windowMs;\n\n    while (\n      state.head < state.queue.length &&\n      state.queue[state.head].timestamp < cutoff\n    ) {\n      state.sum -= state.queue[state.head].utilization;\n      state.head++;\n    }\n\n    // occasional compaction\n    if (state.head > 1000 && state.head > state.queue.length / 2) {\n      state.queue = state.queue.slice(state.head);\n      state.head = 0;\n    }\n  }\n\n  getTop5(now) {\n    const top = [];\n\n    for (const [gpuId, state] of this.gpus) {\n      this.evictExpired(state, now);\n\n      const count = state.queue.length - state.head;\n\n      if (count === 0) continue;\n\n      const avg = state.sum / count;\n\n      top.push({\n        gpuId,\n        avgUtilization: avg,\n      });\n    }\n\n    top.sort((a, b) => b.avgUtilization - a.avgUtilization);\n\n    return top.slice(0, this.k);\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
