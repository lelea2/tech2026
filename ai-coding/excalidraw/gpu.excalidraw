    {
      "id": "iriQ98ofBibL4zqC7qLBq",
      "type": "text",
      "x": 313.7807761617629,
      "y": 832.0787195994717,
      "width": 232.23983764648438,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 315022616,
      "version": 30,
      "versionNonce": 1059399960,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788295488817,
      "link": null,
      "locked": false,
      "text": "Storage\n   ↓\nData loading\n   ↓\nCPU preprocessing\n   ↓\nTokenization\n   ↓\nBatch construction\n   ↓\nHost → Device transfer\n   ↓\nGPU compute",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Storage\n   ↓\nData loading\n   ↓\nCPU preprocessing\n   ↓\nTokenization\n   ↓\nBatch construction\n   ↓\nHost → Device transfer\n   ↓\nGPU compute",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WeS0K5pNo59tmh1zMGZHk",
      "type": "rectangle",
      "x": 286.85596944111614,
