    {
      "id": "zv80DZMAm5jcZ6Nm9a0cE",
      "type": "text",
      "x": -550.591377135159,
      "y": 7851.375780541969,
      "width": 374.57977294921875,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 761086409,
      "version": 138,
      "versionNonce": 2100091431,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788376296887,
      "link": null,
      "locked": false,
      "text": "                  GPU Metrics Stream\n                         |\n                         v\n                 +----------------+\n                 | Stream Processor|\n                 +--------+-------+\n                          |\n                 partition by gpuId\n                          |\n                          v\n               +----------------------+\n               | Per-GPU Window State |\n               |                      |\n               | gpu1 -> deque + sum  |\n               | gpu2 -> deque + sum  |\n               | gpu3 -> deque + sum  |\n               +----------+-----------+\n                          |\n                    avg per GPU\n                          |\n                          v\n                 +----------------+\n                 | Top-K Processor|\n                 |     K = 5      |\n                 +--------+-------+\n                          |\n                          v\n                   Dashboard/API",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                  GPU Metrics Stream\n                         |\n                         v\n                 +----------------+\n                 | Stream Processor|\n                 +--------+-------+\n                          |\n                 partition by gpuId\n                          |\n                          v\n               +----------------------+\n               | Per-GPU Window State |\n               |                      |\n               | gpu1 -> deque + sum  |\n               | gpu2 -> deque + sum  |\n               | gpu3 -> deque + sum  |\n               +----------+-----------+\n                          |\n                    avg per GPU\n                          |\n                          v\n                 +----------------+\n                 | Top-K Processor|\n                 |     K = 5      |\n                 +--------+-------+\n                          |\n                          v\n                   Dashboard/API",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oNz_b_BWADK3TmOCYdAcn",
      "type": "rectangle",
      "x": -517.110490651276,
      "y": 7801.10140171161,
      "width": 408.6171416248451,
      "height": 831.1573825006999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b23",
      "roundness": {
        "type": 3
      },
      "seed": 1759109513,
      "version": 66,
