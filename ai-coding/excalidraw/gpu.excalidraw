    {
      "id": "UV7ifxbluqBMDnjWJfq2i",
      "type": "text",
      "x": 344,
      "y": 124.5,
      "width": 969.576171875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 926796312,
      "version": 92,
      "versionNonce": 1879634024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788292185455,
      "link": null,
      "locked": false,
      "text": "GPU utilization alone is not sufficient. I want to correlate infrastructure metrics with workload\nmetrics so I can distinguish compute saturation from input-pipeline bottlenecks, NCCL\nsynchronization issues, memory pressure, or poor batching.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GPU utilization alone is not sufficient. I want to correlate infrastructure metrics with workload metrics so I can distinguish compute saturation from input-pipeline bottlenecks, NCCL synchronization issues, memory pressure, or poor batching.\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "WbX37wk6RnAJSmqSC5iHB",
