      "isDeleted": false,
      "boundElements": [],
      "updated": 1788303253965,
      "link": null,
      "locked": false,
      "text": "Observability dashboard:\n\n1) TTFT p99\n2) TPOT p99\n3) tokens/sec\n4) queue depth\n5) queue latency\n6) GPU util\n7) SM util\n8) HBM %\n9) KV-cache %\n10) batch size\n11) error rate",
      "fontSize": 22.97118894547082,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Observability dashboard:\n\n1) TTFT p99\n2) TPOT p99\n3) tokens/sec\n4) queue depth\n5) queue latency\n6) GPU util\n7) SM util\n8) HBM %\n9) KV-cache %\n10) batch size\n11) error rate",
      "autoResize": false,
      "lineHeight": 1.25
    },
