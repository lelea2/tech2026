    {
      "id": "43p02Dn623q7iTzpiFqpH",
      "type": "text",
      "x": 328.76953125,
      "y": 277.13671875,
      "width": 335.27978515625,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0e",
      "roundness": null,
      "seed": 342900760,
      "version": 163,
      "versionNonce": 609616920,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788292370088,
      "link": null,
      "locked": false,
      "text": "1)  GPU utilization\n2) SM utilization\n3) Tensor Core utilization\n4) HBM memory used / total\n5) HBM bandwidth utilization\n6) PCIe throughput\n7) NVLink throughput\n8) GPU temperature\n9) Power draw\n10) Thermal / power throttling\n11) ECC errors\n12) XID errors\n13) GPU reset events\n14) MIG partition utilization\n15) CPU utilization\n16) Host memory pressure\n17) Disk / data-loader throughput\n18) Network latency / bandwidth",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1)  GPU utilization\n2) SM utilization\n3) Tensor Core utilization\n4) HBM memory used / total\n5) HBM bandwidth utilization\n6) PCIe throughput\n7) NVLink throughput\n8) GPU temperature\n9) Power draw\n10) Thermal / power throttling\n11) ECC errors\n12) XID errors\n13) GPU reset events\n14) MIG partition utilization\n15) CPU utilization\n16) Host memory pressure\n17) Disk / data-loader throughput\n18) Network latency / bandwidth",
      "autoResize": true,
      "lineHeight": 1.25
    },
