    {
      "id": "nl0GceRYJbV0KIfdvzfGG",
      "type": "text",
      "x": 313.1382251198097,
      "y": 2806.642866678364,
      "width": 329.479736328125,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 26640488,
      "version": 3,
      "versionNonce": 317687400,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788297106155,
      "link": null,
      "locked": false,
      "text": "Possible causes include:\n\n* DataLoader too slow\n* CPU preprocessing/tokenization\n* storage/network I/O\n* host-to-device copies\n* synchronization barriers\n* NCCL/all-reduce delays\n* one slow GPU\n* checkpointing\n* CPU orchestration overhead\n* kernel-launch gaps\n* small batch sizes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Possible causes include:\n\n* DataLoader too slow\n* CPU preprocessing/tokenization\n* storage/network I/O\n* host-to-device copies\n* synchronization barriers\n* NCCL/all-reduce delays\n* one slow GPU\n* checkpointing\n* CPU orchestration overhead\n* kernel-launch gaps\n* small batch sizes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1nu8EyBpkD1boNhckDGxX",
      "type": "text",
      "x": 303.9421182313191,
      "y": 3171.866001830287,
      "width": 390.8797607421875,
      "height": 25,
      "angle": 0,
