    {
      "id": "-duuQ7SEY8MZ37oXaQEwC",
      "type": "text",
      "x": -57.64249702930351,
      "y": 820.8388715223218,
      "width": 270.49981689453125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b10",
      "roundness": null,
      "seed": 1129439592,
      "version": 199,
      "versionNonce": 958282088,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788294719228,
      "link": null,
      "locked": false,
      "text": "1. Data loading bottleneck\n2. Preprocessing bottleneck\n3. Tokenizer bottleneck",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Data loading bottleneck\n2. Preprocessing bottleneck\n3. Tokenizer bottleneck",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SJlONFvBxOLNBC8agxEM9",
      "type": "text",
      "x": 752.3746090220752,
      "y": 1417.5817783725977,
      "width": 594.5257593318164,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b11",
      "roundness": null,
      "seed": 409604888,
      "version": 109,
      "versionNonce": 1595277336,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788295477268,
      "link": null,
      "locked": false,
      "text": "- If preprocessing becomes expensive, CPU cores stay busy\nwhile accelerators wait.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- If preprocessing becomes expensive, CPU cores stay busy while accelerators wait.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "1CEePhS9Av1yRBHKePTlJ",
      "type": "text",
      "x": 313.1382251198084,
      "y": 1696.9284462831904,
      "width": 557.399658203125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b12",
      "roundness": null,
      "seed": 320630552,
      "version": 65,
      "versionNonce": 1155524120,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788295106889,
      "link": null,
      "locked": false,
      "text": "*** Tokenizer bottleneck (most relevant to LLM training)\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Tokenizer bottleneck (most relevant to LLM training)\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NzbN2-uzjIEYRD9c7aOly",
      "type": "text",
      "x": 297.1799425256309,
      "y": 1742.3481736666222,
      "width": 174.21987915039062,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b13",
      "roundness": null,
      "seed": 72318232,
      "version": 3,
      "versionNonce": 481629976,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788295385067,
      "link": null,
      "locked": false,
      "text": "Raw text\n   ↓\nTokenizer on CPU\n   ↓\ntoken IDs\n   ↓\nbatch packing\n   ↓\nGPU training",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Raw text\n   ↓\nTokenizer on CPU\n   ↓\ntoken IDs\n   ↓\nbatch packing\n   ↓\nGPU training",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v5QWKOZrFO-jkPrh4jOhk",
      "type": "rectangle",
      "x": 277.606111531209,
      "y": 1729.7311411460973,
      "width": 250.93536251080246,
      "height": 275.2563989644302,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": {
        "type": 3
      },
      "seed": 939274520,
      "version": 84,
      "versionNonce": 271307544,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788295389521,
      "link": null,
      "locked": false
    },
    {
      "id": "5ocwfvPE2NYr_NtvpU8Ls",
      "type": "text",
      "x": 578.7755390830612,
      "y": 1746.2082750753705,
      "width": 627.95947265625,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 852822376,
      "version": 353,
      "versionNonce": 1053028200,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788295470063,
      "link": null,
      "locked": false,
      "text": "* Tokenization can involve significant CPU works\nAnd if it's performed online during training, it can become critical\npath\n\nnormalization\nBPE / WordPiece lookup\nsequence truncation\npadding\npacking\nattention-mask construction",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Tokenization can involve significant CPU works\nAnd if it's performed online during training, it can become critical\npath\n\nnormalization\nBPE / WordPiece lookup\nsequence truncation\npadding\npacking\nattention-mask construction",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qnPogiotk2Bu9RFcBxpn-",
      "type": "text",
      "x": 995.2732883514359,
      "y": 1837.1532232968782,
      "width": 303.019775390625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b16",
      "roundness": null,
      "seed": 1193453928,
      "version": 172,
      "versionNonce": 2094665240,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788295537825,
      "link": null,
      "locked": false,
      "text": "Symptom:\n\nCPU ↑↑\nGPU ↓\ntokens/sec ↓\nDataLoader workers saturated",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Symptom:\n\nCPU ↑↑\nGPU ↓\ntokens/sec ↓\nDataLoader workers saturated",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JqpAijrvtyNoGXxkshymj",
      "type": "rectangle",
      "x": 971.3214789890795,
      "y": 1825.5671495376962,
      "width": 370.1525565782498,
      "height": 184.24431854450654,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b17",
      "roundness": {
        "type": 3
      },
      "seed": 781150232,
      "version": 81,
      "versionNonce": 407584104,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788295543699,
      "link": null,
      "locked": false
    },
    {
      "id": "BVZigv2TrwCt3NxSiWLmo",
      "type": "text",
      "x": 287.35466577218426,
      "y": 2040.2281234962334,
      "width": 1133.6513640179014,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b18",
      "roundness": null,
      "seed": 1974510616,
      "version": 261,
      "versionNonce": 21299816,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788296872848,
      "link": null,
      "locked": false,
      "text": "What we will compare here?\n\n==> raw samples/sec vs tokenized samples/sec vs. GPU consumed batched/sec\n==> If raw data arrives quickly but tokenized batches are slow, the tokenizer is likely the bottleneck.\n==> Fix:  pre-tokenizing the dataset, increasing tokenizer workers, batching tokenization, caching tokenized\nsamples, or moving some preprocessing offline.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What we will compare here?\n\n==> raw samples/sec vs tokenized samples/sec vs. GPU consumed batched/sec\n==> If raw data arrives quickly but tokenized batches are slow, the tokenizer is likely the bottleneck.\n==> Fix:  pre-tokenizing the dataset, increasing tokenizer workers, batching tokenization, caching tokenized samples, or moving some preprocessing offline.\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "HKJ8qpq7HoYOeZD0Sr_Uq",
      "type": "text",
      "x": 294.724822126527,
      "y": 2268.971499274506,
      "width": 350.73974609375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1A",
      "roundness": null,
      "seed": 760250984,
      "version": 50,
      "versionNonce": 81823080,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788296750193,
      "link": null,
      "locked": false,
      "text": "1) GPU utilization vs. SM utilization",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) GPU utilization vs. SM utilization",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1jfkNTysJ-fLwkBDQTx8B",
      "type": "text",
      "x": 295.95238232607915,
      "y": 2305.7983052610716,
      "width": 917.2118769288038,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1C",
      "roundness": null,
      "seed": 1720627304,
      "version": 100,
      "versionNonce": 15871768,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788296781347,
      "link": null,
      "locked": false,
      "text": "- GPU utilization usually measures the percentage of time during a sampling window that the\nGPU was executing one or more kernels. It is essentially a busy/idle signal.\n- SM utilization measures how actively the GPU’s Streaming Multiprocessors (SMs) are being\nused. SMs are the compute engines executing CUDA warps.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- GPU utilization usually measures the percentage of time during a sampling window that the GPU was executing one or more kernels. It is essentially a busy/idle signal.\n- SM utilization measures how actively the GPU’s Streaming Multiprocessors (SMs) are being used. SMs are the compute engines executing CUDA warps.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "qciQ-IjOwxfXF2tfj-pNW",
      "type": "text",
      "x": 290.5002887835369,
      "y": 2417.741246114767,
      "width": 317.45989990234375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 202942312,
      "version": 66,
      "versionNonce": 402309224,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788296844505,
      "link": null,
      "locked": false,
      "text": "GPU\n├── SMs             ← compute\n├── Tensor Cores\n├── HBM\n├── L2 cache\n├── PCIe\n└── NVLink",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GPU\n├── SMs             ← compute\n├── Tensor Cores\n├── HBM\n├── L2 cache\n├── PCIe\n└── NVLink",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Xq_IA0boNUwV67KcRVVWv",
      "type": "text",
      "x": 277.3903294648819,
      "y": 2215.102705205095,
      "width": 283.38451260143086,
      "height": 35.904187085084686,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 678733080,
      "version": 71,
      "versionNonce": 299564136,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788296872031,
      "link": null,
      "locked": false,
      "text": "*** DEEP DIVE ***",
      "fontSize": 28.72334966806774,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** DEEP DIVE ***",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Wx2mkzFxK2qNxub5YX4B5",
      "type": "text",
      "x": 304.281570086322,
      "y": 2615.5846299949376,
      "width": 1019.6593627929688,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1G",
      "roundness": null,
      "seed": 970559256,
      "version": 73,
      "versionNonce": 1651588968,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788297116634,
      "link": null,
      "locked": false,
      "text": "2) Why can GPU utilization be low during a slow training job? ==> often GPU starvations, not slow GPU",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Why can GPU utilization be low during a slow training job? ==> often GPU starvations, not slow GPU",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wVn5sqGI4MIS7YTW7JZFL",
      "type": "text",
      "x": 303.65340451545734,
      "y": 2669.4534240643484,
      "width": 494.99993896484375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
