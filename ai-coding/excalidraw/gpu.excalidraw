      "text": "* Active debugging - 1s resolution - 24-72hours retention\n* Recent incident - 10s resolution - 7 days retention\n* Operational trends - 1min resolution -- 30-90 days retention\n* Capacity planning -- 1hour resolution -- 1 year capacity planning",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Active debugging - 1s resolution - 24-72hours retention\n* Recent incident - 10s resolution - 7 days retention\n* Operational trends - 1min resolution -- 30-90 days retention\n* Capacity planning -- 1hour resolution -- 1 year capacity planning",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Pxpqnvj6tAv_E1WzvsfIP",
      "type": "text",
      "x": 697.6393671381608,
      "y": 7791.822201714849,
      "width": 255.47982788085938,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b28",
      "roundness": null,
      "seed": 1633368137,
      "version": 354,
      "versionNonce": 756228425,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788378728101,
      "link": null,
      "locked": false,
      "text": "GPU utilization slow\n- data loader bottleneck\n- CPU bottleneck\n- storage bottleneck\n- synchronization/network\n\nGPU utilization high\n- compute-bound\n- memory bandwidth bound\n- inefficient kernels\n\nuneven GPU\n- straggler worker\n- thermal throttling\n- NCCL/network problem\n- hardware degradation",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GPU utilization slow\n- data loader bottleneck\n- CPU bottleneck\n- storage bottleneck\n- synchronization/network\n\nGPU utilization high\n- compute-bound\n- memory bandwidth bound\n- inefficient kernels\n\nuneven GPU\n- straggler worker\n- thermal throttling\n- NCCL/network problem\n- hardware degradation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "naUCmJEhtudjZ0JQtQBNE",
      "type": "text",
      "x": 186.3115116898229,
      "y": 8818.409621107903,
      "width": 434.93963623046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
