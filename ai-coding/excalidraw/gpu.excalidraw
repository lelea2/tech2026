    {
      "id": "xqt-nhjGPyUoj18qNPgLh",
      "type": "text",
      "x": -367.2134735221523,
      "y": 6860.999840704618,
      "width": 502.03973388671875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
