      "versionNonce": 1044768280,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788294642480,
      "link": null,
      "locked": false,
      "text": "raw document\n   ↓\nparse\nclean\nfilter\ntokenize\npack sequences\n   ↓\nGPU",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "raw document\n   ↓\nparse\nclean\nfilter\ntokenize\npack sequences\n   ↓\nGPU",
      "autoResize": true,
      "lineHeight": 1.25
    },
