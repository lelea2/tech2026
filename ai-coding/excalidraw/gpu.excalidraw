    {
      "id": "gAGQPz4hOn4I4_uVTHr0U",
      "type": "text",
      "x": 655.037716480241,
      "y": 809.0331949156904,
      "width": 823.1195068359375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 1671353624,
      "version": 67,
      "versionNonce": 937718808,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788293938915,
      "link": null,
      "locked": false,
      "text": "Patterns: GPU is waiting for the next batch while the host is doing too much work.\n\n- Training throughput ↓\n- GPU utilization ↓\n- CPU utilization ↑",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Patterns: GPU is waiting for the next batch while the host is doing too much work.\n\n- Training throughput ↓\n- GPU utilization ↓\n- CPU utilization ↑",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Fnz5U8IvKm8BEFLjAngZa",
      "type": "text",
      "x": 660.5377615930782,
      "y": 966.5301275496417,
      "width": 613.6395263671875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 1681986152,
      "version": 84,
      "versionNonce": 185144424,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788293985841,
      "link": null,
      "locked": false,
      "text": "Data-loader bottleneck -- training loop waiting on data loading\n\nDisk / Network Storage\n        ↓\n    DataLoader\n        ↓\n      CPU\n        ↓\n      GPU",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data-loader bottleneck -- training loop waiting on data loading\n\nDisk / Network Storage\n        ↓\n    DataLoader\n        ↓\n      CPU\n        ↓\n      GPU",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "J5n3NvEQCc1JguCMFEWUV",
      "type": "text",
      "x": 1125.011056941607,
      "y": 1024.9495256400492,
      "width": 285.97979736328125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 1264100968,
      "version": 150,
      "versionNonce": 1626938216,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788294004841,
      "link": null,
      "locked": false,
      "text": "GPU finishes batch N\n        ↓\nwaits...\n        ↓\nCPU is still loading batch N+1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GPU finishes batch N\n        ↓\nwaits...\n        ↓\nCPU is still loading batch N+1",
      "autoResize": true,
      "lineHeight": 1.25
    },
