      "isDeleted": false,
      "boundElements": null,
      "updated": 1788373848633,
      "link": null,
      "locked": false,
      "text": "                    ┌───────────────┐\nGPU → Collector → Kafka → Processor → Storage\n       │            │        │\n       │            │        ├─ event-time windows\n       │            │        ├─ watermark\n       │            │        └─ deduplication\n       │            │\n       │            └─ bounded durable backlog\n       │\n       ├─ local WAL\n       ├─ batching\n       └─ priority shedding",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                    ┌───────────────┐\nGPU → Collector → Kafka → Processor → Storage\n       │            │        │\n       │            │        ├─ event-time windows\n       │            │        ├─ watermark\n       │            │        └─ deduplication\n       │            │\n       │            └─ bounded durable backlog\n       │\n       ├─ local WAL\n       ├─ batching\n       └─ priority shedding",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dPgenu6KhS1c_R5CdF97d",
      "type": "rectangle",
      "x": -397.95371321993804,
      "y": 6817.081376828148,
      "width": 580.393314719842,
      "height": 395.43033554024896,
      "angle": 0,
      "strokeColor": "#e03131",
