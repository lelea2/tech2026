      "boundElements": [],
      "updated": 1788303353937,
      "link": null,
      "locked": false,
      "text": "                         LLM latency ↑\n                              |\n                +-------------+-------------+\n                |                           |\n          Queue latency ↑              Execution ↑\n                |                           |\n          QUEUE BOUND                 GPU util?\n                                    /           \\\n                                  low           high\n                                  |               |\n                              starvation       SM util?\n                              /   |   \\        /       \\\n                           CPU   I/O  H2D     high      low\n                                              |          |\n                                           compute    HBM BW?\n                                           bound     /      \\\n                                                   high     low\n                                                    |        |\n                                                  memory   comm/\n                                                  bound    stalls",
      "fontSize": 24.823064198990096,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                         LLM latency ↑\n                              |\n                +-------------+-------------+\n                |                           |\n          Queue latency ↑              Execution ↑\n                |                           |\n          QUEUE BOUND                 GPU util?\n                                    /           \\\n                                  low           high\n                                  |               |\n                              starvation       SM util?\n                              /   |   \\        /       \\\n                           CPU   I/O  H2D     high      low\n                                              |          |\n                                           compute    HBM BW?\n                                           bound     /      \\\n                                                   high     low\n                                                    |        |\n                                                  memory   comm/\n                                                  bound    stalls",
      "autoResize": true,
      "lineHeight": 1.25
