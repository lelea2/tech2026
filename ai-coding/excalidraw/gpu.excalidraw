    {
      "id": "KqUDDwbYlS8d4xjbS8rAd",
      "type": "text",
      "x": 285.13204562670614,
      "y": 7575.700187384192,
      "width": 893.9561891971402,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b20",
      "roundness": null,
      "seed": 1667534249,
      "version": 98,
      "versionNonce": 1373104297,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788374113594,
      "link": null,
      "locked": false,
      "text": "use event-time processing and watermarks for out-of-order data, bounded queues plus\npriority-based degradation for backpressure, and at-least-once delivery with idempotent\nconsumers for reliability. I assume retries and late events are normal operating conditions\nrather than exceptional cases.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "use event-time processing and watermarks for out-of-order data, bounded queues plus priority-based degradation for backpressure, and at-least-once delivery with idempotent consumers for reliability. I assume retries and late events are normal operating conditions rather than exceptional cases.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "GFCFSaKC4eklviwK87ZTW",
      "type": "text",
