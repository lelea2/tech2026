      "seed": 1168189208,
      "version": 86,
      "versionNonce": 1631172888,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788292779517,
      "link": null,
      "locked": false,
      "text": "1) Step time\n2) Samples/sec\n3) Tokens/sec\n4) GPU idle time\n5) Data-loader latency\n6) All-reduce latency\n7) NCCL errors\n8) Straggler workers\n9) Checkpoint latency\n10) Checkpoint failures\n11) Training progress\n12) Estimated completion time\n13) Loss\n14) Learning rate\n15) Gradient anomalies\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Step time\n2) Samples/sec\n3) Tokens/sec\n4) GPU idle time\n5) Data-loader latency\n6) All-reduce latency\n7) NCCL errors\n8) Straggler workers\n9) Checkpoint latency\n10) Checkpoint failures\n11) Training progress\n12) Estimated completion time\n13) Loss\n14) Learning rate\n15) Gradient anomalies\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xpf_8wapSr68fQO3XtVUb",
      "type": "text",
      "x": -186,
      "y": 302.5,
      "width": 452.7904052734375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0i",
      "roundness": null,
      "seed": 868581144,
      "version": 178,
      "versionNonce": 2139715096,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788293113342,
      "link": null,
      "locked": false,
      "text": "NCCL: Nvidia Collective communications library\nSM: Streaming multiprocessor\nHBM: high bandwidth memory\nPCIe: Peripheral Component Interconnect\nExpress\nECC: Error-Correcting code RAM\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NCCL: Nvidia Collective communications library\nSM: Streaming multiprocessor\nHBM: high bandwidth memory\nPCIe: Peripheral Component Interconnect Express\nECC: Error-Correcting code RAM\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
