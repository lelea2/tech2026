    {
      "id": "TND029JDeC0NbOWWY5Vwg",
      "type": "text",
      "x": 794,
      "y": 271.5,
      "width": 293.9198303222656,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
