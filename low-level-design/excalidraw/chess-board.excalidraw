      "fontSize": 18,
      "fontFamily": 8,
      "text": "CHECK\nfind king → can any opponent piece attack it?\n\nCHECKMATE\nin check AND no legal move removes check\n\nSTALEMATE\nNOT in check AND no legal move exists",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHECK\nfind king → can any opponent piece attack it?\n\nCHECKMATE\nin check AND no legal move removes check\n\nSTALEMATE\nNOT in check AND no legal move exists",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0D"
