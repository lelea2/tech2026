    {
      "id": "b12cbd415f",
      "type": "text",
      "x": 99.953125,
      "y": 3799.703125,
      "width": 1268.45166015625,
      "height": 118.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
