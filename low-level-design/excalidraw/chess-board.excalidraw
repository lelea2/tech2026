    {
      "id": "7587c5194d",
      "type": "text",
      "x": 86.625,
      "y": 2941.29296875,
      "width": 387.75,
      "height": 768.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "version": 31,
      "versionNonce": 330220939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786989400850,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 8,
      "text": "class ChessGame {\n  private board = new Board();\n  private currentTurn = Color.WHITE;\n  private status = GameStatus.ACTIVE;\n  private history: Move[] = [];\n\n  constructor(\n    private validator: MoveValidator\n  ) {}\n\n  makeMove(from: Position, to: Position) {\n    if (!this.validator.isLegalMove(\n      this, from, to\n    )) return false;\n\n    const piece = this.board.getPiece(from)!;\n    const captured = this.board.getPiece(to);\n\n    this.board.movePiece(from, to);\n\n    this.history.push(\n      new Move(from, to, piece,\n        captured ?? undefined)\n    );\n\n    this.updateGameStatus();\n    this.switchTurn();\n    return true;\n  }\n\n  getBoard() { return this.board; }\n  getCurrentTurn() { return this.currentTurn; }\n\n  private switchTurn() {\n    this.currentTurn =\n      this.currentTurn === Color.WHITE\n        ? Color.BLACK : Color.WHITE;\n  }\n\n  private updateGameStatus() {}\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class ChessGame {\n  private board = new Board();\n  private currentTurn = Color.WHITE;\n  private status = GameStatus.ACTIVE;\n  private history: Move[] = [];\n\n  constructor(\n    private validator: MoveValidator\n  ) {}\n\n  makeMove(from: Position, to: Position) {\n    if (!this.validator.isLegalMove(\n      this, from, to\n    )) return false;\n\n    const piece = this.board.getPiece(from)!;\n    const captured = this.board.getPiece(to);\n\n    this.board.movePiece(from, to);\n\n    this.history.push(\n      new Move(from, to, piece,\n        captured ?? undefined)\n    );\n\n    this.updateGameStatus();\n    this.switchTurn();\n    return true;\n  }\n\n  getBoard() { return this.board; }\n  getCurrentTurn() { return this.currentTurn; }\n\n  private switchTurn() {\n    this.currentTurn =\n      this.currentTurn === Color.WHITE\n        ? Color.BLACK : Color.WHITE;\n  }\n\n  private updateGameStatus() {}\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0c"
    },
