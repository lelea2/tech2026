      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "text": "interface SpecialMoveRule {\n  matches(game, from, to): boolean;\n  execute(game, from, to): void;\n}\n\nCastlingRule\nPawnPromotionRule\nEnPassantRule\n\n→ avoids giant ChessGame condition tree",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface SpecialMoveRule {\n  matches(game, from, to): boolean;\n  execute(game, from, to): void;\n}\n\nCastlingRule\nPawnPromotionRule\nEnPassantRule\n\n→ avoids giant ChessGame condition tree",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0G"
