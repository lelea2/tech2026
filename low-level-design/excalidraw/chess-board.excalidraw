      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 1,
      "text": "Avoid: ChessGame with validatePawn(), validateKnight(), castle(), promotion(), check(), checkmate(), undo(), ...\n\nPrefer: ChessGame → orchestrates | Board → state | Piece → movement | MoveValidator → legality | Move → history |\nSpecialMoveRule → exceptions",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avoid: ChessGame with validatePawn(), validateKnight(), castle(), promotion(), check(), checkmate(), undo(), ...\n\nPrefer: ChessGame → orchestrates | Board → state | Piece → movement | MoveValidator → legality | Move → history | SpecialMoveRule → exceptions",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b0l"
    }
