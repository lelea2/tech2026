      "seed": 1,
      "version": 97,
      "versionNonce": 1150110245,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786988946316,
      "link": null,
      "locked": false,
      "fontSize": 19,
      "fontFamily": 1,
      "text": "“I separate movement rules from global game legality. ChessGame owns orchestration and state transitions. \nBoard owns placement and board queries. Each Piece knows its movement pattern. \nMoveValidator checks turn ownership, collisions, captures, and whether a move leaves the king in check. Move is first-class for history,\nundo, replay, castling, and en passant. Special moves are separate strategies so ChessGame does not become a giant condition\ntree.”",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“I separate movement rules from global game legality. ChessGame owns orchestration and state transitions. \nBoard owns placement and board queries. Each Piece knows its movement pattern. \nMoveValidator checks turn ownership, collisions, captures, and whether a move leaves the king in check. Move is first-class for history, undo, replay, castling, and en passant. Special moves are separate strategies so ChessGame does not become a giant condition tree.”",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b0i"
    },
