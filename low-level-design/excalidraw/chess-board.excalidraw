      "fontSize": 15,
      "fontFamily": 8,
      "text": "interface SpecialMoveRule {\n  matches(\n    game: ChessGame,\n    from: Position,\n    to: Position\n  ): boolean;\n\n  execute(\n    game: ChessGame,\n    from: Position,\n    to: Position\n  ): void;\n}\n\nclass PawnPromotionRule\nimplements SpecialMoveRule {\n  matches(game, from, to) {\n    const piece =\n      game.getBoard().getPiece(from);\n\n    return piece instanceof Pawn &&\n      (to.row === 0 || to.row === 7);\n  }\n\n  execute(game, from, to) {\n    // replace pawn with:\n    // Queen / Rook / Bishop / Knight\n  }\n}\n\n// Also:\n// CastlingRule\n// EnPassantRule",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface SpecialMoveRule {\n  matches(\n    game: ChessGame,\n    from: Position,\n    to: Position\n  ): boolean;\n\n  execute(\n    game: ChessGame,\n    from: Position,\n    to: Position\n  ): void;\n}\n\nclass PawnPromotionRule\nimplements SpecialMoveRule {\n  matches(game, from, to) {\n    const piece =\n      game.getBoard().getPiece(from);\n\n    return piece instanceof Pawn &&\n      (to.row === 0 || to.row === 7);\n  }\n\n  execute(game, from, to) {\n    // replace pawn with:\n    // Queen / Rook / Bishop / Knight\n  }\n}\n\n// Also:\n// CastlingRule\n// EnPassantRule",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0f"
    },
