      "isDeleted": false,
      "boundElements": [],
      "updated": 1786989364729,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 8,
      "text": "class Knight extends Piece {\n  canMove(from: Position, to: Position) {\n    const dr = Math.abs(to.row - from.row);\n    const dc = Math.abs(to.col - from.col);\n\n    return (dr === 2 && dc === 1) ||\n           (dr === 1 && dc === 2);\n  }\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Knight extends Piece {\n  canMove(from: Position, to: Position) {\n    const dr = Math.abs(to.row - from.row);\n    const dc = Math.abs(to.col - from.col);\n\n    return (dr === 2 && dc === 1) ||\n           (dr === 1 && dc === 2);\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0Q"
    },
