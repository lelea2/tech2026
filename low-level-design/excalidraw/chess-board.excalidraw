      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 8,
      "text": "interface MoveValidator {\n  isLegalMove(game, from, to): boolean;\n}\n\nclass StandardMoveValidator\nimplements MoveValidator {\n  isLegalMove(game, from, to) {\n    const board = game.getBoard();\n    const piece = board.getPiece(from);\n\n    if (!piece) return false;\n    if (piece.color !== game.getCurrentTurn())\n      return false;\n\n    const target = board.getPiece(to);\n    if (target?.color === piece.color)\n      return false;\n\n    if (!piece.canMove(from, to, board))\n      return false;\n\n    return !this.leavesKingInCheck(\n      game, from, to\n    );\n  }\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface MoveValidator {\n  isLegalMove(game, from, to): boolean;\n}\n\nclass StandardMoveValidator\nimplements MoveValidator {\n  isLegalMove(game, from, to) {\n    const board = game.getBoard();\n    const piece = board.getPiece(from);\n\n    if (!piece) return false;\n    if (piece.color !== game.getCurrentTurn())\n      return false;\n\n    const target = board.getPiece(to);\n    if (target?.color === piece.color)\n      return false;\n\n    if (!piece.canMove(from, to, board))\n      return false;\n\n    return !this.leavesKingInCheck(\n      game, from, to\n    );\n  }\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b0W"
    },
