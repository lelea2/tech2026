      "updated": 1786989367850,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 8,
      "text": "class Board {\n  private squares =\n    Array.from({ length: 8 },\n      () => Array(8).fill(null));\n\n  getPiece(p: Position) {\n    return this.squares[p.row][p.col];\n  }\n\n  movePiece(from: Position, to: Position) {\n    const piece = this.getPiece(from);\n    this.squares[to.row][to.col] = piece;\n    this.squares[from.row][from.col] = null;\n  }\n\n  isPathClear(from, to) {\n    // walk between squares\n    return true;\n  }\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Board {\n  private squares =\n    Array.from({ length: 8 },\n      () => Array(8).fill(null));\n\n  getPiece(p: Position) {\n    return this.squares[p.row][p.col];\n  }\n\n  movePiece(from: Position, to: Position) {\n    const piece = this.getPiece(from);\n    this.squares[to.row][to.col] = piece;\n    this.squares[from.row][from.col] = null;\n  }\n\n  isPathClear(from, to) {\n    // walk between squares\n    return true;\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0T"
    },
