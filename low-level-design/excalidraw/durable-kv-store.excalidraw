    {
      "id": "VTw5QQdN90OFLeiG_Qkhx",
      "type": "text",
      "x": 338.33984375,
      "y": 723.953125,
      "width": 789.99951171875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "btj",
      "roundness": null,
      "seed": 1405731820,
      "version": 52,
      "versionNonce": 1504880876,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786841270845,
      "link": null,
      "locked": false,
      "text": "put(key, value)   -> upsert; appends a PUT record, applies to memtable\ndelete(key)       -> append a DELETE record (tombstone); apply to memtable\nget(key)          -> newest visible version, or NOT_FOUND if tombstoned/absent",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "put(key, value)   -> upsert; appends a PUT record, applies to memtable\ndelete(key)       -> append a DELETE record (tombstone); apply to memtable\nget(key)          -> newest visible version, or NOT_FOUND if tombstoned/absent",
      "autoResize": true,
      "lineHeight": 1.25
    },
