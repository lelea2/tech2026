    {
      "id": "iN_ryYLUFsrK9HDju8XXL",
      "type": "text",
      "x": 333.58984375,
      "y": 864.953125,
      "width": 830.672119140625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "btl",
      "roundness": null,
      "seed": 1183975404,
      "version": 163,
      "versionNonce": 1905847276,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786841318078,
      "link": null,
      "locked": false,
      "text": "* durability = SYNC — ack only after the WAL record is fsync'd (default). Survives\npower loss.\n\n* durability = ASYNC — ack after append to the page cache; a background fsync\nruns every T ms. Faster, but acknowledged writes in the last T ms can be lost on\npower failure. The loss window is bounded and explicit , never silent.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* durability = SYNC — ack only after the WAL record is fsync'd (default). Survives power loss.\n\n* durability = ASYNC — ack after append to the page cache; a background fsync runs every T ms. Faster, but acknowledged writes in the last T ms can be lost on power failure. The loss window is bounded and explicit , never silent.",
      "autoResize": false,
      "lineHeight": 1.25
    },
