    {
      "id": "96786424c1364dc7b7e6",
      "type": "text",
      "x": 58.04423869517359,
      "y": 3287.4212291876447,
      "width": 820,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 2,
      "version": 70,
      "versionNonce": 2009707229,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784064240377,
      "link": null,
      "locked": false,
      "text": "Unit / component tests\n• Renders question and options\n• Submit disabled until selection\n• Calls onVote with correct poll and option\n• Shows loading state\n• Shows canonical results\n• Error preserves selection\n• Retry works\n• Zero-vote percentage is 0\n• Expired poll disables voting\n• Already-voted poll shows results\n• Aborted request does not update state\n\nAccessibility tests\n• Keyboard selection works\n• Radio group has accessible name\n• Error is announced\n• Success message is announced\n• Color is not sole status indicator\n\nIntegration tests\n• Optimistic rollback\n• Cross-tab duplicate vote\n• Real-time count refresh",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Unit / component tests\n• Renders question and options\n• Submit disabled until selection\n• Calls onVote with correct poll and option\n• Shows loading state\n• Shows canonical results\n• Error preserves selection\n• Retry works\n• Zero-vote percentage is 0\n• Expired poll disables voting\n• Already-voted poll shows results\n• Aborted request does not update state\n\nAccessibility tests\n• Keyboard selection works\n• Radio group has accessible name\n• Error is announced\n• Success message is announced\n• Color is not sole status indicator\n\nIntegration tests\n• Optimistic rollback\n• Cross-tab duplicate vote\n• Real-time count refresh",
      "autoResize": false,
      "lineHeight": 1.25
    },
