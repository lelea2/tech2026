      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8. Core React / TypeScript Implementation",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "22a57cdef8354c17aa95",
      "type": "text",
      "x": 1972.948793748572,
      "y": 1505.6170625018622,
      "width": 801.2428694420443,
      "height": 1530,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 2,
      "version": 244,
      "versionNonce": 1422352531,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784064185618,
      "link": null,
      "locked": false,
      "text": "type SubmissionStatus = \"idle\" | \"submitting\" | \"success\" | \"error\";\n\nexport function PollWidget({ poll, onVote }: PollWidgetProps) {\n  const [currentPoll, setCurrentPoll] = useState(poll);\n  const [selectedOptionId, setSelectedOptionId] =\n    useState<string | null>(poll.userVoteOptionId ?? null);\n  const [status, setStatus] = useState<SubmissionStatus>(\"idle\");\n  const [error, setError] = useState<string | null>(null);\n  const controllerRef = useRef<AbortController | null>(null);\n\n  const totalVotes = useMemo(\n    () => currentPoll.options.reduce((sum, option) => sum + option.voteCount,\n0),\n    [currentPoll.options]\n  );\n\n  const hasVoted = currentPoll.userVoteOptionId !== undefined;\n  const hasExpired = currentPoll.expiresAt !== undefined &&\n    new Date(currentPoll.expiresAt).getTime() <= Date.now();\n  const canSubmit = selectedOptionId !== null && !hasVoted &&\n    !hasExpired && status !== \"submitting\";\n\n  async function handleSubmit(event: FormEvent<HTMLFormElement>) {\n    event.preventDefault();\n    if (!canSubmit || selectedOptionId === null) return;\n\n    controllerRef.current?.abort();\n    const controller = new AbortController();\n    controllerRef.current = controller;\n    setStatus(\"submitting\");\n    setError(null);\n\n    try {\n      const updatedPoll = await onVote(\n        currentPoll.id, selectedOptionId, controller.signal\n      );\n      setCurrentPoll(updatedPoll);\n      setStatus(\"success\");\n    } catch (err) {\n      if (controller.signal.aborted) return;\n      setStatus(\"error\");\n      setError(err instanceof Error ? err.message : \"Unable to submit vote.\");\n    }\n  }\n\n  return (\n    <section aria-labelledby={`poll-${currentPoll.id}-question`}>\n      <form onSubmit={handleSubmit}>\n        <fieldset disabled={hasVoted || hasExpired || status === \"submitting\"}>\n          <legend id={`poll-${currentPoll.id}-question`}>\n            {currentPoll.question}\n          </legend>\n          {currentPoll.options.map(option => (\n            <label key={option.id}>\n              <input type=\"radio\" name={`poll-${currentPoll.id}`}\n                checked={selectedOptionId === option.id}\n                onChange={() => setSelectedOptionId(option.id)} />\n              {option.label}\n            </label>\n          ))}\n        </fieldset>\n        <button type=\"submit\" disabled={!canSubmit}>\n          {status === \"submitting\" ? \"Submitting...\" : \"Submit vote\"}\n        </button>\n        {error && <p role=\"alert\">{error}</p>}\n        <div aria-live=\"polite\">\n          {status === \"success\" && \"Your vote was submitted.\"}\n        </div>\n      </form>\n    </section>\n  );\n}",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type SubmissionStatus = \"idle\" | \"submitting\" | \"success\" | \"error\";\n\nexport function PollWidget({ poll, onVote }: PollWidgetProps) {\n  const [currentPoll, setCurrentPoll] = useState(poll);\n  const [selectedOptionId, setSelectedOptionId] =\n    useState<string | null>(poll.userVoteOptionId ?? null);\n  const [status, setStatus] = useState<SubmissionStatus>(\"idle\");\n  const [error, setError] = useState<string | null>(null);\n  const controllerRef = useRef<AbortController | null>(null);\n\n  const totalVotes = useMemo(\n    () => currentPoll.options.reduce((sum, option) => sum + option.voteCount, 0),\n    [currentPoll.options]\n  );\n\n  const hasVoted = currentPoll.userVoteOptionId !== undefined;\n  const hasExpired = currentPoll.expiresAt !== undefined &&\n    new Date(currentPoll.expiresAt).getTime() <= Date.now();\n  const canSubmit = selectedOptionId !== null && !hasVoted &&\n    !hasExpired && status !== \"submitting\";\n\n  async function handleSubmit(event: FormEvent<HTMLFormElement>) {\n    event.preventDefault();\n    if (!canSubmit || selectedOptionId === null) return;\n\n    controllerRef.current?.abort();\n    const controller = new AbortController();\n    controllerRef.current = controller;\n    setStatus(\"submitting\");\n    setError(null);\n\n    try {\n      const updatedPoll = await onVote(\n        currentPoll.id, selectedOptionId, controller.signal\n      );\n      setCurrentPoll(updatedPoll);\n      setStatus(\"success\");\n    } catch (err) {\n      if (controller.signal.aborted) return;\n      setStatus(\"error\");\n      setError(err instanceof Error ? err.message : \"Unable to submit vote.\");\n    }\n  }\n\n  return (\n    <section aria-labelledby={`poll-${currentPoll.id}-question`}>\n      <form onSubmit={handleSubmit}>\n        <fieldset disabled={hasVoted || hasExpired || status === \"submitting\"}>\n          <legend id={`poll-${currentPoll.id}-question`}>\n            {currentPoll.question}\n          </legend>\n          {currentPoll.options.map(option => (\n            <label key={option.id}>\n              <input type=\"radio\" name={`poll-${currentPoll.id}`}\n                checked={selectedOptionId === option.id}\n                onChange={() => setSelectedOptionId(option.id)} />\n              {option.label}\n            </label>\n          ))}\n        </fieldset>\n        <button type=\"submit\" disabled={!canSubmit}>\n          {status === \"submitting\" ? \"Submitting...\" : \"Submit vote\"}\n        </button>\n        {error && <p role=\"alert\">{error}</p>}\n        <div aria-live=\"polite\">\n          {status === \"success\" && \"Your vote was submitted.\"}\n        </div>\n      </form>\n    </section>\n  );\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
