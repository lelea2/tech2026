      "boundElements": [],
      "updated": 1784064023897,
      "link": null,
      "locked": false,
      "text": "Interview narrative:\n1) Clarify rules and states → 2) define typed contract → 3) implement accessible baseline →\n4) handle async failures → 5) discuss optimistic updates, consistency, real-time, and feed scale.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interview narrative:\n1) Clarify rules and states → 2) define typed contract → 3) implement accessible baseline →\n4) handle async failures → 5) discuss optimistic updates, consistency, real-time, and feed scale.",
      "autoResize": false,
      "lineHeight": 1.25
