      "seed": 2,
      "version": 52,
      "versionNonce": 1073351123,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784064246232,
      "link": null,
      "locked": false,
      "text": "Basic\n• Controlled radio inputs\n• Selection and submit\n• Results rendering\n\nStrong\n• Loading, error, retry\n• Semantic HTML\n• Derived state\n• Meaningful tests\n\nSenior\n• Stale request handling\n• Typed reusable API\n• Optimistic update discussion\n• Prop synchronization\n• Concurrent update awareness\n\nStaff signal\n• Clear local vs server ownership\n• Idempotency and consistency\n• Feed-scale subscription strategy\n• Observability and product metrics\n• Accessibility and failure recovery\n• Evolves design without premature abstraction",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Basic\n• Controlled radio inputs\n• Selection and submit\n• Results rendering\n\nStrong\n• Loading, error, retry\n• Semantic HTML\n• Derived state\n• Meaningful tests\n\nSenior\n• Stale request handling\n• Typed reusable API\n• Optimistic update discussion\n• Prop synchronization\n• Concurrent update awareness\n\nStaff signal\n• Clear local vs server ownership\n• Idempotency and consistency\n• Feed-scale subscription strategy\n• Observability and product metrics\n• Accessibility and failure recovery\n• Evolves design without premature abstraction",
      "autoResize": false,
      "lineHeight": 1.25
    },
