    {
      "id": "CdO9BrilncxiA7Bq3Q5T7",
      "type": "text",
      "x": 2878.68674134453,
      "y": 1431.902733105381,
      "width": 1240.463134765625,
      "height": 980,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
