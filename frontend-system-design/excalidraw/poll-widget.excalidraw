      "updated": 1784064023897,
      "link": null,
      "locked": false,
      "text": "1. Interview Prompt",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Interview Prompt",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "14d02f572c87441e8ab4",
      "type": "text",
      "x": 65,
      "y": 230,
      "width": 540,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a18",
      "roundness": null,
      "seed": 2,
      "version": 2,
      "versionNonce": 573205469,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784064023897,
      "link": null,
      "locked": false,
      "text": "Build a reusable React poll widget.\n\nCore behavior\n• Show question and options\n• Single selection\n• Submit vote to API\n• Loading, success, and error states\n• Show percentages and vote counts\n• Prevent duplicate submissions\n\nAdvanced scope\n• Retry on failure\n• Already-voted state\n• Poll expiration\n• Accessible keyboard / screen-reader support\n• Optional optimistic updates\n• Real-time results\n• Feed-scale rendering",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Build a reusable React poll widget.\n\nCore behavior\n• Show question and options\n• Single selection\n• Submit vote to API\n• Loading, success, and error states\n• Show percentages and vote counts\n• Prevent duplicate submissions\n\nAdvanced scope\n• Retry on failure\n• Already-voted state\n• Poll expiration\n• Accessible keyboard / screen-reader support\n• Optional optimistic updates\n• Real-time results\n• Feed-scale rendering",
      "autoResize": false,
      "lineHeight": 1.25
    },
