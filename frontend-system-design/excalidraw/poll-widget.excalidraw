    {
      "id": "32c426febc3646aa812a",
      "type": "text",
      "x": 69.84481919574137,
      "y": 1540,
      "width": 820,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2t",
      "roundness": null,
      "seed": 2,
      "version": 3,
      "versionNonce": 1290147069,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784064114521,
      "link": null,
      "locked": false,
      "text": "GET /api/polls/:pollId\n\nPOST /api/polls/:pollId/votes\nHeaders:\n  Content-Type: application/json\n  Idempotency-Key: <request-id>\n\nRequest\n{\n  \"optionId\": \"react\"\n}\n\nResponse\n{\n  \"id\": \"poll-123\",\n  \"question\": \"...\",\n  \"options\": [\n    { \"id\": \"react\", \"label\": \"React\", \"voteCount\": 121 }\n  ],\n  \"userVoteOptionId\": \"react\",\n  \"expiresAt\": \"2026-08-01T00:00:00Z\"\n}\n\nBackend validation\n• Poll exists\n• Option belongs to poll\n• User is authorized\n• Poll is active\n• Duplicate-vote rules\n• Idempotency / rate limits",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GET /api/polls/:pollId\n\nPOST /api/polls/:pollId/votes\nHeaders:\n  Content-Type: application/json\n  Idempotency-Key: <request-id>\n\nRequest\n{\n  \"optionId\": \"react\"\n}\n\nResponse\n{\n  \"id\": \"poll-123\",\n  \"question\": \"...\",\n  \"options\": [\n    { \"id\": \"react\", \"label\": \"React\", \"voteCount\": 121 }\n  ],\n  \"userVoteOptionId\": \"react\",\n  \"expiresAt\": \"2026-08-01T00:00:00Z\"\n}\n\nBackend validation\n• Poll exists\n• Option belongs to poll\n• User is authorized\n• Poll is active\n• Duplicate-vote rules\n• Idempotency / rate limits",
      "autoResize": false,
      "lineHeight": 1.25
    },
