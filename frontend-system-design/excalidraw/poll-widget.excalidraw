    {
      "id": "4551fdaa21ab43b2a984",
      "type": "text",
      "x": 66.8075281596141,
      "y": 2509.5215500081963,
      "width": 820,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 2,
      "version": 48,
      "versionNonce": 305543645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784064209594,
      "link": null,
      "locked": false,
      "text": "Accessibility\n• <fieldset> + <legend>\n• Native radio inputs\n• Unique radio group name\n• Disabled semantics\n• role=\"alert\" for errors\n• aria-live=\"polite\" for success\n• Text plus visual progress bars\n• Respect prefers-reduced-motion\n• Do not rely on color alone\n\nEdge cases\n• Zero options\n• Zero total votes\n• Long labels\n• Duplicate option IDs\n• Double-click submit\n• Prop changes during request\n• Request completes after unmount\n• Poll expires during submission\n• Vote already cast on another device\n• Network loss / timeout\n• Very large vote counts",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Accessibility\n• <fieldset> + <legend>\n• Native radio inputs\n• Unique radio group name\n• Disabled semantics\n• role=\"alert\" for errors\n• aria-live=\"polite\" for success\n• Text plus visual progress bars\n• Respect prefers-reduced-motion\n• Do not rely on color alone\n\nEdge cases\n• Zero options\n• Zero total votes\n• Long labels\n• Duplicate option IDs\n• Double-click submit\n• Prop changes during request\n• Request completes after unmount\n• Poll expires during submission\n• Vote already cast on another device\n• Network loss / timeout\n• Very large vote counts",
      "autoResize": false,
      "lineHeight": 1.25
    },
