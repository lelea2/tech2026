    {
      "id": "385046e90f884d39b227",
      "type": "text",
      "x": 1030.4336785471746,
      "y": 3286.0308116525766,
      "width": 870,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
