      "updated": 1786129230024,
      "link": null,
      "locked": false,
      "text": "Static docs / brand knowledge\n→ RAG / search\n→ selected chunks\n→ LLM context\n\nLive campaign metrics\n→ MCP tool\n→ Analytics API\n→ compact structured result\n→ LLM\n\nSession state\n→ agent context\n→ do NOT rediscover through RAG\n\nLarge raw datasets\n→ aggregate/filter inside tool/service\n→ do NOT dump into LLM context",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Static docs / brand knowledge\n→ RAG / search\n→ selected chunks\n→ LLM context\n\nLive campaign metrics\n→ MCP tool\n→ Analytics API\n→ compact structured result\n→ LLM\n\nSession state\n→ agent context\n→ do NOT rediscover through RAG\n\nLarge raw datasets\n→ aggregate/filter inside tool/service\n→ do NOT dump into LLM context",
      "autoResize": true,
      "lineHeight": 1.25
    },
