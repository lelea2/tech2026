      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "validateSchema(call)\nauthorize(user, tool, resource)\nenforceTenant(...)\nrequireApprovalIfRisky(...)\nwithIdempotency(stepId, async () => {\n  result = mcpClient.callTool(call)\n  audit(traceId, call, result)\n  return normalizeForLLM(result)\n})",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "validateSchema(call)\nauthorize(user, tool, resource)\nenforceTenant(...)\nrequireApprovalIfRisky(...)\nwithIdempotency(stepId, async () => {\n  result = mcpClient.callTool(call)\n  audit(traceId, call, result)\n  return normalizeForLLM(result)\n})",
      "autoResize": true,
      "lineHeight": 1.25
    },
