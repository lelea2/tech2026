      "isDeleted": true,
      "boundElements": [],
      "updated": 1786129418550,
      "link": null,
      "locked": false,
      "text": "MCP vs function calling → model intent format vs standardized tool-provider protocol.\nTimeout ≠ failed side effect → reconcile before retry; idempotency + expectedVersion for writes.\nSecurity → LLM has no raw credentials; policy gateway owns authorization, tenant isolation and approval.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MCP vs function calling → model intent format vs standardized tool-provider protocol.\nTimeout ≠ failed side effect → reconcile before retry; idempotency + expectedVersion for writes.\nSecurity → LLM has no raw credentials; policy gateway owns authorization, tenant isolation and approval.",
      "autoResize": true,
      "lineHeight": 1.25
    },
