      "boundElements": null,
      "updated": 1783980841743,
      "link": null,
      "locked": false,
      "text": "A sitemap helps crawlers discover important pages, \nbut submission is a hint rather than a guarantee of crawling or indexing.  \nSitemap update triggers\n* Listing published or unpublished\n* Destination landing page enabled\n* Meaningful descriptive content changed\n* Listing permanently removed\n* Canonical route changed\n* Localization launched\n* Category page promoted or demoted",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A sitemap helps crawlers discover important pages, \nbut submission is a hint rather than a guarantee of crawling or indexing.  \nSitemap update triggers\n* Listing published or unpublished\n* Destination landing page enabled\n* Meaningful descriptive content changed\n* Listing permanently removed\n* Canonical route changed\n* Localization launched\n* Category page promoted or demoted",
      "autoResize": true,
      "lineHeight": 1.25
    },
