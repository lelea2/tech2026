      "isDeleted": false,
      "boundElements": null,
      "updated": 1783979097825,
      "link": null,
      "locked": false,
      "text": "Search engine / Social crawler / User\n                  │\n                  ▼\n          CDN + Edge Routing\n     ┌────────────┴─────────────┐\n     │                          │\nIndexable public route    Transactional route\n/destinations/...         /book/... /account/...\n     │                          │\nSSR / SSG / ISR           CSR + authenticated APIs\n     │\nSEO aggregation layer / BFF\n     │\n     ├── Destination metadata\n     ├── Listing summaries\n     ├── Availability summary\n     ├── Review aggregates\n     ├── Localization content\n     └── Canonical URL policy",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Search engine / Social crawler / User\n                  │\n                  ▼\n          CDN + Edge Routing\n     ┌────────────┴─────────────┐\n     │                          │\nIndexable public route    Transactional route\n/destinations/...         /book/... /account/...\n     │                          │\nSSR / SSG / ISR           CSR + authenticated APIs\n     │\nSEO aggregation layer / BFF\n     │\n     ├── Destination metadata\n     ├── Listing summaries\n     ├── Availability summary\n     ├── Review aggregates\n     ├── Localization content\n     └── Canonical URL policy",
      "autoResize": true,
      "lineHeight": 1.25
    },
