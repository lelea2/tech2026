      "link": null,
      "locked": false,
      "text": "//The SEO platform should provide one canonical policy service:\n\nfunction getCanonicalUrl(search: SearchCriteria): URL {\n  const indexable = extractIndexableDimensions(search);\n\n  return buildDestinationUrl({\n    destination: indexable.destination,\n    category: indexable.category,\n    locale: indexable.locale,\n  });\n}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "//The SEO platform should provide one canonical policy service:\n\nfunction getCanonicalUrl(search: SearchCriteria): URL {\n  const indexable = extractIndexableDimensions(search);\n\n  return buildDestinationUrl({\n    destination: indexable.destination,\n    category: indexable.category,\n    locale: indexable.locale,\n  });\n}",
      "autoResize": true,
