      "text": "Response example:\n{\n  // Pagination metadata.\n  \"pagination\": {\n    \"size\": 5,\n    \"page\": 2,\n    \"total_pages\": 15,\n    \"total\": 74\n  },\n  \"results\": [\n    {\n      \"id\": 561602, // Accommodation ID.\n      \"title\": \"Great view in the Mission, 15 mins by bus downtown\",\n      \"images\": [\n        \"https://www.greathotels.com/img/1.jpg\",\n        \"https://www.greathotels.com/img/2.jpg\",\n        \"https://www.greathotels.com/img/3.jpg\",\n        \"https://www.greathotels.com/img/4.jpg\"\n      ],\n      \"rating\": 4.82,\n      \"coordinates\": {\n        \"latitude\": 37.74403,\n        \"longitude\": -122.41755\n      },\n      \"price\": 200,\n      \"currency\": \"USD\"\n    }\n    // ... More accommodation results.\n  ]\n}\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Response example:\n{\n  // Pagination metadata.\n  \"pagination\": {\n    \"size\": 5,\n    \"page\": 2,\n    \"total_pages\": 15,\n    \"total\": 74\n  },\n  \"results\": [\n    {\n      \"id\": 561602, // Accommodation ID.\n      \"title\": \"Great view in the Mission, 15 mins by bus downtown\",\n      \"images\": [\n        \"https://www.greathotels.com/img/1.jpg\",\n        \"https://www.greathotels.com/img/2.jpg\",\n        \"https://www.greathotels.com/img/3.jpg\",\n        \"https://www.greathotels.com/img/4.jpg\"\n      ],\n      \"rating\": 4.82,\n      \"coordinates\": {\n        \"latitude\": 37.74403,\n        \"longitude\": -122.41755\n      },\n      \"price\": 200,\n      \"currency\": \"USD\"\n    }\n    // ... More accommodation results.\n  ]\n}\n",
