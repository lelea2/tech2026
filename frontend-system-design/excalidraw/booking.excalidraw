    {
      "id": "Fj1Ai-mWiaZWpdLWyoh15",
      "type": "text",
      "x": 1458.3303882255645,
      "y": 1069.4396754611835,
      "width": 483.0236511230469,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
