      "seed": 1528343400,
      "version": 13,
      "versionNonce": 1620561768,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783979130834,
      "link": null,
      "locked": false,
      "text": "* Public pages must return meaningful HTML without \nrequiring client-side JavaScript to fetch the primary content. \nGoogle can process JavaScript, \nbut JavaScript rendering adds another stage \nand makes discovery, indexing, debugging, \nand performance less predictable. \nDynamic rendering—serving different HTML \nspecifically to bots—is now considered a workaround rather\n than the preferred architecture.  ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Public pages must return meaningful HTML without \nrequiring client-side JavaScript to fetch the primary content. \nGoogle can process JavaScript, \nbut JavaScript rendering adds another stage \nand makes discovery, indexing, debugging, \nand performance less predictable. \nDynamic rendering—serving different HTML \nspecifically to bots—is now considered a workaround rather\n than the preferred architecture.  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
