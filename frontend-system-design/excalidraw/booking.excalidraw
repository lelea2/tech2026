      "boundElements": null,
      "updated": 1783980281187,
      "link": null,
      "locked": false,
      "text": "Bad patterns:\n/search?location=San%20Francisco&amenities=pool,wifi\n/search?amenities=wifi,pool&location=san-francisco\n/san-francisco-ca/stays?amenities=wifi,pool\n\nGood patterns:\n/san-francisco-ca/stays?amenities=pool,wifi ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bad patterns:\n/search?location=San%20Francisco&amenities=pool,wifi\n/search?amenities=wifi,pool&location=san-francisco\n/san-francisco-ca/stays?amenities=wifi,pool\n\nGood patterns:\n/san-francisco-ca/stays?amenities=pool,wifi ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
