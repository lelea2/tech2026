      "updated": 1783980906449,
      "link": null,
      "locked": false,
      "text": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"LodgingBusiness\",\n  \"name\": \"Modern Loft in SoMa\",\n  \"image\": [\"https://cdn.example.com/listing/839201/hero.jpg\"],\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"addressLocality\": \"San Francisco\",\n    \"addressRegion\": \"CA\",\n    \"addressCountry\": \"US\"\n  },\n  \"aggregateRating\": {\n    \"@type\": \"AggregateRating\",\n    \"ratingValue\": \"4.88\",\n    \"reviewCount\": \"327\"\n  }\n}\n</script>",
      "fontSize": 16,
