      "isDeleted": false,
      "boundElements": null,
      "updated": 1783980259299,
      "link": null,
      "locked": false,
      "text": "--- Normalization includes:\n* Lowercase destination slugs\n* Stable filter ordering\n* Removal of default values\n* Deduplicated filter values\n* Valid date formats\n* Valid guest ranges\n* Removal of tracking parameters from canonical URLs\n* Redirecting deprecated destination aliases\n* Stable pagination rules",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--- Normalization includes:\n* Lowercase destination slugs\n* Stable filter ordering\n* Removal of default values\n* Deduplicated filter values\n* Valid date formats\n* Valid guest ranges\n* Removal of tracking parameters from canonical URLs\n* Redirecting deprecated destination aliases\n* Stable pagination rules",
      "autoResize": true,
      "lineHeight": 1.25
    },
