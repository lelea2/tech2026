      "updated": 1783980958815,
      "link": null,
      "locked": false,
      "text": "export async function generateMetadata({ params }) {\n  const listing = await getListing(params.id);\n\n  return {\n    title: `${listing.title} in ${listing.city}`,\n    description: listing.seoDescription,\n    alternates: {\n      canonical: listing.canonicalUrl,\n      languages: listing.localizedUrls,\n    },\n    openGraph: {\n      title: listing.title,\n      images: [listing.heroImage],\n    },\n  };\n}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "export async function generateMetadata({ params }) {\n  const listing = await getListing(params.id);\n\n  return {\n    title: `${listing.title} in ${listing.city}`,\n    description: listing.seoDescription,\n    alternates: {\n      canonical: listing.canonicalUrl,\n      languages: listing.localizedUrls,\n    },\n    openGraph: {\n      title: listing.title,\n      images: [listing.heroImage],\n    },\n  };\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
