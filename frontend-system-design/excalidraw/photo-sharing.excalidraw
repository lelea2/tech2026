    {
      "id": "tHc4w2-g_jSLkaxKI-NMw",
      "type": "text",
      "x": -591.3960186865831,
      "y": 538.4226827046821,
      "width": 647.7996215820312,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 32924314,
      "version": 243,
      "versionNonce": 2090349658,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784054388582,
      "link": null,
      "locked": false,
      "text": "Pros:\n-- The image upload stage can be done in an async fashion. \n-- Images can be uploaded in the background after the image\n editing stage while the user is drafting the post caption.\n-- Images can be uploaded in parallel across multiple \nHTTP requests, which is faster than uploading all the images in \na single HTTP request.\n-- Can leverage existing general image uploading APIs.\n==> more reusable & reduce bandwidth (with blob storage on image\nupload), client request presigned URL to upload image first\n\n==========================\nCons:\n-- More coordination is needed on the client. \nThe client needs to wait for all the images to be uploaded, \nget references to the uploaded images, \nand use them when creating the post.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pros:\n-- The image upload stage can be done in an async fashion. \n-- Images can be uploaded in the background after the image\n editing stage while the user is drafting the post caption.\n-- Images can be uploaded in parallel across multiple \nHTTP requests, which is faster than uploading all the images in \na single HTTP request.\n-- Can leverage existing general image uploading APIs.\n==> more reusable & reduce bandwidth (with blob storage on image\nupload), client request presigned URL to upload image first\n\n==========================\nCons:\n-- More coordination is needed on the client. \nThe client needs to wait for all the images to be uploaded, \nget references to the uploaded images, \nand use them when creating the post.",
      "autoResize": true,
      "lineHeight": 1.25
    },
