      "isDeleted": false,
      "boundElements": null,
      "updated": 1784052228211,
      "link": null,
      "locked": false,
      "text": "Functional requirement\n* Browse feed containing image and video posted by people\n* Upload photos, add captions, apply filter before positing\n* Pagination - support infinite scrolling\n* Device support (mobile - primary , desktop, tablet) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirement\n* Browse feed containing image and video posted by people\n* Upload photos, add captions, apply filter before positing\n* Pagination - support infinite scrolling\n* Device support (mobile - primary , desktop, tablet) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
