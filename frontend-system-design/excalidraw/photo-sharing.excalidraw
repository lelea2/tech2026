    },
    {
      "id": "perfText",
      "type": "text",
      "x": 424.87890625,
      "y": 745,
      "width": 650.1595458984375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 38,
      "version": 4,
      "versionNonce": 12205976,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784050681439,
      "link": null,
      "locked": false,
      "text": "• Prioritize LCP image; reserve aspect ratio to prevent CLS\n• srcset/sizes + CDN variants; lazy-load secondary media\n• Worker-based image processing; bounded feed and decoded-image memory\n• Cursor pagination, prefetch near viewport, measure INP and long tasks",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "• Prioritize LCP image; reserve aspect ratio to prevent CLS\n• srcset/sizes + CDN variants; lazy-load secondary media\n• Worker-based image processing; bounded feed and decoded-image memory\n• Cursor pagination, prefetch near viewport, measure INP and long tasks",
      "autoResize": true,
      "lineHeight": 1.25
    },
