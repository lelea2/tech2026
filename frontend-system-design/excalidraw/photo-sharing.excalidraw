      "originalText": "Feed ==> FeedUI (List<posts> with pagination)\nPost ==> id, created_time, caption, image, author, images[]\nUser => id, name, profile\nNewPost => (client input) ==> caption, images[] \nImage (client/server) -> url, alt, width, height",
      "autoResize": true,
