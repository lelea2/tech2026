      "seed": 508640313,
      "version": 91,
      "versionNonce": 1208880247,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784841189526,
      "link": null,
      "locked": false,
      "text": "type CameraId = string;\ntype CellId = string;\n\ntype CameraStatus = \"online\" | \"offline\" | \"degraded\";\n\ninterface Camera {\n  id: CameraId;\n  name: string;\n  location: string;\n  status: CameraStatus;\n  streamUrl?: string;\n  thumbnailUrl?: string;\n  priority: number;\n}\n\ninterface RotationConfig {\n  enabled: boolean;\n  minDisplayMs: number;\n  challengerHoldMs: number;\n  switchThreshold: number;\n  cooldownMs: number;\n}\n\ninterface CameraGridCell {\n  id: CellId;\n  row: number;\n  column: number;\n  title: string;\n\n  // References normalized camera entities.\n  cameraIds: CameraId[];\n\n  rotation: RotationConfig;\n}\n\ninterface CameraGrid {\n  id: string;\n  name: string;\n  rows: number;\n  columns: number;\n  version: number;\n  cells: CameraGridCell[];\n}\n\ninterface CameraGridResponse {\n  grid: CameraGrid;\n  camerasById: Record<CameraId, Camera>;\n}",
      "fontSize": 8.74820314461847,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type CameraId = string;\ntype CellId = string;\n\ntype CameraStatus = \"online\" | \"offline\" | \"degraded\";\n\ninterface Camera {\n  id: CameraId;\n  name: string;\n  location: string;\n  status: CameraStatus;\n  streamUrl?: string;\n  thumbnailUrl?: string;\n  priority: number;\n}\n\ninterface RotationConfig {\n  enabled: boolean;\n  minDisplayMs: number;\n  challengerHoldMs: number;\n  switchThreshold: number;\n  cooldownMs: number;\n}\n\ninterface CameraGridCell {\n  id: CellId;\n  row: number;\n  column: number;\n  title: string;\n\n  // References normalized camera entities.\n  cameraIds: CameraId[];\n\n  rotation: RotationConfig;\n}\n\ninterface CameraGrid {\n  id: string;\n  name: string;\n  rows: number;\n  columns: number;\n  version: number;\n  cells: CameraGridCell[];\n}\n\ninterface CameraGridResponse {\n  grid: CameraGrid;\n  camerasById: Record<CameraId, Camera>;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wB4kJARVY3qyCvxuAyLvO",
      "type": "image",
      "x": 345.0357892503431,
      "y": 1254.555862149286,
