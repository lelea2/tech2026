    {
      "id": "4N_zis409fc1nH_eRUvyo",
      "type": "text",
      "x": 32.45916799901505,
      "y": 1296.4032743772273,
      "width": 221.4343535406153,
      "height": 524.8921886771082,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
