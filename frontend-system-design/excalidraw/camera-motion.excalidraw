      "originalText": "import React, {\n  memo,\n  useEffect,\n  useMemo,\n  useState\n} from \"react\";\n\nimport \"./camera-grid.css\";\n\nconst POLL_INTERVAL_MS = 1000;\nconst MIN_DISPLAY_MS = 5000;\nconst SWITCH_THRESHOLD = 0.15;\nconst EMA_ALPHA = 0.3;\n\n/*\nAPI response shape:\n\n{\n  grid: {\n    id: \"grid-1\",\n    name: \"Security Wall\",\n    rows: 2,\n    columns: 2,\n    cells: [\n      {\n        id: \"cell-1\",\n        title: \"North Entrance\",\n        cameraIds: [\"camera-1\", \"camera-2\"]\n      }\n    ]\n  },\n\n  // Camera metadata is normalized.\n  // A camera can appear in multiple cells without repeating its data.\n  camerasById: {\n    \"camera-1\": {\n      id: \"camera-1\",\n      name: \"North Door\",\n      status: \"online\",\n      streamUrl: \"/streams/camera-1\",\n      thumbnailUrl: \"/thumbnails/camera-1\"\n    }\n  }\n}\n*/\n\nexport default function CameraGridPage({ data }) {\n  const { grid, camerasById } = data;\n\n  /*\n  motionByCameraId:\n\n  {\n    \"camera-1\": {\n      rawScore: 0.8,\n      smoothedScore: 0.65,\n      updatedAt: 1720000000000\n    }\n  }\n  */\n  const [motionByCameraId, setMotionByCameraId] =\n    useState({});\n\n  /*\n  activeByCellId:\n\n  {\n    \"cell-1\": {\n      cameraId: \"camera-1\",\n      activeSince: 1720000000000\n    }\n  }\n  */\n  const [activeByCellId, setActiveByCellId] = useState(\n    () => createInitialActiveState(grid)\n  );\n\n  /*\n  A camera may be assigned to multiple cells.\n\n  Deduplicate camera IDs before polling so each camera's\n  motion is requested only once.\n  */\n  const cameraIds = useMemo(() => {\n    return [\n      ...new Set(\n        grid.cells.flatMap((cell) => cell.cameraIds)\n      )\n    ];\n  }, [grid]);\n\n  /*\n  Poll motion data every second.\n\n  In production, this could be replaced with SSE.\n  */\n  useEffect(() => {\n    let cancelled = false;\n    let timerId;\n\n    async function pollMotion() {\n      try {\n        const response = await fetch(\n          \"/api/camera-motion/query\",\n          {\n            method: \"POST\",\n            headers: {\n              \"Content-Type\": \"application/json\"\n            },\n            body: JSON.stringify({\n              cameraIds\n            })\n          }\n        );\n\n        if (!response.ok) {\n          throw new Error(\n            `Motion request failed: ${response.status}`\n          );\n        }\n\n        const result = await response.json();\n\n        if (!cancelled) {\n          setMotionByCameraId((previous) =>\n            mergeMotion(previous, result.motionByCameraId)\n          );\n        }\n      } catch (error) {\n        console.error(\"Unable to load motion:\", error);\n      } finally {\n        if (!cancelled) {\n          timerId = window.setTimeout(\n            pollMotion,\n            POLL_INTERVAL_MS\n          );\n        }\n      }\n    }\n\n    pollMotion();\n\n    return () => {\n      cancelled = true;\n      window.clearTimeout(timerId);\n    };\n  }, [cameraIds]);\n\n  /*\n  Reevaluate the best camera for each cell whenever\n  motion data changes.\n\n  Each cell independently selects from its cameraIds.\n  */\n  useEffect(() => {\n    if (Object.keys(motionByCameraId).length === 0) {\n      return;\n    }\n\n    setActiveByCellId((previous) => {\n      const next = { ...previous };\n      const now = Date.now();\n\n      for (const cell of grid.cells) {\n        next[cell.id] = chooseCameraForCell({\n          cell,\n          camerasById,\n          motionByCameraId,\n          current: previous[cell.id],\n          now\n        });\n      }\n\n      return next;\n    });\n  }, [grid, camerasById, motionByCameraId]);\n\n  return (\n    <main className=\"camera-page\">\n      <header className=\"camera-toolbar\">\n        <div>\n          <h1>{grid.name}</h1>\n\n          <p>\n            {grid.rows} × {grid.columns} camera grid\n          </p>\n        </div>\n      </header>\n\n      <CameraGrid\n        grid={grid}\n        camerasById={camerasById}\n        motionByCameraId={motionByCameraId}\n        activeByCellId={activeByCellId}\n      />\n    </main>\n  );\n}\n\nfunction createInitialActiveState(grid) {\n  const now = Date.now();\n\n  return Object.fromEntries(\n    grid.cells.map((cell) => [\n      cell.id,\n      {\n        cameraId: cell.cameraIds[0] || null,\n        activeSince: now\n      }\n    ])\n  );\n}\n\n/*\nSmooth motion scores using an exponential moving average.\n\nThis prevents a one-second motion spike from immediately\nchanging the displayed camera.\n\nsmoothed =\n  alpha * newScore +\n  (1 - alpha) * previousScore\n*/\nfunction mergeMotion(previous, incoming) {\n  const next = { ...previous };\n\n  for (const [cameraId, sample] of Object.entries(\n    incoming\n  )) {\n    const oldScore =\n      previous[cameraId]?.smoothedScore ??\n      sample.score;\n\n    next[cameraId] = {\n      rawScore: sample.score,\n\n      smoothedScore:\n        EMA_ALPHA * sample.score +\n        (1 - EMA_ALPHA) * oldScore,\n\n      updatedAt: Date.parse(sample.capturedAt)\n    };\n  }\n\n  return next;\n}\n\n/*\nCamera-selection rules:\n\n1. Ignore offline cameras.\n2. Find the camera with the highest smoothed score.\n3. Keep the current camera visible for at least 5 seconds.\n4. Switch only when the new camera is meaningfully better.\n\nThis prevents the video from changing every second.\n*/\nfunction chooseCameraForCell({\n  cell,\n  camerasById,\n  motionByCameraId,\n  current,\n  now\n}) {\n  const candidates = cell.cameraIds\n    .map((cameraId) => {\n      return {\n        camera: camerasById[cameraId],\n        motion: motionByCameraId[cameraId]\n      };\n    })\n    .filter(({ camera }) => {\n      return camera && camera.status !== \"offline\";\n    })\n    .sort((a, b) => {\n      const scoreA =\n        a.motion?.smoothedScore ?? 0;\n\n      const scoreB =\n        b.motion?.smoothedScore ?? 0;\n\n      return scoreB - scoreA;\n    });\n\n  const winner = candidates[0];\n\n  if (!winner) {\n    return {\n      cameraId: null,\n      activeSince: now\n    };\n  }\n\n  if (!current?.cameraId) {\n    return {\n      cameraId: winner.camera.id,\n      activeSince: now\n    };\n  }\n\n  const currentCamera =\n    camerasById[current.cameraId];\n\n  /*\n  Immediately fail over if the current camera\n  is offline or missing.\n  */\n  if (\n    !currentCamera ||\n    currentCamera.status === \"offline\"\n  ) {\n    return {\n      cameraId: winner.camera.id,\n      activeSince: now\n    };\n  }\n\n  /*\n  The winner is already being displayed.\n  */\n  if (winner.camera.id === current.cameraId) {\n    return current;\n  }\n\n  const currentScore =\n    motionByCameraId[current.cameraId]\n      ?.smoothedScore ?? 0;\n\n  const winnerScore =\n    winner.motion?.smoothedScore ?? 0;\n\n  const displayedLongEnough =\n    now - current.activeSince >= MIN_DISPLAY_MS;\n\n  const meaningfullyBetter =\n    winnerScore >=\n    currentScore + SWITCH_THRESHOLD;\n\n  if (\n    displayedLongEnough &&\n    meaningfullyBetter\n  ) {\n    return {\n      cameraId: winner.camera.id,\n      activeSince: now\n    };\n  }\n\n  return current;\n}\n\nfunction CameraGrid({\n  grid,\n  camerasById,\n  motionByCameraId,\n  activeByCellId\n}) {\n  const style = {\n    display: \"grid\",\n\n    gridTemplateColumns: `repeat(\n      ${grid.columns},\n      minmax(0, 1fr)\n    )`,\n\n    gap: 12\n  };\n\n  return (\n    <section\n      className=\"camera-grid\"\n      style={style}\n      aria-label=\"Live camera grid\"\n    >\n      {grid.cells.map((cell) => {\n        const activeCameraId =\n          activeByCellId[cell.id]?.cameraId;\n\n        const activeCamera =\n          camerasById[activeCameraId];\n\n        const motion =\n          motionByCameraId[activeCameraId];\n\n        return (\n          <CameraCell\n            key={cell.id}\n            cell={cell}\n            camera={activeCamera}\n            motion={motion}\n          />\n        );\n      })}\n    </section>\n  );\n}\n\nconst CameraCell = memo(function CameraCell({\n  cell,\n  camera,\n  motion\n}) {\n  const [streamFailed, setStreamFailed] =\n    useState(false);\n\n  /*\n  Reset the error whenever the selected camera changes.\n  */\n  useEffect(() => {\n    setStreamFailed(false);\n  }, [camera?.id]);\n\n  return (\n    <article className=\"camera-cell\">\n      <header className=\"camera-cell__header\">\n        <div>\n          <h2>{cell.title}</h2>\n\n          <span>\n            {camera?.name ??\n              \"No camera available\"}\n          </span>\n        </div>\n\n        <span\n          className={`status status--${\n            camera?.status ?? \"offline\"\n          }`}\n        >\n          {camera?.status ?? \"offline\"}\n        </span>\n      </header>\n\n      <div className=\"camera-cell__viewport\">\n        {camera && !streamFailed ? (\n          <video\n            key={camera.id}\n            src={camera.streamUrl}\n            autoPlay\n            muted\n            playsInline\n            onError={() =>\n              setStreamFailed(true)\n            }\n          />\n        ) : camera?.thumbnailUrl ? (\n          <img\n            src={camera.thumbnailUrl}\n            alt={`${camera.name} fallback`}\n          />\n        ) : (\n          <div className=\"camera-cell__empty\">\n            Camera unavailable\n          </div>\n        )}\n      </div>\n\n      <footer className=\"camera-cell__metadata\">\n        <span>\n          Motion:{\" \"}\n          {motion\n            ? motion.smoothedScore.toFixed(2)\n            : \"—\"}\n        </span>\n\n        <span>\n          {cell.cameraIds.length} cameras\n        </span>\n      </footer>\n    </article>\n  );\n});\n\n/*\nExample API data:\n\nconst data = {\n  grid: {\n    id: \"grid-1\",\n    name: \"Main Security Wall\",\n    rows: 2,\n    columns: 2,\n    cells: [\n      {\n        id: \"cell-1\",\n        title: \"North Entrance\",\n        cameraIds: [\n          \"camera-1\",\n          \"camera-2\"\n        ]\n      },\n      ...\n    ]\n  },\n\n  camerasById: {\n    \"camera-1\": {\n      id: \"camera-1\",\n      name: \"North Door\",\n      status: \"online\",\n      streamUrl: \"/streams/camera-1\",\n      thumbnailUrl: \"/thumbnails/camera-1\"\n    },\n    ....\n  }\n};\n*/",
