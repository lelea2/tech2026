      "updated": 1784839480443,
      "link": null,
      "locked": false,
      "text": "Requirements\n\n• Dynamic rows × columns\n• Camera list per cell\n• Motion updates every second\n• Stable automatic rotation\n• Manual pin / pause\n• Offline and stale states",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
