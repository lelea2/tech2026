      "text": "*** Reconnection and missed message recovery ***\n",
      "fontSize": 32.797948526807545,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Reconnection and missed message recovery ***\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NYjzDw7XOLQswGhmDI2UK",
      "type": "text",
      "x": 1044.855461642354,
      "y": 2566.0360700616325,
      "width": 493.3996887207031,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1R",
      "roundness": null,
      "seed": 658229764,
      "version": 61,
      "versionNonce": 1845873028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783899363510,
      "link": null,
      "locked": false,
      "text": "-- Maintain sync cursor\n-- On reconnect:\n1. Re-authenticate.\n2. Send the last known cursor.\n3. Ask the server for all events after that cursor.\n4. Apply events transactionally.\n5. Persist the new cursor.\n6. Resume the live stream.\n7. Restart the outbox scheduler.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Maintain sync cursor\n-- On reconnect:\n1. Re-authenticate.\n2. Send the last known cursor.\n3. Ask the server for all events after that cursor.\n4. Apply events transactionally.\n5. Persist the new cursor.\n6. Resume the live stream.\n7. Restart the outbox scheduler.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "agOMYAF8dcZqA39J-dwaz",
