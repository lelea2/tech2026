    },
    {
      "id": "J7Y4XF-JvOMFBs_eIWtAJ",
      "type": "text",
      "x": 284.75390625,
      "y": 191.62109375,
      "width": 615.8595581054688,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 1379206404,
      "version": 843,
      "versionNonce": 1391200956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783889195036,
      "link": null,
      "locked": false,
      "text": "1. Send and receive text messages\n2. Display conversational history\n3. SHow message in real time\n4. support offline browsing\n-- queue message while offline and send them when connectivity\nreturn \n5. pagination for older history\n6. handle delivery state: sending/sent/delivered/read/failed\n7. Support multiple tabs and multiple devices\n-----------------------------------\n* group chats/voice/video calles\n* message encryption protocol design\n* thread/channels\n* large attachment\n* full-text server side search",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Send and receive text messages\n2. Display conversational history\n3. SHow message in real time\n4. support offline browsing\n-- queue message while offline and send them when connectivity\nreturn \n5. pagination for older history\n6. handle delivery state: sending/sent/delivered/read/failed\n7. Support multiple tabs and multiple devices\n-----------------------------------\n* group chats/voice/video calles\n* message encryption protocol design\n* thread/channels\n* large attachment\n* full-text server side search",
      "autoResize": true,
      "lineHeight": 1.25
    },
