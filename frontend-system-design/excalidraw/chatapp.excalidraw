      "seed": 442621140,
      "version": 107,
      "versionNonce": 507179628,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783914498832,
      "link": null,
      "locked": false,
      "text": "*** Accessibility ***",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Accessibility ***",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cFhGT_bxSVncNutd7rHT8",
      "type": "text",
      "x": 254.3632901134937,
      "y": 4367.155962120181,
      "width": 721.5595703125,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2O",
      "roundness": null,
      "seed": 2027906644,
      "version": 48,
      "versionNonce": 949715052,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783914500266,
      "link": null,
      "locked": false,
      "text": "Mention concrete behaviors:\n\n* Composer has an accessible label.\n* Enter sends; Shift+Enter creates a newline.\n* Messages use semantic list structure.\n* Delivery state is not communicated by color alone.\n* New messages should not steal focus.\n* Screen-reader announcements should be batched to avoid announcing \nevery event in a busy chat.\n* Buttons such as retry, attachment, emoji, and more-options have labels.\n* Focus is restored when menus or dialogs close.\n* Respect reduced-motion preferences.\n\nA useful strategy for live regions:\n\n* Announce only messages in the active conversation.\n* Batch announcements over a short interval.\n* Avoid announcing historical messages loaded during pagination.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mention concrete behaviors:\n\n* Composer has an accessible label.\n* Enter sends; Shift+Enter creates a newline.\n* Messages use semantic list structure.\n* Delivery state is not communicated by color alone.\n* New messages should not steal focus.\n* Screen-reader announcements should be batched to avoid announcing \nevery event in a busy chat.\n* Buttons such as retry, attachment, emoji, and more-options have labels.\n* Focus is restored when menus or dialogs close.\n* Respect reduced-motion preferences.\n\nA useful strategy for live regions:\n\n* Announce only messages in the active conversation.\n* Batch announcements over a short interval.\n* Avoid announcing historical messages loaded during pagination.",
      "autoResize": true,
      "lineHeight": 1.25
    },
