    {
      "id": "_CE-MuJ9TmiQHDTRveYIR",
      "type": "text",
      "x": 141.76191483093794,
      "y": 4992.848737644914,
      "width": 717.6595458984375,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2T",
      "roundness": null,
      "seed": 1065536596,
      "version": 32,
      "versionNonce": 1484766676,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783914613811,
      "link": null,
      "locked": false,
      "text": "--- Minimize rerenders\n* Subscribe by conversation rather than to the entire message database.\n* Memoize individual message rows.\n* Keep message object references stable when unrelated records change.\n* Avoid storing rapidly changing typing indicators with durable messages.\n* Batch database writes from large recovery payloads.\n\n-- Off-main-thread work - Use Web Workers for:\n* local search indexing,\n* encryption,\n* image processing,\n* large reconciliation batches where appropriate.\n\n--- Storage management: Local storage cannot grow forever.\nPossible retention strategy:\n* Keep all pending and recent messages.\n* Retain the most recent N messages per active conversation.\n* Evict old media before old text.\n* Re-fetch evicted history from the server.\n* Use navigator.storage.estimate() where supported.\n* Request persistent storage where justified.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--- Minimize rerenders\n* Subscribe by conversation rather than to the entire message database.\n* Memoize individual message rows.\n* Keep message object references stable when unrelated records change.\n* Avoid storing rapidly changing typing indicators with durable messages.\n* Batch database writes from large recovery payloads.\n\n-- Off-main-thread work - Use Web Workers for:\n* local search indexing,\n* encryption,\n* image processing,\n* large reconciliation batches where appropriate.\n\n--- Storage management: Local storage cannot grow forever.\nPossible retention strategy:\n* Keep all pending and recent messages.\n* Retain the most recent N messages per active conversation.\n* Evict old media before old text.\n* Re-fetch evicted history from the server.\n* Use navigator.storage.estimate() where supported.\n* Request persistent storage where justified.",
      "autoResize": true,
      "lineHeight": 1.25
    },
