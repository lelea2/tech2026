      "seed": 1604827244,
      "version": 41,
      "versionNonce": 304037996,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783904252367,
      "link": null,
      "locked": false,
      "text": "*** Core Entities ***\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Core Entities ***\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2uMiWAbieoqH1I792pwLA",
      "type": "text",
      "x": 311.2641923157604,
      "y": 2509.3438296587947,
      "width": 636.1594848632812,
      "height": 575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2A",
      "roundness": null,
      "seed": 409109868,
      "version": 385,
      "versionNonce": 862242156,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783904600210,
      "link": null,
      "locked": false,
      "text": "--- The conversation list needs:\n* last message preview,\n* last activity timestamp,\n* unread count,\n* participant information,\n* typing/presence state.\n\n\n--- Read Receipt ==> avoid sending 1 request for every message, \ninstead track read cursor per conversation, \ninterface ReadState {\n  conversationId: string;\n  lastReadSequence: number;\n\nWhen message becomes visible:\nlastReadSequence = max(previous value, highest visible sequence)\n\n-- Debounce updates and send only the latest cursor.\n{\n  \"type\": \"conversation.read\",\n  \"conversationId\": \"c123\",\n  \"throughSequence\": 845\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--- The conversation list needs:\n* last message preview,\n* last activity timestamp,\n* unread count,\n* participant information,\n* typing/presence state.\n\n\n--- Read Receipt ==> avoid sending 1 request for every message, \ninstead track read cursor per conversation, \ninterface ReadState {\n  conversationId: string;\n  lastReadSequence: number;\n\nWhen message becomes visible:\nlastReadSequence = max(previous value, highest visible sequence)\n\n-- Debounce updates and send only the latest cursor.\n{\n  \"type\": \"conversation.read\",\n  \"conversationId\": \"c123\",\n  \"throughSequence\": 845\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mG4VBEMyuZYP5kLJ6esID",
      "type": "text",
      "x": 998.8557256992053,
      "y": 4986.299096625979,
      "width": 511.69428103839664,
      "height": 42.652592574049805,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
