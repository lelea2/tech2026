    {
      "id": "nQ-a7EAE8hXw3AO-afvJI",
      "type": "text",
      "x": 1482.11328125,
      "y": 355.74609375,
      "width": 389.1514152771081,
      "height": 58.50390624999996,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 797002172,
      "version": 574,
      "versionNonce": 351668356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783890562132,
      "link": null,
      "locked": false,
      "text": "*** The UI reads from a persistent local\ndatabase, not directly from HTTP or WebSocket\nresponses. *** ",
      "fontSize": 15.60104166666666,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** The UI reads from a persistent local database, not directly from HTTP or WebSocket responses. *** ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "4FkqsHH5d3WvSA5RACviV",
      "type": "text",
      "x": 1478.57421875,
      "y": 427.6171875,
      "width": 487.9025719483708,
      "height": 89.40104166666686,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 1327315644,
      "version": 931,
      "versionNonce": 1687027588,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783890564564,
      "link": null,
      "locked": false,
      "text": "- avoid different state model for online vs. offline\nbehavior --> avoid inconsistent data across tab\n- avoid separate websocket & REST state\n",
      "fontSize": 17.88020833333337,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- avoid different state model for online vs. offline behavior --> avoid inconsistent data across tab\n- avoid separate websocket & REST state\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
