    {
      "id": "yDp6YUL5epB1xUChTvG1J",
      "type": "text",
      "x": 1703.875,
      "y": 658.5,
      "width": 488.41961669921875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0i",
      "roundness": null,
      "seed": 1018797372,
      "version": 332,
      "versionNonce": 1813990788,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783892047980,
      "link": null,
      "locked": false,
      "text": "Why not localStorage???\n-- synchronous and block the main thread\n-- small capacity & no useful query model\n-- no transactions across records\n-- poor fit for thousand message\n-- storage one large serialize JSOn object created\nexpensive read-modify-write operations\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why not localStorage???\n-- synchronous and block the main thread\n-- small capacity & no useful query model\n-- no transactions across records\n-- poor fit for thousand message\n-- storage one large serialize JSOn object created\nexpensive read-modify-write operations\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
