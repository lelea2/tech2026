      "seed": 93602948,
      "version": 58,
      "versionNonce": 1890294844,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783898868157,
      "link": null,
      "locked": false,
      "text": "interface ChatTransport {\n  connect(): Promise<void>;\n  disconnect(): void;\n  sendMessage(command: SendMessageCommand): Promise<MessageAck>;\n\n  subscribe(\n    handler: (event: ServerEvent) => void\n  ): () => void;\n  recoverEvents(afterCursor: string): Promise<RecoveryResponse>;\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface ChatTransport {\n  connect(): Promise<void>;\n  disconnect(): void;\n  sendMessage(command: SendMessageCommand): Promise<MessageAck>;\n\n  subscribe(\n    handler: (event: ServerEvent) => void\n  ): () => void;\n  recoverEvents(afterCursor: string): Promise<RecoveryResponse>;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
