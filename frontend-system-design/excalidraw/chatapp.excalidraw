    {
      "id": "S536zYCoMEXmvb9fj7Bfo",
      "type": "text",
      "x": 293.07571628166755,
      "y": 2445.5184559828363,
      "width": 291.619873046875,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
