    },
    {
      "id": "ZSlOSIWIucGsdSR0CYR1K",
      "type": "text",
      "x": 1507.6679896051203,
      "y": 5503.855184949264,
      "width": 493.93975830078125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 249546324,
      "version": 77,
      "versionNonce": 1207681876,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783913757620,
      "link": null,
      "locked": false,
      "text": "const distanceFromBottom =\n  scrollHeight - scrollTop - clientHeight;\n\nconst isNearBottom = distanceFromBottom < 100;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const distanceFromBottom =\n  scrollHeight - scrollTop - clientHeight;\n\nconst isNearBottom = distanceFromBottom < 100;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ir4bAf5pwL7uE_PLy0SLM",
      "type": "text",
      "x": 269.56653328253276,
      "y": 3719.315996048666,
      "width": 607.0995483398438,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2J",
      "roundness": null,
      "seed": 811866604,
      "version": 164,
      "versionNonce": 356819308,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783913961086,
      "link": null,
      "locked": false,
      "text": "* Authenticate WebSocket connections.\n* Refresh expired credentials without losing queued messages.\n* Never trust client-generated sender IDs.\n* Escape or sanitize message rendering.\n* Render messages as text by default, not arbitrary HTML.\n* Apply Content Security Policy.\n* Validate attachment MIME type and size.\n* Avoid storing sensitive tokens in localStorage \nwhen safer cookie-based authentication is available.\n* Clear or partition local data on logout/account switching.\n* Avoid showing cached private content after \nanother account signs in.\n* Encryption: “End-to-end encryption would materially \nchange key management, multi-device history sync,\n search, and notification previews. \nI would treat it as a separate major design area rather \nthan adding ad hoc client-side encryption.”",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Authenticate WebSocket connections.\n* Refresh expired credentials without losing queued messages.\n* Never trust client-generated sender IDs.\n* Escape or sanitize message rendering.\n* Render messages as text by default, not arbitrary HTML.\n* Apply Content Security Policy.\n* Validate attachment MIME type and size.\n* Avoid storing sensitive tokens in localStorage \nwhen safer cookie-based authentication is available.\n* Clear or partition local data on logout/account switching.\n* Avoid showing cached private content after \nanother account signs in.\n* Encryption: “End-to-end encryption would materially \nchange key management, multi-device history sync,\n search, and notification previews. \nI would treat it as a separate major design area rather \nthan adding ad hoc client-side encryption.”",
      "autoResize": true,
      "lineHeight": 1.25
    },
