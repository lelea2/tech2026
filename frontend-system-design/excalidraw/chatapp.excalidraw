    {
      "id": "INVidRdsgMOn9Q38Jq-lm",
      "type": "text",
      "x": 303,
      "y": 613.5,
      "width": 540.9999389648438,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
