      "text": "*** IndexDB instead of LocalStorage for persistent message storage ***",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** IndexDB instead of LocalStorage for persistent message storage ***",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MHn3bgO2gKZ2Q-9PHk_J5",
      "type": "text",
      "x": 920,
      "y": 669.5,
      "width": 565.0995483398438,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 1595117116,
      "version": 458,
      "versionNonce": 1757705276,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783891729411,
      "link": null,
      "locked": false,
      "text": "IndexDB provides advantage\n-- store more data, support structured records & indexes\n-- support transactions, work asynchronously\n-- accessible across tabs in same browser profile\n-- suitable for pagination and range queries\n-- can store blobs if image support is added ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IndexDB provides advantage\n-- store more data, support structured records & indexes\n-- support transactions, work asynchronously\n-- accessible across tabs in same browser profile\n-- suitable for pagination and range queries\n-- can store blobs if image support is added ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ginIZ-lj3wuaYiDDZDgE6",
      "type": "text",
      "x": 1513,
      "y": 667.5,
