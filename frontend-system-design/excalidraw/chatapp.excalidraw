      "boundElements": null,
      "updated": 1783914803757,
      "link": null,
      "locked": false,
      "text": "*** How to handle retry ***",
      "fontSize": 31.769360859382147,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** How to handle retry ***",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hwWD-IDMaPm-DaqVs-kNb",
      "type": "text",
      "x": 1014.5935334331884,
      "y": 4791.913435417427,
      "width": 844.1394653320312,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b25",
      "roundness": null,
      "seed": 790738924,
      "version": 36,
      "versionNonce": 2086935380,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783914823377,
      "link": null,
      "locked": false,
      "text": "Avoid relying only on navigator.onLine\nIt can indicate network interface availability, but not whether the server is reachable.\nUse:\n* WebSocket state,\n* heartbeat responses,\n* request success/failure,\n* browser online/offline events as hints.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Avoid relying only on navigator.onLine\nIt can indicate network interface availability, but not whether the server is reachable.\nUse:\n* WebSocket state,\n* heartbeat responses,\n* request success/failure,\n* browser online/offline events as hints.",
      "autoResize": true,
      "lineHeight": 1.25
    },
