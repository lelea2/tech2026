      "isDeleted": false,
      "boundElements": null,
      "updated": 1783914798128,
      "link": null,
      "locked": false,
      "text": "*** How to sync between different device",
      "fontSize": 30.82479866338033,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** How to sync between different device",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bam5VlwADB8ZL4091i5X8",
      "type": "text",
      "x": 2004.6209154214105,
      "y": 4307.706397982177,
      "width": 496.0195617675781,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1y",
      "roundness": null,
      "seed": 167035476,
      "version": 179,
      "versionNonce": 1362278508,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783903843596,
      "link": null,
      "locked": false,
      "text": "Laptop sends message\n   ↓\nServer persists message and assigns sequence 250\n   ↓\nServer acknowledges laptop\n   ↓\nServer publishes message event to:\n   - laptop’s other tabs\n   - phone\n   - tablet\n   - recipient’s active devices",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Laptop sends message\n   ↓\nServer persists message and assigns sequence 250\n   ↓\nServer acknowledges laptop\n   ↓\nServer publishes message event to:\n   - laptop’s other tabs\n   - phone\n   - tablet\n   - recipient’s active devices",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UyafSPHjUmN46RgGlvStG",
      "type": "rectangle",
      "x": 1951.6318924349246,
      "y": 4274.734278761749,
      "width": 653.0988041052317,
      "height": 333.7573919652741,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1z",
      "roundness": {
        "type": 3
      },
      "seed": 586821228,
      "version": 147,
      "versionNonce": 1478864724,
      "isDeleted": false,
