    {
      "id": "Eh0UGEKUHRfrxyf8to4Rg",
      "type": "text",
      "x": 2123.594862899111,
      "y": 2543.7409790976612,
      "width": 364.0997314453125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
