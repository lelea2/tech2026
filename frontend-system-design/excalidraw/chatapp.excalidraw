      "version": 249,
      "versionNonce": 2142076292,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783892165298,
      "link": null,
      "locked": false,
      "text": "type MessageStatus =\n  | \"queued\"\n  | \"sending\"\n  | \"sent\"\n  | \"delivered\"\n  | \"read\"\n  | \"failed\";\n\ninterface Message {\n  localId: string;\n  serverId?: string;\n\n  conversationId: string;\n  senderId: string;\n\n  text: string;\n  createdAtClient: number;\n  createdAtServer?: number;\n\n  sequence?: number;\n  status: MessageStatus;\n\n  replyToMessageId?: string;\n  updatedAt?: number;\n  deletedAt?: number;\n}\n\ninterface Conversation {\n  id: string;\n  participantIds: string[];\n\n  lastMessageId?: string;\n  lastMessagePreview?: string;\n  lastActivityAt: number;\n\n  lastReadSequence: number;\n  unreadCount: number;\n}\n\ninterface OutboxItem {\n  operationId: string;\n  messageLocalId: string;\n  conversationId: string;\n\n  attemptCount: number;\n  nextAttemptAt: number;\n  leaseOwner?: string;\n  leaseExpiresAt?: number;\n}\n\ninterface ConversationSyncState {\n  conversationId: string;\n  latestSequence: number;\n  historyCursor?: string;\n  fullyLoadedBefore?: boolean;\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type MessageStatus =\n  | \"queued\"\n  | \"sending\"\n  | \"sent\"\n  | \"delivered\"\n  | \"read\"\n  | \"failed\";\n\ninterface Message {\n  localId: string;\n  serverId?: string;\n\n  conversationId: string;\n  senderId: string;\n\n  text: string;\n  createdAtClient: number;\n  createdAtServer?: number;\n\n  sequence?: number;\n  status: MessageStatus;\n\n  replyToMessageId?: string;\n  updatedAt?: number;\n  deletedAt?: number;\n}\n\ninterface Conversation {\n  id: string;\n  participantIds: string[];\n\n  lastMessageId?: string;\n  lastMessagePreview?: string;\n  lastActivityAt: number;\n\n  lastReadSequence: number;\n  unreadCount: number;\n}\n\ninterface OutboxItem {\n  operationId: string;\n  messageLocalId: string;\n  conversationId: string;\n\n  attemptCount: number;\n  nextAttemptAt: number;\n  leaseOwner?: string;\n  leaseExpiresAt?: number;\n}\n\ninterface ConversationSyncState {\n  conversationId: string;\n  latestSequence: number;\n  historyCursor?: string;\n  fullyLoadedBefore?: boolean;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "98anu9IZj3jZP4R2lkilF",
      "type": "text",
      "x": 630.1594614494954,
      "y": 958.6001500492121,
      "width": 361.459716796875,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 1442660412,
      "version": 62,
      "versionNonce": 413979012,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783892386144,
      "link": null,
      "locked": false,
      "text": "*** Importance indexes:\nmessages:\n- localId\n- serverId\n- [conversationId + sequence]\n- [conversationId + createdAtClient]\n\nconversations:\n- lastActivityAt\n\noutbox:\n- nextAttemptAt\n- messageLocalId",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Importance indexes:\nmessages:\n- localId\n- serverId\n- [conversationId + sequence]\n- [conversationId + createdAtClient]\n\nconversations:\n- lastActivityAt\n\noutbox:\n- nextAttemptAt\n- messageLocalId",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MQCyVGU6gwdyWkPNXt3qZ",
      "type": "text",
      "x": 1087.5310921513533,
      "y": 853.5929975156116,
      "width": 295.1598205566406,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 468017724,
      "version": 87,
      "versionNonce": 1389923900,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783892644107,
      "link": null,
      "locked": false,
      "text": "*** Message sending flow *** ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Message sending flow *** ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sm6B8BA66vFFFhXrjTefA",
      "type": "text",
      "x": 1061.6600099367427,
      "y": 891.0079292010648,
      "width": 573.7396240234375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 1171122108,
      "version": 68,
      "versionNonce": 1853360828,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783892700437,
      "link": null,
      "locked": false,
      "text": "-- Step1: user sends (localId, operationId, local timestamp)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Step1: user sends (localId, operationId, local timestamp)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mlRp8rr7maHJT-1qHZV_h",
      "type": "text",
      "x": 1081.4079937040167,
      "y": 924.0355733834522,
      "width": 463.69184490473117,
      "height": 333.1531730859873,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 1261641220,
      "version": 181,
      "versionNonce": 886845500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783894856251,
      "link": null,
      "locked": false,
      "text": "await db.transaction(\"rw\", db.messages, db.outbox, async () => {\n  await db.messages.add({\n    localId,\n    conversationId,\n    senderId: currentUserId,\n    text,\n    createdAtClient: Date.now(),\n    status: \"queued\",\n  });\n\n  await db.outbox.add({\n    operationId,\n    messageLocalId: localId,\n    conversationId,\n    attemptCount: 0,\n    nextAttemptAt: Date.now(),\n  });\n});",
      "fontSize": 14.806807692710544,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "await db.transaction(\"rw\", db.messages, db.outbox, async () => {\n  await db.messages.add({\n    localId,\n    conversationId,\n    senderId: currentUserId,\n    text,\n    createdAtClient: Date.now(),\n    status: \"queued\",\n  });\n\n  await db.outbox.add({\n    operationId,\n    messageLocalId: localId,\n    conversationId,\n    attemptCount: 0,\n    nextAttemptAt: Date.now(),\n  });\n});",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y5d6fd4bOcqx3c-RkzCLy",
      "type": "text",
      "x": 1062.601615662349,
      "y": 1265.7414995259435,
      "width": 709.6195678710938,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 1423153980,
      "version": 322,
      "versionNonce": 2064741180,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783894829335,
      "link": null,
      "locked": false,
      "text": "-- Step2: scheduler sends\n1. find eligible outbox operation, take a lease\n2. marks message as sending, sned the operation through active support\n3. wait for server ack.\n-- Step3: acknowledgement\nServer returns:\ninterface MessageAck {\n  operationId: string;\n  serverId: string;\n  conversationId: string;\n  sequence: number;\n  createdAtServer: number;\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Step2: scheduler sends\n1. find eligible outbox operation, take a lease\n2. marks message as sending, sned the operation through active support\n3. wait for server ack.\n-- Step3: acknowledgement\nServer returns:\ninterface MessageAck {\n  operationId: string;\n  serverId: string;\n  conversationId: string;\n  sequence: number;\n  createdAtServer: number;\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Wkw0LQqo6J83cQLJlJm_5",
      "type": "text",
      "x": 267.8966293927169,
      "y": -90.09660391337906,
      "width": 641.3395385742188,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0s",
      "roundness": null,
      "seed": 927943812,
      "version": 4,
      "versionNonce": 987687684,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783892850839,
      "link": null,
      "locked": false,
      "text": "Five points the interviewer should remember\n\n1. Persistent local database as the client-side source of truth.\n2. Optimistic writes backed by a durable transactional outbox.\n3. WebSocket for live delivery, HTTP for bootstrap and recovery.\n4. Idempotency, acknowledgments, cursors, and sequence numbers \nfor correctness.\n5. Explicit multi-tab and multi-device synchronization strategies.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Five points the interviewer should remember\n\n1. Persistent local database as the client-side source of truth.\n2. Optimistic writes backed by a durable transactional outbox.\n3. WebSocket for live delivery, HTTP for bootstrap and recovery.\n4. Idempotency, acknowledgments, cursors, and sequence numbers \nfor correctness.\n5. Explicit multi-tab and multi-device synchronization strategies.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XwiXNA3qtoOdEbWfWLCyv",
      "type": "rectangle",
      "x": 259.6353109549905,
      "y": -107.67237149772859,
      "width": 659.7760474590367,
      "height": 231.94719605522346,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": {
        "type": 3
      },
      "seed": 1777156740,
      "version": 111,
      "versionNonce": 748976956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783892859489,
      "link": null,
      "locked": false
    },
    {
      "id": "Zbd9leHbrWQNJRQTDz2S6",
      "type": "text",
      "x": 1451.9982962360887,
      "y": 1402.4393420124957,
      "width": 434.81964111328125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 952133892,
      "version": 224,
      "versionNonce": 2069510460,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783894851115,
      "link": null,
      "locked": false,
      "text": "Client reconciles optimistic record:\n-- localId remains stable for React rendering\n-- serverId is added\n-- sequence is added\n-- server timestamp is added\n-- status becomes sent\n-- outbox item is removed",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client reconciles optimistic record:\n-- localId remains stable for React rendering\n-- serverId is added\n-- sequence is added\n-- server timestamp is added\n-- status becomes sent\n-- outbox item is removed",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "W-ECMyUsy3T9EWi7LqJLm",
      "type": "text",
      "x": 1043.0063621327054,
      "y": 1623.3486861012366,
      "width": 1245.279052734375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0w",
      "roundness": null,
      "seed": 742047748,
      "version": 185,
      "versionNonce": 1697190020,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783895511066,
      "link": null,
      "locked": false,
      "text": "*** Handle duplication:  at-least-once transmission with idempotent processing to produce effectively-once user-visible behavior.\n{\n  \"operationId\": \"operation-uuid\",\n  \"clientMessageId\": \"local-message-uuid\"\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Handle duplication:  at-least-once transmission with idempotent processing to produce effectively-once user-visible behavior.\n{\n  \"operationId\": \"operation-uuid\",\n  \"clientMessageId\": \"local-message-uuid\"\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yV84plhfKxsOLrWLylcJI",
      "type": "text",
      "x": 1476.3328893925523,
      "y": 1667.702352723133,
      "width": 1035.079345703125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0x",
      "roundness": null,
      "seed": 1727239228,
      "version": 89,
      "versionNonce": 278736900,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783895541813,
      "link": null,
      "locked": false,
      "text": "The server stores the operation ID and returns the previous result if it receives the same request again.\nThe client also deduplicates received messages by:\n1. serverId, when available.\n2. operationId, for the sender’s optimistic copy.\n3. Potentially (conversationId, sequence) as another uniqueness constraint.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The server stores the operation ID and returns the previous result if it receives the same request again.\nThe client also deduplicates received messages by:\n1. serverId, when available.\n2. operationId, for the sender’s optimistic copy.\n3. Potentially (conversationId, sequence) as another uniqueness constraint.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r4HJuAxoKfBmOEIe85JF_",
      "type": "text",
      "x": 1057.938368882487,
      "y": 1819.3389295319332,
      "width": 763.0660569014256,
      "height": 83.544996393279,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0y",
      "roundness": null,
      "seed": 1661115324,
      "version": 131,
      "versionNonce": 1912426604,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783914771381,
      "link": null,
      "locked": false,
      "text": "*** Websocket vs. SSE *** (prefer Websocket)\n",
      "fontSize": 33.417998557311606,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Websocket vs. SSE *** (prefer Websocket)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Rmzqoixeiaq6hlhVbZTpb",
      "type": "text",
      "x": 1055.3716891139231,
      "y": 1879.9755137829795,
      "width": 689.8394165039062,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0z",
      "roundness": null,
      "seed": 2093995652,
      "version": 422,
      "versionNonce": 600154372,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783897766856,
      "link": null,
      "locked": false,
      "text": "Why Websocket\n1. Bidirectional\n2. Low overhead for frequent small events\n3. Support client-to-server and server-to-client messaging\n4. Fit messages, typing indicators, read receipts, presence, delivery ack\n5. avoid using one protocol for sending and another for receiving. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Websocket\n1. Bidirectional\n2. Low overhead for frequent small events\n3. Support client-to-server and server-to-client messaging\n4. Fit messages, typing indicators, read receipts, presence, delivery ack\n5. avoid using one protocol for sending and another for receiving. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b0ZlbV0lTYFy_u3MmPdIi",
      "type": "text",
      "x": 1862.8745210936765,
      "y": 1870.6554753788503,
      "width": 843.4192504882812,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b10",
      "roundness": null,
      "seed": 181518908,
      "version": 285,
      "versionNonce": 1395100804,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783898105263,
      "link": null,
      "locked": false,
      "text": "Why not SSE (SSE is undirectional, it's server to client)\nStill need HTTP for: sending messages, typing events, read receipts, presence updates\n--> SSE can work, but create split transport model. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why not SSE (SSE is undirectional, it's server to client)\nStill need HTTP for: sending messages, typing events, read receipts, presence updates\n--> SSE can work, but create split transport model. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sPFOEz-oIcwt-9N1NOpEM",
      "type": "text",
      "x": 1065.8772690071555,
      "y": 2042.8248318579392,
      "width": 591.9395751953125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b12",
      "roundness": null,
      "seed": 1788816132,
      "version": 185,
      "versionNonce": 1047724092,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783898781330,
      "link": null,
      "locked": false,
      "text": "Websocket alone does not guarantee reliability, we still need:\n* acknowledgments,\n* sequence numbers,\n* reconnect handling,\n* missed-event recovery,\n* idempotency,\n* retry logic,\n* heartbeat and liveness detection.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Websocket alone does not guarantee reliability, we still need:\n* acknowledgments,\n* sequence numbers,\n* reconnect handling,\n* missed-event recovery,\n* idempotency,\n* retry logic,\n* heartbeat and liveness detection.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "K0ICUjHbrveb9u_HGRoid",
      "type": "text",
      "x": 1846.9533656139686,
      "y": 2020.9869632307193,
      "width": 488.099609375,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 878500356,
      "version": 88,
      "versionNonce": 1440522044,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783898780626,
      "link": null,
      "locked": false,
      "text": "WebSocket\n* New message events.\n* Send commands when connected.\n* Message acknowledgments.\n* Delivered/read receipts.\n* Typing indicators.\n* Presence updates.\n* Conversation update events.\nHTTP\n* Initial application bootstrap.\n* Fetch conversation list.\n* Fetch paginated message history.\n* Recover messages after a connection gap.\n* Refresh authentication.\n* Upload images using pre-signed URLs.\n* Fallback sending if the WebSocket is unavailable.\n* Large payload operations.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WebSocket\n* New message events.\n* Send commands when connected.\n* Message acknowledgments.\n* Delivered/read receipts.\n* Typing indicators.\n* Presence updates.\n* Conversation update events.\nHTTP\n* Initial application bootstrap.\n* Fetch conversation list.\n* Fetch paginated message history.\n* Recover messages after a connection gap.\n* Refresh authentication.\n* Upload images using pre-signed URLs.\n* Fallback sending if the WebSocket is unavailable.\n* Large payload operations.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y2OKsBSwnDfJOtyMSpOPq",
