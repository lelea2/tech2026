      "updated": 1783903846284,
      "link": null,
      "locked": false
    },
    {
      "id": "UfJEVc9nEoii9mKwqoHdL",
      "type": "text",
      "x": 1008.9435126482701,
      "y": 4296.99738439766,
      "width": 452.9596862792969,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b20",
      "roundness": null,
      "seed": 1037602900,
      "version": 99,
      "versionNonce": 139914196,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783903817454,
      "link": null,
      "locked": false,
      "text": "==> Server initiate. If 2 devices send message\nat the same time, server order will win\nEvery device maintains:\n* its own local database,\n* its own outbox,\n* its own sync cursor,\n* its own connection lifecycle.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "==> Server initiate. If 2 devices send message\nat the same time, server order will win\nEvery device maintains:\n* its own local database,\n* its own outbox,\n* its own sync cursor,\n* its own connection lifecycle.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KbVf-KV6eNwmrsHwHrbW0",
      "type": "text",
      "x": 1014.7854168536724,
      "y": 4512.701631098184,
      "width": 1035.19921875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b21",
      "roundness": null,
      "seed": 1246920812,
      "version": 96,
      "versionNonce": 116884204,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783903841771,
      "link": null,
      "locked": false,
      "text": "Device was offline for several days ==> On reconnection:\n* recover events after the cursor,\n* or perform incremental history sync,\n* update delivery/read state,\n* drain that device’s outbox.\n\nDuplicate optimistic message on another device\nThe originating device may know clientMessageId; another device may only receive the canonical serverId. \nThis is fine because each device performs its own local reconciliation.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Device was offline for several days ==> On reconnection:\n* recover events after the cursor,\n* or perform incremental history sync,\n* update delivery/read state,\n* drain that device’s outbox.\n\nDuplicate optimistic message on another device\nThe originating device may know clientMessageId; another device may only receive the canonical serverId. \nThis is fine because each device performs its own local reconciliation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1iC_Dbw1W3LGzwHuHLsRn",
