    },
    {
      "id": "OHZjkakWhsThDvndLAuSL",
      "type": "text",
      "x": 272.03036983778827,
      "y": 4321.970540504704,
      "width": 197.0398712158203,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
