      "seed": 1501189204,
      "version": 246,
      "versionNonce": 1004447316,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783914821436,
      "link": null,
      "locked": false,
      "text": "*** Handle User experience ***",
      "fontSize": 34.12207405923985,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Handle User experience ***",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7Eb6OIExh4rsqTdWGrO5i",
      "type": "text",
      "x": 998.192946283666,
      "y": 5047.280927003284,
      "width": 706.6995239257812,
      "height": 850,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2D",
      "roundness": null,
      "seed": 812820052,
      "version": 416,
      "versionNonce": 313572180,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783914819540,
      "link": null,
      "locked": false,
      "text": "*** Treat typing and presence as ephemeral, not durable message state.\n---- Typing\n* Send after the user starts typing.\n* Throttle repeated events.\n* Expire automatically after a few seconds.\n* Send a stop event when the composer empties or the message is sent.\nDo not persist typing events to IndexedDB.\n\n---- Presence: Presence is approximate. A user may have:\n* multiple tabs,\n* multiple devices,\n* backgrounded browsers,\n* unstable mobile connectivity.\n\n---- The UI should use states such as:\n* online,\n* recently active,\n* offline,\n* unknown\n\n---- Handling Scrolling\n* VirtualDOM \n* Auto scroll -- do not always scrollBottom\n* If the current user sends a message, \nusually scroll to it.\n* If a remote message arrives and \nthe user is near the bottom, auto-scroll.\n* If the user has scrolled upward, \npreserve position and show a “new messages” indicator.\n\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Treat typing and presence as ephemeral, not durable message state.\n---- Typing\n* Send after the user starts typing.\n* Throttle repeated events.\n* Expire automatically after a few seconds.\n* Send a stop event when the composer empties or the message is sent.\nDo not persist typing events to IndexedDB.\n\n---- Presence: Presence is approximate. A user may have:\n* multiple tabs,\n* multiple devices,\n* backgrounded browsers,\n* unstable mobile connectivity.\n\n---- The UI should use states such as:\n* online,\n* recently active,\n* offline,\n* unknown\n\n---- Handling Scrolling\n* VirtualDOM \n* Auto scroll -- do not always scrollBottom\n* If the current user sends a message, \nusually scroll to it.\n* If a remote message arrives and \nthe user is near the bottom, auto-scroll.\n* If the user has scrolled upward, \npreserve position and show a “new messages” indicator.\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wT7YHJVacrCGiTBGszDph",
      "type": "text",
      "x": 320.2259762928918,
      "y": 3116.34011562496,
      "width": 632.0595703125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2F",
      "roundness": null,
      "seed": 1969148500,
      "version": 31,
      "versionNonce": 1443841876,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783904609366,
      "link": null,
      "locked": false,
      "text": "---- Message history\nGET /conversations/:id/messages?beforeSequence=800&limit=50\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "---- Message history\nGET /conversations/:id/messages?beforeSequence=800&limit=50\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FZJCYr6MXFPtNHTSFi5Sf",
      "type": "text",
      "x": 305.79694045549553,
      "y": 3191.371101979418,
      "width": 440.5196533203125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 630463980,
      "version": 4,
      "versionNonce": 1946506604,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783904640053,
      "link": null,
      "locked": false,
      "text": "The client:\n1. Reads cached messages from IndexedDB.\n2. Displays them immediately.\n3. Fetches missing history in the background.\n4. Inserts historical messages.\n5. Preserves the user’s scroll position.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The client:\n1. Reads cached messages from IndexedDB.\n2. Displays them immediately.\n3. Fetches missing history in the background.\n4. Inserts historical messages.\n5. Preserves the user’s scroll position.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0UShpcLDDiiLUzRI8g-Lj",
      "type": "rectangle",
      "x": 1480.0611858818518,
      "y": 5488.3651099615645,
      "width": 551.1215328830513,
      "height": 134.33094184088532,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": {
        "type": 3
      },
      "seed": 74875628,
      "version": 187,
      "versionNonce": 2000729172,
      "isDeleted": false,
