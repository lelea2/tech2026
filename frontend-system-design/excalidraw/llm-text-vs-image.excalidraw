      "seed": 2005149419,
      "version": 103,
      "versionNonce": 883520261,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787027498712,
      "link": null,
      "locked": false,
      "text": "Text-generation SSE stream would look like:\n\nevent: message.delta\ndata: {\"requestId\":\"r1\",\"delta\":\"Hello\"}\n\nevent: message.delta\ndata: {\"requestId\":\"r1\",\"delta\":\" world\"}\n\nevent: tool.started\ndata: {\"tool\":\"search\"}\n\nevent: tool.completed\ndata: {\"tool\":\"search\",\"resultId\":\"x1\"}\n\nevent: message.delta\ndata: {\"requestId\":\"r1\",\"delta\":\"Here is what I found...\"}\n\nevent: message.completed\ndata: {\"requestId\":\"r1\",\"finishReason\":\"stop\"}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Text-generation SSE stream would look like:\n\nevent: message.delta\ndata: {\"requestId\":\"r1\",\"delta\":\"Hello\"}\n\nevent: message.delta\ndata: {\"requestId\":\"r1\",\"delta\":\" world\"}\n\nevent: tool.started\ndata: {\"tool\":\"search\"}\n\nevent: tool.completed\ndata: {\"tool\":\"search\",\"resultId\":\"x1\"}\n\nevent: message.delta\ndata: {\"requestId\":\"r1\",\"delta\":\"Here is what I found...\"}\n\nevent: message.completed\ndata: {\"requestId\":\"r1\",\"finishReason\":\"stop\"}",
      "autoResize": true,
      "lineHeight": 1.25
    },
