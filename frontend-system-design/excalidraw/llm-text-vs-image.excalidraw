    {
      "id": "BkaMpcqRyxvEJlUKE2WCJ",
      "type": "text",
      "x": 1546.9352183028243,
      "y": 85.81322063069118,
      "width": 407.3485507321939,
      "height": 2692.9449531308865,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
