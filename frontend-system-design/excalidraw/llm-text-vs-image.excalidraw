    {
      "id": "ftfYnOyQMbVczs99r-eV0",
      "type": "text",
      "x": 414.5822005068324,
      "y": 1331.2174093948367,
      "width": 320.1116943359375,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 1398798021,
      "version": 191,
      "versionNonce": 427506059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787028656706,
      "link": null,
      "locked": false,
      "text": "The flow would be:\n\nPOST /images\nResponse: \n{ jobId: \"image_123\", status: \"queued\"}\n\nThen \nGET /images/img_123/events\n\nSSE\n\nevent: generation.queued\ndata: {\"jobId\":\"img_123\"}\n\nevent: generation.started\ndata: {\"jobId\":\"img_123\"}\n\nevent: generation.progress\ndata: {\n  \"jobId\":\"img_123\",\n  \"stage\":\"sampling\",\n  \"progress\":0.35\n}\n\nevent: generation.preview\ndata: {\n  \"jobId\":\"img_123\",\n  \"previewUrl\":\"https://cdn/.../preview.jpg\"\n}\n\nevent: generation.completed\ndata: {\n  \"jobId\":\"img_123\",\n  \"assetId\":\"asset_456\",\n  \"url\":\"https://cdn/.../final.webp\"\n}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The flow would be:\n\nPOST /images\nResponse: \n{ jobId: \"image_123\", status: \"queued\"}\n\nThen \nGET /images/img_123/events\n\nSSE\n\nevent: generation.queued\ndata: {\"jobId\":\"img_123\"}\n\nevent: generation.started\ndata: {\"jobId\":\"img_123\"}\n\nevent: generation.progress\ndata: {\n  \"jobId\":\"img_123\",\n  \"stage\":\"sampling\",\n  \"progress\":0.35\n}\n\nevent: generation.preview\ndata: {\n  \"jobId\":\"img_123\",\n  \"previewUrl\":\"https://cdn/.../preview.jpg\"\n}\n\nevent: generation.completed\ndata: {\n  \"jobId\":\"img_123\",\n  \"assetId\":\"asset_456\",\n  \"url\":\"https://cdn/.../final.webp\"\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
