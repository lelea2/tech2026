      "boundElements": null,
      "updated": 1787029041586,
      "link": null,
      "locked": false,
      "text": "React\n  |\n  | POST /api/images\n  v\nAI Backend\n  |\n  | enqueue generation\n  v\nImage Model / GPU\n  |\n  | progress events\n  v\nSSE / EventSource\n  |\n  | completed { imageUrl }\n  v\nReact\n  |\n  | GET imageUrl\n  v\nCDN / Object Storage",
      "fontSize": 13.4205988450943,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "React\n  |\n  | POST /api/images\n  v\nAI Backend\n  |\n  | enqueue generation\n  v\nImage Model / GPU\n  |\n  | progress events\n  v\nSSE / EventSource\n  |\n  | completed { imageUrl }\n  v\nReact\n  |\n  | GET imageUrl\n  v\nCDN / Object Storage",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HaBGoGmvfpQMKlV_NEKTU",
