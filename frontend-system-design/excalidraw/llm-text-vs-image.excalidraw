      "updated": 1787028736267,
      "link": null,
      "locked": false,
      "text": "Stream state:\n\ntype ImageGeneration = {\n  jobId: string;\n\n  status:\n    | \"queued\"\n    | \"running\"\n    | \"completed\"\n    | \"failed\"\n    | \"cancelled\";\n\n  progress?: number;\n\n  previewUrl?: string;\n  finalUrl?: string;\n\n  error?: string;\n};",
      "fontSize": 16,
