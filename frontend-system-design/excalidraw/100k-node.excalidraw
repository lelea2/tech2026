      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 5,
      "text": "FUNCTIONAL\n• Load/edit 100K objects\n• Pan, zoom, select, multi-select\n• Drag, resize, rotate, reorder\n• Search + virtualized layer tree\n• Undo/redo + autosave\n• Images, text, vectors, groups\n• Optional real-time collaboration",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FUNCTIONAL\n• Load/edit 100K objects\n• Pan, zoom, select, multi-select\n• Drag, resize, rotate, reorder\n• Search + virtualized layer tree\n• Undo/redo + autosave\n• Images, text, vectors, groups\n• Optional real-time collaboration",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "req_nf",
      "type": "text",
      "x": 650,
      "y": 205,
      "width": 500,
      "height": 170,
