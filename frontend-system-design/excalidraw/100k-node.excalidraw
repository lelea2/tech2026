      "boundElements": [],
      "updated": 1785948589540,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 8,
      "text": "INCREMENTAL LOADING\n1. Application shell\n2. Document metadata\n3. Hierarchy + object bounds\n4. Low-detail scene\n5. Visible object details\n6. Nearby objects\n7. Offscreen objects lazily\n8. Hi-res assets on demand\n\nAssets:\nobject storage + CDN + size variants",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "INCREMENTAL LOADING\n1. Application shell\n2. Document metadata\n3. Hierarchy + object bounds\n4. Low-detail scene\n5. Visible object details\n6. Nearby objects\n7. Offscreen objects lazily\n8. Hi-res assets on demand\n\nAssets:\nobject storage + CDN + size variants",
      "autoResize": false,
      "lineHeight": 1.25
    },
