    {
      "id": "1DaoZszBJRtjY67JJhY1r",
      "type": "text",
      "x": 233.7698409839274,
      "y": 2699.5933830427916,
      "width": 11,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
