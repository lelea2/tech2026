      "boundElements": null,
      "updated": 1782164759965,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n-- Design feature add basic element like rectangles, images, frames\n-- enter/edit text\n-- More/resize/rotate elements\n-- Change elements' styling properties like stroke color, fill color, and stroke thickness\n-- Support single-select and multi-select, moving, resizing, rotating, deleting, copying, \nand layer ordering operations.\n-- Undo/redo recent actions\n-- Keyboard shortcut on common operator\n-- Zooming in/out of the canvas, panning the canvas view via mouse drag or scrollbars\n-----",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n-- Design feature add basic element like rectangles, images, frames\n-- enter/edit text\n-- More/resize/rotate elements\n-- Change elements' styling properties like stroke color, fill color, and stroke thickness\n-- Support single-select and multi-select, moving, resizing, rotating, deleting, copying, \nand layer ordering operations.\n-- Undo/redo recent actions\n-- Keyboard shortcut on common operator\n-- Zooming in/out of the canvas, panning the canvas view via mouse drag or scrollbars\n-----",
      "autoResize": true,
      "lineHeight": 1.25
    },
