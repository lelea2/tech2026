      "link": null,
      "locked": false,
      "text": "* Sharing file with other users: (eg: userId: [fileId1, fileId2])\n-- normalize data, create a new table map userId and fileId,\n| userId (Partition Key) | fileId (Sort Key) |\n|----------------------------|-----------------------|\n| user1                     | fileId1     |\n| user1                     | fileId2     |\n| user2                    | fileId3     |",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Sharing file with other users: (eg: userId: [fileId1, fileId2])\n-- normalize data, create a new table map userId and fileId,\n| userId (Partition Key) | fileId (Sort Key) |\n|----------------------------|-----------------------|\n| user1                     | fileId1     |\n| user1                     | fileId2     |\n| user2                    | fileId3     |",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sCgb1OYs5ga6a9VWbF40h",
      "type": "image",
      "x": 928.4893121887812,
      "y": 640.1638103109342,
      "width": 706.1192193821821,
      "height": 353.32768836207896,
