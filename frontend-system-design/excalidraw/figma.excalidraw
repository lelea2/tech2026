    {
      "id": "QLD1TdXCRaeHQlPKoZs42",
      "type": "text",
      "x": 294.70127389500567,
      "y": 2350.0812719655373,
      "width": 991.3592529296875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
