      "link": null,
      "locked": false,
      "text": "Non-functional requirements:\n-- performance: interactive update should be smooth, even with dozen or hundreds of shapes\n-- Accessibililty: desktop keyboard interactions should work, including keyboard shortcuts\nand focus management\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirements:\n-- performance: interactive update should be smooth, even with dozen or hundreds of shapes\n-- Accessibililty: desktop keyboard interactions should work, including keyboard shortcuts\nand focus management\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
