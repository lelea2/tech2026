    {
      "id": "2kMjVaFU3Nuxdk6eSGYHL",
      "type": "text",
      "x": 1412.2996283653,
      "y": 9.957746339679716,
      "width": 1190.3918040540716,
      "height": 425.59411932351134,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 179745468,
      "version": 541,
      "versionNonce": 1108082108,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783724257675,
      "link": null,
      "locked": false,
      "text": "\n* number of results\n* API URL /search?query=<>\n* Event listener: input/focus/blur/change/select => document.eventListener, adding DOM hook/input hook to these event\n****Cursor base vs offset base pagination\n--- Cursor based: `{cursor: \"<hash_cursor>\", size: <int>}`\nPros: It allows for a seamless continuation of the data stream, which is ideal for real-time updates.\nCons:The inability to jump to a specific page can limit users’ ability to navigate to a known position in the list.\n--- Offset based: `{page: <int>, limit: <int>}`\nPros: Easy implementation and direct navigation to any page.\nCons: Potential performance issues with large datasets, as SQL queries become more expensive with higher offsets.\n\n\n\n\n\n",
      "fontSize": 20.027958556400534,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n* number of results\n* API URL /search?query=<>\n* Event listener: input/focus/blur/change/select => document.eventListener, adding DOM hook/input hook to these event\n****Cursor base vs offset base pagination\n--- Cursor based: `{cursor: \"<hash_cursor>\", size: <int>}`\nPros: It allows for a seamless continuation of the data stream, which is ideal for real-time updates.\nCons:The inability to jump to a specific page can limit users’ ability to navigate to a known position in the list.\n--- Offset based: `{page: <int>, limit: <int>}`\nPros: Easy implementation and direct navigation to any page.\nCons: Potential performance issues with large datasets, as SQL queries become more expensive with higher offsets.\n\n\n\n\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "06rK3rs1FB8Bw6exNk1zT",
      "type": "text",
      "x": 2624.5292790463673,
      "y": 114.30187979975028,
      "width": 8,
      "height": 25,
      "angle": 0,
