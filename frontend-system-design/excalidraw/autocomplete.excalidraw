    {
      "id": "n9OOpe7A3WRjMdLmZkf-E",
      "type": "text",
      "x": 344.3793580518369,
      "y": 118.80005076902705,
      "width": 961.9193115234375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
      "roundness": null,
      "seed": 1832119740,
      "version": 329,
      "versionNonce": 1825592452,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783721137193,
      "link": null,
      "locked": false,
      "text": "Additional questions\n1. What kind of results should be support (text, image, media/media with text)\n2. What devices will this component used (laptio/tablets/mobile)\n3. support fuzzy search \n(technique that finds text matches even when the user query does not perfectly match the data)\n4. Data source flexibility (rely on API or also client/local data)\n5. offline usage \n6. Perfomance/scalability (how big is the dataset, high user traffic)\n7. Customized component?\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Additional questions\n1. What kind of results should be support (text, image, media/media with text)\n2. What devices will this component used (laptio/tablets/mobile)\n3. support fuzzy search \n(technique that finds text matches even when the user query does not perfectly match the data)\n4. Data source flexibility (rely on API or also client/local data)\n5. offline usage \n6. Perfomance/scalability (how big is the dataset, high user traffic)\n7. Customized component?\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
