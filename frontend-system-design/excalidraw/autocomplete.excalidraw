    {
      "id": "nJ8RIXtLVofq9jZ4Pm4iJ",
      "type": "text",
      "x": 1286.5050953926134,
      "y": 454.7857811966252,
      "width": 1211.2991943359375,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 515022780,
      "version": 315,
      "versionNonce": 1278758204,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783724267188,
      "link": null,
      "locked": false,
      "text": "\n-- Minimum query length trigger search only when minimum number of characters have been typed in (reduce irrelevant results)\n-- * Debounce duration:\nTriggering a back end search API for every keystroke can be quite wasteful, \nespecially when the queries for the first few characters are likely to not be meaningful. \nDebouncing is a technique that limits the number of times a function gets called. \nWe could debounce the API calls so that the server does not get hit too often. With a debounce duration of 300ms, \nthe back end search API will only be called after there has been no user input for 300ms\n* API timeout: how long we should wait for response before determine if search has time out\n* Cache-related\n   -- initial results\n   -- result source: network only/network and cache/cache only\n   -- Function to merge result from server and cache\n   -- cache durration\n* Server API: \n   * query/limit/pagination => useful if there is a need to allow users to scroll down beyond the initial list\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n-- Minimum query length trigger search only when minimum number of characters have been typed in (reduce irrelevant results)\n-- * Debounce duration:\nTriggering a back end search API for every keystroke can be quite wasteful, \nespecially when the queries for the first few characters are likely to not be meaningful. \nDebouncing is a technique that limits the number of times a function gets called. \nWe could debounce the API calls so that the server does not get hit too often. With a debounce duration of 300ms, \nthe back end search API will only be called after there has been no user input for 300ms\n* API timeout: how long we should wait for response before determine if search has time out\n* Cache-related\n   -- initial results\n   -- result source: network only/network and cache/cache only\n   -- Function to merge result from server and cache\n   -- cache durration\n* Server API: \n   * query/limit/pagination => useful if there is a need to allow users to scroll down beyond the initial list\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5znRw3KOu0y_b0NwbgBXm",
