    {
      "id": "e3V8aYf_fK-Q0WhpSw2sy",
      "type": "text",
      "x": 1569.5191064941203,
      "y": 3309.532893309121,
      "width": 279.86189496489453,
      "height": 459.0278568671742,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 1732814180,
      "version": 246,
      "versionNonce": 1575324764,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783618592518,
      "link": null,
      "locked": false,
      "text": "function VirtualizedColumn({\n  items,\n  viewportTop,\n  viewportHeight,\n  overscan = 800,\n}: {\n  items: PositionedPin[];\n  viewportTop: number;\n  viewportHeight: number;\n  overscan?: number;\n}) {\n  const visibleItems = getVisibleItems({\n    items,\n    viewportTop,\n    viewportHeight,\n    overscan,\n  });\n\n  const totalHeight = getTotalHeight(items);\n\n  return (\n    <div style={{ position: \"relative\", height: totalHeight }}>\n      {visibleItems.map(item => (\n        <div\n          key={item.pin.id}\n          style={{\n            position: \"absolute\",\n            top: item.start,\n            left: 0,\n            right: 0,\n          }}\n        >\n          <PinCard pin={item.pin} />\n        </div>\n      ))}\n    </div>\n  );\n}",
      "fontSize": 9.6637443550984,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function VirtualizedColumn({\n  items,\n  viewportTop,\n  viewportHeight,\n  overscan = 800,\n}: {\n  items: PositionedPin[];\n  viewportTop: number;\n  viewportHeight: number;\n  overscan?: number;\n}) {\n  const visibleItems = getVisibleItems({\n    items,\n    viewportTop,\n    viewportHeight,\n    overscan,\n  });\n\n  const totalHeight = getTotalHeight(items);\n\n  return (\n    <div style={{ position: \"relative\", height: totalHeight }}>\n      {visibleItems.map(item => (\n        <div\n          key={item.pin.id}\n          style={{\n            position: \"absolute\",\n            top: item.start,\n            left: 0,\n            right: 0,\n          }}\n        >\n          <PinCard pin={item.pin} />\n        </div>\n      ))}\n    </div>\n  );\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Q4QrdLIS8ppIU8DgSaQ8D",
      "type": "text",
      "x": 2018.774682494291,
      "y": 2009.099315352286,
      "width": 576.5195922851562,
      "height": 175,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 18744548,
      "version": 312,
      "versionNonce": 1139603172,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783618709578,
      "link": null,
      "locked": false,
      "text": "Note: To avoid browser not know the image\nheight until it loads, backend should provide width/height. \nIf BE does not provide dimension: (fallback)\n* Use a default placeholder ratio.\n* Probe image metadata before layout.\n* Accept some layout shift.\n* Ask backend to enrich image metadata asynchronously.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: To avoid browser not know the image\nheight until it loads, backend should provide width/height. \nIf BE does not provide dimension: (fallback)\n* Use a default placeholder ratio.\n* Probe image metadata before layout.\n* Accept some layout shift.\n* Ask backend to enrich image metadata asynchronously.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-h433ccA4h239B2JCD8-L",
      "type": "text",
      "x": 1946.9516244553274,
      "y": 3297.9846056736424,
      "width": 798.8994140625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0w",
      "roundness": null,
      "seed": 1641938908,
      "version": 240,
      "versionNonce": 1493782108,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783618875830,
      "link": null,
      "locked": false,
      "text": "To reduce reflow/repaints\n-- Paint images in order, i.e., only show an image \nif all that come before it have been fully loaded.\n-- Ensure multiple images that load within a short period of time \nonly cause one reflow and repaint. This feature is also built into React Suspense.\n-- Debounce/throttle masonry layout recalculation when the window resizes.\n-- Use list virtualization, so that the number of elements on the page is lower \nand fewer calculations are needed during reflows.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To reduce reflow/repaints\n-- Paint images in order, i.e., only show an image \nif all that come before it have been fully loaded.\n-- Ensure multiple images that load within a short period of time \nonly cause one reflow and repaint. This feature is also built into React Suspense.\n-- Debounce/throttle masonry layout recalculation when the window resizes.\n-- Use list virtualization, so that the number of elements on the page is lower \nand fewer calculations are needed during reflows.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HzgH16xfXW01UBTzae11P",
      "type": "text",
      "x": 1944.2638207520458,
      "y": 3551.960429626977,
      "width": 197.0398712158203,
      "height": 25,
      "angle": 0,
