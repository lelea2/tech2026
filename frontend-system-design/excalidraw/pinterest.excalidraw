    {
      "id": "Iks9y_43zx0cUnLcGG-V0",
      "type": "text",
      "x": 1139.6249854462203,
      "y": 3109.362574294142,
      "width": 301.4615383032031,
      "height": 507.8947727445284,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1816356572,
      "version": 265,
      "versionNonce": 248190820,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783618220526,
      "link": null,
      "locked": false,
      "text": "-- IntersectionObserver\n\nfunction InfiniteScrollSentinel({\n  onVisible,\n}: {\n  onVisible: () => void;\n}) {\n  const ref = useRef<HTMLDivElement | null>(null);\n\n  useEffect(() => {\n    const node = ref.current;\n    if (!node) return;\n\n    const observer = new IntersectionObserver(\n      entries => {\n        if (entries[0]?.isIntersecting) {\n          onVisible();\n        }\n      },\n      {\n        root: null,\n        rootMargin: \"800px\",\n        threshold: 0,\n      }\n    );\n\n    observer.observe(node);\n\n    return () => observer.disconnect();\n  }, [onVisible]);\n\n  return <div ref={ref} style={{ height: 1 }} />;\n}",
      "fontSize": 12.312600551382525,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- IntersectionObserver\n\nfunction InfiniteScrollSentinel({\n  onVisible,\n}: {\n  onVisible: () => void;\n}) {\n  const ref = useRef<HTMLDivElement | null>(null);\n\n  useEffect(() => {\n    const node = ref.current;\n    if (!node) return;\n\n    const observer = new IntersectionObserver(\n      entries => {\n        if (entries[0]?.isIntersecting) {\n          onVisible();\n        }\n      },\n      {\n        root: null,\n        rootMargin: \"800px\",\n        threshold: 0,\n      }\n    );\n\n    observer.observe(node);\n\n    return () => observer.disconnect();\n  }, [onVisible]);\n\n  return <div ref={ref} style={{ height: 1 }} />;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
