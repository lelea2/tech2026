      "link": null,
      "locked": false,
      "text": "// Calculate for responsive column\nfunction getColumnCount(containerWidth: number): number {\n  const minColumnWidth = 220;\n  const maxColumns = 6;\n\n  return Math.max(\n    2,\n    Math.min(maxColumns, Math.floor(containerWidth / minColumnWidth))\n  );\n}",
      "fontSize": 10.704030079279212,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Calculate for responsive column\nfunction getColumnCount(containerWidth: number): number {\n  const minColumnWidth = 220;\n  const maxColumns = 6;\n\n  return Math.max(\n    2,\n    Math.min(maxColumns, Math.floor(containerWidth / minColumnWidth))\n  );\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
