    {
      "id": "WqbzXwqxvZPBTkD7DXa-G",
      "type": "text",
      "x": 1660.1845953219542,
      "y": 2228.547674721858,
      "width": 484.96226263969044,
      "height": 521.2664960708386,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 998337116,
      "version": 244,
      "versionNonce": 849618652,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783617881590,
      "link": null,
      "locked": false,
      "text": "// How component will be used\nfunction MasonryFeed() {\n  const { pins, loadMore, hasMore, status } = useFeed();\n  const containerRef = useRef<HTMLDivElement | null>(null);\n\n  const { width } = useContainerSize(containerRef);\n\n  const columnCount = getColumnCount(width);\n  const gap = 16;\n  const columnWidth = Math.floor((width - gap * (columnCount - 1)) / columnCount);\n\n  const columns = useMemo(() => {\n    return distributePinsToColumns(pins, columnCount, columnWidth, gap);\n  }, [pins, columnCount, columnWidth]);\n\n  return (\n    <div ref={containerRef}>\n      <div\n        style={{\n          display: \"grid\",\n          gridTemplateColumns: `repeat(${columnCount}, 1fr)`,\n          gap,\n          alignItems: \"start\",\n        }}\n      >\n        {columns.map((column, index) => (\n          <MasonryColumn key={index} pins={column} gap={gap} />\n        ))}\n      </div>\n\n      {status === \"loading\" && <SkeletonGrid />}\n      {hasMore && <InfiniteScrollSentinel onVisible={loadMore} />}\n    </div>\n  );\n}",
      "fontSize": 11.914662767333452,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// How component will be used\nfunction MasonryFeed() {\n  const { pins, loadMore, hasMore, status } = useFeed();\n  const containerRef = useRef<HTMLDivElement | null>(null);\n\n  const { width } = useContainerSize(containerRef);\n\n  const columnCount = getColumnCount(width);\n  const gap = 16;\n  const columnWidth = Math.floor((width - gap * (columnCount - 1)) / columnCount);\n\n  const columns = useMemo(() => {\n    return distributePinsToColumns(pins, columnCount, columnWidth, gap);\n  }, [pins, columnCount, columnWidth]);\n\n  return (\n    <div ref={containerRef}>\n      <div\n        style={{\n          display: \"grid\",\n          gridTemplateColumns: `repeat(${columnCount}, 1fr)`,\n          gap,\n          alignItems: \"start\",\n        }}\n      >\n        {columns.map((column, index) => (\n          <MasonryColumn key={index} pins={column} gap={gap} />\n        ))}\n      </div>\n\n      {status === \"loading\" && <SkeletonGrid />}\n      {hasMore && <InfiniteScrollSentinel onVisible={loadMore} />}\n    </div>\n  );\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jif8gG5Fz8qQSiQF_tuce",
      "type": "text",
      "x": 1646.2852518034892,
      "y": 2785.822065298516,
