    {
      "id": "db1hVHIOdUZL5BL2-7X95",
      "type": "text",
      "x": 1158.355892216102,
      "y": 2232.9564879763957,
      "width": 382.59882822931905,
      "height": 671.4168568744373,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 1095784796,
      "version": 66,
      "versionNonce": 1111770340,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783617808072,
      "link": null,
      "locked": false,
      "text": "type PositionedPin = {\n  pin: Pin;\n  columnIndex: number;\n  width: number;\n  height: number;\n};\n\nfunction distributePinsToColumns(\n  pins: Pin[],\n  columnCount: number,\n  columnWidth: number,\n  gap: number\n): PositionedPin[][] {\n  const columns: PositionedPin[][] = Array.from(\n    { length: columnCount },\n    () => []\n  );\n\n  const columnHeights = Array.from({ length: columnCount }, () => 0);\n\n  for (const pin of pins) {\n    const aspectRatio = pin.imageHeight / pin.imageWidth;\n    const imageHeight = columnWidth * aspectRatio;\n\n    const cardExtraHeight = 72; // title, actions, creator row\n    const estimatedHeight = imageHeight + cardExtraHeight + gap;\n\n    let shortestColumnIndex = 0;\n\n    for (let i = 1; i < columnCount; i++) {\n      if (columnHeights[i] < columnHeights[shortestColumnIndex]) {\n        shortestColumnIndex = i;\n      }\n    }\n\n    columns[shortestColumnIndex].push({\n      pin,\n      columnIndex: shortestColumnIndex,\n      width: columnWidth,\n      height: estimatedHeight,\n    });\n\n    columnHeights[shortestColumnIndex] += estimatedHeight;\n  }\n\n  return columns;\n}",
      "fontSize": 11.428372031905305,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type PositionedPin = {\n  pin: Pin;\n  columnIndex: number;\n  width: number;\n  height: number;\n};\n\nfunction distributePinsToColumns(\n  pins: Pin[],\n  columnCount: number,\n  columnWidth: number,\n  gap: number\n): PositionedPin[][] {\n  const columns: PositionedPin[][] = Array.from(\n    { length: columnCount },\n    () => []\n  );\n\n  const columnHeights = Array.from({ length: columnCount }, () => 0);\n\n  for (const pin of pins) {\n    const aspectRatio = pin.imageHeight / pin.imageWidth;\n    const imageHeight = columnWidth * aspectRatio;\n\n    const cardExtraHeight = 72; // title, actions, creator row\n    const estimatedHeight = imageHeight + cardExtraHeight + gap;\n\n    let shortestColumnIndex = 0;\n\n    for (let i = 1; i < columnCount; i++) {\n      if (columnHeights[i] < columnHeights[shortestColumnIndex]) {\n        shortestColumnIndex = i;\n      }\n    }\n\n    columns[shortestColumnIndex].push({\n      pin,\n      columnIndex: shortestColumnIndex,\n      width: columnWidth,\n      height: estimatedHeight,\n    });\n\n    columnHeights[shortestColumnIndex] += estimatedHeight;\n  }\n\n  return columns;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
