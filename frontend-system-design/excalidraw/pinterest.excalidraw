    {
      "id": "McmIB0auDZRQqpvelEz9J",
      "type": "text",
      "x": -821.5384834664488,
      "y": 692.4199198852793,
      "width": 916.6793823242188,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
