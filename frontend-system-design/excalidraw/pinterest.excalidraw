      "updated": 1783617246483,
      "link": null,
      "locked": false,
      "text": "<img\n  src={pin.imageUrl}\n  srcSet={`\n    ${pin.imageUrl}?w=236 236w,\n    ${pin.imageUrl}?w=474 474w,\n    ${pin.imageUrl}?w=736 736w\n  `}\n  sizes=\"(max-width: 480px) 50vw, \n         (max-width: 768px) 33vw, \n         (max-width: 1024px) 25vw, \n         236px\"\n  width={pin.imageWidth}\n  height={pin.imageHeight}\n  loading=\"lazy\"\n  decoding=\"async\" // avoid holding up other content from displaying if the decoding time is long\n  fetchprioity=\"auto\"\n  alt={pin.title}\n/>",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<img\n  src={pin.imageUrl}\n  srcSet={`\n    ${pin.imageUrl}?w=236 236w,\n    ${pin.imageUrl}?w=474 474w,\n    ${pin.imageUrl}?w=736 736w\n  `}\n  sizes=\"(max-width: 480px) 50vw, \n         (max-width: 768px) 33vw, \n         (max-width: 1024px) 25vw, \n         236px\"\n  width={pin.imageWidth}\n  height={pin.imageHeight}\n  loading=\"lazy\"\n  decoding=\"async\" // avoid holding up other content from displaying if the decoding time is long\n  fetchprioity=\"auto\"\n  alt={pin.title}\n/>",
      "autoResize": true,
      "lineHeight": 1.25
    },
