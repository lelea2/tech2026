    {
      "id": "LIJRJ1peBn3GX4DOE45xT",
      "type": "text",
      "x": 1613.5311197779736,
      "y": 3024.9253754270103,
      "width": 208.89990234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
