      "updated": 1783617106301,
      "link": null,
      "locked": false,
      "text": "-- Use srcset enable multiple image source for different resolution or sizes\n-- Use width and height or aspect-ratio to prevent layout shift.\n-- fetchpriority: Provides a hint of the relative priority to use when fetching the image. Pinterest uses fetchpriority=\"auto\".\n-- Use loading=\"lazy\". loading: Indicates how the browser should load the image. Pinterest uses loading=\"auto\". \nLoading \"lazy\", which defers the load until the image or iframe reaches a distance threshold from the viewport.\n-- Use decoding=\"async\".\n-- Use responsive image sizes.\n-- Use CDN-generated thumbnails.\n-- Avoid loading full-resolution images in feed.\n-- Use dominant color or blur placeholder.\n-- Preload only above-the-fold critical images.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Use srcset enable multiple image source for different resolution or sizes\n-- Use width and height or aspect-ratio to prevent layout shift.\n-- fetchpriority: Provides a hint of the relative priority to use when fetching the image. Pinterest uses fetchpriority=\"auto\".\n-- Use loading=\"lazy\". loading: Indicates how the browser should load the image. Pinterest uses loading=\"auto\". \nLoading \"lazy\", which defers the load until the image or iframe reaches a distance threshold from the viewport.\n-- Use decoding=\"async\".\n-- Use responsive image sizes.\n-- Use CDN-generated thumbnails.\n-- Avoid loading full-resolution images in feed.\n-- Use dominant color or blur placeholder.\n-- Preload only above-the-fold critical images.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
