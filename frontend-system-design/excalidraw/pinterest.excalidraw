    {
      "id": "ABd-MXiHxUHcATDfHGb0I",
      "type": "text",
      "x": -346.46312972769465,
      "y": -118.96542275282309,
      "width": 1085.439208984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
      "roundness": null,
      "seed": 176139108,
      "version": 208,
      "versionNonce": 367895012,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783615653055,
      "link": null,
      "locked": false,
      "text": "- Users scroll through a responsive grid of pins. \n- Each card can have an image, title, creator, save button, and metadata. \n- Cards have different aspect ratios, so the layout should minimize vertical gaps while keeping scrolling smooth.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Users scroll through a responsive grid of pins. \n- Each card can have an image, title, creator, save button, and metadata. \n- Cards have different aspect ratios, so the layout should minimize vertical gaps while keeping scrolling smooth.",
      "autoResize": true,
      "lineHeight": 1.25
    },
