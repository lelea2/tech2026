    {
      "id": "9AUZUGh9Pj-73ho3IYoz_",
      "type": "text",
      "x": 2685.198185060063,
      "y": 1661.2452170195645,
      "width": 958.3993530273438,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 1849498338,
      "version": 170,
      "versionNonce": 795265534,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784225030931,
      "link": null,
      "locked": false,
      "text": "* For streaming chat responses, Server-Sent Events (SSE) is preferred over regular HTTP fetch. \nSSE allows the backend to send each chunk as soon as it’s ready, \nmaintaining the strict order. The client receives and renders each piece immediately.\n* All message events follow a simple, predictable JSON structure, \nallowing the frontend to update the chat view in real-time.\n* Use an Idempotency-Key header on message POSTs to prevent accidental duplicate sends.\n* When the backend is done streaming, it sends a data: [DONE] signal to completion.\n* All endpoints require an authToken header for security.\n* Pagination is handled via cursor  limit Parameters for listing messages and conversations.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* For streaming chat responses, Server-Sent Events (SSE) is preferred over regular HTTP fetch. \nSSE allows the backend to send each chunk as soon as it’s ready, \nmaintaining the strict order. The client receives and renders each piece immediately.\n* All message events follow a simple, predictable JSON structure, \nallowing the frontend to update the chat view in real-time.\n* Use an Idempotency-Key header on message POSTs to prevent accidental duplicate sends.\n* When the backend is done streaming, it sends a data: [DONE] signal to completion.\n* All endpoints require an authToken header for security.\n* Pagination is handled via cursor  limit Parameters for listing messages and conversations.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
