      "isDeleted": false,
      "boundElements": null,
      "updated": 1784224776441,
      "link": null,
      "locked": false,
      "text": "// Set up SSE connection\nconst eventSource = new EventSource('/api/conversation/stream');\n\neventSource.onmessage = (event) => {\n  const parsed = JSON.parse(event.data);\n  if (parsed.choices) {\n    updateLastMessage(parsed.choices[0].delta.content);\n  } else if (event.data === \"[DONE]\") {\n    eventSource.close();\n  }\n};\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Set up SSE connection\nconst eventSource = new EventSource('/api/conversation/stream');\n\neventSource.onmessage = (event) => {\n  const parsed = JSON.parse(event.data);\n  if (parsed.choices) {\n    updateLastMessage(parsed.choices[0].delta.content);\n  } else if (event.data === \"[DONE]\") {\n    eventSource.close();\n  }\n};\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
