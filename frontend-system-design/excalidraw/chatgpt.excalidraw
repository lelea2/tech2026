      "link": null,
      "locked": false,
      "text": "One typed event protocol.\nOne transport-independent reducer.\nFine-grained part updates.\nServer-authoritative persistence.\nMeasured optimizations.\nRecovery + accessibility built in.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One typed event protocol.\nOne transport-independent reducer.\nFine-grained part updates.\nServer-authoritative persistence.\nMeasured optimizations.\nRecovery + accessibility built in.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0P"
    },
