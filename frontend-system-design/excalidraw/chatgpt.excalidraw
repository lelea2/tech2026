    {
      "id": "7gQ-belegYeOeBA4tT8qw",
      "type": "text",
      "x": 1886.2827266661902,
      "y": 1651.6288927992857,
      "width": 650.6195068359375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
