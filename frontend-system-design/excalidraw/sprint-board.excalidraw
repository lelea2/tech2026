      "updated": 1784649215601,
      "link": null,
      "locked": false,
      "text": "*** Functional Requirements ***\n-- manage existing sprints\n-- create new tickets\n-- Reorder tickets by columns/status -- ticket only\nassigned to 1 user at a time\n-- create new columns, new ticket\n=====================\n-- filter by author/status\n-- complete a sprint\n-- searching",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Functional Requirements ***\n-- manage existing sprints\n-- create new tickets\n-- Reorder tickets by columns/status -- ticket only\nassigned to 1 user at a time\n-- create new columns, new ticket\n=====================\n-- filter by author/status\n-- complete a sprint\n-- searching",
      "autoResize": true,
      "lineHeight": 1.25
    },
