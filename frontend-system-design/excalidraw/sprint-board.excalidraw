    {
      "id": "tyCHnhoJr2xcCC47NlIg7",
      "type": "text",
      "x": 924.1901274365241,
      "y": 2540.9282564347673,
      "width": 1317.3787841796875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
