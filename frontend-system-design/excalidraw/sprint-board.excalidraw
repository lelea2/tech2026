      "isDeleted": false,
      "boundElements": null,
      "updated": 1784650673620,
      "link": null,
      "locked": false,
      "text": "*** Rendering optimization ***",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Rendering optimization ***",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "grCFxG4JCpAJ6QQETgJXG",
      "type": "text",
      "x": 923.4459519142916,
      "y": 2652.1136974034575,
      "width": 1227.5789794921875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 131708666,
      "version": 121,
      "versionNonce": 1945860390,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784650727186,
      "link": null,
      "locked": false,
      "text": "-- Paginating Tickets: Implement infinite scrolling with the Intersection Observer API to \nload tickets as they enter the viewport, reducing initial load times.\n-- Virtualization: Virtualize the rendering of tickets to replace nodes in the DOM rather than re-creating them, \nwhich is beneficial for performance when dealing with long lists.\n-- Hybrid Rendering: Utilize a combination of Server-Side Rendering (SSR) for the initial load and Client-Side Rendering (CSR) \nfor dynamic interactions, capitalizing on the strengths of both rendering methods. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Paginating Tickets: Implement infinite scrolling with the Intersection Observer API to \nload tickets as they enter the viewport, reducing initial load times.\n-- Virtualization: Virtualize the rendering of tickets to replace nodes in the DOM rather than re-creating them, \nwhich is beneficial for performance when dealing with long lists.\n-- Hybrid Rendering: Utilize a combination of Server-Side Rendering (SSR) for the initial load and Client-Side Rendering (CSR) \nfor dynamic interactions, capitalizing on the strengths of both rendering methods. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
