      "isDeleted": false,
      "boundElements": null,
      "updated": 1784650727843,
      "link": null,
      "locked": false,
      "text": "-- Images: Pull specific image sizes based on the viewport using web-compressed formats like WebP, when available; otherwise, use PNG.\n-- Compression: Utilize GZIP or Brotli for text compression to minimize the payload size sent over the network.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Images: Pull specific image sizes based on the viewport using web-compressed formats like WebP, when available; otherwise, use PNG.\n-- Compression: Utilize GZIP or Brotli for text compression to minimize the payload size sent over the network.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XuHVuT_tlLHLWSgkZOrox",
      "type": "text",
      "x": 936.6870656034712,
      "y": 2620.3172198861093,
      "width": 299.1998291015625,
      "height": 25,
      "angle": 0,
