      "boundElements": null,
      "updated": 1784649536695,
      "link": null,
      "locked": false,
      "text": "**** Data Model ****\n\nApp = {\n  activeBoard: Board;\n}\n\nBoard = {\n  id,\n  type: Enum{Sprint|Kanban|...}\n  title\n  description\n  duration: BoardDuration\n  columns: List[BoardColumn]\n}\n\nBoardDuration = {\n   start: Date\n   end: Date\n}\n\nBoardColumn ={\n   id,\n   position: Number, //index\n   title,\n   tickets: List[BoardTicket]\n}\n\nBoardTicket = {\n   title,\n   description,\n   position: Number, //index\n   assignee: UserProfile,\n   status: Enum<New|InProgress|Done>\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**** Data Model ****\n\nApp = {\n  activeBoard: Board;\n}\n\nBoard = {\n  id,\n  type: Enum{Sprint|Kanban|...}\n  title\n  description\n  duration: BoardDuration\n  columns: List[BoardColumn]\n}\n\nBoardDuration = {\n   start: Date\n   end: Date\n}\n\nBoardColumn ={\n   id,\n   position: Number, //index\n   title,\n   tickets: List[BoardTicket]\n}\n\nBoardTicket = {\n   title,\n   description,\n   position: Number, //index\n   assignee: UserProfile,\n   status: Enum<New|InProgress|Done>\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
