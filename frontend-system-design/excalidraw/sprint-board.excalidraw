    },
    {
      "id": "aesYQ-Zy-zJmbixmLUpLm",
      "type": "text",
      "x": 962.3018479187147,
      "y": 1638.4117929821439,
      "width": 1103.1993408203125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 892839718,
      "version": 26,
      "versionNonce": 406519974,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784650080814,
      "link": null,
      "locked": false,
      "text": "Considerations for Scalability and Maintainability:\n* Componentization: Ensure that components in the views are reusable and encapsulated.\n* State Management: Use Redux or Context API to manage the application \nstate for predictable state management.\n* Data Flow: Adopt a unidirectional data flow to ensure that the state changes are predictable and debuggable.\n* API Layer: Implement a service or API layer for all server interactions to decouple \nthe frontend from the backend, making it easier to manage changes on either side.\n* Optimistic Updates: Apply optimistic UI updates to make the application feel faster. \nFor instance, when a ticket is moved, the UI should immediately reflect this change \nbefore the server confirms the update.\n* Error Handling: Incorporate robust error handling to manage failures in network requests or server updates.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Considerations for Scalability and Maintainability:\n* Componentization: Ensure that components in the views are reusable and encapsulated.\n* State Management: Use Redux or Context API to manage the application \nstate for predictable state management.\n* Data Flow: Adopt a unidirectional data flow to ensure that the state changes are predictable and debuggable.\n* API Layer: Implement a service or API layer for all server interactions to decouple \nthe frontend from the backend, making it easier to manage changes on either side.\n* Optimistic Updates: Apply optimistic UI updates to make the application feel faster. \nFor instance, when a ticket is moved, the UI should immediately reflect this change \nbefore the server confirms the update.\n* Error Handling: Incorporate robust error handling to manage failures in network requests or server updates.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jjlOUblYi7USKd6p5PI88",
      "type": "text",
      "x": 973.8894465558521,
      "y": 1960.02626587218,
      "width": 390.0997619628906,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
