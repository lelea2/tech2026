      "seed": 1205405434,
      "version": 54,
      "versionNonce": 315510458,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784650128206,
      "link": null,
      "locked": false,
      "text": "*** Chosing GraphQL for dashboard ***",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Chosing GraphQL for dashboard ***",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Zb1SySYmmkYfIRf-fRTxz",
      "type": "text",
      "x": 949.7497772693214,
      "y": 1994.1057989825763,
      "width": 1252.7191162109375,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 324817146,
      "version": 27,
      "versionNonce": 478150714,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784650184483,
      "link": null,
      "locked": false,
      "text": "GraphQL is a query language that enables clients to request exactly the data they need, making it highly efficient. \nIt’s type-friendly and works well with HTTP/2, bringing the benefits of modern transport protocols,\n such as efficient use of headers and multiplexing. While it may lead to pulling all connected nodes, \npotentially increasing latency if not managed correctly, it allows for precise and optimized data retrieval.\n\n-- Why GraphQL for Our Application\nFor our Sprint Board Application, GraphQL is the protocol of choice due to its flexibility and efficiency. It enables us to:\n\n** Fetch specific data related to board columns, tickets, and sprints with a single request.\n** Minimize over-fetching and under-fetching of data, which is common in REST.\n** Combine multiple operations into a single HTTP request to reduce network overhead.\n** Effortlessly evolve the API without versioning, benefiting from a strong type system to build reliable client-side applications.\n\nThe ability to pull precisely the data we need, when we need it, without the extra overhead, \nmakes GraphQL the ideal candidate for our web application, where performance, scalability, and real-time updates are key.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GraphQL is a query language that enables clients to request exactly the data they need, making it highly efficient. \nIt’s type-friendly and works well with HTTP/2, bringing the benefits of modern transport protocols,\n such as efficient use of headers and multiplexing. While it may lead to pulling all connected nodes, \npotentially increasing latency if not managed correctly, it allows for precise and optimized data retrieval.\n\n-- Why GraphQL for Our Application\nFor our Sprint Board Application, GraphQL is the protocol of choice due to its flexibility and efficiency. It enables us to:\n\n** Fetch specific data related to board columns, tickets, and sprints with a single request.\n** Minimize over-fetching and under-fetching of data, which is common in REST.\n** Combine multiple operations into a single HTTP request to reduce network overhead.\n** Effortlessly evolve the API without versioning, benefiting from a strong type system to build reliable client-side applications.\n\nThe ability to pull precisely the data we need, when we need it, without the extra overhead, \nmakes GraphQL the ideal candidate for our web application, where performance, scalability, and real-time updates are key.",
      "autoResize": true,
      "lineHeight": 1.25
    },
