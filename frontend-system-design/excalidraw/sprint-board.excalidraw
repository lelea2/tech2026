    {
      "id": "qakYmsuMygSVvKXW-Hz5d",
      "type": "text",
      "x": 280,
      "y": 774.5,
      "width": 379.3597717285156,
      "height": 850,
      "angle": 0,
      "strokeColor": "#1e1e1e",
