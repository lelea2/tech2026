    {
      "id": "lM7NW7D7e4HDC576DZEyQ",
      "type": "text",
      "x": 288.23698301949713,
      "y": 5558.965511626765,
      "width": 655.439453125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
