    {
      "id": "HmRgUpOuQ-euByRwzgakD",
      "type": "text",
      "x": 1008.9542528470337,
      "y": 6226.5148527764495,
      "width": 853.3593139648438,
      "height": 200,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
