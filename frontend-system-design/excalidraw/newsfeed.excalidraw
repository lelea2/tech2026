    {
      "id": "QuNgaC1eLmxEY7oBYF0Kh",
      "type": "text",
      "x": 1132.1903183535533,
      "y": 7711.179798477724,
      "width": 948.1193237304688,
      "height": 125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
