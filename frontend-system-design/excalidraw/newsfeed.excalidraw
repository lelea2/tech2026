    {
      "id": "RfxVU_FfPusSGxWElGyYf",
      "type": "text",
      "x": 369.3346050644851,
      "y": 823.6654195233077,
      "width": 249.95591735839844,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0k",
