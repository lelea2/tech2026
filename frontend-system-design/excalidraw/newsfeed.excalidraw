      "seed": 1764327318,
      "version": 111,
      "versionNonce": 1022161674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781569572930,
      "link": null,
      "locked": false,
      "text": "# Sample GraphQL query to demonstrate data-driven dependencies.\n... on Post {\n  content @match {\n    ...TextPostFragment @module(name: \"TextComponent.react\")\n    ...ImagePostFragment @module(name: \"ImageComponent.react\")\n  }\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Sample GraphQL query to demonstrate data-driven dependencies.\n... on Post {\n  content @match {\n    ...TextPostFragment @module(name: \"TextComponent.react\")\n    ...ImagePostFragment @module(name: \"ImageComponent.react\")\n  }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
