    {
      "id": "7A0FNL0eoZTv5gAaVq7ZA",
      "type": "text",
      "x": 383.12654921417294,
      "y": 2254.870424803567,
      "width": 6.399993896484375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 16360074,
      "version": 3,
      "versionNonce": 891671958,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781555111807,
