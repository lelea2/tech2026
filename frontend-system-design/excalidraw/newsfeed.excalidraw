      "isDeleted": false,
      "boundElements": null,
      "updated": 1781552547442,
      "link": null,
      "locked": false,
      "text": "** Architecture **",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** Architecture **",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6Ot78jqRoGvAP8Xpvrd45",
      "type": "text",
      "x": 1426.5007427543808,
      "y": 890.7505800292483,
      "width": 869.455322265625,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0l",
      "roundness": null,
      "seed": 1213071766,
      "version": 1039,
      "versionNonce": 29800586,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781553264653,
      "link": null,
      "locked": false,
      "text": "* View: this is what user interact with directly. Render data from store and trigger user action\n* Store: SOT for client-side state. It holds feed data, post, composer state, it keeps \ndifferent parts of inference consistent and lets the UI remain responsive even when the network is slow\n* Data access: abstract communication with API backend. Handle network request, response\nparsing, caching policy, navigation, retries, transformation, convert raw API response to \nstructure that easy to store to consume\n* Server: Expose HTTP endpoints for fetching the feed, fetching a single post, creating post, uploading media,\n\nIn SPA, Store and Data access layers are initialized once on first load, the persist \nand update throughout the session as user scroll, navigate and interact with posts\n\n ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* View: this is what user interact with directly. Render data from store and trigger user action\n* Store: SOT for client-side state. It holds feed data, post, composer state, it keeps \ndifferent parts of inference consistent and lets the UI remain responsive even when the network is slow\n* Data access: abstract communication with API backend. Handle network request, response\nparsing, caching policy, navigation, retries, transformation, convert raw API response to \nstructure that easy to store to consume\n* Server: Expose HTTP endpoints for fetching the feed, fetching a single post, creating post, uploading media,\n\nIn SPA, Store and Data access layers are initialized once on first load, the persist \nand update throughout the session as user scroll, navigate and interact with posts\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
