    {
      "id": "PHyGhlOw_OnDae8HoLTX8",
      "type": "text",
      "x": 548.0000000000001,
      "y": -123.5,
      "width": 1002.7393798828125,
      "height": 400,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 1958552842,
      "version": 927,
      "versionNonce": 1692716362,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781551643807,
      "link": null,
      "locked": false,
      "text": "Requirements\n* render initial feed quickly and load more posts as the user scrolls\n* support common feed interactions such as reaction/post creation\n* handle long lived sessions, stale data, common feed performance concerns\n* Do not need to go deep on feed ranking, ads delivery\nWhat kind of posts are supported\n* Primary text and image based posts (if time permit, we can discuss more type: video, carousel, etc...)\nPagination UX\n* infinite scrolling\n* For long lived session, it's worth to discuss how newer posts are surfaced at the top\nwithout disrupting what user is reading\nMobile device??\n* Whether application can stay web first or focus on mobile-specific interaction patterns\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements\n* render initial feed quickly and load more posts as the user scrolls\n* support common feed interactions such as reaction/post creation\n* handle long lived sessions, stale data, common feed performance concerns\n* Do not need to go deep on feed ranking, ads delivery\nWhat kind of posts are supported\n* Primary text and image based posts (if time permit, we can discuss more type: video, carousel, etc...)\nPagination UX\n* infinite scrolling\n* For long lived session, it's worth to discuss how newer posts are surfaced at the top\nwithout disrupting what user is reading\nMobile device??\n* Whether application can stay web first or focus on mobile-specific interaction patterns\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4JT8Wg2IDZNBDD-LCoiaK",
      "type": "text",
      "x": 447.2380425577501,
      "y": 215.4463645059201,
      "width": 287.59979248046875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
