      "text": "{\n  \"text\": \"Check out @greatfrontend at https://www.greatfrontend.com #webdev\",\n  \"entities\": [\n    {\n      \"type\": \"mention\",\n      \"start\": 10,\n      \"end\": 24,\n      \"userId\": \"u_99\"\n    },\n    {\n      \"type\": \"link\",\n      \"start\": 28,\n      \"end\": 57,\n      \"url\": \"https://www.greatfrontend.com\"\n    },\n    {\n      \"type\": \"hashtag\",\n      \"start\": 58,\n      \"end\": 65\n    }\n  ]\n}\n",
