      "fontSize": 24.996874999999992,
      "fontFamily": 1,
      "text": "5. Short coding snippet: streaming chat reducer",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. Short coding snippet: streaming chat reducer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9234c5338372",
      "type": "text",
      "x": 56.96875,
      "y": 1184.87109375,
      "width": 630.9715576171875,
      "height": 828.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 38,
      "version": 68,
      "versionNonce": 1424031465,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784909568589,
      "link": null,
      "locked": false,
      "fontSize": 17,
      "fontFamily": 1,
      "text": "type ChatState = {\n  status: \"idle\" | \"streaming\" | \"done\" | \"error\";\n  text: string;\n  requestId?: string;\n  error?: string;\n};\ntype Action =\n  | { type: \"START\"; requestId: string }\n  | { type: \"TOKEN\"; requestId: string; token: string }\n  | { type: \"DONE\"; requestId: string }\n  | { type: \"ERROR\"; requestId: string; message: string }\n  | { type: \"CANCEL\" };\n\nfunction reducer(state: ChatState, action: Action): ChatState {\n  if (\"requestId\" in action &&\n      state.requestId &&\n      action.requestId !== state.requestId) {\n    return state; // ignore stale stream events\n  }\n\n  switch (action.type) {\n    case \"START\":\n      return { status: \"streaming\", text: \"\", requestId: action.requestId };\n    case \"TOKEN\":\n      return { ...state, text: state.text + action.token };\n    case \"DONE\":\n      return { ...state, status: \"done\" };\n    case \"ERROR\":\n      return { ...state, status: \"error\", error: action.message };\n    case \"CANCEL\":\n      return { status: \"idle\", text: \"\" };\n  }\n}\n\nDiscussion:\n• Why reducer? Explicit state transitions and testability.\n• Concern: appending per token creates many renders.\n• Improvement: buffer tokens in a ref and flush every 16–50 ms.\n• Cancellation: AbortController + requestId stale-event guard.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type ChatState = {\n  status: \"idle\" | \"streaming\" | \"done\" | \"error\";\n  text: string;\n  requestId?: string;\n  error?: string;\n};\ntype Action =\n  | { type: \"START\"; requestId: string }\n  | { type: \"TOKEN\"; requestId: string; token: string }\n  | { type: \"DONE\"; requestId: string }\n  | { type: \"ERROR\"; requestId: string; message: string }\n  | { type: \"CANCEL\" };\n\nfunction reducer(state: ChatState, action: Action): ChatState {\n  if (\"requestId\" in action &&\n      state.requestId &&\n      action.requestId !== state.requestId) {\n    return state; // ignore stale stream events\n  }\n\n  switch (action.type) {\n    case \"START\":\n      return { status: \"streaming\", text: \"\", requestId: action.requestId };\n    case \"TOKEN\":\n      return { ...state, text: state.text + action.token };\n    case \"DONE\":\n      return { ...state, status: \"done\" };\n    case \"ERROR\":\n      return { ...state, status: \"error\", error: action.message };\n    case \"CANCEL\":\n      return { status: \"idle\", text: \"\" };\n  }\n}\n\nDiscussion:\n• Why reducer? Explicit state transitions and testability.\n• Concern: appending per token creates many renders.\n• Improvement: buffer tokens in a ref and flush every 16–50 ms.\n• Cancellation: AbortController + requestId stale-event guard.",
      "autoResize": true,
      "lineHeight": 1.25
    },
