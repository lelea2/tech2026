      "seed": 1886701256,
      "version": 38,
      "versionNonce": 1723195401,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782867643418,
      "link": null,
      "locked": false,
      "text": "** 2 phases approach\n-- Reduces the load on the system during the contest by 90%.\n-- Allows for more accurate final results after full evaluation.\n-- Is similar to the approach used by platforms like Codeforces for large contests.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** 2 phases approach\n-- Reduces the load on the system during the contest by 90%.\n-- Allows for more accurate final results after full evaluation.\n-- Is similar to the approach used by platforms like Codeforces for large contests.",
      "autoResize": true,
      "lineHeight": 1.25
    },
