    {
      "id": "pzOyXOQGRzLouqYkds0wN",
      "type": "text",
      "x": 323.75390625,
      "y": 165.5,
      "width": 863.1393432617188,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2S",
      "roundness": null,
      "seed": 1242220118,
      "version": 940,
      "versionNonce": 1454180182,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781736740468,
      "link": null,
      "locked": false,
      "text": "*** Requirements\n-- Browsing recommended video on homepage\n-- Autoplay billboard video at top (discover/recommendations page)\n-- Playback video content on standalone page\n*** Functionality requirement for video player\n-- Video progress (play/pause/skip/seeking to specific timestamp of video, playbackrate)\n-- Audio: adjusting volumne, changing language\n-- Subtitle: display and select\n*** Device support \n--- Mostly desktop (can be web tablet/mobile)\n*** Non-functional requirement: smooth video watching experience\n--- user on slow internet should still be able to watch video (can be lower quality)\n--- Reduce stuttering/buffering\n--- Fast video startup time\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Requirements\n-- Browsing recommended video on homepage\n-- Autoplay billboard video at top (discover/recommendations page)\n-- Playback video content on standalone page\n*** Functionality requirement for video player\n-- Video progress (play/pause/skip/seeking to specific timestamp of video, playbackrate)\n-- Audio: adjusting volumne, changing language\n-- Subtitle: display and select\n*** Device support \n--- Mostly desktop (can be web tablet/mobile)\n*** Non-functional requirement: smooth video watching experience\n--- user on slow internet should still be able to watch video (can be lower quality)\n--- Reduce stuttering/buffering\n--- Fast video startup time\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
