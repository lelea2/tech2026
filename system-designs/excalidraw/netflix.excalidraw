      "isDeleted": false,
      "boundElements": null,
      "updated": 1781738534496,
      "link": null,
      "locked": false,
      "text": "* Server: fetching video recommendation and its metadata\n* CDN: fetch video content itself, allow fetching individual segments of the video",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Server: fetching video recommendation and its metadata\n* CDN: fetch video content itself, allow fetching individual segments of the video",
      "autoResize": true,
      "lineHeight": 1.25
    },
