      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API\nPOST /upload {video, videoMeatdata}\nGET /videos/{videoId} --> {video/videoMetadata}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vCfvdqtJ2ojkqO4b4Uep_",
