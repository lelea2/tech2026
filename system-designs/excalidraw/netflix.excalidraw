    },
    {
      "id": "MZTJirf3JhRcG9tJsJMAt",
      "type": "text",
      "x": 213.07543936123398,
      "y": 2057.9428370994724,
      "width": 301.15985107421875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b27",
      "roundness": null,
      "seed": 484106250,
      "version": 85,
      "versionNonce": 702890506,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781731918967,
      "link": null,
      "locked": false,
      "text": "**** Concurrency control model\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**** Concurrency control model\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WIGqXnAa6RbKZ2dgzCqq0",
      "type": "text",
      "x": 227.60469489070215,
      "y": 2095.102153752368,
      "width": 887.4793090820312,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b28",
      "roundness": null,
      "seed": 2125262998,
      "version": 899,
      "versionNonce": 1133460374,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781731918967,
      "link": null,
      "locked": false,
      "text": "-- Local updates: update made to the document by user viewing it\n-- Merge updates from peers: updates made to the document by peers\n** Pessimistic update: guarantee no conflicts occur. Do not require conflict resolution, \nhave higher network latency and longer response time\n** Optimistic update: have 0/near 0 local response time, require conflictresolution\n==> Treat the whole document as the unit of concurrency will silently drop\none participant's work every time 2 people save at once. Last-write-wins can still be useful\ninside narrow CRDT (Conflict-free Replicated Data Type) primitives",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Local updates: update made to the document by user viewing it\n-- Merge updates from peers: updates made to the document by peers\n** Pessimistic update: guarantee no conflicts occur. Do not require conflict resolution, \nhave higher network latency and longer response time\n** Optimistic update: have 0/near 0 local response time, require conflictresolution\n==> Treat the whole document as the unit of concurrency will silently drop\none participant's work every time 2 people save at once. Last-write-wins can still be useful\ninside narrow CRDT (Conflict-free Replicated Data Type) primitives",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "E1NkifiFXTlYG4BhMB2sJ",
      "type": "text",
      "x": 183.07955697781574,
      "y": 2315.474956553984,
      "width": 247.8199005126953,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b29",
      "roundness": null,
      "seed": 375289930,
      "version": 37,
      "versionNonce": 1824813258,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781731918967,
      "link": null,
      "locked": false,
      "text": "**** Floor control models",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**** Floor control models",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cg5WLcUsHaVpugjtRC_Tm",
      "type": "text",
      "x": 458.4962952255653,
      "y": 2325.019100948708,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
