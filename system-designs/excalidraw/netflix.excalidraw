    {
      "id": "VhsIxbSZ5j90mlWOcKegi",
      "type": "text",
      "x": 1110.9428180003772,
      "y": 1952.832729278035,
      "width": 677.1795654296875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
