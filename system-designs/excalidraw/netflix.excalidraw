      "index": "b30",
      "roundness": null,
      "seed": 2043128650,
      "version": 368,
      "versionNonce": 1407533194,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781739360080,
      "link": null,
      "locked": false,
      "text": "*** For API, both offset-based pagination or cursor-based pagination can be used\nThe data for the first page:\n1. Is used to SSR the initial HTML\n2. Rendered and store JSON (first in client store)\nSubsequent pages is fetched from HTTP API and added into client store,\nwhich is then added to the page's DOM",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** For API, both offset-based pagination or cursor-based pagination can be used\nThe data for the first page:\n1. Is used to SSR the initial HTML\n2. Rendered and store JSON (first in client store)\nSubsequent pages is fetched from HTTP API and added into client store,\nwhich is then added to the page's DOM",
      "autoResize": true,
      "lineHeight": 1.25
    },
