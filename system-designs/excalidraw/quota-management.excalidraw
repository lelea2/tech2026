    {
      "id": "yGPLMVVefn8kapGiftbwP",
      "type": "text",
      "x": 136.05842488438049,
      "y": 868.1900195493765,
      "width": 541.6596069335938,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
