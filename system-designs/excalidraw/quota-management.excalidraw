      "fontSize": 19,
      "fontFamily": 5,
      "text": "Researcher: root cause in minutes, not hours\nPlatform: metric freshness < 30s hot path\nTraining: no silent GPU degradation\nEvaluation: reproducible score + lineage + policy decision",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Researcher: root cause in minutes, not hours\nPlatform: metric freshness < 30s hot path\nTraining: no silent GPU degradation\nEvaluation: reproducible score + lineage + policy decision",
      "autoResize": true,
      "lineHeight": 1.25
