      "text": "Request\n  ↓\nBEGIN TRANSACTION\n  ↓\nLock quota row\n  ↓\nCheck used + requested <= limit\n  ↓\nUpdate used storage\n  ↓\nInsert allocation record\n  ↓\nCOMMIT",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Request\n  ↓\nBEGIN TRANSACTION\n  ↓\nLock quota row\n  ↓\nCheck used + requested <= limit\n  ↓\nUpdate used storage\n  ↓\nInsert allocation record\n  ↓\nCOMMIT",
      "autoResize": true,
      "lineHeight": 1.25
