    {
      "id": "wj76da36T49Hwf5aa1luk",
      "type": "text",
      "x": 310,
      "y": 420.5,
      "width": 354.7997741699219,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
