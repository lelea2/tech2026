      "updated": 1786749432790,
      "link": null,
      "locked": false,
      "text": "Heartbeats: The uploading service (Drive) sends a \"heartbeat\" every 5 minutes to extend the reservation time.\nIf the heartbeat stops, the worker deletes the reservation.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Heartbeats: The uploading service (Drive) sends a \"heartbeat\" every 5 minutes to extend the reservation time.\nIf the heartbeat stops, the worker deletes the reservation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
