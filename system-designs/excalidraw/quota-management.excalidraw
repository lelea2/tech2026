      "fontSize": 19,
      "fontFamily": 5,
      "text": "evaluation_id • model_version • checkpoint_id • training_run_id\nbenchmark + benchmark_version • dataset_hash/version\nprompt_template_version • evaluator_version • judge_model/version\nseed / decoding config • code hash • hardware profile\n\nNever store only “MMLU = 81%”. Store enough context to reproduce the score.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "evaluation_id • model_version • checkpoint_id • training_run_id\nbenchmark + benchmark_version • dataset_hash/version\nprompt_template_version • evaluator_version • judge_model/version\nseed / decoding config • code hash • hardware profile\n\nNever store only “MMLU = 81%”. Store enough context to reproduce the score.",
      "autoResize": true,
