      "text": "Quota Management Systems\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Quota Management Systems\n",
      "autoResize": true,
