      "isDeleted": false,
      "boundElements": [],
      "updated": 1786744682795,
      "link": null,
      "locked": false,
      "text": "Non-functional requiremen\n1) Strict consistency > no overdraft\n2) Low latency (<50ms)\n3) High availability (99.9%)\n4) High throughput (10k-100k+ QPS)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requiremen\n1) Strict consistency > no overdraft\n2) Low latency (<50ms)\n3) High availability (99.9%)\n4) High throughput (10k-100k+ QPS)",
      "autoResize": true,
      "lineHeight": 1.25
    },
