    {
      "id": "e1120",
      "type": "text",
      "x": 1758,
      "y": 2793,
      "width": 1464,
      "height": 161.28,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a112",
      "roundness": null,
      "seed": 328219839,
      "version": 3,
      "versionNonce": 1544549072,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786743368049,
      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 5,
      "text": "Hot TSDB: low-cardinality operational metrics\nPer-rank details: short retention / sampled / event store\nHigh-cardinality dimensions: ClickHouse/object store, queried on demand\nPre-aggregate by run, stage, node, GPU pool, percentile\nAvoid putting raw prompt/user/example IDs into Prometheus labels.\n\nRule: cardinality is an architecture concern, not a dashboard concern.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hot TSDB: low-cardinality operational metrics\nPer-rank details: short retention / sampled / event store\nHigh-cardinality dimensions: ClickHouse/object store, queried on demand\nPre-aggregate by run, stage, node, GPU pool, percentile\nAvoid putting raw prompt/user/example IDs into Prometheus labels.\n\nRule: cardinality is an architecture concern, not a dashboard concern.",
      "autoResize": true,
      "lineHeight": 1.25
    },
