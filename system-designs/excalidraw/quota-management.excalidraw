    {
      "id": "4MYIuX4khz_5WQlGUHzZN",
      "type": "text",
      "x": 2353.953764241184,
      "y": 1685.0373295453753,
      "width": 925.8915304976472,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1476431935,
      "version": 108,
      "versionNonce": 1735569777,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787331681409,
      "link": null,
      "locked": false,
      "text": "I separate policy versioning from quota accounting. Versioning tells me which rule applies; a\nstrongly consistent reservation counter ensures concurrent requests cannot collectively\nviolate that rule.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I separate policy versioning from quota accounting. Versioning tells me which rule applies; a strongly consistent reservation counter ensures concurrent requests cannot collectively violate that rule.",
      "autoResize": false,
      "lineHeight": 1.25
    },
