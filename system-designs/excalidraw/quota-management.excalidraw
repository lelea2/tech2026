      "updated": 1786744968658,
      "link": null,
      "locked": false,
      "text": "Capacity Math\n\n1) Daily active users (~10M)\n2) 20 actions (upload/delete/edit) per user/day\n3) peak QPS: ~20k+ QPS\n4) Data szie: ~100 bytes per users\n5) total storage ~1GB",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Capacity Math\n\n1) Daily active users (~10M)\n2) 20 actions (upload/delete/edit) per user/day\n3) peak QPS: ~20k+ QPS\n4) Data szie: ~100 bytes per users\n5) total storage ~1GB",
      "autoResize": true,
      "lineHeight": 1.25
    },
