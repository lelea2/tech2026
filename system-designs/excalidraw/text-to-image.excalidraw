      "versionNonce": 1126788504,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785945087792,
      "link": null,
      "locked": false,
      "text": "SSE vs WebSocket vs Polling\n\n- SSE: one-way, native reconnect, event IDs; chosen\n- WebSocket: full duplex, custom resume, more state\n- Polling: simplest but delayed and wasteful\n\n- Use HTTP commands for cancel/retry and SSE\nfor status.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "r127",
      "originalText": "SSE vs WebSocket vs Polling\n\n- SSE: one-way, native reconnect, event IDs; chosen\n- WebSocket: full duplex, custom resume, more state\n- Polling: simplest but delayed and wasteful\n\n- Use HTTP commands for cancel/retry and SSE for status.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "r129",
      "type": "rectangle",
      "x": 550,
