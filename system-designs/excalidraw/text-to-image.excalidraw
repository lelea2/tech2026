      "seed": 2329,
      "version": 4,
      "versionNonce": 1033593064,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785945125565,
      "link": null,
      "locked": false,
      "text": "Retry + Deduplication\n\nInternal transient retry = new attempt, same job\nManual retry = new linked job\nDedupe at submission, lease, attempt, asset,\nevent, and billing layers\nExponential backoff + jitter + max elapsed/cost\nbudget.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "r135",
      "originalText": "Retry + Deduplication\n\nInternal transient retry = new attempt, same job\nManual retry = new linked job\nDedupe at submission, lease, attempt, asset, event, and billing layers\nExponential backoff + jitter + max elapsed/cost budget.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "r137",
      "type": "rectangle",
      "x": 1060,
      "y": 3200,
