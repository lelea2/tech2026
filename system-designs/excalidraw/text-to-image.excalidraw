    {
      "id": "t125",
      "type": "text",
      "x": 40,
      "y": 2630,
      "width": 1500,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 2142,
      "version": 2,
      "versionNonce": 1876176024,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785944805196,
      "link": null,
      "locked": false,
      "text": "Progress design when exact model progress is unavailable:\nVALIDATING 0–10% → QUEUED 10–20% → PREPARING 20–35% → GENERATING 35–85% → POST-PROCESS 85–92% → MODERATION 92–98% → FINALIZING 98–100%. Use indeterminate animation inside a phase, historical ETA as an estimate, monotonic display, and never claim synthetic precision as model truth.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Progress design when exact model progress is unavailable:\nVALIDATING 0–10% → QUEUED 10–20% → PREPARING 20–35% → GENERATING 35–85% → POST-PROCESS 85–92% → MODERATION 92–98% → FINALIZING 98–100%. Use indeterminate animation inside a phase, historical ETA as an estimate, monotonic display, and never claim synthetic precision as model truth.",
      "autoResize": false,
      "lineHeight": 1.25
    },
