      "boundElements": [],
      "updated": 1785944805196,
      "link": null,
      "locked": false,
      "text": "Cancellation-wins policy: if cancellation is persisted before the atomic success commit, discard unpublished outputs and finish CANCELLED. If success commits first, cancellation returns the terminal SUCCEEDED state. Keep CANCELLING visible until the queue/worker acknowledges cleanup.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cancellation-wins policy: if cancellation is persisted before the atomic success commit, discard unpublished outputs and finish CANCELLED. If success commits first, cancellation returns the terminal SUCCEEDED state. Keep CANCELLING visible until the queue/worker acknowledges cleanup.",
      "autoResize": false,
      "lineHeight": 1.25
    },
