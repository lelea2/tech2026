    {
      "id": "t130",
      "type": "text",
      "x": 555,
      "y": 2945,
      "width": 446,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
