      "locked": false
    },
    {
      "id": "t138",
      "type": "text",
      "x": 1065,
      "y": 3250,
      "width": 456,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
