      "isDeleted": false,
      "boundElements": [],
      "updated": 1785946027981,
      "link": null,
      "locked": false,
      "text": "Idempotency + Lost Response\n\nScope key by tenant/user/endpoint\nCanonical request hash\nUnique DB constraint is the race arbiter\nSame key + same hash returns original job\nSame key + different hash returns 409\nTransactional outbox avoids DB/queue dual-write\nbugs.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "r133",
      "originalText": "Idempotency + Lost Response\n\nScope key by tenant/user/endpoint\nCanonical request hash\nUnique DB constraint is the race arbiter\nSame key + same hash returns original job\nSame key + different hash returns 409\nTransactional outbox avoids DB/queue dual-write bugs.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "r135",
