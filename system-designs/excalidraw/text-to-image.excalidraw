      "index": "an",
      "roundness": null,
      "seed": 2363,
      "version": 4,
      "versionNonce": 286235288,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785945123232,
      "link": null,
      "locked": false,
      "text": "Moderation + Cost Controls\n\nPre-moderation saves GPU cost\nPost-moderation catches unsafe outputs\nReserve quota at submit; settle actual usage at\nterminal state\nWeighted rate limits by model/count/resolution\nAdmission control, batching, warm pools, budget caps.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "r137",
      "originalText": "Moderation + Cost Controls\n\nPre-moderation saves GPU cost\nPost-moderation catches unsafe outputs\nReserve quota at submit; settle actual usage at terminal state\nWeighted rate limits by model/count/resolution\nAdmission control, batching, warm pools, budget caps.",
      "autoResize": false,
      "lineHeight": 1.25
    },
