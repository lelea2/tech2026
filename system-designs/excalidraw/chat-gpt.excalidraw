      "updated": 1786552093011,
      "link": null,
      "locked": false,
      "text": "\n\n\n\n\n================================================================\nOption1: wait for complete response\n-- Simple HTTP post and get full response back\n-- normally user will need to wait for 10-30 seconds staring at loading spinner\n-- Create poor UX, feel slow\n\n***** Option2: Stream word by word ==> chosen\n-- Required persistent connection\n-- User see progress immediately\n-- Much better UX\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n\n\n\n================================================================\nOption1: wait for complete response\n-- Simple HTTP post and get full response back\n-- normally user will need to wait for 10-30 seconds staring at loading spinner\n-- Create poor UX, feel slow\n\n***** Option2: Stream word by word ==> chosen\n-- Required persistent connection\n-- User see progress immediately\n-- Much better UX\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EmJHaz-M2fEtM8VhB1Ts4",
