    },
    {
      "id": "fe437eiFC1DAGVvTb0dW_",
      "type": "text",
      "x": -496.900565437998,
      "y": 3156.1716226840626,
      "width": 766.0797729492188,
      "height": 35,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
