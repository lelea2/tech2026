    {
      "id": "i4NBXSdbIfVHITRklajKt",
      "type": "text",
      "x": 8.30441405793988,
      "y": 3777.9777363070457,
      "width": 732.7393798828125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b41",
      "roundness": null,
      "seed": 507767382,
      "version": 269,
      "versionNonce": 468740298,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781806195765,
      "link": null,
      "locked": false,
      "text": "*** Conversation API\n-- The conversation service is a Rest API, \nwith operations such as creating, deleting, viewing, and sending a message. \nEach conversation has a unique ID for each message.\n-- User can rate each message with thumbs up/down\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Conversation API\n-- The conversation service is a Rest API, \nwith operations such as creating, deleting, viewing, and sending a message. \nEach conversation has a unique ID for each message.\n-- User can rate each message with thumbs up/down\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5kj6Iz5r6wPCnK0vGG2Gp",
      "type": "text",
      "x": -58.63294059168692,
      "y": 2611.3052508577443,
      "width": 582.399658203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b42",
      "roundness": null,
      "seed": 519362390,
      "version": 103,
      "versionNonce": 1669652804,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786551800677,
      "link": null,
      "locked": false,
      "text": "*** high level design (ChatGPT has more READ than Write)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** high level design (ChatGPT has more READ than Write)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YzS_-LDkwgh3yF3BE_Juf",
      "type": "text",
      "x": 1735.5228411322894,
      "y": 1951.5867290174856,
      "width": 536.57958984375,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b43",
      "roundness": null,
      "seed": 833791702,
      "version": 855,
      "versionNonce": 442385788,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786552965962,
      "link": null,
      "locked": false,
      "text": "Why postgres??\n** Pros\n-- ACID\n-- Strong consistency\n-- Proven at 800M users with single primary DB\n-- Relational model fits chat data\n-- Scale read easily by adding more replicas\n-- Battle test at extreme scale (stable system)\n** Cons:\n--- Single primary become write bottleneck\n--- Avoid write heavy workloads to other systems\n--- Required careful optimization (index, query timeout)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why postgres??\n** Pros\n-- ACID\n-- Strong consistency\n-- Proven at 800M users with single primary DB\n-- Relational model fits chat data\n-- Scale read easily by adding more replicas\n-- Battle test at extreme scale (stable system)\n** Cons:\n--- Single primary become write bottleneck\n--- Avoid write heavy workloads to other systems\n--- Required careful optimization (index, query timeout)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3wPh-_eJYDqNbvhPa8c9K",
      "type": "text",
      "x": 1016.0900829662962,
      "y": 3390.6666992073046,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
