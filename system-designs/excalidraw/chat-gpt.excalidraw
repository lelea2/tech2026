    {
      "id": "nMZOQeyFEbLnvA2zKnLyK",
      "type": "text",
      "x": 500.9216591508954,
      "y": 518.9143414127761,
      "width": 554.5996704101562,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
