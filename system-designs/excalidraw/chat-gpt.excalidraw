    {
      "id": "zRuD0SiwSRmwBhonIqJbw",
      "type": "text",
      "x": -495.5559613303508,
      "y": 2742.139698103325,
      "width": 976.5836791992188,
      "height": 35,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
