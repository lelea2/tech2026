    {
      "id": "2IkQoK5CXvXeV1I67Pk9v",
      "type": "text",
      "x": -516.4144310130678,
      "y": -466.01629864435364,
      "width": 713.4993896484375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
