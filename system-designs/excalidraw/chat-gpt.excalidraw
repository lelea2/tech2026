      "seed": 1096149642,
      "version": 307,
      "versionNonce": 251790788,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786551426101,
      "link": null,
      "locked": false,
      "text": "Design Chat-GPT systems\n",
      "fontSize": 61.85811297837295,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design Chat-GPT systems\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_6okCEnOHyoT0n-a5uG6c",
      "type": "text",
      "x": 507.4449417479214,
      "y": -1700.2566909299446,
      "width": 985.3191528320312,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3I",
      "roundness": null,
      "seed": 1572116618,
      "version": 452,
      "versionNonce": 1782555900,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786551429455,
      "link": null,
      "locked": false,
      "text": "\n*** Requirements ***\n-- ChatGPT's scale 5.8 billion visits per month, 1 billion weekly usage sending 2.5 billion prompts/days",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n*** Requirements ***\n-- ChatGPT's scale 5.8 billion visits per month, 1 billion weekly usage sending 2.5 billion prompts/days",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "shK-0D4KY-T_EhWJQutvB",
      "type": "text",
      "x": 500.94902507360473,
      "y": -1539.265628138979,
      "width": 615.6796264648438,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3J",
      "roundness": null,
      "seed": 1810585110,
      "version": 706,
      "versionNonce": 1822575740,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786551432314,
      "link": null,
      "locked": false,
      "text": "* Are we building our own AI model?\n* Need streaming response word by word or complete response?\n* What is expected scale? Thousands vs. million users?\n* Do we need account and conversation history?\n* Is conversation private or sharable?\n* Support multi languages?\n* Handle rate limiting? Free vs. paid tiers?\n* Text only vs images and files?\n* Do we need content moderation",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Are we building our own AI model?\n* Need streaming response word by word or complete response?\n* What is expected scale? Thousands vs. million users?\n* Do we need account and conversation history?\n* Is conversation private or sharable?\n* Support multi languages?\n* Handle rate limiting? Free vs. paid tiers?\n* Text only vs images and files?\n* Do we need content moderation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1sSQdkgP4yJErDSz_GaoC",
      "type": "text",
      "x": 1296.0887325860865,
      "y": -1522.7550165740608,
      "width": 599.3795776367188,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3K",
      "roundness": null,
      "seed": 1963520918,
      "version": 692,
      "versionNonce": 692083708,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786551435001,
      "link": null,
      "locked": false,
      "text": "**** Assumption we make for this design\n* Integrating with existing LLM\n* Streaming responses requires good UX\n* 800-900 million users weekly with ~2.5 billion prompts/days\n* User need account and private conversation history\n* Text only/English first\n* Rate limit for both request and token use\n* Basic content moderation required",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**** Assumption we make for this design\n* Integrating with existing LLM\n* Streaming responses requires good UX\n* 800-900 million users weekly with ~2.5 billion prompts/days\n* User need account and private conversation history\n* Text only/English first\n* Rate limit for both request and token use\n* Basic content moderation required",
      "autoResize": true,
      "lineHeight": 1.25
    },
