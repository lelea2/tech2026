    {
      "id": "ckIXcxwsop2UPW6UC3eQt",
      "type": "text",
      "x": -526.221741293203,
      "y": -1529.1879096523421,
      "width": 694.2411021293442,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4P",
      "roundness": null,
      "seed": 1277030084,
      "version": 411,
      "versionNonce": 1327510084,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786551456373,
      "link": null,
      "locked": false,
      "text": "1) Users should be able to send a prompt in a chat and receive an AI-\ngenerated response.\n2) Users should be able to view past chats and resume a\nconversation, with the chat's prior context carried into the prompt.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Users should be able to send a prompt in a chat and receive an AI-generated response.\n2) Users should be able to view past chats and resume a conversation, with the chat's prior context carried into the prompt.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
