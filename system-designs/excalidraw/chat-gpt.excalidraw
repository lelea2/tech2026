      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3a",
      "roundness": null,
      "seed": 124240778,
      "version": 836,
      "versionNonce": 1008613756,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786552056206,
      "link": null,
      "locked": false,
      "text": "*** SSE ==> each word appears in UI as it arrive, creating typing effect\n-- Works over standard HTTP\n-- Browser has built in EventSource API\n-- Auto-reconnection handle automatically\n-- One-way communication (server to client)\n-- Simpler to implement and debug\n-- Lower over head\n\n*** Websocket\n-- Require protocol upgrade from HTTP\n-- Bidirectional communication\n-- More complex to implement \n-- Useful for collaborative feature (eg: chat app), typing inidicators\n-- Overkill for just streaming AI response",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** SSE ==> each word appears in UI as it arrive, creating typing effect\n-- Works over standard HTTP\n-- Browser has built in EventSource API\n-- Auto-reconnection handle automatically\n-- One-way communication (server to client)\n-- Simpler to implement and debug\n-- Lower over head\n\n*** Websocket\n-- Require protocol upgrade from HTTP\n-- Bidirectional communication\n-- More complex to implement \n-- Useful for collaborative feature (eg: chat app), typing inidicators\n-- Overkill for just streaming AI response",
      "autoResize": true,
      "lineHeight": 1.25
    },
