    {
      "id": "IXerA01fUZFDMHf9nW0ik",
      "type": "text",
      "x": -546.5601343482587,
      "y": -1730.228422460891,
      "width": 802.0706176757812,
      "height": 154.64528244593237,
      "angle": 0,
      "strokeColor": "#e03131",
