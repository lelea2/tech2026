      "version": 660,
      "versionNonce": 1302248516,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786552068677,
      "link": null,
      "locked": false,
      "text": "-- React for UI component\n-- EventSource API for SSE connection\n-- State management (Redux, Zustand) for conversation\n-- Optimistic update (show user message immediately)\n-- Error handling network failure/rate limits\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- React for UI component\n-- EventSource API for SSE connection\n-- State management (Redux, Zustand) for conversation\n-- Optimistic update (show user message immediately)\n-- Error handling network failure/rate limits\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Riz---2oTB7bdDm5gxU02",
      "type": "text",
      "x": 200.32522866267087,
      "y": 1845.6153132503562,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
