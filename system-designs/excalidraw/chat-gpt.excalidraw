      "text": "**** MediaSource API (URL.createObjectURL() for video source creation)\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**** MediaSource API (URL.createObjectURL() for video source creation)\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "D6FdMWOKMzUzkBsQwDfyB",
      "type": "rectangle",
      "x": 232.97006331862792,
      "y": 3015.4030482032194,
      "width": 826.9333385858355,
      "height": 873.2394462626908,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b39",
      "roundness": {
        "type": 3
      },
      "seed": 524755734,
      "version": 183,
