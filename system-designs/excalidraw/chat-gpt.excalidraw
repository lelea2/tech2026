    {
      "id": "HG_TWsmiVA7E9dOkwkN55",
      "type": "text",
      "x": -506.94241362084995,
      "y": 3977.4278206914055,
      "width": 1662.638916015625,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
