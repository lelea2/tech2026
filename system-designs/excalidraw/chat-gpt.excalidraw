    {
      "id": "AKlvPm_4nGQVw-UAB1VgH",
      "type": "text",
      "x": 1744.5574731601187,
      "y": 2327.0172988312843,
      "width": 533.4395751953125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b45",
      "roundness": null,
      "seed": 257350538,
      "version": 872,
      "versionNonce": 2131622852,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786552969778,
      "link": null,
      "locked": false,
      "text": "MongoDB?? (NoSQL)\n** Pros:\n-- Built-in sharding\n-- Schema flexibility\n-- Good for write-heavy workloads\n** Cons\n-- Eventual consistency\n-- Less mature for analytical queries\n-- Message order is critical for chat app like ChatGPT",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MongoDB?? (NoSQL)\n** Pros:\n-- Built-in sharding\n-- Schema flexibility\n-- Good for write-heavy workloads\n** Cons\n-- Eventual consistency\n-- Less mature for analytical queries\n-- Message order is critical for chat app like ChatGPT",
      "autoResize": true,
      "lineHeight": 1.25
    },
