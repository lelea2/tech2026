      "seed": 1207213692,
      "version": 218,
      "versionNonce": 653529980,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786551510843,
      "link": null,
      "locked": false,
      "text": "POST /chats/{chatId}/messages -> { runId }\nBody: {\n  content\n}\n\n// Generate SSE token, keep the stream of GET\nGET /chats/{chatId}/runs/{runId}/stream -> Message tokens (SSE)\n\n// List of chats, list of messages\nGET /chats?cursor={cursor}&limit={n} -> Chat[]\nGET /chats/{chatId}/messages?cursor={cursor}&limit={n} -> Message[]\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /chats/{chatId}/messages -> { runId }\nBody: {\n  content\n}\n\n// Generate SSE token, keep the stream of GET\nGET /chats/{chatId}/runs/{runId}/stream -> Message tokens (SSE)\n\n// List of chats, list of messages\nGET /chats?cursor={cursor}&limit={n} -> Chat[]\nGET /chats/{chatId}/messages?cursor={cursor}&limit={n} -> Message[]\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
