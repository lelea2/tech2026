      "isDeleted": false,
      "boundElements": [],
      "updated": 1784144242148,
      "link": null,
      "locked": false,
      "text": "CORE ENTITIES\n\nTenant — policy profile, model policy\nUser — roles, scopes, tenant\nConversation — user-visible thread\nMessage — user / assistant / tool\nAgentRun — lifecycle and versions\nAgentStep — plan, retrieve, tool, approval, response\nToolDefinition — schema, risk, scopes, version\nApprovalRequest — preview and decision\nAuditEvent — actor, action, target, payload hash",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CORE ENTITIES\n\nTenant — policy profile, model policy\nUser — roles, scopes, tenant\nConversation — user-visible thread\nMessage — user / assistant / tool\nAgentRun — lifecycle and versions\nAgentStep — plan, retrieve, tool, approval, response\nToolDefinition — schema, risk, scopes, version\nApprovalRequest — preview and decision\nAuditEvent — actor, action, target, payload hash",
      "autoResize": false,
      "lineHeight": 1.25
    },
