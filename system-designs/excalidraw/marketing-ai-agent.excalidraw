      "updated": 1784144243365,
      "link": null,
      "locked": false,
      "text": "POSSIBLE APIs\n\nPOST /v1/conversations\nPOST /v1/conversations/:id/messages\nGET  /v1/runs/:runId/events       (SSE)\nGET  /v1/runs/:runId\nPOST /v1/runs/:runId/cancel\nPOST /v1/runs/:runId/retry\nPOST /v1/approvals/:id/approve\nPOST /v1/approvals/:id/reject\nGET  /v1/tools\nPUT  /v1/tenants/:id/tool-policies",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POSSIBLE APIs\n\nPOST /v1/conversations\nPOST /v1/conversations/:id/messages\nGET  /v1/runs/:runId/events       (SSE)\nGET  /v1/runs/:runId\nPOST /v1/runs/:runId/cancel\nPOST /v1/runs/:runId/retry\nPOST /v1/approvals/:id/approve\nPOST /v1/approvals/:id/reject\nGET  /v1/tools\nPUT  /v1/tenants/:id/tool-policies",
      "autoResize": false,
      "lineHeight": 1.25
    },
