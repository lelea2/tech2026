    {
      "id": "r1uV_Uzt5cUmYQD2WLs5s",
      "type": "text",
      "x": 2531.432785238068,
      "y": 925.9807471966335,
      "width": 939.639404296875,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 2085124638,
      "version": 32,
      "versionNonce": 1383330050,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784146013646,
      "link": null,
      "locked": false,
      "text": "       // 1. Establish connection to the server's SSE endpoint\n        const eventSource = new EventSource('http://localhost:3000/events'); // server endpoint\n\n        const list = document.getElementById('events-list');\n\n        // 2. Listen for generic message events (sent without a specific event name)\n        eventSource.onmessage = function(event) {\n            const newElement = document.createElement('li');\n            newElement.textContent = `Generic message: ${event.data}`;\n            list.appendChild(newElement);\n        };\n\n        // 3. Listen for custom named events (e.g., \"flightState\" or \"scoreUpdate\")\n        eventSource.addEventListener('scoreUpdate', function(event) {\n            const newElement = document.createElement('li');\n            newElement.textContent = `Custom event (scoreUpdate): ${event.data}`;\n            list.appendChild(newElement);\n        });\n\n        // 4. Handle errors and connection drops\n        eventSource.onerror = function(error) {\n            console.error(\"SSE connection failed:\", error);\n            // The browser automatically attempts to reconnect by default\n        };",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "       // 1. Establish connection to the server's SSE endpoint\n        const eventSource = new EventSource('http://localhost:3000/events'); // server endpoint\n\n        const list = document.getElementById('events-list');\n\n        // 2. Listen for generic message events (sent without a specific event name)\n        eventSource.onmessage = function(event) {\n            const newElement = document.createElement('li');\n            newElement.textContent = `Generic message: ${event.data}`;\n            list.appendChild(newElement);\n        };\n\n        // 3. Listen for custom named events (e.g., \"flightState\" or \"scoreUpdate\")\n        eventSource.addEventListener('scoreUpdate', function(event) {\n            const newElement = document.createElement('li');\n            newElement.textContent = `Custom event (scoreUpdate): ${event.data}`;\n            list.appendChild(newElement);\n        });\n\n        // 4. Handle errors and connection drops\n        eventSource.onerror = function(error) {\n            console.error(\"SSE connection failed:\", error);\n            // The browser automatically attempts to reconnect by default\n        };",
      "autoResize": true,
      "lineHeight": 1.25
    },
