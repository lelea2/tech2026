      "seed": 254387128,
      "version": 2,
      "versionNonce": 1616614430,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784144233721,
      "link": null,
      "locked": false,
      "text": "DEEP DIVE: OBSERVABILITY + EVALUATION\n\nOps: TTFT, total latency, tool failure, cost/run.\nQuality: groundedness, citation correctness, task success.\nSafety: unauthorized-tool attempts, injection detection.\nBusiness: time saved, adoption, action completion.\nUse golden sets, trace replay, shadow traffic, canaries,\nA/B tests, and regression gates.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEEP DIVE: OBSERVABILITY + EVALUATION\n\nOps: TTFT, total latency, tool failure, cost/run.\nQuality: groundedness, citation correctness, task success.\nSafety: unauthorized-tool attempts, injection detection.\nBusiness: time saved, adoption, action completion.\nUse golden sets, trace replay, shadow traffic, canaries,\nA/B tests, and regression gates.",
      "autoResize": false,
      "lineHeight": 1.25
    },
