      "boundElements": null,
      "updated": 1784146189043,
      "link": null,
      "locked": false,
      "text": "// Server code for SSE\nconst express = require('express');\nconst cors = require('cors');\n\nconst app = express();\napp.use(cors()); // Allow cross-origin requests from your frontend\n\napp.get('/events', (req, res) => {\n    // 1. Set SSE-specific HTTP headers\n    res.writeHead(200, {\n        'Content-Type': 'text/event-stream',\n        'Cache-Control': 'no-cache',\n        'Connection': 'keep-alive'\n    });\n\n    // 2. Send an initial ping or message immediately\n    res.write('data: Connected to event stream\\n\\n');\n\n    // 3. Send generic updates periodically (Every 3 seconds)\n    const genericInterval = setInterval(() => {\n        const time = new Date().toLocaleTimeString();\n        // SSE payload format MUST start with \"data: \" and end with \"\\n\\n\"\n        res.write(`data: The current server time is ${time}\\n\\n`);\n    }, 3000);\n\n    // 4. Send a named custom event periodically (Every 5 seconds)\n    const customInterval = setInterval(() => {\n        const score = Math.floor(Math.random() * 10);\n        // Custom events require an \"event: eventName\\n\" line before the data line\n        res.write(`event: scoreUpdate\\n`);\n        res.write(`data: Team A score is now ${score}\\n\\n`);\n    }, 5000);\n\n    // 5. Clean up when the client closes the connection\n    req.on('close', () => {\n        clearInterval(genericInterval);\n        clearInterval(customInterval);\n        res.end();\n        console.log('Client closed connection.');\n    });\n});\n\napp.listen(3000, () => {\n    console.log('SSE Server running on http://localhost:3000');\n});\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Server code for SSE\nconst express = require('express');\nconst cors = require('cors');\n\nconst app = express();\napp.use(cors()); // Allow cross-origin requests from your frontend\n\napp.get('/events', (req, res) => {\n    // 1. Set SSE-specific HTTP headers\n    res.writeHead(200, {\n        'Content-Type': 'text/event-stream',\n        'Cache-Control': 'no-cache',\n        'Connection': 'keep-alive'\n    });\n\n    // 2. Send an initial ping or message immediately\n    res.write('data: Connected to event stream\\n\\n');\n\n    // 3. Send generic updates periodically (Every 3 seconds)\n    const genericInterval = setInterval(() => {\n        const time = new Date().toLocaleTimeString();\n        // SSE payload format MUST start with \"data: \" and end with \"\\n\\n\"\n        res.write(`data: The current server time is ${time}\\n\\n`);\n    }, 3000);\n\n    // 4. Send a named custom event periodically (Every 5 seconds)\n    const customInterval = setInterval(() => {\n        const score = Math.floor(Math.random() * 10);\n        // Custom events require an \"event: eventName\\n\" line before the data line\n        res.write(`event: scoreUpdate\\n`);\n        res.write(`data: Team A score is now ${score}\\n\\n`);\n    }, 5000);\n\n    // 5. Clean up when the client closes the connection\n    req.on('close', () => {\n        clearInterval(genericInterval);\n        clearInterval(customInterval);\n        res.end();\n        console.log('Client closed connection.');\n    });\n});\n\napp.listen(3000, () => {\n    console.log('SSE Server running on http://localhost:3000');\n});\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
