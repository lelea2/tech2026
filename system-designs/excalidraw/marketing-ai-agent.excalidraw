    {
      "id": "a70c3528be5e4f16",
      "type": "text",
      "x": 52,
      "y": 1879.875,
      "width": 2336,
      "height": 137.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
