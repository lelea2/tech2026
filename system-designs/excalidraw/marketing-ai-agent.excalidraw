      "seed": 42447580,
      "version": 4,
      "versionNonce": 192772290,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784144246924,
      "link": null,
      "locked": false,
      "text": "ROLLOUT STRATEGY\n\nPhase 1: Read-only Q&A with citations  →  Phase 2: Recommendations and previews  →  Phase 3: Low-risk approved writes  →  Phase 4: High-impact workflows with stronger policy and dual approval\n\nStaff signal: treat this as a secure workflow platform with an AI planner—not as a chatbot with unrestricted API access.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROLLOUT STRATEGY\n\nPhase 1: Read-only Q&A with citations  →  Phase 2: Recommendations and previews  →  Phase 3: Low-risk approved writes  →  Phase 4: High-impact workflows with stronger policy and dual approval\n\nStaff signal: treat this as a secure workflow platform with an AI planner—not as a chatbot with unrestricted API access.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "jKU6FD19R2MR_ovlNaXX_",
      "type": "text",
