    {
      "id": "293e8ff947fb4c68",
      "type": "text",
      "x": 852,
      "y": 1460,
      "width": 736,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1068737582,
      "version": 2,
      "versionNonce": 248725470,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784144233721,
      "link": null,
      "locked": false,
      "text": "DEEP DIVE: RELIABILITY\n\nPersist each run and step.\nResume after worker crashes.\nRetry only idempotent operations.\nIf tool status is unknown, query by idempotency key.\nReconnect clients with runId + last event sequence.\nExpire stale approvals and recompute previews.\nLimit max steps, wall time, tokens, and tool repetition.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEEP DIVE: RELIABILITY\n\nPersist each run and step.\nResume after worker crashes.\nRetry only idempotent operations.\nIf tool status is unknown, query by idempotency key.\nReconnect clients with runId + last event sequence.\nExpire stale approvals and recompute previews.\nLimit max steps, wall time, tokens, and tool repetition.",
      "autoResize": false,
      "lineHeight": 1.25
    },
