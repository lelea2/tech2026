      "isDeleted": false,
      "boundElements": [],
      "updated": 1782321357748,
      "link": null,
      "locked": false,
      "text": "Requirements\n\nFunctional\n• Send messages to agent\n• Preserve full history\n• Fetch current + audit views\n• Rollback conversation/code\n• Compact old context\n• Async multi-agent work\n\nNon-functional\n• Durable audit log\n• Low-latency writes/reads\n• Correct concurrent mutations\n• Idempotent workflows",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Requirements\n\nFunctional\n• Send messages to agent\n• Preserve full history\n• Fetch current + audit views\n• Rollback conversation/code\n• Compact old context\n• Async multi-agent work\n\nNon-functional\n• Durable audit log\n• Low-latency writes/reads\n• Correct concurrent mutations\n• Idempotent workflows",
      "lineHeight": 1.25,
      "index": "a2",
      "autoResize": true
    },
