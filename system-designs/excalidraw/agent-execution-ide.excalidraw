      "link": null,
      "locked": false,
      "text": "Core Entities\n\nConversationHead\nchatId, headVersion, visibleStartVersion, latestCommitId, status\n\nConversationEvents\nchatId, version, eventType, payloadRef, commitId, parentVersion, visibility\n\nWorkflowState\noperationId, type, status, targetVersion\n\nWorkspaceMetadata\nworkspaceId, currentCommitId, runtimeStatus",
      "fontSize": 18,
      "fontFamily": 1,
