    {
      "id": "dataflow_text",
      "type": "text",
      "x": 597.94921875,
      "y": -789.875,
      "width": 613.3316650390625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1303194355,
      "version": 133,
      "versionNonce": 1633164847,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782321458395,
      "link": null,
      "locked": false,
      "text": "Dataflow\n\nNew message\n1. check expectedVersion\n2. append USER_MESSAGE\n3. update head\n4. publish Kafka job\n5. agent appends response/commit\n\nRollback\nvalidate target → Git revert → append ROLLBACK → update head\n\nCompaction\nsummarize range → S3 → append COMPACT → update head",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Dataflow\n\nNew message\n1. check expectedVersion\n2. append USER_MESSAGE\n3. update head\n4. publish Kafka job\n5. agent appends response/commit\n\nRollback\nvalidate target → Git revert → append ROLLBACK → update head\n\nCompaction\nsummarize range → S3 → append COMPACT → update head",
      "lineHeight": 1.25,
      "index": "a8",
      "autoResize": true
    },
    {
      "id": "deep_dives",
      "type": "rectangle",
      "x": 860,
      "y": -420,
      "width": 420,
