    {
      "id": "deep_dives_text",
      "type": "text",
      "x": -805.90625,
      "y": 813.9140625,
      "width": 351.32379150390625,
      "height": 382.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1645223192,
      "version": 189,
      "versionNonce": 1428649281,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782321498940,
      "link": null,
      "locked": false,
      "text": "Deep Dives\n\n1. Optimistic concurrency\nheadVersion gates every mutation\n\n2. Git + DB saga\nnot atomic; use WorkflowState, retries,\nreconciliation\n\n3. Stale agent writes\nconditional write fails after rollback\n\n4. Compaction\nsummary is additive, never destructive\n\n5. Hot chat partitions\nshard only if needed",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Deep Dives\n\n1. Optimistic concurrency\nheadVersion gates every mutation\n\n2. Git + DB saga\nnot atomic; use WorkflowState, retries, reconciliation\n\n3. Stale agent writes\nconditional write fails after rollback\n\n4. Compaction\nsummary is additive, never destructive\n\n5. Hot chat partitions\nshard only if needed",
      "lineHeight": 1.25,
      "index": "aA",
      "autoResize": true
    },
