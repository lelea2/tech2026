      "updated": 1782321407027,
      "link": null,
      "locked": false,
      "text": "APIs\n\nPOST /messages\n{ message, expectedVersion,\nidempotencyKey }\n\nGET /conversations/{id}?view=current\nGET /conversations/{id}?view=audit\n\nPOST /rollback\n{ targetVersion, rollbackCode,\nexpectedVersion }\n\nPOST /compact\n{ upToVersion, expectedVersion }",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "APIs\n\nPOST /messages\n{ message, expectedVersion, idempotencyKey }\n\nGET /conversations/{id}?view=current\nGET /conversations/{id}?view=audit\n\nPOST /rollback\n{ targetVersion, rollbackCode, expectedVersion }\n\nPOST /compact\n{ upToVersion, expectedVersion }",
      "lineHeight": 1.25,
      "index": "a6",
      "autoResize": true
    },
