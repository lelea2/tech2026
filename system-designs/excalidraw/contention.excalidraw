    },
    {
      "id": "w5RnREyVAYKBR9ITlQPLb",
      "type": "text",
      "x": -317.14867270231895,
      "y": 2240.9856366198724,
      "width": 449.73583984375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2e",
      "roundness": null,
      "seed": 651898749,
      "version": 138,
      "versionNonce": 610470931,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785538497175,
      "link": null,
      "locked": false,
      "text": "1. Pulling via polling\n2. Pushing via consistent hashes\n3. Pushing via Pub/sub",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Pulling via polling\n2. Pushing via consistent hashes\n3. Pushing via Pub/sub",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "otr_BQIpRISRg-3P-rhni",
      "type": "text",
      "x": 287.0545645483446,
      "y": 2219.61005333701,
      "width": 645.0358276367188,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2f",
      "roundness": null,
      "seed": 40868851,
      "version": 218,
      "versionNonce": 271692445,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785538497175,
      "link": null,
      "locked": false,
      "text": "** Pulling via polling **\nAdvantage\n* Simple, state constrained in DB\nDisadvantage\n* High latency\n* Excess DB load when update are infrequent, \nand polling is frequent",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** Pulling via polling **\nAdvantage\n* Simple, state constrained in DB\nDisadvantage\n* High latency\n* Excess DB load when update are infrequent, \nand polling is frequent",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "THN6aJKCGwuo2T8vYrrjS",
