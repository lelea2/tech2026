    {
      "id": "_EVW5AuoNr3KCDzp8kie9",
      "type": "text",
      "x": -602.0877610442285,
      "y": -27113.69107790961,
      "width": 577.2155151367188,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b33",
      "roundness": null,
      "seed": 424937843,
      "version": 68,
      "versionNonce": 1342406621,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785540377758,
      "link": null,
      "locked": false,
      "text": "// Booking -- \"decrement count only if a seat is left\"\nBEGIN TRANSACTION;\n\nWITH reservation AS (\n  UPDATE concerts\n  SET available_seats = available_seats - 1\n  WHERE concert_id = 'weeknd_tour'\n    AND available_seats > 0\n  RETURNING concert_id\n)\nINSERT INTO tickets (user_id, concert_id, seat_number, purchase_time)\nSELECT 'user123', concert_id, 'A15', NOW()\nFROM reservation;\n\nCOMMIT;",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Booking -- \"decrement count only if a seat is left\"\nBEGIN TRANSACTION;\n\nWITH reservation AS (\n  UPDATE concerts\n  SET available_seats = available_seats - 1\n  WHERE concert_id = 'weeknd_tour'\n    AND available_seats > 0\n  RETURNING concert_id\n)\nINSERT INTO tickets (user_id, concert_id, seat_number, purchase_time)\nSELECT 'user123', concert_id, 'A15', NOW()\nFROM reservation;\n\nCOMMIT;",
      "autoResize": true,
      "lineHeight": 1.25
    },
