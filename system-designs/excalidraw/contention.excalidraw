    {
      "id": "DjY92I7RcD6SUrNLFo7oK",
      "type": "text",
      "x": 89.38198507474567,
      "y": -26465.288677588163,
      "width": 816.767333984375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3H",
      "roundness": null,
      "seed": 92988627,
      "version": 430,
      "versionNonce": 130692253,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785554822327,
      "link": null,
      "locked": false,
      "text": "- Common failure:\n* Locking too much, for too long: lock row, not whole table, hold only for milisecond.\nThe worst offender can be slow I/O\n* Deadlocks from inconsistent ordering: 2 transactions that grab same rows\nin opposite orders will deadlock => always lock in consistent order (eg: sorted by Id so cycle can't form)\n\n ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Common failure:\n* Locking too much, for too long: lock row, not whole table, hold only for milisecond.\nThe worst offender can be slow I/O\n* Deadlocks from inconsistent ordering: 2 transactions that grab same rows\nin opposite orders will deadlock => always lock in consistent order (eg: sorted by Id so cycle can't form)\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
