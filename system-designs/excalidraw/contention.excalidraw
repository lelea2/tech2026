    {
      "id": "UIlD5BCo9Vdc_IItG6Frg",
      "type": "text",
      "x": 1037.0186997447197,
      "y": 1027.245352401449,
      "width": 352.9197998046875,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
