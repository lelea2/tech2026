      "isDeleted": false,
      "boundElements": null,
      "updated": 1785567830591,
      "link": null,
      "locked": false,
      "text": "// Update database column\nUPDATE seats\nSET reserved_by = 'user123', reserved_until = NOW() + INTERVAL '10 minutes'\nWHERE seat_id = 'A15'\n  AND (reserved_until IS NULL OR reserved_until < NOW());",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Update database column\nUPDATE seats\nSET reserved_by = 'user123', reserved_until = NOW() + INTERVAL '10 minutes'\nWHERE seat_id = 'A15'\n  AND (reserved_until IS NULL OR reserved_until < NOW());",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CzZZQ0KZXnNBNwb6U-M6O",
      "type": "rectangle",
      "x": -675.9724383740172,
      "y": -25268.800211854872,
      "width": 676.7898845368131,
      "height": 135.7961049800797,
      "angle": 0,
      "strokeColor": "#2f9e44",
