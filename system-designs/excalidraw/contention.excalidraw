    {
      "id": "CTOlmrdtDuUkm0LY_V4tR",
      "type": "text",
      "x": -644.9748285977737,
      "y": -25690.438617067313,
      "width": 477.6156005859375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3S",
      "roundness": null,
      "seed": 183349309,
      "version": 3,
      "versionNonce": 1487045885,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785558141059,
      "link": null,
      "locked": false,
      "text": "BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE;\n\n-- Is anyone else on call right now?\nSELECT count(*) FROM on_call\nWHERE team_id = 'payments'\n  AND is_active = true;\n\n-- App sees 2, decides it's safe to step down, then writes:\nUPDATE on_call\nSET is_active = false\nWHERE engineer_id = 'alice';\n\nCOMMIT;\n-- If Bob's transaction made the same decision concurrently,\n-- one of the two commits aborts with a serialization error.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BEGIN TRANSACTION ISOLATION LEVEL SERIALIZABLE;\n\n-- Is anyone else on call right now?\nSELECT count(*) FROM on_call\nWHERE team_id = 'payments'\n  AND is_active = true;\n\n-- App sees 2, decides it's safe to step down, then writes:\nUPDATE on_call\nSET is_active = false\nWHERE engineer_id = 'alice';\n\nCOMMIT;\n-- If Bob's transaction made the same decision concurrently,\n-- one of the two commits aborts with a serialization error.",
      "autoResize": true,
      "lineHeight": 1.25
    },
