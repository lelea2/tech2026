    {
      "id": "m9-Ktr_8_vFiC2n0LevuR",
      "type": "text",
      "x": -619.0227363907409,
      "y": -26227.391176011504,
      "width": 516.1184551153209,
      "height": 380.599107019465,
      "angle": 0,
