    },
    {
      "id": "ICba_d956hbbpYccNOkjT",
      "type": "text",
      "x": -544.0687308023091,
      "y": -27504.318383665897,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
