    {
      "id": "EPnPHdZsvwr14DfquRNR2",
      "type": "text",
      "x": 103.9696278089782,
      "y": -25696.496973103025,
      "width": 1187.59912109375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3W",
      "roundness": null,
      "seed": 300931773,
      "version": 101,
      "versionNonce": 1300015859,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785558459275,
      "link": null,
      "locked": false,
      "text": "- 2 transactions each read an overlapping set of rows, each makes a decision that's perfectly valid on its own, and only together do they break a rule. \nBecause no single row collides, a conditional UPDATE, a row lock, and a version check all sail straight through. This is called write skew.\n- Isolation level control how much one transaction can see of another's inflight work\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 2 transactions each read an overlapping set of rows, each makes a decision that's perfectly valid on its own, and only together do they break a rule. \nBecause no single row collides, a conditional UPDATE, a row lock, and a version check all sail straight through. This is called write skew.\n- Isolation level control how much one transaction can see of another's inflight work\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
