      "seed": 378665213,
      "version": 256,
      "versionNonce": 1209399677,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785557833134,
      "link": null,
      "locked": false,
      "text": "- It assumes conflicts are rare and detects them after the fact instead of blocking to prevent them\n- It's protecting the same gap between read/write, \n- Use version number, dedicate the version bumped in every write\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- It assumes conflicts are rare and detects them after the fact instead of blocking to prevent them\n- It's protecting the same gap between read/write, \n- Use version number, dedicate the version bumped in every write\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
