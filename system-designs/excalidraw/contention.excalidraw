    {
      "id": "925H7fotbKo76S-WqaEVk",
      "type": "text",
      "x": -622.094323196615,
      "y": -26687.551304063774,
      "width": 586.383544921875,
      "height": 320,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3A",
      "roundness": null,
      "seed": 1315747155,
      "version": 5,
      "versionNonce": 57550557,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785554362285,
      "link": null,
      "locked": false,
      "text": "BEGIN TRANSACTION;\n\n-- Lock the open seats in this section while we pick a block\nSELECT seat_number FROM seats\nWHERE concert_id = 'weeknd_tour'\n  AND section = 'floor'\n  AND status = 'available'\nFOR UPDATE;\n\n-- App scans the result, finds A15-A18 open and adjacent, then claims them\nUPDATE seats\nSET status = 'sold', user_id = 'user123'\nWHERE concert_id = 'weeknd_tour'\n  AND seat_number IN ('A15', 'A16', 'A17', 'A18');\n\nCOMMIT;",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BEGIN TRANSACTION;\n\n-- Lock the open seats in this section while we pick a block\nSELECT seat_number FROM seats\nWHERE concert_id = 'weeknd_tour'\n  AND section = 'floor'\n  AND status = 'available'\nFOR UPDATE;\n\n-- App scans the result, finds A15-A18 open and adjacent, then claims them\nUPDATE seats\nSET status = 'sold', user_id = 'user123'\nWHERE concert_id = 'weeknd_tour'\n  AND seat_number IN ('A15', 'A16', 'A17', 'A18');\n\nCOMMIT;",
      "autoResize": true,
      "lineHeight": 1.25
    },
