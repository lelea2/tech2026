      "link": null,
      "locked": false,
      "text": "Core entities\n-- Events\n-- Users\n-- Venues: view and search by venue\n-- Performers: so can view and search by performers\n-- Ticket: inidividual ticket for event\n-- Booking: record of details for ticket purchases (include\nstatus of booking -- inprogress/confirm/etc)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core entities\n-- Events\n-- Users\n-- Venues: view and search by venue\n-- Performers: so can view and search by performers\n-- Ticket: inidividual ticket for event\n-- Booking: record of details for ticket purchases (include\nstatus of booking -- inprogress/confirm/etc)",
      "autoResize": true,
