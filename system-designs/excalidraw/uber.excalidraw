      "link": null,
      "locked": false,
      "text": "* POST /fare -> Fare\nBody: {\n  pickupLocation, \n  destination\n}\n// request ride\nPOST /rides -> Ride\nBody: {\n  fareId\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* POST /fare -> Fare\nBody: {\n  pickupLocation, \n  destination\n}\n// request ride\nPOST /rides -> Ride\nBody: {\n  fareId\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oVVnYZ7O8PvY7HcmNOO3i",
      "type": "text",
      "x": 304.50390625,
      "y": 782.20703125,
      "width": 511.6396179199219,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 1098610020,
      "version": 258,
      "versionNonce": 632338148,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782315666252,
      "link": null,
      "locked": false,
      "text": "// update driver location\nPOST /drivers/location -> Success/Error\nBody: {\n        lat, long\n    }\n\n- note the driverId is present in the session cookie \nor JWT and not in the body or path params\n\n// drive accept/deny the ride\nPATCH /rides/:rideId -> Ride\nBody: {\n  accept/deny\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// update driver location\nPOST /drivers/location -> Success/Error\nBody: {\n        lat, long\n    }\n\n- note the driverId is present in the session cookie \nor JWT and not in the body or path params\n\n// drive accept/deny the ride\nPATCH /rides/:rideId -> Ride\nBody: {\n  accept/deny\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
