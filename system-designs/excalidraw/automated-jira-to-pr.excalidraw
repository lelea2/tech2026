      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SHARED PLATFORM\n\nPostgreSQL \u2014 run metadata + uniqueness    |    Object Storage \u2014 plans/patches/logs    |    Secrets Broker \u2014 short-lived scoped creds\nRedis \u2014 rate limits/transient cache       |    Kafka/PubSub \u2014 analytics/fan-out        |    OpenTelemetry + immutable audit",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "SHARED PLATFORM\n\nPostgreSQL \u2014 run metadata + uniqueness    |    Object Storage \u2014 plans/patches/logs    |    Secrets Broker \u2014 short-lived scoped creds\nRedis \u2014 rate limits/transient cache       |    Kafka/PubSub \u2014 analytics/fan-out        |    OpenTelemetry + immutable audit",
      "lineHeight": 1.25
    },
