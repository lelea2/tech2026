      "text": "API\n// Create job\nPOST /jobs\n{\n  \"task_id\": \"send_email\",\n  \"schedule\": \"0 10 * * *\",\n  \"parameters\": {\n    \"to\": \"john@example.com\",\n    \"subject\": \"Daily Report\"\n  }\n}",
