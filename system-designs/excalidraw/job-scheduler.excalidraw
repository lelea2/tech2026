    {
      "id": "3hG1EOSeDqOAnDy9KVf38",
      "type": "text",
      "x": 242.85546875,
      "y": 155.74609375,
      "width": 591.2195434570312,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b32",
      "roundness": null,
      "seed": 1081799854,
      "version": 385,
      "versionNonce": 1111300658,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782249400937,
      "link": null,
      "locked": false,
      "text": "Functional\n-- users can schedule jobs for future or immediate execution\n-- user can query for their job status\n\nNon-functional\n-- Availability > consistency\n-- execute jobs within 2s of their scheduled time\n-- scalable to support up to 10k jobs / sec\n-- ensure at least once execution of jobs\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional\n-- users can schedule jobs for future or immediate execution\n-- user can query for their job status\n\nNon-functional\n-- Availability > consistency\n-- execute jobs within 2s of their scheduled time\n-- scalable to support up to 10k jobs / sec\n-- ensure at least once execution of jobs\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
