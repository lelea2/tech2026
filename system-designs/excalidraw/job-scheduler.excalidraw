    },
    {
      "id": "KhUJSNEoeHvGNTeNX7ACQ",
      "type": "text",
      "x": 1046,
      "y": 967.5,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3I",
      "roundness": null,
      "seed": 678020398,
      "version": 3,
      "versionNonce": 6345134,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1782250215833,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 20,
      "fontFamily": 5,
