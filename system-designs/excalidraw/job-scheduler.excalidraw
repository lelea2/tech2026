    {
      "id": "TuKrwLEs8Am-9LVu4vwDw",
      "type": "text",
      "x": 1019,
      "y": 175.5,
      "width": 943.29931640625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3F",
      "roundness": null,
      "seed": 2129606382,
      "version": 293,
      "versionNonce": 1776105010,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782250179713,
      "link": null,
      "locked": false,
      "text": "** potential execution status: COMPLETE, FAILED, IN_PROGRESS, RETRYING\n** to query for all job_ids for given user \n -- we'll add a Global Secondary Index (GSI) on the Executions table:\n  * Partition Key: user_id\n  * Sort Key: execution_time + job_id\n--> add some write overhead and cost, but it's worthy tradeoff to support efficient user query \n(using dynamo DB) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** potential execution status: COMPLETE, FAILED, IN_PROGRESS, RETRYING\n** to query for all job_ids for given user \n -- we'll add a Global Secondary Index (GSI) on the Executions table:\n  * Partition Key: user_id\n  * Sort Key: execution_time + job_id\n--> add some write overhead and cost, but it's worthy tradeoff to support efficient user query \n(using dynamo DB) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
