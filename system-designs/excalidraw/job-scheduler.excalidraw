    {
      "id": "FP3OPQdnIyNeXYpxHcZwA",
      "type": "text",
      "x": 176.0859375,
      "y": 1194.58203125,
      "width": 714.7994995117188,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3C",
      "roundness": null,
      "seed": 1924833074,
      "version": 140,
      "versionNonce": 2003115250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782249718347,
      "link": null,
      "locked": false,
      "text": "1/ A user schedules a job by providing the task to be executed, \nthe schedule for when the task should be executed, \nand the parameters needed to execute the task.\n2/ The job is persisted in the system.\n3/ The job is picked up by a worker and executed at the scheduled time.\n-- If the job fails, it is retried with exponential backoff.\n4/ Update the job status in the system.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1/ A user schedules a job by providing the task to be executed, \nthe schedule for when the task should be executed, \nand the parameters needed to execute the task.\n2/ The job is persisted in the system.\n3/ The job is picked up by a worker and executed at the scheduled time.\n-- If the job fails, it is retried with exponential backoff.\n4/ Update the job status in the system.",
      "autoResize": true,
      "lineHeight": 1.25
    },
