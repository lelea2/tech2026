    {
      "id": "eQeHg5jNp5wYXfuR6wdop",
      "type": "text",
      "x": 1178.44921875,
      "y": 1855.1015625,
      "width": 985.2192993164062,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2u",
      "roundness": null,
      "seed": 429486002,
      "version": 104,
      "versionNonce": 421668078,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1782248392484,
      "link": null,
      "locked": false,
      "text": "Steps to follow:\n1. Fetch the robots.txt file for the domain.\n2. Parse the robots.txt file and store it in the Metadata DB.\n3. When we pull a URL off the queue, check the rules stored in the Metadata DB for that domain.\n4. If the URL is disallowed, ack the message and move on to the next URL.\n5. If the URL is allowed, check the Crawl-delay directive.\n6. If the Crawl-delay time has not passed since the last crawl, \nuse ChangeMessageVisibility to extend the visibility timeout and defer reprocessing.\n7. If the Crawl-delay time has passed, crawl the page and update the last crawl time for the domain.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Steps to follow:\n1. Fetch the robots.txt file for the domain.\n2. Parse the robots.txt file and store it in the Metadata DB.\n3. When we pull a URL off the queue, check the rules stored in the Metadata DB for that domain.\n4. If the URL is disallowed, ack the message and move on to the next URL.\n5. If the URL is allowed, check the Crawl-delay directive.\n6. If the Crawl-delay time has not passed since the last crawl, \nuse ChangeMessageVisibility to extend the visibility timeout and defer reprocessing.\n7. If the Crawl-delay time has passed, crawl the page and update the last crawl time for the domain.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
