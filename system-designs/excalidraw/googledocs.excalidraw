    {
      "id": "yD7f2qEdCSfwOwvlyjPL2",
      "type": "text",
      "x": 169.44506498535293,
      "y": 2709.5117751361595,
      "width": 290.85980224609375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
