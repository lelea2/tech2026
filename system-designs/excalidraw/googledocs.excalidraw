    {
      "id": "IUyHfL4Od-_OrkrlKEgHA",
      "type": "text",
      "x": 238.10546875,
      "y": 1077.5859375,
      "width": 359.9397277832031,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1s",
