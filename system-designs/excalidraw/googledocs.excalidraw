    {
      "id": "MZTJirf3JhRcG9tJsJMAt",
      "type": "text",
      "x": 213.07543936123398,
      "y": 2057.9428370994724,
      "width": 301.15985107421875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b27",
