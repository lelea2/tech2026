      "seed": 1202511398,
      "version": 925,
      "versionNonce": 95766438,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786907366450,
      "link": null,
      "locked": false,
      "text": "- 1 way update from server, SSE establish persistent connections\nthat allow server to push live pirce changes to clients instantly. \n- Require API to have /subscribe GET request with query\nparameter contains symbol of stock instead\n- Challenges:\n-- Load balancer will need to be configured to support \"sticky\nsession\", so user and server can maintain connection to promote\ndata transfer\n- Discuss on how connect/reconnect/disconnect will work\n ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 1 way update from server, SSE establish persistent connections that allow server to push live pirce changes to clients instantly. \n- Require API to have /subscribe GET request with query parameter contains symbol of stock instead\n- Challenges:\n-- Load balancer will need to be configured to support \"sticky session\", so user and server can maintain connection to promote data transfer\n- Discuss on how connect/reconnect/disconnect will work\n ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "JHDQRhvid_CGCEdlT8FkT",
      "type": "text",
      "x": 1653.5222240543574,
      "y": 77.74105936089325,
      "width": 246.95499470796642,
      "height": 614.5357072504022,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bw1",
      "roundness": null,
      "seed": 387899878,
      "version": 449,
      "versionNonce": 1326745126,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786908093126,
      "link": null,
      "locked": false,
      "text": "import { useEffect, useState } from \"react\";\n\nfunction StockPrice({ symbol = \"AAPL\" }) {\n  const [stock, setStock] = useState(null);\n  const [status, setStatus] = useState(\"connecting\");\n\n  useEffect(() => {\n    const eventSource = new EventSource(\n      `/api/stocks/stream?symbol=${symbol}`\n    );\n\n    eventSource.onopen = () => {\n      setStatus(\"connected\");\n    };\n\n    eventSource.onmessage = (event) => {\n      const data = JSON.parse(event.data);\n\n      // Example:\n      // {\n      //   symbol: \"AAPL\",\n      //   price: 231.45,\n      //   timestamp: 1786915920000\n      // }\n\n      setStock(data);\n    };\n\n    eventSource.onerror = () => {\n      setStatus(\"reconnecting\");\n\n      // Don't normally close here.\n      // EventSource automatically reconnects.\n    };\n\n    return () => {\n      eventSource.close();\n    };\n  }, [symbol]);\n\n  return (\n    <div>\n      <div>Status: {status}</div>\n\n      {stock && (\n        <>\n          <h3>{stock.symbol}</h3>\n          <strong>${stock.price.toFixed(2)}</strong>\n        </>\n      )}\n    </div>\n  );\n}",
      "fontSize": 9.276010675477766,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import { useEffect, useState } from \"react\";\n\nfunction StockPrice({ symbol = \"AAPL\" }) {\n  const [stock, setStock] = useState(null);\n  const [status, setStatus] = useState(\"connecting\");\n\n  useEffect(() => {\n    const eventSource = new EventSource(\n      `/api/stocks/stream?symbol=${symbol}`\n    );\n\n    eventSource.onopen = () => {\n      setStatus(\"connected\");\n    };\n\n    eventSource.onmessage = (event) => {\n      const data = JSON.parse(event.data);\n\n      // Example:\n      // {\n      //   symbol: \"AAPL\",\n      //   price: 231.45,\n      //   timestamp: 1786915920000\n      // }\n\n      setStock(data);\n    };\n\n    eventSource.onerror = () => {\n      setStatus(\"reconnecting\");\n\n      // Don't normally close here.\n      // EventSource automatically reconnects.\n    };\n\n    return () => {\n      eventSource.close();\n    };\n  }, [symbol]);\n\n  return (\n    <div>\n      <div>Status: {status}</div>\n\n      {stock && (\n        <>\n          <h3>{stock.symbol}</h3>\n          <strong>${stock.price.toFixed(2)}</strong>\n        </>\n      )}\n    </div>\n  );\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
