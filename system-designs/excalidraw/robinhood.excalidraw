    {
      "id": "jgoBUPe2Yt15f0AF31Vi-",
      "type": "text",
      "x": 913.90234375,
      "y": 195.97265625,
      "width": 671.0911865234375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
