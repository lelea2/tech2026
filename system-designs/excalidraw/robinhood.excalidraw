    {
      "id": "lf3Bnb_zwgU1N5KNp1cYl",
      "type": "text",
      "x": 891.5385748732859,
      "y": 1870.6058479215058,
      "width": 798.2594604492188,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bwG",
      "roundness": null,
      "seed": 2133844026,
      "version": 465,
      "versionNonce": 1816289658,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786909558370,
      "link": null,
      "locked": false,
      "text": "Flow:\n1. STore order with PENDNING status. \n2. Submit order to exchange and get back externalOrderId (order_id, user_id)\n3. Write externalOrderId to key-value DB and update order status to submitted.\n\nPossible failure\n1. Failure storing order\n2. Failure submitting order to exchange\n3. Failure procssing order after exchange submission",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flow:\n1. STore order with PENDNING status. \n2. Submit order to exchange and get back externalOrderId (order_id, user_id)\n3. Write externalOrderId to key-value DB and update order status to submitted.\n\nPossible failure\n1. Failure storing order\n2. Failure submitting order to exchange\n3. Failure procssing order after exchange submission",
      "autoResize": true,
      "lineHeight": 1.25
    },
