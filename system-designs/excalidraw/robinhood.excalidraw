      "link": null,
      "locked": false,
      "text": "POST /order\nRequest: {\n  position: \"buy\",\n  symbol: \"META\",\n  priceInCents: 52210,\n  numShares: 10\n}\nResponse: Order\n\n// Cancel and order\nDELETE /order/:id\nResponse: {\n  ok: true\n}\n\n// List all orders\nGET /orders\nResponse: Order[] (paginated)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /order\nRequest: {\n  position: \"buy\",\n  symbol: \"META\",\n  priceInCents: 52210,\n  numShares: 10\n}\nResponse: Order\n\n// Cancel and order\nDELETE /order/:id\nResponse: {\n  ok: true\n}\n\n// List all orders\nGET /orders\nResponse: Order[] (paginated)\n",
      "autoResize": true,
      "lineHeight": 1.25
