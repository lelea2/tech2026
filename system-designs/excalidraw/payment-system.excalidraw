    {
      "id": "236243d185a64715",
      "type": "text",
      "x": 1388.43359375,
      "y": 539.09375,
      "width": 474.53363037109375,
      "height": 337.5,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
