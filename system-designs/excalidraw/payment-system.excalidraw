      "versionNonce": 1832979066,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782231739858,
      "link": null,
      "locked": false,
      "text": "POST {merchant_webhook_url}\n{\n  \"type\": \"payment.succeeded\",\n  \"data\": {\n    \"paymentId\": \"pay_123\",\n    \"amountInCents\": 2499,\n    \"currency\": \"usd\",\n    \"status\": \"succeeded\"\n  }\n}",
      "fontSize": 20,
      "fontFamily": 5,
