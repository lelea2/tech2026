    {
      "id": "enGY2DCw5o25XuUN7W4Ck",
      "type": "text",
      "x": 354.875,
      "y": 745.37890625,
      "width": 670.4940334824154,
      "height": 525.12109375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 791808506,
      "version": 215,
      "versionNonce": 1484858170,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782231677412,
      "link": null,
      "locked": false,
      "text": "API\n//  Create paymentIntent\nPOST /payment-intents -> paymentIntentId\n{\n  \"amountInCents\": 2499,\n  \"currency\": \"usd\",\n  \"description\": \"Order #1234\",\n}\n// Transaction based on paymentIntent (secure access and process)\nPOST /payment-intents/{paymentIntentId}/transactions\n{\n  \"type\": \"charge\",\n  \"card\": {\n    \"number\": \"4242424242424242\", // never pass draw format here\n    \"exp_month\": 12,\n    \"exp_year\": 2025,\n    \"cvc\": \"123\"\n  }\n}\n// Get payment (status checking)\nGET /payment-intents/{paymentIntentId} -> PaymentIntent",
      "fontSize": 20.0046130952381,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API\n//  Create paymentIntent\nPOST /payment-intents -> paymentIntentId\n{\n  \"amountInCents\": 2499,\n  \"currency\": \"usd\",\n  \"description\": \"Order #1234\",\n}\n// Transaction based on paymentIntent (secure access and process)\nPOST /payment-intents/{paymentIntentId}/transactions\n{\n  \"type\": \"charge\",\n  \"card\": {\n    \"number\": \"4242424242424242\", // never pass draw format here\n    \"exp_month\": 12,\n    \"exp_year\": 2025,\n    \"cvc\": \"123\"\n  }\n}\n// Get payment (status checking)\nGET /payment-intents/{paymentIntentId} -> PaymentIntent",
      "autoResize": true,
      "lineHeight": 1.25
    },
