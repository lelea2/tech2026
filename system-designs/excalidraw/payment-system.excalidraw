      ],
      "updated": 1782231265770,
      "link": null,
      "locked": false,
      "text": "External Providers\nKYC/AML: Persona, Alloy, Middesk, ComplyAdvantage. \nE-sign: DocuSign/Dropbox Sign. \nPayments: Stripe Treasury, Modern Treasury, Plaid, \nbank wire files.\nTechnique: verify webhooks, dedupe event IDs, \nstore raw payload encrypted for audit.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "External Providers\nKYC/AML: Persona, Alloy, Middesk, ComplyAdvantage. \nE-sign: DocuSign/Dropbox Sign. \nPayments: Stripe Treasury, Modern Treasury, Plaid, \nbank wire files.\nTechnique: verify webhooks, dedupe event IDs, \nstore raw payload encrypted for audit.",
      "lineHeight": 1.25,
      "index": "aj",
      "autoResize": true
