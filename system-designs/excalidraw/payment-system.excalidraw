      "isDeleted": true,
      "boundElements": [],
      "updated": 1782231265770,
      "link": null,
      "locked": false,
      "text": "4. Document correctness\n\n-- Version legal templates; store rendered variables and template hash. \n-- Generated docs immutable once sent for signature; corrections create new packet versions. \n-- Compliance decisions are explicit state machine transitions with reviewer attribution.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Document correctness\n\n-- Version legal templates; store rendered variables and template hash. \n-- Generated docs immutable once sent for signature; corrections create new packet versions. \n-- Compliance decisions are explicit state machine transitions with reviewer attribution.",
      "lineHeight": 1.25,
