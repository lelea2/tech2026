    {
      "id": "7852cb1bee444878",
      "type": "text",
      "x": -138.8010067739379,
      "y": 1311.3619977776214,
      "width": 734.4715576171875,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
