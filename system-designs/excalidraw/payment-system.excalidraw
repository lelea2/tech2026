    {
      "id": "-ALF4J0Vby1rAqbJmboa-",
      "type": "text",
      "x": 365,
      "y": 125.37890625,
      "width": 613.0195922851562,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
