      "versionNonce": 1733310758,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782231265770,
      "link": null,
      "locked": false,
      "text": "3. Workflow reliability\n\n-- Temporal handles wait-for-human, webhook callbacks, retries, \nand compensation. \n-- Every external call uses request ID \n+ provider correlation ID + reconciliation job. \n-- Dead-letter queue + admin replay tools.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Workflow reliability\n\n-- Temporal handles wait-for-human, webhook callbacks, retries, \nand compensation. \n-- Every external call uses request ID \n+ provider correlation ID + reconciliation job. \n-- Dead-letter queue + admin replay tools.",
      "lineHeight": 1.25,
      "index": "ax",
      "autoResize": true
    },
