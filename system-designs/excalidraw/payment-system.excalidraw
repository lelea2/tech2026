    {
      "id": "78WKB-KHhp3ejRHVmEirL",
      "type": "text",
      "x": 355,
      "y": 1275.5,
      "width": 648.4595336914062,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1045406694,
      "version": 256,
      "versionNonce": 1500440742,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782231727008,
      "link": null,
      "locked": false,
      "text": "For more real time, we could also provide webhooks, that notify \nmerchants when payment status changes. Merchant would provide\ncallback URL that we could post to when payment status changes\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For more real time, we could also provide webhooks, that notify \nmerchants when payment status changes. Merchant would provide\ncallback URL that we could post to when payment status changes\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Pxp9zHtmaevPvVxKxdE3s",
      "type": "text",
      "x": 364,
      "y": 1370.5,
      "width": 306.7998046875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
