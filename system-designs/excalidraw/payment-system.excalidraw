      "isDeleted": false,
      "boundElements": null,
      "updated": 1782231422462,
      "link": null,
      "locked": false,
      "text": "Non-functional requirement\n1. System should be highly secure\n2. Transaction safely and financial integrity (no double charge)\n3. Strong durability (can't loose transaction)\n4. Scale to 10k TPS",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirement\n1. System should be highly secure\n2. Transaction safely and financial integrity (no double charge)\n3. Strong durability (can't loose transaction)\n4. Scale to 10k TPS",
      "autoResize": true,
      "lineHeight": 1.25
    },
