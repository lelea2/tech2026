      "isDeleted": false,
      "boundElements": null,
      "updated": 1782231358608,
      "link": null,
      "locked": false,
      "text": "Functional Requirement\n1. Merchant able to create payments\n2. User should be able to pay via credit/debit card\n-- SUCCESS vs FAILURE (with reason)\n3. Merchant should be able to view status update for payment",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement\n1. Merchant able to create payments\n2. User should be able to pay via credit/debit card\n-- SUCCESS vs FAILURE (with reason)\n3. Merchant should be able to view status update for payment",
      "autoResize": true,
      "lineHeight": 1.25
    },
