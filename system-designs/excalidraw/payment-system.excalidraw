      "version": 91,
      "versionNonce": 624836390,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782231265770,
      "link": null,
      "locked": false,
      "text": "Storage Recommendations\n-- Postgres/Aurora: \nsource of truth for SPV, \ninvestors, applications, ledger, \naudit metadata. \nUse SERIALIZABLE or row locks for allocations.\n-- S3 + Object Lock: \nimmutable signed PDFs, \ntemplates, KYC files. Encrypt with KMS; signed URLs.\n-- Redis: \nsessions, idempotency cache, rate limits, job progress.\n-- OpenSearch: \ninvestors/deals/docs/audit search.\n-- Snowflake/BigQuery: \nBI, compliance reports, funnel analytics.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Storage Recommendations\n-- Postgres/Aurora: \nsource of truth for SPV, \ninvestors, applications, ledger, \naudit metadata. \nUse SERIALIZABLE or row locks for allocations.\n-- S3 + Object Lock: \nimmutable signed PDFs, \ntemplates, KYC files. Encrypt with KMS; signed URLs.\n-- Redis: \nsessions, idempotency cache, rate limits, job progress.\n-- OpenSearch: \ninvestors/deals/docs/audit search.\n-- Snowflake/BigQuery: \nBI, compliance reports, funnel analytics.",
      "lineHeight": 1.25,
      "index": "ah",
      "autoResize": true
    },
