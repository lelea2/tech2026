      "updated": 1782231265770,
      "link": null,
      "locked": false,
      "text": "Event Bus\nRecommendation: \nKafka for scale; \nEventBridge/SNS+SQS \nfor simpler SaaS.\nEvents: \n-- InvestorApproved, \n-- DocsSigned, \n-- FundsReceived.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
