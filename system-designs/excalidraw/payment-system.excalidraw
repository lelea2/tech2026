    {
      "id": "02i94Kf0I8Pn84w9Ynl3v",
      "type": "text",
      "x": 1174.0541973674826,
      "y": 2253.7130376505856,
      "width": 545.1995849609375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0L",
      "roundness": null,
      "seed": 67267110,
      "version": 76,
