      "locked": false,
      "text": "Tenant isolation:\ntenant_id on every record, scoped BFF permissions, fair queues, isolated runners, redacted logs.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "bbc8c72885c341d693eec3",
      "originalText": "Tenant isolation:\ntenant_id on every record, scoped BFF permissions, fair queues, isolated runners, redacted logs.",
      "lineHeight": 1.25
    },
    {
      "id": "dcb5bc547d844e6f9dfdd8",
      "type": "text",
      "x": 50,
      "y": 940,
      "width": 1150,
      "height": 24,
      "angle": 0,
      "strokeColor": "#1e1e1e",
