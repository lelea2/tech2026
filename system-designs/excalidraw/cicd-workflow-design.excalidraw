      "isDeleted": false,
      "boundElements": null,
      "updated": 1782318250267,
      "link": null,
      "locked": false,
      "text": "Key flows: 1) push ingestion creates durable workflow run, 2) scheduler expands config into jobs, 3) runners emit status/log events, 4) BFF + realtime gateway power the frontend progress UI, 5) UI actions write commands back to control plane.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Key flows: 1) push ingestion creates durable workflow run, 2) scheduler expands config into jobs, 3) runners emit status/log events, 4) BFF + realtime gateway power the frontend progress UI, 5) UI actions write commands back to control plane.",
      "lineHeight": 1.25
    }
