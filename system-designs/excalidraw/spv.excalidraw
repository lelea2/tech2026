      "updated": 1782226952635,
      "link": null,
      "locked": false,
      "text": "Workflow Engine\nRecommendation: Temporal\n• SPV creation workflow\n• Investor onboarding workflow\n• Durable timers\n• Human approval wait states\n• Retries with exponential backoff\n• Compensation steps\nAlternative: \nCamunda if BPMN-heavy",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workflow Engine\nRecommendation: Temporal\n• SPV creation workflow\n• Investor onboarding workflow\n• Durable timers\n• Human approval wait states\n• Retries with exponential backoff\n• Compensation steps\nAlternative: \nCamunda if BPMN-heavy",
      "lineHeight": 1.25,
      "index": "ad",
      "autoResize": false
    },
