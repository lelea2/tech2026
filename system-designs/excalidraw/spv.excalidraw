      "version": 75,
      "versionNonce": 2126452806,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782227271914,
      "link": null,
      "locked": false,
      "text": "Storage Recommendations\nPostgres/Aurora: \nsource of truth for SPV, \ninvestors, applications, ledger, \naudit metadata. \nUse SERIALIZABLE or row locks for allocations.\nS3 + Object Lock: \nimmutable signed PDFs, \ntemplates, KYC files. Encrypt with KMS; signed URLs.\nRedis: \nsessions, idempotency cache, rate limits, job progress.\nOpenSearch: \ninvestors/deals/docs/audit search.\nSnowflake/BigQuery: \nBI, compliance reports, funnel analytics.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Storage Recommendations\nPostgres/Aurora: \nsource of truth for SPV, \ninvestors, applications, ledger, \naudit metadata. \nUse SERIALIZABLE or row locks for allocations.\nS3 + Object Lock: \nimmutable signed PDFs, \ntemplates, KYC files. Encrypt with KMS; signed URLs.\nRedis: \nsessions, idempotency cache, rate limits, job progress.\nOpenSearch: \ninvestors/deals/docs/audit search.\nSnowflake/BigQuery: \nBI, compliance reports, funnel analytics.",
      "lineHeight": 1.25,
      "index": "ah",
      "autoResize": true
    },
