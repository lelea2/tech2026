      "boundElements": [],
      "updated": 1782226865043,
      "link": null,
      "locked": false,
      "text": "External Providers\nKYC/AML: Persona, Alloy, Middesk, ComplyAdvantage. E-sign: DocuSign/Dropbox Sign. Payments: Stripe Treasury, Modern Treasury, Plaid, bank wire files.\nTechnique: verify webhooks, dedupe event IDs, store raw payload encrypted for audit.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "External Providers\nKYC/AML: Persona, Alloy, Middesk, ComplyAdvantage. E-sign: DocuSign/Dropbox Sign. Payments: Stripe Treasury, Modern Treasury, Plaid, bank wire files.\nTechnique: verify webhooks, dedupe event IDs, store raw payload encrypted for audit.",
      "lineHeight": 1.25,
      "index": "aj",
      "autoResize": true
    },
