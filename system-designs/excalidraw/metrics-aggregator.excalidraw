      "seed": 366161912,
      "version": 475,
      "versionNonce": 1799861824,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786683268667,
      "link": null,
      "locked": false,
      "text": "Functional requirement\n\n1. Service emits metrics to platform\n2. Query/visualize metrics on the dashboard\n3. Define alert rules with threshold\n4. Receive notification when alerts fire",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirement\n\n1. Service emits metrics to platform\n2. Query/visualize metrics on the dashboard\n3. Define alert rules with threshold\n4. Receive notification when alerts fire",
      "autoResize": true,
      "lineHeight": 1.25
    },
