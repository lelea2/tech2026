    {
      "id": "SYik9BJ13bftJQI-bCjQi",
      "type": "text",
      "x": 423.125,
      "y": -702.1796875,
      "width": 434.0196838378906,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0z",
      "roundness": null,
      "seed": 631076488,
      "version": 643,
      "versionNonce": 515583552,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786683283191,
      "link": null,
      "locked": false,
      "text": "Non-functional requirement\n\n1. Scale 5M metrics/sec, 500k servers\n2. Dashboard queries return in seconds\n3. Alert latency (threshold) < 1 min\n4. High availability (eventual consistency OK)\n5. Handle late/out of order data gracefully",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirement\n\n1. Scale 5M metrics/sec, 500k servers\n2. Dashboard queries return in seconds\n3. Alert latency (threshold) < 1 min\n4. High availability (eventual consistency OK)\n5. Handle late/out of order data gracefully",
      "autoResize": true,
      "lineHeight": 1.25
    },
