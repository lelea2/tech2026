      "seed": 1490437696,
      "version": 4,
      "versionNonce": 182719936,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786684035129,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "",
      "autoResize": true,
