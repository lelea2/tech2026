    },
    {
      "id": "XiwjsC2FZvRqMYRpA8LW_",
      "type": "text",
      "x": 95.255859375,
      "y": 2895.208984375,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
