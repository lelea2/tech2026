    {
      "id": "ZUalYghHy6pWfbi6ubVrS",
      "type": "text",
      "x": 359.875,
      "y": 108.62109375,
      "width": 432.83966064453125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0x",
      "roundness": null,
      "seed": 366161912,
      "version": 226,
      "versionNonce": 1059897224,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782190486619,
      "link": null,
      "locked": false,
      "text": "Functional requirement\n1. Service emits metrics to platform\n2. Query/visualize metrics on the dashboard\n3. Define alert rules with threshold\n4. Receive notification when alerts fire",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirement\n1. Service emits metrics to platform\n2. Query/visualize metrics on the dashboard\n3. Define alert rules with threshold\n4. Receive notification when alerts fire",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ee1P5eKAi_EYOzjNMvOwz",
