    {
      "id": "PKZGYaplwtapV3A_dkTik",
      "type": "text",
      "x": 402.46484375,
      "y": -422.03125,
      "width": 741.3605346679688,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b11",
      "roundness": null,
      "seed": 226969736,
      "version": 683,
      "versionNonce": 577973824,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786683297121,
      "link": null,
      "locked": false,
      "text": "Core entities\n\n1. Label: key-value pair attached to metrics (eg: host=\"server-1\", etc)\n2. metrics: eg: cpu_usage{host=\"server-1} = 75\n3. series: full sequence over time\n4. Alert rule: condition that triggers notification when threshold violate\n5. dashboard: connection of panel, displaying query result as chart/table UI",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core entities\n\n1. Label: key-value pair attached to metrics (eg: host=\"server-1\", etc)\n2. metrics: eg: cpu_usage{host=\"server-1} = 75\n3. series: full sequence over time\n4. Alert rule: condition that triggers notification when threshold violate\n5. dashboard: connection of panel, displaying query result as chart/table UI",
      "autoResize": false,
      "lineHeight": 1.25
    },
