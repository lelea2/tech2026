    {
      "id": "Zss7a0p7iaAfM2ioRv1VW",
      "type": "text",
      "x": 1621.9811589982264,
      "y": 450.48339747354385,
      "width": 519.859619140625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 2120042888,
      "version": 334,
      "versionNonce": 252199672,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782191789468,
      "link": null,
      "locked": false,
      "text": "--> kafka absorbs spike while \nconsumers process at their own space.\n--> metrics will persit in kafka until topic is consumed\n--> support processing data ion parallel. \n--> kafka can add complexity and latency. \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> kafka absorbs spike while \nconsumers process at their own space.\n--> metrics will persit in kafka until topic is consumed\n--> support processing data ion parallel. \n--> kafka can add complexity and latency. \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XsTGF6llK5u_qewDTrr_2",
      "type": "text",
      "x": 1143.4907228355025,
      "y": 347.53236153618326,
      "width": 436.419677734375,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1r",
      "roundness": null,
      "seed": 1650001544,
      "version": 524,
      "versionNonce": 903140088,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782192140240,
      "link": null,
      "locked": false,
      "text": "** Improvement: \n-- instead server publish directly to\ningestion service, we can run small\nbackground process on each server.\nThis is similar to DataDog or OTEL\n1. Collect metrics locally at high\nfrequency\n2. Buffers and batches metrics\nlocally\n3. Periodically flushes batches via Kafka\n==> this solution shifts work to the edge,\nreduce central ingestion load. Agent can also\nhandle local aggregation. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** Improvement: \n-- instead server publish directly to\ningestion service, we can run small\nbackground process on each server.\nThis is similar to DataDog or OTEL\n1. Collect metrics locally at high\nfrequency\n2. Buffers and batches metrics\nlocally\n3. Periodically flushes batches via Kafka\n==> this solution shifts work to the edge,\nreduce central ingestion load. Agent can also\nhandle local aggregation. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
