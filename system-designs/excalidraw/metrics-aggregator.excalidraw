    {
      "id": "h7qeAhoTxkaMTPs3GrUnW",
      "type": "text",
      "x": 1235.2674505435982,
      "y": 1163.7069559594506,
      "width": 1605.0386962890625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2g",
      "roundness": null,
      "seed": 1860578952,
      "version": 690,
      "versionNonce": 1122784904,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782193536244,
      "link": null,
      "locked": false,
      "text": "*** Low latency queries\n-- Dashboard queries showcase scaling reads challenges: heavy aggregations, time-range scans, and the need for sub-second responses to keep engineers productive.\n-- Approach by caching + query splitting\n--- The best approach takes advantage of the fact that most queries are covering the same data.\n1. Query splitting: break 30 days query into chunk (eg: last 2 hours read from DB, while historical data from caching/redis)\n2. Precomputation: dashboard queires are precomputed on schedule, whole result is cached with TTL aligned with data freshness\n3. Result caching: cachekey = queries+time_range\n--> cachekey invalidation can be tricky. if there is databackfill, it will affext cache data. \n---> the size of cache needs to be monitored to prevent memory exhaustion",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Low latency queries\n-- Dashboard queries showcase scaling reads challenges: heavy aggregations, time-range scans, and the need for sub-second responses to keep engineers productive.\n-- Approach by caching + query splitting\n--- The best approach takes advantage of the fact that most queries are covering the same data.\n1. Query splitting: break 30 days query into chunk (eg: last 2 hours read from DB, while historical data from caching/redis)\n2. Precomputation: dashboard queires are precomputed on schedule, whole result is cached with TTL aligned with data freshness\n3. Result caching: cachekey = queries+time_range\n--> cachekey invalidation can be tricky. if there is databackfill, it will affext cache data. \n---> the size of cache needs to be monitored to prevent memory exhaustion",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TQktepcQVKqXT3WuQ_0Kg",
      "type": "text",
      "x": 1239.5137393576313,
      "y": 1403.4852927408003,
      "width": 815.5394287109375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2h",
      "roundness": null,
      "seed": 879920008,
      "version": 244,
      "versionNonce": 620457864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782193718689,
      "link": null,
      "locked": false,
      "text": "*** STream process for real time alert\n-- polling alert has latency, we might need it sooner. \n-- with polling, we are pulling data on schedule, and not act on it when data arrive. \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** STream process for real time alert\n-- polling alert has latency, we might need it sooner. \n-- with polling, we are pulling data on schedule, and not act on it when data arrive. \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Igz8q70lzWdBR0k4tIS9T",
      "type": "image",
      "x": 1240.4039152613843,
