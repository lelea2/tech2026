    {
      "id": "ZUalYghHy6pWfbi6ubVrS",
      "type": "text",
      "x": 420.53515625,
      "y": -946.98046875,
      "width": 432.83966064453125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
