      "boundElements": null,
      "updated": 1785969447278,
      "link": null,
      "locked": false,
      "text": "1) User able to view an aggregated feed of new article for thousands source\n-- Discuss from query directly from RSS to offline workflow collect data to DB\n2) Able to scroll through feed ==> support pagination (either pagesize or cursor base)\n3) ABle to click on articles and be redirected to publisher's website \n  ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) User able to view an aggregated feed of new article for thousands source\n-- Discuss from query directly from RSS to offline workflow collect data to DB\n2) Able to scroll through feed ==> support pagination (either pagesize or cursor base)\n3) ABle to click on articles and be redirected to publisher's website \n  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
