    {
      "id": "-FTfKcpcMOmFM59jhQ7bk",
      "type": "text",
      "x": 998.08758123214,
      "y": 360.426459757815,
      "width": 471.9676513671875,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
