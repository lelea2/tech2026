      "isDeleted": false,
      "boundElements": [],
      "updated": 1786853331197,
      "link": null,
      "locked": false,
      "text": "3) Prevent duplicate notification and ensure at-least-once delivery \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3) Prevent duplicate notification and ensure at-least-once delivery \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
