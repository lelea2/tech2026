      "boundElements": null,
      "updated": 1786844047242,
      "link": null,
      "locked": false,
      "text": "API or system interface\n\n// Send notifications\nPOST /notifications -> 200 OK { id, status }\nBody: {\n  userId,\n  channel,     // push | email | sms\n  priority,    // high | standard\n  content,     // { title, body }\n  scheduledAt  // optional, defaults to now\n}\n\n// campaign get endpoint of their own to avoid overloading\nPOST /campaigns -> 202 Accepted { id }\nBody: {\n  segmentId,\n  channel,     // push | email | sms\n  priority,    // high | standard\n  templateId,\n  scheduledAt  // optional, defaults to now\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API or system interface\n\n// Send notifications\nPOST /notifications -> 200 OK { id, status }\nBody: {\n  userId,\n  channel,     // push | email | sms\n  priority,    // high | standard\n  content,     // { title, body }\n  scheduledAt  // optional, defaults to now\n}\n\n// campaign get endpoint of their own to avoid overloading\nPOST /campaigns -> 202 Accepted { id }\nBody: {\n  segmentId,\n  channel,     // push | email | sms\n  priority,    // high | standard\n  templateId,\n  scheduledAt  // optional, defaults to now\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
