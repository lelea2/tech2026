      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n\n1) Send a notification to user either immediately or scheduled\n2) Send campaigns, immediately or scheduled\n3) Users should be able to set notification preferences",
      "autoResize": true,
      "lineHeight": 1.25
