      "backgroundColor": "transparent",
      "fontSize": 19,
      "fontFamily": 1,
      "text": "Edge cases\n\n- Two users edit same event\n- Event created offline\n- Event moved by another user\n- Large attendee list\n- DST transition\n- Cross-day event\n- Private/free-busy visibility\n- Deleted recurring occurrence\n- Retry creates duplicate event\n- Dense day with too many overlaps",
      "originalText": "Edge cases\n\n- Two users edit same event\n- Event created offline\n- Event moved by another user\n- Large attendee list\n- DST transition\n- Cross-day event\n- Private/free-busy visibility\n- Deleted recurring occurrence\n- Retry creates duplicate event\n- Dense day with too many overlaps",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 233
    },
