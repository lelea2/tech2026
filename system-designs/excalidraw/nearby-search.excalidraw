      "boundElements": [],
      "updated": 1786039754149,
      "link": null,
      "locked": false,
      "text": "• ordering key = (bootEpoch, sequence)\n• keep eventTime, ingestTime, \nindexAppliedTime\n• ignore stale add/remove/tombstone\n• return locationAge + indexWatermark\n• stale fallback must be explicit",
      "fontSize": 15.639375000000006,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• ordering key = (bootEpoch, sequence)\n• keep eventTime, ingestTime, \nindexAppliedTime\n• ignore stale add/remove/tombstone\n• return locationAge + indexWatermark\n• stale fallback must be explicit",
      "autoResize": true,
      "lineHeight": 1.25
