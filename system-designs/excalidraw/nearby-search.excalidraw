      "versionNonce": 782423849,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786039583894,
      "link": null,
      "locked": false,
      "text": "VehicleLocationEvent\n  vehicleId, eventId, bootEpoch, sequence\n  eventTime, lat/lon, accuracy, source\n\nVehicleOperationalState\n  availability, mode, battery, capabilities\n\nVehicleSearchDocument\n  cellId, exact location, versions, filter bits\n\nPOST /v1/vehicle-search\n  location, radiusMeters, limit, filters, freshness\n\nPOST /v1/dispatch-reservations\n  vehicleId, expectedOperationalVersion, TTL",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VehicleLocationEvent\n  vehicleId, eventId, bootEpoch, sequence\n  eventTime, lat/lon, accuracy, source\n\nVehicleOperationalState\n  availability, mode, battery, capabilities\n\nVehicleSearchDocument\n  cellId, exact location, versions, filter bits\n\nPOST /v1/vehicle-search\n  location, radiusMeters, limit, filters, freshness\n\nPOST /v1/dispatch-reservations\n  vehicleId, expectedOperationalVersion, TTL",
      "autoResize": true,
      "lineHeight": 1.25
    },
