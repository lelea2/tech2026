    {
      "id": "acbf90e6390d",
      "type": "text",
      "x": 32.26953125,
      "y": 209.5546875,
      "width": 383.349609375,
      "height": 276.25,
      "angle": 0,
      "strokeColor": "#1e3a8a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af7p",
      "roundness": null,
      "seed": 12345,
      "version": 56,
      "versionNonce": 227727177,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786039599766,
      "link": null,
      "locked": false,
      "text": "Functional\n• ingest changing vehicle positions\n• radius / top-k nearby search\n• filter status, mode, battery, capacity\n• expose location age and confidence\n• optional road-ETA reranking\n• regional failover and index rebuild\n\nNon-functional\n• 200K–500K updates/sec globally\n• p99 search < 200 ms regionally\n• 99.99% regional availability\n• bounded staleness, no hidden stale data",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional\n• ingest changing vehicle positions\n• radius / top-k nearby search\n• filter status, mode, battery, capacity\n• expose location age and confidence\n• optional road-ETA reranking\n• regional failover and index rebuild\n\nNon-functional\n• 200K–500K updates/sec globally\n• p99 search < 200 ms regionally\n• 99.99% regional availability\n• bounded staleness, no hidden stale data",
      "autoResize": true,
      "lineHeight": 1.25
    },
