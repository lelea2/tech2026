      "updated": 1786039763586,
      "link": null,
      "locked": false,
      "text": "• adaptive spatial resolution\n• query replicas for dense cells\n• local top-m then global merge\n• cap radius and expensive reranking\n• hedged read only for tail latency",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• adaptive spatial resolution\n• query replicas for dense cells\n• local top-m then global merge\n• cap radius and expensive reranking\n• hedged read only for tail latency",
      "autoResize": true,
      "lineHeight": 1.25
    },
