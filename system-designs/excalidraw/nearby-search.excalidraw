    {
      "id": "1c5407c058b2",
      "type": "text",
      "x": 1013.4765625,
      "y": 185.53125,
      "width": 387.199462890625,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af8A",
      "roundness": null,
      "seed": 12345,
      "version": 65,
      "versionNonce": 1156840489,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786039573068,
      "link": null,
      "locked": false,
      "text": "Event log: Kafka-compatible\n  keyed by vehicleId for ordering and replay\n\nProjection: Flink / Kafka Streams\n  keyed state, idempotent version checks\n\nSpatial cells: H3 or S2\n  distributed ownership, neighbor cover\n\nHot index: custom in-memory shards\n  compact docs, filter bitmaps, expiry heap\n\nGeometry truth: PostGIS\n  service areas, polygons, validation\n\nETA: dedicated routing engine\n  only rerank final 20–50 candidates",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event log: Kafka-compatible\n  keyed by vehicleId for ordering and replay\n\nProjection: Flink / Kafka Streams\n  keyed state, idempotent version checks\n\nSpatial cells: H3 or S2\n  distributed ownership, neighbor cover\n\nHot index: custom in-memory shards\n  compact docs, filter bitmaps, expiry heap\n\nGeometry truth: PostGIS\n  service areas, polygons, validation\n\nETA: dedicated routing engine\n  only rerank final 20–50 candidates",
      "autoResize": true,
      "lineHeight": 1.25
    },
