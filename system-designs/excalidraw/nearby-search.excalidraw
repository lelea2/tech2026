      "seed": 12345,
      "version": 6,
      "versionNonce": 823374249,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786039822367,
      "link": null,
      "locked": false,
      "text": "1. Durable truth is append-only telemetry.\n2. Ordering is by vehicle version, not arrival time.\n3. Search locality is partitioned by spatial cell.\n4. Exact distance follows coarse cell retrieval.\n5. Freshness is visible in every result.\n6. Reservation is a separate conditional transaction.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Durable truth is append-only telemetry.\n2. Ordering is by vehicle version, not arrival time.\n3. Search locality is partitioned by spatial cell.\n4. Exact distance follows coarse cell retrieval.\n5. Freshness is visible in every result.\n6. Reservation is a separate conditional transaction.",
      "autoResize": true,
      "lineHeight": 1.25
    }
