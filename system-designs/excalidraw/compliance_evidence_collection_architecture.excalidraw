      "roundness": null,
      "seed": 417688,
      "versionNonce": 452387,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Interview thesis: build an async connector platform. Polling is the correctness backbone; webhooks improve freshness. Store raw evidence for replay and normalized evidence for product queries. Use versioned rules, idempotent writes, tenant isolation, freshness semantics, and point-in-time audit exports.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Interview thesis: build an async connector platform. Polling is the correctness backbone; webhooks improve freshness. Store raw evidence for replay and normalized evidence for product queries. Use versioned rules, idempotent writes, tenant isolation, freshness semantics, and point-in-time audit exports.",
      "lineHeight": 1.2
    }
