    {
      "id": "ent_body",
      "type": "text",
      "x": 1470,
      "y": 145,
      "width": 330,
      "height": 700,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 688958,
      "versionNonce": 973746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Tenant\n- customer org, region, plan\n\nIntegration\n- provider, auth ref, status, sync frequency\n\nConnectorRun\n- run status, cursor, counts, errors\n\nRawEvidence\n- immutable payload URI, hash, provenance\n\nEvidenceItem\n- normalized subject, status, freshness\n\nControl\n- framework requirement, version, owner\n\nEvidenceMapping\n- evidence type + rule satisfying control\n\nControlResult\n- passing/failing/stale/missing + reason\n\nAuditExport\n- point-in-time evidence package",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Tenant\n- customer org, region, plan\n\nIntegration\n- provider, auth ref, status, sync frequency\n\nConnectorRun\n- run status, cursor, counts, errors\n\nRawEvidence\n- immutable payload URI, hash, provenance\n\nEvidenceItem\n- normalized subject, status, freshness\n\nControl\n- framework requirement, version, owner\n\nEvidenceMapping\n- evidence type + rule satisfying control\n\nControlResult\n- passing/failing/stale/missing + reason\n\nAuditExport\n- point-in-time evidence package",
      "lineHeight": 1.2
    },
