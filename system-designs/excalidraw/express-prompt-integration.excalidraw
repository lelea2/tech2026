      "updated": 1785951304524,
      "link": null,
      "locked": false,
      "text": "VERSIONING\n• major version in URL\n• additive fields within major\n• clients ignore unknown fields\n• tool versions independent of API\n• public DTO ≠ internal document model\n• sunset/deprecation headers\n• adapters + contract tests\n• never repurpose enum semantics",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e114",
      "originalText": "VERSIONING\n• major version in URL\n• additive fields within major\n• clients ignore unknown fields\n• tool versions independent of API\n• public DTO ≠ internal document model\n• sunset/deprecation headers\n• adapters + contract tests\n• never repurpose enum semantics",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
