      "isDeleted": false,
      "boundElements": [],
      "updated": 1785951287309,
      "link": null,
      "locked": false,
      "text": "ASSET AUTHORIZATION\n• Never trust a model-supplied asset ID\n• Query by (tenant_id, asset_id)\n• Re-check ACL before read/export/publish\n• Validate classification + brand library\n• quarantine → approved → published states\n• short-lived, audience-bound signed URLs\n• return 404 for cross-tenant guesses",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e107",
      "originalText": "ASSET AUTHORIZATION\n• Never trust a model-supplied asset ID\n• Query by (tenant_id, asset_id)\n• Re-check ACL before read/export/publish\n• Validate classification + brand library\n• quarantine → approved → published states\n• short-lived, audience-bound signed URLs\n• return 404 for cross-tenant guesses",
      "autoResize": false,
      "lineHeight": 1.25
    },
