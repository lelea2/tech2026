    },
    {
      "id": "e136",
      "type": "text",
      "x": 65,
      "y": 4037.5,
      "width": 1556,
      "height": 95,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
