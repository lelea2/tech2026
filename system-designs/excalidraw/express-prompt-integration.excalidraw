      "text": "IDEMPOTENCY\nUnique: tenant + principal + endpoint + key\nSame key + same request hash → original response\nSame key + different hash → 409\nQueue duplicates handled by effect key",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e98",
      "originalText": "IDEMPOTENCY\nUnique: tenant + principal + endpoint + key\nSame key + same request hash → original response\nSame key + different hash → 409\nQueue duplicates handled by effect key",
      "autoResize": false,
      "lineHeight": 1.25
