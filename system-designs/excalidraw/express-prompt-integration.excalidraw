      "versionNonce": 431135286,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785951291733,
      "link": null,
      "locked": false,
      "text": "TENANT ISOLATION\n1. Tenant from signed claims\n2. tenant_id on every record\n3. repository requires TenantContext\n4. RLS / partition guard as defense in depth\n5. tenant-prefixed cache + queue keys\n6. tenant-scoped storage policies\n7. per-tenant encryption context\n8. negative cross-tenant tests",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e105",
      "originalText": "TENANT ISOLATION\n1. Tenant from signed claims\n2. tenant_id on every record\n3. repository requires TenantContext\n4. RLS / partition guard as defense in depth\n5. tenant-prefixed cache + queue keys\n6. tenant-scoped storage policies\n7. per-tenant encryption context\n8. negative cross-tenant tests",
      "autoResize": false,
      "lineHeight": 1.25
    },
