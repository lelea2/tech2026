    {
      "id": "vncLlsyBhkZ9Ds86RmjOc",
      "type": "text",
      "x": 872.6323177497723,
      "y": 1624.6331811745695,
      "width": 563.2996215820312,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
