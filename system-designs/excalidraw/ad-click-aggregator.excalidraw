      "seed": 1607029631,
      "version": 382,
      "versionNonce": 1572848415,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786318301059,
      "link": null,
      "locked": false,
      "text": "Non-functional requirements\n1) Scalable support peak 10k CPS\n2) Low latency analytics queries < 1s\n3) Fault tolerance\n4) Data integrity\n5) As realtime as possible & idempotency of ad clicks\n-----------------------------------------------\n- Spam detection\n- Demographic profiling\n- Conversion tracking",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirements\n1) Scalable support peak 10k CPS\n2) Low latency analytics queries < 1s\n3) Fault tolerance\n4) Data integrity\n5) As realtime as possible & idempotency of ad clicks\n-----------------------------------------------\n- Spam detection\n- Demographic profiling\n- Conversion tracking",
      "autoResize": true,
      "lineHeight": 1.25
    },
