    {
      "id": "T72svkKRwt8JMJ64y-8GB",
      "type": "text",
      "x": 396,
      "y": 501.5,
      "width": 517.0796508789062,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
