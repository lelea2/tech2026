    {
      "id": "YYYxvBE5EUAHbXVI2K0jL",
      "type": "text",
      "x": 235.8671875,
      "y": 397.26171875,
      "width": 415.77557373046875,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 707952659,
      "version": 303,
      "versionNonce": 1984668573,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785723592219,
      "link": null,
      "locked": false,
      "text": "Non-functional requirement\n1) Low latency for search (<500ms)\n2) high availability >> consistency\n3) scalable by handle 100M daily user, 10M businesses\n=======\n* protect user data adhere to GDPR\n* should be fault tolerant\n* system should protect against spam and abuse",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirement\n1) Low latency for search (<500ms)\n2) high availability >> consistency\n3) scalable by handle 100M daily user, 10M businesses\n=======\n* protect user data adhere to GDPR\n* should be fault tolerant\n* system should protect against spam and abuse",
      "autoResize": true,
      "lineHeight": 1.25
    },
