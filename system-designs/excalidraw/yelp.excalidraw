      "link": null,
      "locked": false,
      "text": "1) How would you efficiently calculate and update the avg rating?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) How would you efficiently calculate and update the avg rating?",
      "autoResize": true,
