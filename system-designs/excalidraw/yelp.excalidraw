    {
      "id": "fO9uk8YtXrbzpJBmSvddC",
      "type": "text",
      "x": 230.875,
      "y": 140,
      "width": 606.8314819335938,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 982970877,
      "version": 463,
      "versionNonce": 156686323,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785723502195,
      "link": null,
      "locked": false,
      "text": "Functional Requirement\n\n1) User should be able to search for business by name,\nlocation(lat/long) and category\n2) User should be able to view businesses (and reviews)\n3) Should able to leave review on business (1-5 star rating and optional text)\n============\n* Admin able to add/update/remove business\n* User able to view businesses on map\n* should be recommended business relevant to them\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement\n\n1) User should be able to search for business by name,\nlocation(lat/long) and category\n2) User should be able to view businesses (and reviews)\n3) Should able to leave review on business (1-5 star rating and optional text)\n============\n* Admin able to add/update/remove business\n* User able to view businesses on map\n* should be recommended business relevant to them\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
