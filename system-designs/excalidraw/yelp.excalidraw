    {
      "id": "ahoUVqQ-lKvDAhxPwgiU8",
      "type": "text",
      "x": 796.9834405548517,
      "y": 684.7477695409877,
      "width": 202.20362690364934,
      "height": 113.40103180428662,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
