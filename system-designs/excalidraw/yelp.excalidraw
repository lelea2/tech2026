    {
      "id": "note3_text",
      "type": "text",
      "x": 1434.9959664262096,
      "y": 525.2500815749963,
      "width": 287.17974853515625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 848821304,
      "version": 281,
      "versionNonce": 2135841107,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785723356893,
      "link": null,
      "locked": false,
      "text": "Serving guarantees:\n• HLL dashboards: ~1–2% error\n• Exact reports: batch truth\n• Cache hot queries\n• Dimension allowlist prevents\ncardinality explosion",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "note3",
      "originalText": "Serving guarantees:\n• HLL dashboards: ~1–2% error\n• Exact reports: batch truth\n• Cache hot queries\n• Dimension allowlist prevents cardinality explosion",
      "lineHeight": 1.25,
      "baseline": 42,
      "index": "as",
      "autoResize": true
    },
    {
      "id": "RE3Xvx4PAJLgySxc3rRsQ",
      "type": "text",
      "x": 1556.5617458147578,
      "y": 25.169723858922097,
      "width": 429.48234344405233,
      "height": 82.10272927576557,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 89962504,
      "version": 138,
      "versionNonce": 643619165,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785723356893,
      "link": null,
      "locked": false,
      "text": "HLL stands for HyperLogLog. \nIt is a smart, memory-saving algorithm used to count unique items \n(known as cardinality) in massive datasets. \nInstead of storing every single item, \nHLL gives an incredibly close estimate using very little memory.",
      "fontSize": 13.1364366841225,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HLL stands for HyperLogLog. \nIt is a smart, memory-saving algorithm used to count unique items \n(known as cardinality) in massive datasets. \nInstead of storing every single item, \nHLL gives an incredibly close estimate using very little memory.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x3HXhmUp7DfSpTXVASmCt",
      "type": "rectangle",
      "x": 84.24838125446092,
      "y": -235.0382789774215,
      "width": 914.8517985039831,
      "height": 302.47669708224356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": {
        "type": 3
      },
      "seed": 352302088,
      "version": 123,
      "versionNonce": 494778099,
      "isDeleted": true,
      "boundElements": [],
