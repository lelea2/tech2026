    },
    {
      "id": "TljmEx79epMsrYXHvEQv_",
      "type": "text",
      "x": 893.12109375,
      "y": 693.375,
      "width": 874.87939453125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 1792637501,
      "version": 415,
      "versionNonce": 1930529757,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785726229053,
      "link": null,
      "locked": false,
      "text": "- What happen if multiple review comes in at the same time and one could overwrite other,\ncan lead to inconsistent state. \n- To solve this, use \"Optimistic locking\" - read the current state\nof buseinss first then attempt to update. If state has change since \nwe read it, our update will fail. Add version number to table we want to locak on,\nin this case, check if number of reviews has change\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- What happen if multiple review comes in at the same time and one could overwrite other,\ncan lead to inconsistent state. \n- To solve this, use \"Optimistic locking\" - read the current state\nof buseinss first then attempt to update. If state has change since \nwe read it, our update will fail. Add version number to table we want to locak on,\nin this case, check if number of reviews has change\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
