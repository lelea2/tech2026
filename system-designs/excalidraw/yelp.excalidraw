      "boundElements": [],
      "updated": 1785723356893,
      "link": null,
      "locked": false,
      "text": "- 30s - 5min depending on \nfreshness SLA\nQueries:\ntoday_dau_global\ntoday_dau_by_platform\ncurrent_month_mau_global\nrolling_30d_active_users_global",
      "fontSize": 12.960117920489902,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 30s - 5min depending on \nfreshness SLA\nQueries:\ntoday_dau_global\ntoday_dau_by_platform\ncurrent_month_mau_global\nrolling_30d_active_users_global",
      "autoResize": true,
