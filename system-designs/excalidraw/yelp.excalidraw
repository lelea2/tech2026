      "isDeleted": true,
      "boundElements": [],
      "updated": 1785723356893,
      "link": null,
      "locked": false,
      "text": "Core correctness rules:\n• Active user = canonical user with ≥1 qualifying\nevent\n• Compute by event_time, not ingestion_time\n• Mark today as provisional; finalize at T+1",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "note1",
      "originalText": "Core correctness rules:\n• Active user = canonical user with ≥1 qualifying event\n• Compute by event_time, not ingestion_time\n• Mark today as provisional; finalize at T+1",
      "lineHeight": 1.25,
      "baseline": 42,
      "index": "ao",
      "autoResize": true
    },
