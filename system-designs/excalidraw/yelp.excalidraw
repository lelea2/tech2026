      "isDeleted": true,
      "boundElements": [],
      "updated": 1785723356893,
      "link": null,
      "locked": false,
      "text": "Identity priority:\n1. hash(user_id)\n2. hash(anonymous_id)\n3. hash(device/install id if\nallowed)\nAvoid raw PII and\nfingerprinting.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "note2",
      "originalText": "Identity priority:\n1. hash(user_id)\n2. hash(anonymous_id)\n3. hash(device/install id if allowed)\nAvoid raw PII and fingerprinting.",
      "lineHeight": 1.25,
      "baseline": 42,
      "index": "aq",
      "autoResize": true
    },
