    {
      "id": "cPq8kSU9tp7eFOZBU2J5a",
      "type": "text",
      "x": 1307.594448921262,
      "y": 1234.049469217405,
      "width": 674.1273193359375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b17",
      "roundness": null,
      "seed": 1913411869,
      "version": 485,
      "versionNonce": 1737729629,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785726947448,
      "link": null,
      "locked": false,
      "text": "- We do not use this as primary DB, since it's \nnot optimized for ACID compliance and handle complex transaction\n- Need to ensure ElasticSearch remain in sync with primary DB,\nuse CDC (Change Data capture) system to capture changes\nto primary DB and apply to ElasticSearch\n\n\n\n-- Another solution can be Postgres with Extension (PostGIS)\nfor geography data, and use pg_trgm for index/query text data\n-- Given that this is a small amount of data, \n10M businesses x 1kb each = 10GB + 10M businesses x 100 reviews each x 1kb = 1TB, \nwe don't need to worry too much about scaling, \nsomething that Elasticsearch excels at, so this is a perfectly reasonable solution.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- We do not use this as primary DB, since it's \nnot optimized for ACID compliance and handle complex transaction\n- Need to ensure ElasticSearch remain in sync with primary DB,\nuse CDC (Change Data capture) system to capture changes\nto primary DB and apply to ElasticSearch\n\n\n\n-- Another solution can be Postgres with Extension (PostGIS)\nfor geography data, and use pg_trgm for index/query text data\n-- Given that this is a small amount of data, \n10M businesses x 1kb each = 10GB + 10M businesses x 100 reviews each x 1kb = 1TB, \nwe don't need to worry too much about scaling, \nsomething that Elasticsearch excels at, so this is a perfectly reasonable solution.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EcMi-MRD5gS-gN79A1fEt",
      "type": "text",
      "x": 918.305126855432,
      "y": 1826.529536258382,
      "width": 8,
      "height": 25,
