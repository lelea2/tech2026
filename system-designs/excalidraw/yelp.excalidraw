      "updated": 1785723356893,
      "link": null,
      "locked": false,
      "text": "S3 / GCS / ADLS + Iceberg \n/ Delta / Hudi\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "S3 / GCS / ADLS + Iceberg \n/ Delta / Hudi\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JJEdwJMUxPKw3Mzc-ANAp",
      "type": "text",
      "x": 899.2247275187922,
      "y": 250.13466247504417,
      "width": 427.59627406205766,
      "height": 56.01740434875711,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 1232931592,
      "version": 204,
      "versionNonce": 1438302941,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785723356893,
      "link": null,
      "locked": false,
      "text": "A T+1 Truth Path in system design refers to an architectural pattern\nthat guarantees system correctness and data consistency \nwithin exactly one business day (Transaction + 1 Day). \nIt separates real-time user experiences from the authoritative \"Single Source of Truth\" (SSOT), \nallowing asynchronous reconciliation over 24 hours.",
      "fontSize": 8.96278469580114,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A T+1 Truth Path in system design refers to an architectural pattern\nthat guarantees system correctness and data consistency \nwithin exactly one business day (Transaction + 1 Day). \nIt separates real-time user experiences from the authoritative \"Single Source of Truth\" (SSOT), \nallowing asynchronous reconciliation over 24 hours.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RlNSY8pP-kVfm-EPd6N0A",
      "type": "text",
      "x": 1932.4736213728886,
      "y": 694.2382650031624,
      "width": 213.74986716257868,
      "height": 259.6063449585061,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
