      "versionNonce": 174925171,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785723356893,
      "link": null,
      "locked": false,
      "text": "Use an OLAP store such as:\nDruid / Pinot / ClickHouse / BigQuery /\nSnowflake\n\nStore rows like:\n\nmetric_name\nwindow_type\nwindow_start\nwindow_end\nplatform\ncountry\napp_version\nestimate_value\nexact_value\nhll_sketch\nstatus: provisional | final | corrected\nupdated_at\nmetric_version\n",
      "fontSize": 10.384253798340243,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use an OLAP store such as:\nDruid / Pinot / ClickHouse / BigQuery / Snowflake\n\nStore rows like:\n\nmetric_name\nwindow_type\nwindow_start\nwindow_end\nplatform\ncountry\napp_version\nestimate_value\nexact_value\nhll_sketch\nstatus: provisional | final | corrected\nupdated_at\nmetric_version\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
