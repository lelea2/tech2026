      "isDeleted": false,
      "boundElements": [],
      "updated": 1786473760368,
      "link": null,
      "locked": false,
      "text": "KEY TRADEOFFS\n\nKafka vs direct DB\nReplayability wins at scale\n\nPrecompute vs raw query\nUse both\n\nHot OLAP vs data lake\nHot for UX, lake for cost\n\nExactly-once vs at-least-once\nUse deterministic dedup",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r80",
      "originalText": "KEY TRADEOFFS\n\nKafka vs direct DB\nReplayability wins at scale\n\nPrecompute vs raw query\nUse both\n\nHot OLAP vs data lake\nHot for UX, lake for cost\n\nExactly-once vs at-least-once\nUse deterministic dedup",
      "autoResize": false,
      "lineHeight": 1.25
    },
