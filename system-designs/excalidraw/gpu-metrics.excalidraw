      "boundElements": [],
      "updated": 1786473760368,
      "link": null,
      "locked": false,
      "text": "NEW METRIC ROLLOUT\n\n1. Schema registry\n2. Collector feature flag\n3. Canary hosts\n4. Verify ingest\n5. Verify storage\n6. Validate coverage/nulls\n7. Enable aggregation\n8. Dashboard support\n9. Gradual fleet rollout\n10. Watch cardinality/cost",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "r78",
      "originalText": "NEW METRIC ROLLOUT\n\n1. Schema registry\n2. Collector feature flag\n3. Canary hosts\n4. Verify ingest\n5. Verify storage\n6. Validate coverage/nulls\n7. Enable aggregation\n8. Dashboard support\n9. Gradual fleet rollout\n10. Watch cardinality/cost",
      "autoResize": false,
      "lineHeight": 1.25
    },
