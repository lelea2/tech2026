    {
      "id": "t7",
      "type": "text",
      "x": 1085,
      "y": 134.43132790935442,
      "width": 476,
      "height": 233.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
