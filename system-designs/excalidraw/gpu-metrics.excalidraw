    {
      "id": "RTGYcJFBO1M3yGP09eUIi",
      "type": "text",
      "x": 70.18847688968418,
      "y": -134.02755447305128,
      "width": 1390.799072265625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
