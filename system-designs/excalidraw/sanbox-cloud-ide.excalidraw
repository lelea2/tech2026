      "isDeleted": false,
      "boundElements": [],
      "updated": 1782224190184,
      "link": null,
      "locked": false,
      "text": "Functional\n• Create/start/stop/suspend/resume/delete sessions\n• Browser terminal + code execution\n• Real-time stdout/stderr streaming\n• Runtime templates: Python/Node/Java\n• Persistent filesystem\n• CPU/memory/disk limits\n• Replay logs after reconnect",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional\n• Create/start/stop/suspend/resume/delete sessions\n• Browser terminal + code execution\n• Real-time stdout/stderr streaming\n• Runtime templates: Python/Node/Java\n• Persistent filesystem\n• CPU/memory/disk limits\n• Replay logs after reconnect",
      "lineHeight": 1.25,
      "index": "a3",
      "autoResize": true
    },
