      "seed": 1973377145,
      "version": 2,
      "versionNonce": 1704454502,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782224190184,
      "link": null,
      "locked": false,
      "text": "API design\nPOST   /v1/sandboxsessions\nPOST   /v1/sandboxsessions/{id}/resume\nPOST   /v1/sandboxsessions/{id}/suspend\nDELETE /v1/sandboxsessions/{id}\nGET    /v1/sandboxsessions/{id}\nGET    /v1/sandboxsessions/{id}/logs?offset=\n\nLifecycle writes include idempotencyKey.\nResponses return sessionId, status, connectUrl.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API design\nPOST   /v1/sandboxsessions\nPOST   /v1/sandboxsessions/{id}/resume\nPOST   /v1/sandboxsessions/{id}/suspend\nDELETE /v1/sandboxsessions/{id}\nGET    /v1/sandboxsessions/{id}\nGET    /v1/sandboxsessions/{id}/logs?offset=\n\nLifecycle writes include idempotencyKey.\nResponses return sessionId, status, connectUrl.",
      "lineHeight": 1.25,
      "index": "b0x",
      "autoResize": true
    },
    {
      "id": "jhMX5Fd5gnFORDAaxLhis",
      "type": "rectangle",
      "x": 679.9025354564692,
      "y": 1440,
      "width": 718.0852933222477,
      "height": 352.84081351277604,
      "angle": 0,
      "strokeColor": "#1e1e1e",
