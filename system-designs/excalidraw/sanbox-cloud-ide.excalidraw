      "boundElements": [],
      "updated": 1782224190184,
      "link": null,
      "locked": false,
      "text": "Non-functional\n• 50K active sandboxes peak\n• Cold start < 5s with warm pool\n• Log ingress ~50 MB/s\n• 7-day log retention\n• 10 GB/sandbox, 10 PB total\n• 99.9% management-plane availability\n• At-least-once log delivery\n• Safe retries + concurrent lifecycle correctness",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional\n• 50K active sandboxes peak\n• Cold start < 5s with warm pool\n• Log ingress ~50 MB/s\n• 7-day log retention\n• 10 GB/sandbox, 10 PB total\n• 99.9% management-plane availability\n• At-least-once log delivery\n• Safe retries + concurrent lifecycle correctness",
      "lineHeight": 1.25,
      "index": "a5",
      "autoResize": true
