      "index": "b10"
    },
    {
      "id": "eZTpu4tzSJ0pmq6hkiwAM",
      "type": "text",
      "x": 1495.0253674425867,
      "y": 1473.2970622702605,
      "width": 712.725830078125,
      "height": 97.1685614983628,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1174851480,
      "version": 175,
      "versionNonce": 1425632954,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782224363671,
      "link": null,
      "locked": false,
      "text": "Scaling notes\n• 50K active sandboxes require horizontally scaled routers + distributed compute pools.\n• 50 MB/s logs is practical with Kafka/Pulsar partitioned by sessionId/sandboxId.\n• 10 PB storage needs tiering: hot active volumes, warm snapshots, archived object storage.\n• Warm pools should be sized per runtime based on recent demand, not one global pool.",
      "fontSize": 15.546969839738049,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scaling notes\n• 50K active sandboxes require horizontally scaled routers + distributed compute pools.\n• 50 MB/s logs is practical with Kafka/Pulsar partitioned by sessionId/sandboxId.\n• 10 PB storage needs tiering: hot active volumes, warm snapshots, archived object storage.\n• Warm pools should be sized per runtime based on recent demand, not one global pool.",
      "lineHeight": 1.25,
      "index": "b11",
      "autoResize": true
    }
  ],
