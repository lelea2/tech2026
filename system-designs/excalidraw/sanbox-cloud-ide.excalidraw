    {
      "id": "34STsMxhV4a2u1bYFA2z5",
      "type": "text",
      "x": 85,
      "y": 1465,
      "width": 510,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
