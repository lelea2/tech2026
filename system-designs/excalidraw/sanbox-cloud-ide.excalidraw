    {
      "id": "MK2liFvJwt6QPPDZ04v96",
      "type": "text",
      "x": 80,
      "y": 155,
      "width": 350,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
