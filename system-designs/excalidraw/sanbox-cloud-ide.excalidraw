      "link": null,
      "locked": false,
      "text": "Colab-like browser IDE with isolated runtime sandboxes, persistent workspaces, terminal access, lifecycle management, and real-time logs.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Colab-like browser IDE with isolated runtime sandboxes, persistent workspaces, terminal access, lifecycle management, and real-time logs.",
      "lineHeight": 1.25,
      "index": "a1",
      "autoResize": true
    },
