    {
      "id": "IejwNcA1llXYCDZuaJPc9",
      "type": "text",
      "x": 299,
      "y": 61.5,
      "width": 816.199462890625,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
