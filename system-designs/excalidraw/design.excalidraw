    {
      "id": "1kxqcXsAaolu1Sx-FheGx",
      "type": "text",
      "x": 1710.4411345769954,
      "y": 1582.0966129640756,
      "width": 1585.7388916015625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
