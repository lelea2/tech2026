      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MCP vs function calling \u2192 model intent format vs standardized tool-provider protocol.\nTimeout \u2260 failed side effect \u2192 reconcile before retry; idempotency + expectedVersion for writes.\nSecurity \u2192 LLM has no raw credentials; policy gateway owns authorization, tenant isolation and approval.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MCP vs function calling \u2192 model intent format vs standardized tool-provider protocol.\nTimeout \u2260 failed side effect \u2192 reconcile before retry; idempotency + expectedVersion for writes.\nSecurity \u2192 LLM has no raw credentials; policy gateway owns authorization, tenant isolation and approval.",
      "autoResize": true,
      "lineHeight": 1.25
    }
