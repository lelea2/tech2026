      "isDeleted": false,
      "boundElements": [],
      "updated": 1782309064768,
      "link": null,
      "locked": false,
      "text": "Application → SDK Local Cache returns immediately when fresh (<10ms, usually in-process). Background poll/SSE → Read Service → Redis → Postgres/S3 on cache miss.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Application → SDK Local Cache returns immediately when fresh (<10ms, usually in-process). Background poll/SSE → Read Service → Redis → Postgres/S3 on cache miss.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b03"
    },
    {
