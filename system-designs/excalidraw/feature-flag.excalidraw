    {
      "id": "6283164a773e4e11b0c7",
      "type": "text",
      "x": 83.05859375,
      "y": 1268.6328125,
      "width": 1395.9,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1485767693,
      "version": 128,
      "versionNonce": 2022916188,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782308293204,
      "link": null,
      "locked": false,
      "text": "Rollback creates a new current version derived from an older snapshot. Never mutate history; preserve audit trail and deterministic recovery.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rollback creates a new current version derived from an older snapshot. Never mutate history; preserve audit trail and deterministic recovery.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b05"
    },
