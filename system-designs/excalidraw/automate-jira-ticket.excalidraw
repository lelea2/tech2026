    {
      "id": "jpC7Uf7_yoZYGl5UNsP3x",
      "type": "text",
      "x": 358.2421875,
      "y": 176.4375,
      "width": 752.6713256835938,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 837539834,
      "version": 369,
      "versionNonce": 409391974,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786117188002,
      "link": null,
      "locked": false,
      "text": "Durable workflow, constraint agent, sandbox, deterministic validation, human-controlled published\n\n\nJira \n→ Trigger/API \n→ Policy & Risk \n→ Temporal \n→ Context Service \n→ Coding Agent \n→ Isolated Sandbox \n→ Validation/Repair Loop \n→ GitHub App \n→ Draft PR \n→ Jira update\n\n\n\n-  Temporal for durable long-running orchestration\n- PostgreSQL for run metadata/idempotency\n- S3/GCS for artifacts\n- Kubernetes Jobs + gVisor with optional Firecracker for sandboxing, \n- GitHub App short-lived tokens for publishing\n- SSE for frontend progress, \nand a constrained Planner → Executor → Verifier agent architecture.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Durable workflow, constraint agent, sandbox, deterministic validation, human-controlled published\n\n\nJira \n→ Trigger/API \n→ Policy & Risk \n→ Temporal \n→ Context Service \n→ Coding Agent \n→ Isolated Sandbox \n→ Validation/Repair Loop \n→ GitHub App \n→ Draft PR \n→ Jira update\n\n\n\n-  Temporal for durable long-running orchestration\n- PostgreSQL for run metadata/idempotency\n- S3/GCS for artifacts\n- Kubernetes Jobs + gVisor with optional Firecracker for sandboxing, \n- GitHub App short-lived tokens for publishing\n- SSE for frontend progress, \nand a constrained Planner → Executor → Verifier agent architecture.",
      "autoResize": true,
      "lineHeight": 1.25
    },
