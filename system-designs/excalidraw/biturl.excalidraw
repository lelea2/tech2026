    {
      "id": "vAmaUwMB-AMYi2AYLWshN",
      "type": "text",
      "x": 270.4649963746057,
      "y": 1283.7737863868617,
      "width": 666.5175961303712,
      "height": 139.28906250000006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4X",
      "roundness": null,
      "seed": 599891493,
      "version": 251,
      "versionNonce": 1004747223,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787257745601,
      "link": null,
      "locked": false,
      "text": "For 302 redirect is often preferred because:\n* It gives us more control over the redirection process, \nallowing us to update or expire links as needed.\n* It prevents browsers from caching the redirect, \nwhich could cause issues if we need to change or delete the short URL in the future.\n* It allows us to track click statistics \nfor each short URL (even though this is out of scope for this design).",
      "fontSize": 15.918749999999983,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For 302 redirect is often preferred because:\n* It gives us more control over the redirection process, \nallowing us to update or expire links as needed.\n* It prevents browsers from caching the redirect, \nwhich could cause issues if we need to change or delete the short URL in the future.\n* It allows us to track click statistics \nfor each short URL (even though this is out of scope for this design).",
      "autoResize": true,
      "lineHeight": 1.25
    },
