    },
    {
      "id": "4AyOH2bFxFlYjdL82xBHg",
      "type": "text",
      "x": 1132.9495586212486,
      "y": 235.646065501357,
      "width": 956.019287109375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4x",
      "roundness": null,
      "seed": 2127959851,
      "version": 691,
      "versionNonce": 1475987641,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787257936233,
      "link": null,
      "locked": false,
      "text": "-- To improve redirect speed, use in-memory cache like Redis/Memcache\n-- Memory access is faster the SSD or HDD \n(support millions reads/second vs SSD ~100000IOPS or HDD 100-200 IOPS)\n-- Cache invalidation:\n--- issue can occurs when update or delete (though short URL is mostly READ, so this is minimal)\n--- cache need time to warm up, initial request still hit DB until cahce is populated\n--- Memory limitation need to determine policy for cache (eg: LRU)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- To improve redirect speed, use in-memory cache like Redis/Memcache\n-- Memory access is faster the SSD or HDD \n(support millions reads/second vs SSD ~100000IOPS or HDD 100-200 IOPS)\n-- Cache invalidation:\n--- issue can occurs when update or delete (though short URL is mostly READ, so this is minimal)\n--- cache need time to warm up, initial request still hit DB until cahce is populated\n--- Memory limitation need to determine policy for cache (eg: LRU)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_c6bvTP5lA4qojQIhfL6w",
      "type": "text",
      "x": 1129.4348852711917,
      "y": 427.1497687808069,
      "width": 1177.9993896484375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4z",
      "roundness": null,
      "seed": 1741710379,
      "version": 1076,
      "versionNonce": 216757625,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787257932283,
      "link": null,
      "locked": false,
      "text": "\n-- short URL is served through CDN with PoPs (point of presence) geographically distributed around the world\n-- CDN cache the mapping of short codes to long URLS, allowing redirect request to be handled closer to user's location\n-- Redirect happen at CDN level, and never reach primary server so reducing latency\n-- Cons\n* Cache validation across CDN is complex\n-- setting up edge computing requires additional confirguation and understand serverless function at edge\n-- Higher cost (especially for edge set up)\n-- Debug and monitoring can be challenging\n==> depending on traffic patterns, price sentivity and user requirement\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n-- short URL is served through CDN with PoPs (point of presence) geographically distributed around the world\n-- CDN cache the mapping of short codes to long URLS, allowing redirect request to be handled closer to user's location\n-- Redirect happen at CDN level, and never reach primary server so reducing latency\n-- Cons\n* Cache validation across CDN is complex\n-- setting up edge computing requires additional confirguation and understand serverless function at edge\n-- Higher cost (especially for edge set up)\n-- Debug and monitoring can be challenging\n==> depending on traffic patterns, price sentivity and user requirement\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2DpVlVMgLKHooJyJCtVOe",
      "type": "text",
      "x": 1116.3669036711574,
      "y": 712.4232469141344,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
