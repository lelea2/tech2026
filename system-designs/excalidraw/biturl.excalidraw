    {
      "id": "wNVgzumLtNLI99KFWAcLh",
      "type": "text",
      "x": 1114.2615015892202,
      "y": 749.3047911648484,
      "width": 1241.0191650390625,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b51",
      "roundness": null,
      "seed": 1652308197,
      "version": 1572,
      "versionNonce": 746739223,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787258115785,
      "link": null,
      "locked": false,
      "text": "-- each row in DB consist short code (~8 bytes), long URL (100 chars -- ~100bytes), creationTime (~8bytes), \ncustom alias (~100bytes), expiration_date (~8bytes) -- ~100 bytes per row, and route up to 500 bytes (additional metadata)\n-- 1B mapping --> 500bytes * 1B rows = 500GB. \n-- Read heavy application will mostly happen through cache, write throuput is low\n-- Estimate ~100k new urls/days (whichever will work -- Postgres, dynamoDB, etc...)\n\n\n1. DB replication: if one server goes down, can redirect to another. Add complexity to ensure\nprimary server can interact with any replica without issues.\n\n2. DB backup: periodically take snapshot of DB and store in seperate location\nHorizontal scaling:\n-- can be good for READ but not for WRITE (for counter)\n-- add more instances of serve to distribute the load across multiple server\n-- help to handle large request per second without increase load in one single server\n-- store counter in Redis, and shared across write service, Redis is single thread,\nWrite will get next counter value from Redis instance, compute short code,\nand store the mapping in DB\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- each row in DB consist short code (~8 bytes), long URL (100 chars -- ~100bytes), creationTime (~8bytes), \ncustom alias (~100bytes), expiration_date (~8bytes) -- ~100 bytes per row, and route up to 500 bytes (additional metadata)\n-- 1B mapping --> 500bytes * 1B rows = 500GB. \n-- Read heavy application will mostly happen through cache, write throuput is low\n-- Estimate ~100k new urls/days (whichever will work -- Postgres, dynamoDB, etc...)\n\n\n1. DB replication: if one server goes down, can redirect to another. Add complexity to ensure\nprimary server can interact with any replica without issues.\n\n2. DB backup: periodically take snapshot of DB and store in seperate location\nHorizontal scaling:\n-- can be good for READ but not for WRITE (for counter)\n-- add more instances of serve to distribute the load across multiple server\n-- help to handle large request per second without increase load in one single server\n-- store counter in Redis, and shared across write service, Redis is single thread,\nWrite will get next counter value from Redis instance, compute short code,\nand store the mapping in DB\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VQZL4MkmTVyhLwqeykM5h",
