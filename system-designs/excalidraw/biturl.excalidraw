      "boundElements": [],
      "updated": 1781817320873,
      "link": null,
      "locked": false,
      "text": "API\n* POSt /urls \nBody request: { \"long_url\": \"....\", \"custom_alias\": \"....\", \"expiration_date\": \"...\"}\nResponse: {\"short_url\": \"....\"}\n\n* Redirection GET /{short_code} (or {short_url})\n--> 302 direct to original long URL",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API\n* POSt /urls \nBody request: { \"long_url\": \"....\", \"custom_alias\": \"....\", \"expiration_date\": \"...\"}\nResponse: {\"short_url\": \"....\"}\n\n* Redirection GET /{short_code} (or {short_url})\n--> 302 direct to original long URL",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
