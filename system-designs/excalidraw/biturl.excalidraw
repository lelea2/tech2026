    {
      "id": "6ZXgIVPbRdb1vZvEIfiEA",
      "type": "text",
      "x": 285,
      "y": 607.37890625,
      "width": 731.5195922851562,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
