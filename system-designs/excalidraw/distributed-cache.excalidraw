    {
      "id": "Z34tY8Zwcydh1XkoVJL4j",
      "type": "text",
      "x": -711.3515625,
      "y": 323.91796875,
      "width": 651.4794921875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
