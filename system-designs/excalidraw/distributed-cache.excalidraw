    {
      "id": "S9jJBzocZXy4C_Ux4i11L",
      "type": "text",
      "x": -371.58984375,
      "y": -107.46875,
      "width": 1198.819091796875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 1839038812,
      "version": 129,
      "versionNonce": 267048292,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782304506797,
      "link": null,
      "locked": false,
      "text": "An **in-memory database** stores the working dataset primarily in RAM to provide very low-latency reads and writes. \nA good staff-level answer should avoid jumping directly to Redis. \nStart with the product contract, then design the single-node core, then expand into durability, \nconcurrency, eviction, replication, sharding, observability, and operational trade-offs.\n\nA reasonable target is something like **Redis / Memcached-like key-value storage**, with optional durability and clustering.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An **in-memory database** stores the working dataset primarily in RAM to provide very low-latency reads and writes. \nA good staff-level answer should avoid jumping directly to Redis. \nStart with the product contract, then design the single-node core, then expand into durability, \nconcurrency, eviction, replication, sharding, observability, and operational trade-offs.\n\nA reasonable target is something like **Redis / Memcached-like key-value storage**, with optional durability and clustering.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cPXOl_wdraarpBsoc-lz6",
      "type": "rectangle",
      "x": -742.859375,
