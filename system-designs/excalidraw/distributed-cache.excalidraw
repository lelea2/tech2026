    {
      "id": "K70yjdoTY-4LJZiT7MrnO",
      "type": "text",
      "x": 1344,
      "y": 98.5,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
