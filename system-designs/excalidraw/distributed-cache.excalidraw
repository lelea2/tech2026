    {
      "id": "TZdo76vLQISb-wXAJZZrf",
      "type": "text",
      "x": -715.578125,
      "y": 115.90625,
      "width": 741.779541015625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 1277358052,
      "version": 211,
      "versionNonce": 280188892,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782304748570,
      "link": null,
      "locked": false,
      "text": "FUnctional\n1. Users should be able to set, get, and delete key-value pairs.\n2. Users should be able to configure the expiration time for key-value pairs.\n3. Data should be evicted according to Least Recently Used (LRU) policy.\n========================\nshould able to configure cache size",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FUnctional\n1. Users should be able to set, get, and delete key-value pairs.\n2. Users should be able to configure the expiration time for key-value pairs.\n3. Data should be evicted according to Least Recently Used (LRU) policy.\n========================\nshould able to configure cache size",
      "autoResize": true,
      "lineHeight": 1.25
    },
