      "index": "aE",
      "roundness": null,
      "seed": 1011294451,
      "version": 550,
      "versionNonce": 1231454397,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785818398119,
      "link": null,
      "locked": false,
      "text": "1) Customer should be able to query availability of items, find distribution center (DC) within 1\nhour delivery\n2) Customer able to order items (order services --> nearby services) \n3) Making sure not double order. PG is ACID, putting order and inventory in same DB to take\nadvantage of this, 2 users try to order the same item, one of them will be rejected.  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Customer should be able to query availability of items, find distribution center (DC) within 1 hour delivery\n2) Customer able to order items (order services --> nearby services) \n3) Making sure not double order. PG is ACID, putting order and inventory in same DB to take advantage of this, 2 users try to order the same item, one of them will be rejected.  ",
      "autoResize": false,
      "lineHeight": 1.25
    },
