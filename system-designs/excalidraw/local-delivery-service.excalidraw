    {
      "id": "77AxCnFYNA5siqtMooUtE",
      "type": "text",
      "x": 1292,
      "y": 692.6171875,
      "width": 854.519287109375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
