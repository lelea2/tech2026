    {
      "id": "PnPx9I6a2tLmvCaiLntsi",
      "type": "text",
      "x": 1273.734375,
      "y": -231.25,
      "width": 940.3112182617189,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
