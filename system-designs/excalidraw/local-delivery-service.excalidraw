      "link": null,
      "locked": false,
      "text": "API\n\nGET /availability?lat={}&long={}&keyword={}&page_size={}&page_num={}\nReponse \n[{ items: {name, quatity}}]\n\nPOST /order \n{ lat, long, items: []} -> Order | Failure",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API\n\nGET /availability?lat={}&long={}&keyword={}&page_size={}&page_num={}\nReponse \n[{ items: {name, quatity}}]\n\nPOST /order \n{ lat, long, items: []} -> Order | Failure",
      "autoResize": true,
      "lineHeight": 1.25
