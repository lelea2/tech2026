    {
      "id": "JXhE3XmkebUo6PYw8_T8T",
      "type": "text",
      "x": 2168.9716741402103,
      "y": 996.3661888130212,
      "width": 588.6394653320312,
      "height": 140,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2U",
      "roundness": null,
      "seed": 1928059261,
      "version": 170,
      "versionNonce": 1497833981,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785530685317,
      "link": null,
      "locked": false,
      "text": "* Defer to SSE unless we need bi-directional communication (slack chatapp)\n* How to minimize spread of state across architecture\n* Scaling:\nLoad can be uneven which can result in hotspots and failures. \nUsing a \"least connections\" strategy for the load balancer can help, \nas well as minimizing the amount of work the WebSocket servers \nneed to do as they process messages",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Defer to SSE unless we need bi-directional communication (slack chatapp)\n* How to minimize spread of state across architecture\n* Scaling:\nLoad can be uneven which can result in hotspots and failures. \nUsing a \"least connections\" strategy for the load balancer can help, \nas well as minimizing the amount of work the WebSocket servers \nneed to do as they process messages",
      "autoResize": true,
      "lineHeight": 1.25
    },
