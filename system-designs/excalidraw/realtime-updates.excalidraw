      "isDeleted": false,
      "boundElements": null,
      "updated": 1785531632286,
      "link": null,
      "locked": false,
      "text": "async function poll() {\n  const response = await fetch('/api/updates');\n  const data = await response.json();\n  processData(data);\n}\n\n// Poll every 2 seconds\nsetInterval(poll, 2000);",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async function poll() {\n  const response = await fetch('/api/updates');\n  const data = await response.json();\n  processData(data);\n}\n\n// Poll every 2 seconds\nsetInterval(poll, 2000);",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pbOIfh9pZYPvmuMUrPLrr",
      "type": "text",
      "x": 336.95720734488856,
      "y": -104.30343605862453,
      "width": 535.879638671875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b21",
      "roundness": null,
      "seed": 1579029693,
      "version": 658,
      "versionNonce": 796886515,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785531628151,
      "link": null,
      "locked": false,
      "text": "** Long polling **\nAdvantage\n* Standard HTTP, easy to implement\n* Stateless server side, no special infra needed\nDisadvantage\n* High latency, more HTTP overhead\n* Resource intensive, Not suitable for frequent update\n* Request hang around long time => hard to monitor\n* Browser limit the number of concurrent connections\nper domain.  \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** Long polling **\nAdvantage\n* Standard HTTP, easy to implement\n* Stateless server side, no special infra needed\nDisadvantage\n* High latency, more HTTP overhead\n* Resource intensive, Not suitable for frequent update\n* Request hang around long time => hard to monitor\n* Browser limit the number of concurrent connections\nper domain.  \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BTWh1j8Ceb-PX7PIa6Ag9",
