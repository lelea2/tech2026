    {
      "id": "tXSexRgIKaCIixmetcmHv",
      "type": "text",
      "x": 1659.964553108366,
      "y": 1617.886695597298,
      "width": 487.071533203125,
      "height": 440,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Z",
      "roundness": null,
      "seed": 1727191997,
      "version": 37,
      "versionNonce": 1720343229,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785531432283,
      "link": null,
      "locked": false,
      "text": "// Simplified WebRTC setup\nasync function startCall() {\n  const pc = new RTCPeerConnection();\n  \n  // Get local stream\n  const stream = await navigator.mediaDevices.getUserMedia({\n    video: true,\n    audio: true\n  });\n  \n  // Add tracks to peer connection\n  stream.getTracks().forEach(track => {\n    pc.addTrack(track, stream);\n  });\n  \n  // Create and send offer\n  const offer = await pc.createOffer();\n  await pc.setLocalDescription(offer);\n  \n  // Send offer to signaling server\n  signalingServer.send(offer);\n}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Simplified WebRTC setup\nasync function startCall() {\n  const pc = new RTCPeerConnection();\n  \n  // Get local stream\n  const stream = await navigator.mediaDevices.getUserMedia({\n    video: true,\n    audio: true\n  });\n  \n  // Add tracks to peer connection\n  stream.getTracks().forEach(track => {\n    pc.addTrack(track, stream);\n  });\n  \n  // Create and send offer\n  const offer = await pc.createOffer();\n  await pc.setLocalDescription(offer);\n  \n  // Send offer to signaling server\n  signalingServer.send(offer);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
