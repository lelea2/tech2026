    {
      "id": "3olszJrNmBNcrpidRFoA4",
      "type": "text",
      "x": 1162.02373857221,
      "y": 1628.2543607588775,
      "width": 325.2397766113281,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2c",
      "roundness": null,
      "seed": 622120659,
      "version": 254,
      "versionNonce": 1960742195,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785531501958,
      "link": null,
      "locked": false,
      "text": "Advantage\n* Direct peer communication\n* Low latency/reduce server cost\n* Native audio/video support\n\nDisadvantage\n* Complex setup\n* Require signaling serer\n* NAT/firewall issues\n* Connection set up delay",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Advantage\n* Direct peer communication\n* Low latency/reduce server cost\n* Native audio/video support\n\nDisadvantage\n* Complex setup\n* Require signaling serer\n* NAT/firewall issues\n* Connection set up delay",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
