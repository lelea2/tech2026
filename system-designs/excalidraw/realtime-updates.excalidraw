    {
      "id": "eSlF4Z5uWvWqRS83jUbqG",
      "type": "text",
      "x": 354.7351376479851,
      "y": -518.4672295731149,
      "width": 479.2996826171875,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
