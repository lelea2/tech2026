    {
      "id": "5wRqqx6GznLr8_DBY0KH2",
      "type": "text",
      "x": 938.909416189923,
      "y": -406.6662538952055,
      "width": 369.0556640625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
