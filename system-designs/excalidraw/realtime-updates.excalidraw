    {
      "id": "THjANLog4f8mEKALA-595",
      "type": "text",
      "x": 304.3069215070886,
      "y": 33.4442472367582,
      "width": 240.8398895263672,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
