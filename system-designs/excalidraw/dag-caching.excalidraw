      "link": null,
      "locked": false,
      "text": "L1 RAM\n ↓ miss\nL2 local SSD\n ↓ miss\nL3 distributed/shared cache\n ↓ miss\nDurable materialized storage\n ↓ miss\nRecompute",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
