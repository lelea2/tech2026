    {
      "id": "O8-jUdZ-ufz6JNSMHUvH0",
      "type": "text",
      "x": 429,
      "y": -247.5,
      "width": 305.5397644042969,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7G",
      "roundness": null,
      "seed": 1335579423,
      "version": 51,
      "versionNonce": 1092615519,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787262736545,
      "link": null,
      "locked": false,
      "text": "Granularity: What we will cache:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Granularity: What we will cache:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6AQQBNA7aDIy-kV2_CNVr",
      "type": "text",
      "x": 426.7109375,
      "y": -215.09765625,
      "width": 756.0322282791138,
      "height": 275.12109375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7H",
      "roundness": null,
      "seed": 2069358015,
      "version": 683,
      "versionNonce": 902959871,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787263275316,
      "link": null,
      "locked": false,
      "text": "1) Base blocks/columns: (eg: sales/2026-08-20/region=US) \n-- High reuse, more computation remains\n\n2) Intermediate DAG results (eg: daily sales grouped by region)\n-- reused by downstream service, invalidate more frequently\n\n3) Full materialized view (eg: dashboard result)\n-- lowest latency, low use + potentially large data\n\n\nCache-value = recompute_cost * expected_reuse * query_frequency/entrysize",
      "fontSize": 20.008806818181817,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Base blocks/columns: (eg: sales/2026-08-20/region=US) \n-- High reuse, more computation remains\n\n2) Intermediate DAG results (eg: daily sales grouped by region)\n-- reused by downstream service, invalidate more frequently\n\n3) Full materialized view (eg: dashboard result)\n-- lowest latency, low use + potentially large data\n\n\nCache-value = recompute_cost * expected_reuse * query_frequency/entrysize",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bQpigHahSHvzm6lYqXA2o",
      "type": "text",
      "x": 421.3125,
      "y": -581.30078125,
      "width": 1331.986083984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7J",
      "roundness": null,
      "seed": 1105732497,
      "version": 187,
      "versionNonce": 272551441,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787263152398,
      "link": null,
      "locked": false,
      "text": "materialized view is a database object that stores the precomputed results of a query. Unlike a regular database view—which is a\nvirtual table that runs its underlying query every single time it is accessed—a materialized view physically saves the data to the disk,\nfunctioning much like a concrete cache.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "materialized view is a database object that stores the precomputed results of a query. Unlike a regular database view—which is a virtual table that runs its underlying query every single time it is accessed—a materialized view physically saves the data to the disk, functioning much like a concrete cache.",
      "autoResize": false,
      "lineHeight": 1.25
    },
