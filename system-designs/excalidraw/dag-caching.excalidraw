    {
      "id": "u91m6wO7kn9OK8XvFgPaw",
      "type": "text",
      "x": 425.8125,
      "y": -453.53515625,
      "width": 373.1197204589844,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
