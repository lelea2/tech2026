    {
      "id": "vdCfyftdSvOwLoyruhlrG",
      "type": "text",
      "x": 425,
      "y": 191.5,
      "width": 278.97979736328125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7M",
      "roundness": null,
      "seed": 20161105,
      "version": 5,
      "versionNonce": 505058335,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787263326876,
      "link": null,
      "locked": false,
      "text": "MV A:\ncompute = 20 sec\nreuse = 100 queries/min\nsize = 50 MB\n=> excellent cache candidate\n\nMV B:\ncompute = 30 ms\nreuse = 1 query/hour\nsize = 2 GB\n=> do not cache",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MV A:\ncompute = 20 sec\nreuse = 100 queries/min\nsize = 50 MB\n=> excellent cache candidate\n\nMV B:\ncompute = 30 ms\nreuse = 1 query/hour\nsize = 2 GB\n=> do not cache",
      "autoResize": true,
      "lineHeight": 1.25
    },
