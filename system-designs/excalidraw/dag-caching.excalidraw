      "isDeleted": false,
      "boundElements": null,
      "updated": 1787262615922,
      "link": null,
      "locked": false,
      "text": "4 concerns:\n\n1) DAG metadata & lineage\n2) materialization/update propagation\n3) versioned cache storage\n4) query-time snapshot selection",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 concerns:\n\n1) DAG metadata & lineage\n2) materialization/update propagation\n3) versioned cache storage\n4) query-time snapshot selection",
      "autoResize": true,
      "lineHeight": 1.25
    },
