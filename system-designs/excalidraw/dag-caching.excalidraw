    {
      "id": "Wfh2YWHi8913ZjeqrQ9Xm",
      "type": "text",
      "x": 1195,
      "y": 275.5,
      "width": 277.8597717285156,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
