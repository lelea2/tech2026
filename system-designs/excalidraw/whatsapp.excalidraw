      "isDeleted": false,
      "boundElements": null,
      "updated": 1781827900270,
      "link": null,
      "locked": false,
      "text": "Functional requirements\n-- Start group chats (limit 100 users)\n-- Send-receive messages\n-- Send/receive media\n-- Access message after they've been offline\n-----\n-- Audio/video calling\n-- Interaction with businesses\n-- Registration profile management",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements\n-- Start group chats (limit 100 users)\n-- Send-receive messages\n-- Send/receive media\n-- Access message after they've been offline\n-----\n-- Audio/video calling\n-- Interaction with businesses\n-- Registration profile management",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2eLbsir0n9cmCOPKqDtGt",
      "type": "text",
      "x": 311,
      "y": 357.5,
      "width": 436.07965087890625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b58",
