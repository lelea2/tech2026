    {
      "id": "gOvTNFD3SvNv9tIQp-JBU",
      "type": "text",
      "x": 279.87109375,
      "y": 631.5,
      "width": 750.5794067382812,
      "height": 825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
