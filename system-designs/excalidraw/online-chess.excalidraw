    },
    {
      "id": "x2rDUugfhZe1XKKpMvW5K",
      "type": "text",
      "x": 1110,
      "y": 1317.5,
      "width": 925.29931640625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
