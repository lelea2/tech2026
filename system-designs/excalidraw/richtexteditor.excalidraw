    {
      "id": "GGVHsmx9ncNHGWjNbetSp",
      "type": "text",
      "x": 199.12109375,
      "y": 1195.5,
      "width": 1082.099365234375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 1075012026,
      "version": 100,
      "versionNonce": 1663616422,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781641851017,
      "link": null,
      "locked": false,
      "text": "** High level approach for interview\n1) Design an editor-specific model of the document content\n2) Create a mapping between the model and DOM elements\n3) Define a set of supported operations on this model (e.g. insert text at position, delete text, format text)\n4) Translate user events (keypresses and mouse clicks) into a sequence of these supported operations\n5) Update the DOM based on these operations, ideally with minimal DOM manipulation calls",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** High level approach for interview\n1) Design an editor-specific model of the document content\n2) Create a mapping between the model and DOM elements\n3) Define a set of supported operations on this model (e.g. insert text at position, delete text, format text)\n4) Translate user events (keypresses and mouse clicks) into a sequence of these supported operations\n5) Update the DOM based on these operations, ideally with minimal DOM manipulation calls",
      "autoResize": true,
      "lineHeight": 1.25
    },
