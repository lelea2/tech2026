    {
      "id": "dERecGKxZzUW_xj5IRT1W",
      "type": "text",
      "x": 67.38004501175851,
      "y": 3458.7650425135807,
      "width": 758.8479271376974,
      "height": 1597.0679946806747,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2C",
      "roundness": null,
      "seed": 2041485350,
      "version": 102,
      "versionNonce": 1326388966,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781649745872,
      "link": null,
      "locked": false,
      "text": "**** Editor\ninterface Editor {\n  // Reference to contenteditable DOM element.\n  rootElement: HTMLElement | null;\n  // Both current and pending EditorStates.\n  editorState: EditorState;\n  pendingEditorState: EditorState | null;\n\n  // Non-core fields are omitted.\n}\n\ntype NodeKey = string;\n\ninterface EditorState {\n  // Primarily contains content (nodes) and selection state.\n  nodes: EditorNodeMap;\n  rootNodeKey: NodeKey;\n  selection: EditorSelection | null;\n}\n\ninterface EditorNode {\n  parent: NodeKey | null;\n  prev: NodeKey | null;\n  next: NodeKey | null;\n}\n\ninterface ElementNode extends EditorNode {\n  type: 'element';\n  firstChild: NodeKey | null;\n  lastChild: NodeKey | null;\n  // Can contain other fields, depending on the node type.\n}\n\ninterface TextNode extends EditorNode {\n  type: 'text';\n  text: string;\n  format: string[];\n}\n\ntype EditorNodeMap = Record<NodeKey, EditorNode>;\n\ninterface EditorSelection {\n  anchorNode: EditorNode | null;\n  anchorOffset: number;\n  focusNode: EditorNode | null;\n  focusOffset: number;\n  type: 'caret' | 'range';\n}\n",
      "fontSize": 26.074579504990602,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**** Editor\ninterface Editor {\n  // Reference to contenteditable DOM element.\n  rootElement: HTMLElement | null;\n  // Both current and pending EditorStates.\n  editorState: EditorState;\n  pendingEditorState: EditorState | null;\n\n  // Non-core fields are omitted.\n}\n\ntype NodeKey = string;\n\ninterface EditorState {\n  // Primarily contains content (nodes) and selection state.\n  nodes: EditorNodeMap;\n  rootNodeKey: NodeKey;\n  selection: EditorSelection | null;\n}\n\ninterface EditorNode {\n  parent: NodeKey | null;\n  prev: NodeKey | null;\n  next: NodeKey | null;\n}\n\ninterface ElementNode extends EditorNode {\n  type: 'element';\n  firstChild: NodeKey | null;\n  lastChild: NodeKey | null;\n  // Can contain other fields, depending on the node type.\n}\n\ninterface TextNode extends EditorNode {\n  type: 'text';\n  text: string;\n  format: string[];\n}\n\ntype EditorNodeMap = Record<NodeKey, EditorNode>;\n\ninterface EditorSelection {\n  anchorNode: EditorNode | null;\n  anchorOffset: number;\n  focusNode: EditorNode | null;\n  focusOffset: number;\n  type: 'caret' | 'range';\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5aqwFCfquzFyG2xrgnWNX",
      "type": "text",
      "x": 1045.9219132786357,
      "y": 3403.7990695463395,
      "width": 611.5259651042334,
      "height": 950.2040441570185,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2D",
      "roundness": null,
      "seed": 223497402,
      "version": 335,
      "versionNonce": 1479087162,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781649852557,
      "link": null,
      "locked": false,
      "text": "*** EditorNode APIs:\neditorNode.getParent()\neditorNode.getNextSibling()\neditorNode.insertAfter()\neditorNode.insertBefore()\neditorNode.isSelected()\neditorNode.getTextContent()\n\n** ElementNode API\nelementNode.getChildren()\nelementNode.getFirstChild()\nelementNode.getLastChild()\n\n** TextNode API\ntextNode.setTextContent()\ntextNode.setFormat()\ntextNode.getFormat()\n",
      "fontSize": 42.23129085142305,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** EditorNode APIs:\neditorNode.getParent()\neditorNode.getNextSibling()\neditorNode.insertAfter()\neditorNode.insertBefore()\neditorNode.isSelected()\neditorNode.getTextContent()\n\n** ElementNode API\nelementNode.getChildren()\nelementNode.getFirstChild()\nelementNode.getLastChild()\n\n** TextNode API\ntextNode.setTextContent()\ntextNode.setFormat()\ntextNode.getFormat()\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
