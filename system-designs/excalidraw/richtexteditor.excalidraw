      "isDeleted": false,
      "boundElements": null,
      "updated": 1781641816240,
      "link": null,
      "locked": false,
      "text": "{\n  type: \"document\",\n  children: [\n    {\n      type: \"heading\",\n      children: [{ type: \"text\", content: \"Hello\" }]\n    },\n    {\n      type: \"paragraph\",\n      children: [\n        { type: \"text\", content: \"This is John Doe. \" },\n        { type: \"text\", content: \"He is strong\", bold: true }]\n    },\n  ]\n}\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n  type: \"document\",\n  children: [\n    {\n      type: \"heading\",\n      children: [{ type: \"text\", content: \"Hello\" }]\n    },\n    {\n      type: \"paragraph\",\n      children: [\n        { type: \"text\", content: \"This is John Doe. \" },\n        { type: \"text\", content: \"He is strong\", bold: true }]\n    },\n  ]\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
