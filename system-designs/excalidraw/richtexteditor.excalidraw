    {
      "id": "22Lde7mzFUs7fKLgY7Jbl",
      "type": "text",
      "x": 217.27734375,
      "y": 686.890625,
      "width": 844.4419661736484,
      "height": 143.44921875,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1h",
      "roundness": null,
      "seed": 137285350,
      "version": 151,
      "versionNonce": 1204419962,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781641062464,
      "link": null,
      "locked": false,
      "text": "*** Model and State design\n-- The DOM is what you render, not what you store. \nA separate in-memory model gives you undo/redo, serialization, headless testing, \nand, critically, protection from browser extensions and pasted markup quietly rewriting state. \nEvery production-grade editor (Lexical, Slate, Tiptap/ProseMirror, Quill) keeps its own model and reconciles to the DOM.\n\n\n",
      "fontSize": 14.344921874999995,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Model and State design\n-- The DOM is what you render, not what you store. \nA separate in-memory model gives you undo/redo, serialization, headless testing, \nand, critically, protection from browser extensions and pasted markup quietly rewriting state. \nEvery production-grade editor (Lexical, Slate, Tiptap/ProseMirror, Quill) keeps its own model and reconciles to the DOM.\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qi9C-S2NzZjVeTd_iiqAb",
