      "isDeleted": false,
      "boundElements": null,
      "updated": 1781643342355,
      "link": null,
      "locked": false,
      "text": "*** Input UI\n--- Content element `contenteditable` add event listeners (eg: input, click, keydown...)\n--- Toolbar element: contain formatting button, rich text editor\n--- Headless mode: used for test, no DOM to update\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Input UI\n--- Content element `contenteditable` add event listeners (eg: input, click, keydown...)\n--- Toolbar element: contain formatting button, rich text editor\n--- Headless mode: used for test, no DOM to update\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uF_1mTzs5IVFue03n6Jue",
      "type": "text",
      "x": 151.18604020761563,
      "y": 1990.6660389254325,
      "width": 604.9196166992188,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1z",
      "roundness": null,
      "seed": 1285663290,
      "version": 93,
      "versionNonce": 417587002,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781643470015,
      "link": null,
      "locked": false,
      "text": "*** Data model\n-- Tree like structure (like DOM tree) for content state node\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Data model\n-- Tree like structure (like DOM tree) for content state node\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
