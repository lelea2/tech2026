    {
      "id": "U4IB8_3xS3WwmZg2iTEsQ",
      "type": "text",
      "x": 573.8464810525528,
      "y": -166.5,
      "width": 170.31983947753906,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
