      "isDeleted": true,
      "boundElements": null,
      "updated": 1781634444077,
      "link": null,
      "locked": false,
      "text": "***** Network optimization\n--- Error states\n--- Reading offline (service worker, cache-first strategy)\n--- Writing offline with an outbox: should never drop user action because lost of connectivity. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "***** Network optimization\n--- Error states\n--- Reading offline (service worker, cache-first strategy)\n--- Writing offline with an outbox: should never drop user action because lost of connectivity. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
