    {
      "id": "65Q5yEZ0JM7t5AJ7FTQdD",
      "type": "text",
      "x": 771,
      "y": 845,
      "width": 686.927490234375,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1n",
      "roundness": null,
      "seed": 518593958,
      "version": 685,
      "versionNonce": 272984250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781641471651,
      "link": null,
      "locked": false,
      "text": "** During utilization\n--- initialize all required state (content state, selection state)\n--- editor loops through content state and renders in DOM\n\n** Update\n--- Updating will modify the underlying state model and result in DOM update\n--- How do we know DOM update is blowing away the whole DOM or rerender partially???\n* editor intercept event (input/keypress), insert character, delete character\n* Making a clone of content state\n* Modify cloned content state\n* compare original content state with clone\n* Modify DOM based on determined changes\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "** During utilization\n--- initialize all required state (content state, selection state)\n--- editor loops through content state and renders in DOM\n\n** Update\n--- Updating will modify the underlying state model and result in DOM update\n--- How do we know DOM update is blowing away the whole DOM or rerender partially???\n* editor intercept event (input/keypress), insert character, delete character\n* Making a clone of content state\n* Modify cloned content state\n* compare original content state with clone\n* Modify DOM based on determined changes\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MTMnVvtTDJMIPv1Lj_LNA",
      "type": "text",
      "x": 219,
      "y": 1198,
      "width": 6.399993896484375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
