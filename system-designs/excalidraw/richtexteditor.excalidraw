    {
      "id": "2yV8iGsaUe49j65UDW0NJ",
      "type": "text",
      "x": 491,
      "y": 152.5,
      "width": 1214.2191162109375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1b",
      "roundness": null,
      "seed": 177473830,
      "version": 627,
      "versionNonce": 226508134,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781635721904,
      "link": null,
      "locked": false,
      "text": "*** Requirements\n-- Formatting features supported: block formatting (headings, paragraphs, blockquotes), \n& inline formatting (bold, underline, italics)\n-- Use browser default stylesheet to determine how element should be style, further customization could be discussed later\n-- Support media?? (Image/video)\n-- Any keyboard shortcut for editor (copy/cut/paste/redo)\n-- Non-func (performance, user experience on edit)\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Requirements\n-- Formatting features supported: block formatting (headings, paragraphs, blockquotes), \n& inline formatting (bold, underline, italics)\n-- Use browser default stylesheet to determine how element should be style, further customization could be discussed later\n-- Support media?? (Image/video)\n-- Any keyboard shortcut for editor (copy/cut/paste/redo)\n-- Non-func (performance, user experience on edit)\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Cn6JCKDYkPuT6ZBO6Wrrt",
