    {
      "id": "lulXDH3HNvCmt5BYnFp-S",
      "type": "text",
      "x": -738.2252153272229,
      "y": 432.9002219772202,
      "width": 662.3015486263369,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 1015688406,
      "version": 86,
      "versionNonce": 1615373386,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787095222248,
      "link": null,
      "locked": false,
      "text": "Query Algorithm:\n\n1. Pick geohash precision ≈ requested radius.\n2. Compute the 3×3 neighbor block of cells around the search\npoint.\n3. Fan out to the shards owning those cells in parallel (cheap\nbecause it's a handful of shards, not a full scan).\n4. Merge candidates, then post-filter with exact haversine distance\nagainst the true radius.\n5. If text/category filters are present, intersect with the text-\nindex match (same index, since it's a combined geo+text index).\n6. Hand the surviving candidate set to Ranking.\n7. For very large radius requests, walk to a coarser precision first\nto bound fan-out cost, rather than querying hundreds of fine-\ngrained cells.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Query Algorithm:\n\n1. Pick geohash precision ≈ requested radius.\n2. Compute the 3×3 neighbor block of cells around the search point.\n3. Fan out to the shards owning those cells in parallel (cheap because it's a handful of shards, not a full scan).\n4. Merge candidates, then post-filter with exact haversine distance against the true radius.\n5. If text/category filters are present, intersect with the text-index match (same index, since it's a combined geo+text index).\n6. Hand the surviving candidate set to Ranking.\n7. For very large radius requests, walk to a coarser precision first to bound fan-out cost, rather than querying hundreds of fine-grained cells.",
      "autoResize": false,
      "lineHeight": 1.25
    },
