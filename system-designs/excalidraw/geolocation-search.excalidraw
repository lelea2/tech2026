      "versionNonce": 73230922,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787097882784,
      "link": null,
      "locked": false,
      "text": "- Static place: low write QPS, async CDC - batch/eventual index update\n- Mobile entities: high QPS (every ping 2-5s/entity), show update on READ within second, not miniute",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Static place: low write QPS, async CDC - batch/eventual index update\n- Mobile entities: high QPS (every ping 2-5s/entity), show update on READ within second, not miniute",
      "autoResize": true,
      "lineHeight": 1.25
    },
