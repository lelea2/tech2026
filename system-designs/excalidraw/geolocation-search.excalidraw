    },
    {
      "id": "D96x3j4-XomUqfoazv86Q",
      "type": "text",
      "x": 542.5896596193221,
      "y": 1986.3573860558333,
      "width": 785.2393188476562,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b04",
      "roundness": null,
      "seed": 2034229974,
      "version": 350,
      "versionNonce": 1720010646,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787097788174,
      "link": null,
      "locked": false,
      "text": "- GPS pings can arrive faster than the index should absorb each individual write\n- Debounce/coalesce to latest position per entity per short window (2-5s)\n- Keep raw ping history in append-only log for analytics (not for search)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- GPS pings can arrive faster than the index should absorb each individual write\n- Debounce/coalesce to latest position per entity per short window (2-5s)\n- Keep raw ping history in append-only log for analytics (not for search)",
      "autoResize": true,
      "lineHeight": 1.25
    },
