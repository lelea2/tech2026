      "link": null,
      "locked": false,
      "text": "==> Recommendations: \n- geohash or S2-cell prefix, sharded by prefix, is the pragmatic default for a from-scratch design \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "==> Recommendations: \n- geohash or S2-cell prefix, sharded by prefix, is the pragmatic default for a from-scratch design \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
