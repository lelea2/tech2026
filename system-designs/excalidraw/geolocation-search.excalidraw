    {
      "id": "v0NugbiPD0_rphpvFey0M",
      "type": "text",
      "x": 555.2633267361147,
      "y": 2525.90023223711,
      "width": 1025.3880941592865,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
