    {
      "id": "eyuzNFqpmrEAVm8_FOXGH",
      "type": "text",
      "x": 553.4742990025385,
      "y": 2382.7695175248905,
      "width": 803.139404296875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 805090826,
      "version": 300,
      "versionNonce": 1134731478,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787099939566,
      "link": null,
      "locked": false,
      "text": "- Dense urban cells get more search (REAAD) and more entities updates (WRITE)\n- Write hot-spotting is dangerous:1 single write bottleneck per cell\n- Mitigate: adaptive precision + sub-shard a hot cell's entities by entity_id hash",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Dense urban cells get more search (REAAD) and more entities updates (WRITE)\n- Write hot-spotting is dangerous:1 single write bottleneck per cell\n- Mitigate: adaptive precision + sub-shard a hot cell's entities by entity_id hash",
      "autoResize": true,
      "lineHeight": 1.25
    },
