    {
      "id": "4tfX89m2i1UxtBJwq6ClH",
      "type": "text",
      "x": -728.0450626010529,
      "y": -4.301480718025573,
      "width": 915.7155230098986,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
