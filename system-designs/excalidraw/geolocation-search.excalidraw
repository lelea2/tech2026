      "seed": 899826186,
      "version": 291,
      "versionNonce": 137984214,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787099937432,
      "link": null,
      "locked": false,
      "text": "- Static - immutable/segment-base index, periodic rebuild \n- Mobile entities - mutable in-memory grid/hash (geohash-cell -> set of entity, ids). O(1) 'move'\n= remove old cell + add new cell (Eg: Redis GEO sorted sets)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Static - immutable/segment-base index, periodic rebuild \n- Mobile entities - mutable in-memory grid/hash (geohash-cell -> set of entity, ids). O(1) 'move'\n= remove old cell + add new cell (Eg: Redis GEO sorted sets)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wJUlYddnA491n6EpADKML",
      "type": "text",
