    {
      "id": "B1RCCQKG45NONT4SdbwSs",
      "type": "text",
      "x": 354.984375,
      "y": 1757.09765625,
      "width": 934.2166748046875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
