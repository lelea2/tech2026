    },
    {
      "id": "8xe_H3VOCjBvn6ahlVM0v",
      "type": "text",
      "x": 346,
      "y": 2443.5,
      "width": 1041.9193115234375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5d",
      "roundness": null,
      "seed": 1743125190,
      "version": 165,
      "versionNonce": 629528474,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787328215343,
      "link": null,
      "locked": false,
      "text": "- Metrics: go to timeseries or SQL store, where point for one series are contiguous and compress to byte \n- Log: full text search required",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Metrics: go to timeseries or SQL store, where point for one series are contiguous and compress to byte \n- Log: full text search required",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZPb-YKf1LCqICIhaMEGNo",
      "type": "text",
      "x": 338,
      "y": 2507.5,
      "width": 570.919677734375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
