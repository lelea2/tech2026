    },
    {
      "id": "yUnzqGdVkXccEKoMfff5S",
      "type": "text",
      "x": 323.2421875,
      "y": 180.9140625,
      "width": 724.6995239257812,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5G",
      "roundness": null,
      "seed": 1558407130,
      "version": 123,
      "versionNonce": 1091699930,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787326644068,
      "link": null,
      "locked": false,
      "text": "Requirements:\n1. Five severity levels: DEBUG < INFO < WARN < ERROR < FATAL.\n2. Each record carries timestamp, level, message, emitting thread name.\n3. Logger writes each record to one or more destinations, set at startup.\n4. Each destination has its own min-level threshold and its own format.\n   Format and destination type vary independently.\n5. Concurrent calls are safe. A record's bytes never interleave with\n   another record's bytes on the same destination.\n\n\nOut of scope:\n- Hot-reloading config at runtime\n- Async / buffered writes\n- Remote / network destinations in v1 (design should accommodate)\n- Hierarchical / named loggers (com.app.service inheriting from com.app)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements:\n1. Five severity levels: DEBUG < INFO < WARN < ERROR < FATAL.\n2. Each record carries timestamp, level, message, emitting thread name.\n3. Logger writes each record to one or more destinations, set at startup.\n4. Each destination has its own min-level threshold and its own format.\n   Format and destination type vary independently.\n5. Concurrent calls are safe. A record's bytes never interleave with\n   another record's bytes on the same destination.\n\n\nOut of scope:\n- Hot-reloading config at runtime\n- Async / buffered writes\n- Remote / network destinations in v1 (design should accommodate)\n- Hierarchical / named loggers (com.app.service inheriting from com.app)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WED09VwAh_lMgGct6JtaJ",
      "type": "rectangle",
      "x": 298.94140625,
      "y": 150.3125,
      "width": 804.3359375,
