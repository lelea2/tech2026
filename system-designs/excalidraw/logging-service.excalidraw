    {
      "id": "3aB9IqJryKVMWQro14rJv",
      "type": "text",
      "x": 1143,
      "y": 157.5,
      "width": 395.6197509765625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
