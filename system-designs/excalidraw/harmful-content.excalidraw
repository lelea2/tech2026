      "seed": 571128192,
      "version": 628,
      "versionNonce": 1248532864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786916174359,
      "link": null,
      "locked": false,
      "text": "QUESTIONS\n1) Are posts text-only or include image/videos/other medias?\n2) kind of content want to detect (nudity, violence, etc...)\n3) what happen if we found harmful content?\n4) what are the consequences of false positive and false negatives?\n5) how quickly need to detect harmful content?\n6) data available of initial training or need cold start?\n(eg: data labelled vs not)\n7) harmful comments or just post?\n8) how many posts/per day? (volume)\n9) how common are harmful posts?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "QUESTIONS\n1) Are posts text-only or include image/videos/other medias?\n2) kind of content want to detect (nudity, violence, etc...)\n3) what happen if we found harmful content?\n4) what are the consequences of false positive and false negatives?\n5) how quickly need to detect harmful content?\n6) data available of initial training or need cold start?\n(eg: data labelled vs not)\n7) harmful comments or just post?\n8) how many posts/per day? (volume)\n9) how common are harmful posts?",
      "autoResize": true,
      "lineHeight": 1.25
    },
