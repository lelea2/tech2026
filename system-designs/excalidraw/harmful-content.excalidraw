    {
      "id": "io9BJNYV2s22l4NWQzXio",
      "type": "text",
      "x": 402.421875,
      "y": 642.9140625,
      "width": 646.142578125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2d",
      "roundness": null,
      "seed": 2023127424,
      "version": 285,
      "versionNonce": 1663314304,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786920337849,
      "link": null,
      "locked": false,
      "text": "Model selection Requirements:\n\n1) The ability to handle multiple modalities (text and images)\n2) The capacity to incorporate behavioral and user features\n3) Efficient inference to handle 1B posts per day\n4) The ability to update predictions as new behavioral data\narrives (and handle missing data when it hasn't arrived yet)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Model selection Requirements:\n\n1) The ability to handle multiple modalities (text and images)\n2) The capacity to incorporate behavioral and user features\n3) Efficient inference to handle 1B posts per day\n4) The ability to update predictions as new behavioral data arrives (and handle missing data when it hasn't arrived yet)",
      "autoResize": false,
      "lineHeight": 1.25
    },
