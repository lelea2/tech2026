      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "==> Data drift is a common cause for model performance degradation. \nIf your model tested well but performance has gradually worsened over time ==> most likely drift\n",
      "autoResize": true,
      "lineHeight": 1.25
