    {
      "id": "PJ8RvIGgY3LLCcbyxS-nm",
      "type": "text",
      "x": 421.373046875,
      "y": 244.857421875,
      "width": 604.637939453125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": null,
      "seed": 990714240,
      "version": 472,
      "versionNonce": 970559104,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786916396180,
      "link": null,
      "locked": false,
      "text": "BUSINESS OBJECTIVE:\n\n1) Minimize number of successful user report on harmful\ncontent\n-- might not be perfect, label-free since based on user's\nreport\n\n2) Minimize number of views on harmful content, subject to\nprecision guardrails\n-- this metrics require to label content on regular basis in\norder to evaluate the quantity. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BUSINESS OBJECTIVE:\n\n1) Minimize number of successful user report on harmful content\n-- might not be perfect, label-free since based on user's report\n\n2) Minimize number of views on harmful content, subject to precision guardrails\n-- this metrics require to label content on regular basis in order to evaluate the quantity. ",
      "autoResize": false,
      "lineHeight": 1.25
    },
