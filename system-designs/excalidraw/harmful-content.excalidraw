    {
      "id": "yXjC-MWCo4Zib7r0nuwvG",
      "type": "text",
      "x": 405.033203125,
      "y": -343.419921875,
      "width": 667.739501953125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
