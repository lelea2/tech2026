    {
      "id": "gCjSb298tLk0MX7LKM8WW",
      "type": "text",
      "x": 900.2113211867793,
      "y": 1699.8704731311257,
      "width": 1010.71923828125,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
