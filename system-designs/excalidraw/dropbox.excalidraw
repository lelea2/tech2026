      "text": "API\n\n* Upload: POST /file Request {file, fileMetadata}\n* Download: GET /files/{fileId} (file, fileMetadata)\n* SHare: POST /files/{fileId}/share\n* change: GET /files/changes?since={timestamp} \n--> changeEvent[]",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API\n\n* Upload: POST /file Request {file, fileMetadata}\n* Download: GET /files/{fileId} (file, fileMetadata)\n* SHare: POST /files/{fileId}/share\n* change: GET /files/changes?since={timestamp} \n--> changeEvent[]",
      "autoResize": true,
      "lineHeight": 1.25
