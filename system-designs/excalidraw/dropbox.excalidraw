      "link": null,
      "locked": false,
      "text": "-- POST /files/presigned-url -> PresignedUrl\n-- Request: { FileMetadata }\n\n* Download from blobstorage vs. download from CDN (better approach would be CDN)\n-- GET /files/{fileId}/presigned-url -> PresignedUrl to download file from blobStorage\n--> geographical issue for user far away from region\n-- CDN: cache file closer to user. SInce CDN is network of servers distributed across \nthe globe, it will reduce latency and speed up download time\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- POST /files/presigned-url -> PresignedUrl\n-- Request: { FileMetadata }\n\n* Download from blobstorage vs. download from CDN (better approach would be CDN)\n-- GET /files/{fileId}/presigned-url -> PresignedUrl to download file from blobStorage\n--> geographical issue for user far away from region\n-- CDN: cache file closer to user. SInce CDN is network of servers distributed across \nthe globe, it will reduce latency and speed up download time\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
