    {
      "id": "text_4a162b6b",
      "type": "text",
      "x": 2378,
      "y": 3064,
      "width": 1164,
      "height": 34,
      "angle": 0,
      "strokeColor": "#4338ca",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
