      "fontSize": 11.900726944001775,
      "fontFamily": 1,
      "text": "Document\n  id, tenantId, title, headVersion, permissions\n\nSceneNode\n  id, type, parentId, zIndex, transform, bounds,\n  style, contentRef, revision, deleted\n\nOperation\n  opId, actorId, clientSeq, baseVersion,\n  type, targetIds, payload, timestamp\n\nSnapshot\n  documentId, version, compressedScene, assetRefs\n\nSession / Presence\n  userId, connectionId, cursor, viewport, selection\n\nAsset\n  assetId, mimeType, size, storageKey, checksum\n\nComment / Thread\n  anchorNodeId or canvasPosition, status\n\nUndoGroup\n  actorId, operationIds, inverseOps, status",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Document\n  id, tenantId, title, headVersion, permissions\n\nSceneNode\n  id, type, parentId, zIndex, transform, bounds,\n  style, contentRef, revision, deleted\n\nOperation\n  opId, actorId, clientSeq, baseVersion,\n  type, targetIds, payload, timestamp\n\nSnapshot\n  documentId, version, compressedScene, assetRefs\n\nSession / Presence\n  userId, connectionId, cursor, viewport, selection\n\nAsset\n  assetId, mimeType, size, storageKey, checksum\n\nComment / Thread\n  anchorNodeId or canvasPosition, status\n\nUndoGroup\n  actorId, operationIds, inverseOps, status",
      "lineHeight": 1.25,
      "baseline": 12,
      "index": "aA",
      "autoResize": true
    },
