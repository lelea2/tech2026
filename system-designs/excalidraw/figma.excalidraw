      "seed": 1,
      "version": 183,
      "versionNonce": 11381366,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785922959583,
      "link": null,
      "locked": false,
      "fontSize": 17.110075183399672,
      "fontFamily": 1,
      "text": "React App Shell\n  Route loader + auth + document metadata\n\nEditor Controller\n  Interaction state machine\n  Tool manager\n  Keyboard/gesture manager\n  Command bus\n\nScene Model\n  Normalized node map\n  Spatial index (R-tree / quadtree)\n  Derived world bounds\n  Dirty region tracker\n\nRender System\n  WebGL main scene\n  Canvas 2D fallback / text rasterization\n  SVG/DOM overlay for accessibility, inputs, handles\n\nState Boundaries\n  Persistent document state\n  Ephemeral viewport/selection/presence\n  Server cache vs local command history\n\nWorkers\n  Geometry/layout, image decode, hit-test assistance,\n  snapshot compression, export preparation\n\nPersistence\n  IndexedDB op queue + local snapshots",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "React App Shell\n  Route loader + auth + document metadata\n\nEditor Controller\n  Interaction state machine\n  Tool manager\n  Keyboard/gesture manager\n  Command bus\n\nScene Model\n  Normalized node map\n  Spatial index (R-tree / quadtree)\n  Derived world bounds\n  Dirty region tracker\n\nRender System\n  WebGL main scene\n  Canvas 2D fallback / text rasterization\n  SVG/DOM overlay for accessibility, inputs, handles\n\nState Boundaries\n  Persistent document state\n  Ephemeral viewport/selection/presence\n  Server cache vs local command history\n\nWorkers\n  Geometry/layout, image decode, hit-test assistance,\n  snapshot compression, export preparation\n\nPersistence\n  IndexedDB op queue + local snapshots",
      "lineHeight": 1.25,
      "baseline": 12,
      "index": "aG",
      "autoResize": true
    },
    {
      "id": "rect_10538706",
