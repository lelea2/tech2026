    },
    {
      "id": "text_fa95c859",
      "type": "text",
      "x": 908,
      "y": 236,
      "width": 784,
      "height": 452,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "version": 2,
      "versionNonce": 1604725610,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785922638434,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 1,
      "text": "• 60 FPS pan/zoom and drag target\n• <100 ms interaction response\n• <2 s initial shell load; progressive document paint\n• 100k objects without DOM explosion\n• Durable, ordered, idempotent operations\n• P99 collaboration propagation <250 ms regional\n• Recover from disconnect without lost edits\n• Memory ceiling per tab, leak detection\n• Accessible keyboard and screen-reader workflows\n• Secure tenant isolation and signed asset access\n• Observable rendering, network, sync, and storage\n• Graceful degradation on low-end devices",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• 60 FPS pan/zoom and drag target\n• <100 ms interaction response\n• <2 s initial shell load; progressive document paint\n• 100k objects without DOM explosion\n• Durable, ordered, idempotent operations\n• P99 collaboration propagation <250 ms regional\n• Recover from disconnect without lost edits\n• Memory ceiling per tab, leak detection\n• Accessible keyboard and screen-reader workflows\n• Secure tenant isolation and signed asset access\n• Observable rendering, network, sync, and storage\n• Graceful degradation on low-end devices",
      "lineHeight": 1.25,
      "baseline": 12,
      "index": "a7",
      "autoResize": true
    },
