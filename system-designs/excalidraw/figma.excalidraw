      "text": "1. Functional Requirements",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Functional Requirements",
      "lineHeight": 1.25,
      "baseline": 19,
      "index": "a3",
      "autoResize": true
    },
    {
      "id": "text_a18d2e93",
      "type": "text",
      "x": 57.70352785782302,
      "y": 236.14395066909015,
      "width": 410.4223327636719,
      "height": 238.41885182125785,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "version": 81,
      "versionNonce": 1552615530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785923641860,
      "link": null,
      "locked": false,
      "fontSize": 15.89459012141719,
      "fontFamily": 1,
      "text": "• Create/open/save design documents\n• Add, move, resize, rotate, group, lock, hide objects\n• Shapes, text, images, frames, components, layers\n• Pan/zoom, selection box, snapping, guides\n• Multi-select, copy/paste, duplicate\n• Undo/redo with local optimistic UX\n• Real-time multiplayer cursors, presence, comments\n• Offline edits + reconnect/rebase\n• Export PNG/SVG/PDF\n• Version history and restore\n• Permissions: owner/editor/commenter/viewer\n• Large-document support: 100k+ objects",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Create/open/save design documents\n• Add, move, resize, rotate, group, lock, hide objects\n• Shapes, text, images, frames, components, layers\n• Pan/zoom, selection box, snapping, guides\n• Multi-select, copy/paste, duplicate\n• Undo/redo with local optimistic UX\n• Real-time multiplayer cursors, presence, comments\n• Offline edits + reconnect/rebase\n• Export PNG/SVG/PDF\n• Version history and restore\n• Permissions: owner/editor/commenter/viewer\n• Large-document support: 100k+ objects",
      "lineHeight": 1.25,
      "baseline": 12,
      "index": "a4",
      "autoResize": true
    },
