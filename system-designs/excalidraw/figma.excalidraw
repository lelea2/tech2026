    {
      "id": "text_6895db76",
      "type": "text",
      "x": 58,
      "y": 1444,
      "width": 794,
      "height": 34,
      "angle": 0,
      "strokeColor": "#be123c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
