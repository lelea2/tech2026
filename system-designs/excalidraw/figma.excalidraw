      "fontSize": 16,
      "fontFamily": 1,
      "text": "HTTP\nGET  /documents/:id?version=\nPOST /documents\nGET  /documents/:id/snapshot\nGET  /documents/:id/ops?afterVersion=\nPOST /documents/:id/ops:batch\nPOST /documents/:id/assets/presign\nGET  /documents/:id/versions\nPOST /documents/:id/restore\nPOST /documents/:id/export\n\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP\nGET  /documents/:id?version=\nPOST /documents\nGET  /documents/:id/snapshot\nGET  /documents/:id/ops?afterVersion=\nPOST /documents/:id/ops:batch\nPOST /documents/:id/assets/presign\nGET  /documents/:id/versions\nPOST /documents/:id/restore\nPOST /documents/:id/export\n\n",
