      "boundElements": null,
      "updated": 1785922816073,
      "link": null,
      "locked": false,
      "text": "WebSocket\nclient.join {documentId, lastVersion, capabilities}\nserver.snapshot | server.ops\nclient.ops {ops[], clientSeq}\nserver.ack {clientSeq, committedVersion}\npresence.cursor / presence.selection / viewport\nserver.rebaseRequired {snapshotVersion}\nserver.permissionChanged\nserver.rateLimited\n\nContract rules\n• opId idempotency key\n• monotonic committedVersion\n• clientSeq preserves per-client order\n• schemaVersion supports evolution",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rect_2f8640cf",
      "originalText": "WebSocket\nclient.join {documentId, lastVersion, capabilities}\nserver.snapshot | server.ops\nclient.ops {ops[], clientSeq}\nserver.ack {clientSeq, committedVersion}\npresence.cursor / presence.selection / viewport\nserver.rebaseRequired {snapshotVersion}\nserver.permissionChanged\nserver.rateLimited\n\nContract rules\n• opId idempotency key\n• monotonic committedVersion\n• clientSeq preserves per-client order\n• schemaVersion supports evolution",
      "autoResize": true,
      "lineHeight": 1.25
    },
