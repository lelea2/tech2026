    {
      "id": "text_bfcba1f6",
      "type": "text",
      "x": 72.08916980223171,
      "y": 607.8083814715937,
      "width": 460.56876281080986,
      "height": 663.0154133567376,
      "angle": 0,
      "strokeColor": "#172033",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
