    {
      "id": "p-RY8fX7Hos1b7Ozm5-xy",
      "type": "text",
      "x": 251.24975570043895,
      "y": 3339.3465509463435,
      "width": 445.7725327818507,
      "height": 22.026962351828356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2F",
      "roundness": null,
      "seed": 315921326,
      "version": 219,
      "versionNonce": 573036974,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Events: Kafka is the immutable log/source of truth.",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Events: Kafka is the immutable log/source of truth.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mZp_sc7ByaugmZ3AoxBtT",
      "type": "text",
      "x": 148.43675785273794,
      "y": 3401.022045531463,
      "width": 651.3985284772527,
      "height": 22.026962351828356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 556942898,
      "version": 219,
      "versionNonce": 1478385714,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Delivery State: A dedicated KV store tracks (webhook_id, event_id) tuples.",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Delivery State: A dedicated KV store tracks (webhook_id, event_id) tuples.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "UOYQ8OnAAsdgDe76k8ioJ",
      "type": "text",
      "x": 132.79769524808515,
      "y": 3451.6840589406684,
      "width": 682.6766536865583,
      "height": 44.05392470365671,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": null,
      "seed": 1990323694,
      "version": 219,
      "versionNonce": 127693806,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Uses conditional writes to ensure a delivery is never processed twice (even if a\nworker crashes and restarts).",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uses conditional writes to ensure a delivery is never processed twice (even if a worker crashes and restarts).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "1-BbIKNXbA8GacI2-vaVo",
      "type": "text",
      "x": 143.52917107592074,
      "y": 3535.386515877616,
      "width": 661.2137020308871,
      "height": 44.05392470365671,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 791588850,
      "version": 219,
      "versionNonce": 629639666,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Client Side: The API accepts an Idempotency-Key so clients can safely retry\nregistration requests without creating duplicate webhooks.",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client Side: The API accepts an Idempotency-Key so clients can safely retry registration requests without creating duplicate webhooks.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "55RmINSDVQzaS0b_wqoQm",
      "type": "text",
      "x": 341.1989752686141,
      "y": 3630.102453990478,
      "width": 265.87409364550047,
      "height": 22.026962351828356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
