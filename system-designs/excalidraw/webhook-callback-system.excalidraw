      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Fault Tolerance Walkthrough",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r0o4xvyjawpfoLlbx1hZf",
      "type": "text",
      "x": 335.4896307239663,
      "y": 3660.940201283038,
      "width": 277.29278273479605,
      "height": 22.026962351828356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
