      "updated": 1785898018359,
      "link": null,
      "locked": false,
      "text": "API Routes\n\nPOST /webhooks\n{ callbackurl\n  event_types\n  retry_config\n}\nResponse: {webhook_id, signining_secret, status, create_at}\nPATCH /webhook/{webhook_id}\n{callbackurl, event_type, status}\nResponse: {webhook_id, status, update_at}\n\nDELETE /webhook/{webhook_id}\nResponse': 204 no content",
      "fontSize": 20.714285714285705,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Routes\n\nPOST /webhooks\n{ callbackurl\n  event_types\n  retry_config\n}\nResponse: {webhook_id, signining_secret, status, create_at}\nPATCH /webhook/{webhook_id}\n{callbackurl, event_type, status}\nResponse: {webhook_id, status, update_at}\n\nDELETE /webhook/{webhook_id}\nResponse': 204 no content",
      "autoResize": true,
      "lineHeight": 1.25
    },
