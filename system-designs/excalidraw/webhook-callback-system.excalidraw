    {
      "id": "PfCT9f1k7ZaJoaM05U7CC",
      "type": "text",
      "x": 915.5014896761304,
      "y": 786.1479551487012,
      "width": 657.799560546875,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 136169906,
      "version": 1112,
      "versionNonce": 1361384045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785898122550,
      "link": null,
      "locked": false,
      "text": "1. Client sends POST to /webhooks with JWT auth\n2. webhook manager validates the request\n3. Generate unique webhook_id and signing_secret\n4. store the confirguation in DB\n5. Caches essential lookup data in Redis\n6. Return webhook details include signing secret\n\n\n\n\n1. Event ingestion to event processor from dependency processor\n2. EVent processor finds the matching webhook info from cache/db\n3. after found, enqueue the delivery task\n\n\n\n\n1. Deliever worker pull task from queue\n2. Retrieves event data and webhook confirguration\n3. Generate HMAC signature\npayload == timestamp + JSON.stringify(event)\nsignature = HMAC_SHA256(webhook_signing_secret, payload)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Client sends POST to /webhooks with JWT auth\n2. webhook manager validates the request\n3. Generate unique webhook_id and signing_secret\n4. store the confirguation in DB\n5. Caches essential lookup data in Redis\n6. Return webhook details include signing secret\n\n\n\n\n1. Event ingestion to event processor from dependency processor\n2. EVent processor finds the matching webhook info from cache/db\n3. after found, enqueue the delivery task\n\n\n\n\n1. Deliever worker pull task from queue\n2. Retrieves event data and webhook confirguration\n3. Generate HMAC signature\npayload == timestamp + JSON.stringify(event)\nsignature = HMAC_SHA256(webhook_signing_secret, payload)",
      "autoResize": true,
      "lineHeight": 1.25
    },
