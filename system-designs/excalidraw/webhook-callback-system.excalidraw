      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Scenario 1: Redis (Cache) Failure",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scenario 1: Redis (Cache) Failure",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dVT33LRUZ9611ZNKMbTiE",
      "type": "text",
      "x": 141.6877202499137,
      "y": 3680.7644673996833,
      "width": 664.8966036829013,
      "height": 44.05392470365671,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2L",
      "roundness": null,
      "seed": 2142620270,
      "version": 219,
      "versionNonce": 205967470,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Problem: The Redis cluster holding the subscription index goes down or loses\ndata.",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem: The Redis cluster holding the subscription index goes down or loses data.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "sCOfTl0va9zJDj4GIjpSz",
      "type": "text",
      "x": 134.1545098809411,
      "y": 3711.602214692243,
      "width": 679.9630244208464,
      "height": 88.10784940731342,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2M",
      "roundness": null,
      "seed": 1463081842,
      "version": 219,
      "versionNonce": 1553937778,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Recovery: The Event Processor detects a connection failure or \"stale version\"\nerror. It falls back to querying the Multi-region Config Store (slower, but\naccurate) to route events while a background process rebuilds the Redis cache\nfrom the source of truth.",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recovery: The Event Processor detects a connection failure or \"stale version\" error. It falls back to querying the Multi-region Config Store (slower, but accurate) to route events while a background process rebuilds the Redis cache from the source of truth.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "aPNhytyXxq8wXV05XyQwX",
      "type": "text",
      "x": 360.13335694615444,
      "y": 3841.5612925680302,
      "width": 228.00533029041975,
      "height": 22.026962351828356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2N",
      "roundness": null,
      "seed": 128863406,
      "version": 219,
      "versionNonce": 674140846,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Scenario 2: Region Outage",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scenario 2: Region Outage",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4k8JOGyygo_yVfUjivRPv",
      "type": "text",
      "x": 275.13578076833835,
      "y": 3872.39903986059,
      "width": 398.0004826460519,
      "height": 22.026962351828356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2O",
      "roundness": null,
      "seed": 1252826418,
      "version": 219,
      "versionNonce": 633059122,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Problem: An entire AWS/GCP region goes dark.",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem: An entire AWS/GCP region goes dark.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CzUzHWCeph9gCC6BcPZtP",
      "type": "text",
      "x": 124.40093760995812,
      "y": 3881.2098248013212,
      "width": 699.4701689628124,
      "height": 66.08088705548506,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2P",
      "roundness": null,
      "seed": 2044495598,
      "version": 219,
      "versionNonce": 1852050670,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Recovery (Control Plane): DNS (Route53) fails over to the next nearest region.\nSince the database is a Multi-region Global Table, the new region already has the\ndata and can accept writes.",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recovery (Control Plane): DNS (Route53) fails over to the next nearest region. Since the database is a Multi-region Global Table, the new region already has the data and can accept writes.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "arF9GzhzfVELkEtTUJKZ8",
      "type": "text",
      "x": 121.89875857854156,
      "y": 3967.114977973452,
      "width": 704.4745270256456,
      "height": 44.05392470365671,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2Q",
      "roundness": null,
      "seed": 88483570,
      "version": 219,
      "versionNonce": 593625330,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Recovery (Data Plane): Kafka topics are mirrored (e.g., MirrorMaker 2). Workers in\nthe healthy region pick up the slack, consuming from the replicated topics.",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recovery (Data Plane): Kafka topics are mirrored (e.g., MirrorMaker 2). Workers in the healthy region pick up the slack, consuming from the replicated topics.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "KW5b37ug2pVy7nrxRNw_A",
      "type": "text",
      "x": 329.7185504547582,
      "y": 4030.993168793754,
      "width": 288.8349432732123,
      "height": 22.026962351828356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2R",
      "roundness": null,
      "seed": 1992915246,
      "version": 219,
      "versionNonce": 1013989166,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Scenario 3: Destination Downtime",
      "fontSize": 17.621569881462683,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scenario 3: Destination Downtime",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-6LLVmov15bQHj6IOPmRb",
      "type": "text",
      "x": 236.02472039839046,
      "y": 4061.8309160863137,
      "width": 476.2226033859477,
      "height": 22.026962351828356,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2S",
      "roundness": null,
      "seed": 1334343858,
      "version": 219,
      "versionNonce": 823726770,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782242284047,
      "link": null,
      "locked": false,
      "text": "Problem: The user's server is crashing (returning 500s).",
