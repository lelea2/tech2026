    {
      "id": "5OVFftfvnw6wVWzxRfwo6",
      "type": "text",
      "x": 3063.581580993411,
      "y": 820.9772403356529,
      "width": 538.7196044921875,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Y",
      "roundness": null,
      "seed": 1994926190,
      "version": 845,
      "versionNonce": 1813027139,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785898358459,
      "link": null,
      "locked": false,
      "text": "Delivery side: hot client receives high event volumn\npotentially overwhelm the infra, causing lots of \nevent retries delivery\n\nSolution\n-- per client queue partiitioning\n-- adaptive rate limit\n-- client: configurable rate limit\n-- priority queue\n\n\n\n\nSolution:\n-- horizontal scaling of webhook manager\n-- source rate limits\n-- backpressure: if queue fill up slow down ingestion\n-- batch processing: batch process the queue messages\n\nDB scaling\n-- partition event table by date\n-- read replicas for query load\n-- seperate DB for configuration vs. event logs\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Delivery side: hot client receives high event volumn\npotentially overwhelm the infra, causing lots of \nevent retries delivery\n\nSolution\n-- per client queue partiitioning\n-- adaptive rate limit\n-- client: configurable rate limit\n-- priority queue\n\n\n\n\nSolution:\n-- horizontal scaling of webhook manager\n-- source rate limits\n-- backpressure: if queue fill up slow down ingestion\n-- batch processing: batch process the queue messages\n\nDB scaling\n-- partition event table by date\n-- read replicas for query load\n-- seperate DB for configuration vs. event logs\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
