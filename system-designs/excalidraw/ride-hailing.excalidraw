    {
      "id": "e_lx5u_zG4PBe5PMIwOEg",
      "type": "text",
      "x": -5887.041434485388,
      "y": -13570.05096573767,
      "width": 330.5277099609375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 1392617779,
      "version": 4,
      "versionNonce": 1111470611,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786035337935,
      "link": null,
      "locked": false,
      "text": "Vehicle sends position, heading, speed, \nbattery, health, autonomy mode, sequence.\n\n• Authenticate device certificate\n• Partition by vehicleId\n• Deduplicate sequence numbers\n• Store raw late events for history\n• Update latest state only if newer\n• Re-index when cell changes\n• Expire eligibility after heartbeat TTL",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vehicle sends position, heading, speed, \nbattery, health, autonomy mode, sequence.\n\n• Authenticate device certificate\n• Partition by vehicleId\n• Deduplicate sequence numbers\n• Store raw late events for history\n• Update latest state only if newer\n• Re-index when cell changes\n• Expire eligibility after heartbeat TTL",
      "autoResize": true,
      "lineHeight": 1.25
    },
