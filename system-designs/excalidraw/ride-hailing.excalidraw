    {
      "id": "mWlmce0Z59g-ZoIL6V-Qp",
      "type": "text",
      "x": -6356.335976289212,
      "y": -13570.704579305648,
      "width": 345.7596435546875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 1278400243,
      "version": 407,
      "versionNonce": 2143930877,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786035111082,
      "link": null,
      "locked": false,
      "text": "1. validate rider, pickup, destination\n2. create request with idempotent key\n3. query nearby AVs by H3/S2\n4. Filter health, battery, capacity, staleness\n5. Refine using road pickup ETA\n6. Score for ETA, utilization, fairness\n7. Reserve via conditional write\n8. Persist trip + outbox assignment\n9. Vehicle ACK; ride receives events.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. validate rider, pickup, destination\n2. create request with idempotent key\n3. query nearby AVs by H3/S2\n4. Filter health, battery, capacity, staleness\n5. Refine using road pickup ETA\n6. Score for ETA, utilization, fairness\n7. Reserve via conditional write\n8. Persist trip + outbox assignment\n9. Vehicle ACK; ride receives events.",
      "autoResize": true,
      "lineHeight": 1.25
    },
