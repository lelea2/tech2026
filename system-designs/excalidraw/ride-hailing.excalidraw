      "seed": 2034278067,
      "version": 54,
      "versionNonce": 1887639229,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786035827238,
      "link": null,
      "locked": false,
      "text": "\nVehicle disappears after candidate lookup: \nreservation CAS fails; retry next candidate.\n\nVehicle disconnect: lease expires; remove from matching; \nactive trip enters uncertainty workflow.\n\n- Bus outage: outbox buffers events.\n- Index failure: rebuild from latest-state stream.\n- Payment failure: settle asynchronously.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nVehicle disappears after candidate lookup: \nreservation CAS fails; retry next candidate.\n\nVehicle disconnect: lease expires; remove from matching; \nactive trip enters uncertainty workflow.\n\n- Bus outage: outbox buffers events.\n- Index failure: rebuild from latest-state stream.\n- Payment failure: settle asynchronously.",
      "autoResize": true,
      "lineHeight": 1.25
    },
