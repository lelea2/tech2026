      "seed": 2010161395,
      "version": 355,
      "versionNonce": 1357981811,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786033709416,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n\n* Quote, request, match, pickup, trip, pay\n* Live vehicle/ETA updates\n* Cancel, support, incident flow\n* Fleet charging + rebalancing\n\nScale: 5M riders, 100K AVs\n20K requests/s, 1M telemetry/s\np95 quote < 300 ms; match 2s",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n\n* Quote, request, match, pickup, trip, pay\n* Live vehicle/ETA updates\n* Cancel, support, incident flow\n* Fleet charging + rebalancing\n\nScale: 5M riders, 100K AVs\n20K requests/s, 1M telemetry/s\np95 quote < 300 ms; match 2s",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pDnYR3icD57xR4kAuxeQc",
      "type": "text",
      "x": -6350.581247987689,
      "y": -14845.80747132171,
      "width": 352.2597351074219,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 1706328371,
      "version": 39,
      "versionNonce": 431657939,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786033741377,
      "link": null,
      "locked": false,
      "text": "\nNon-functional requirements\n\n• Safety > utilization\n• Strong consistency for ownership\n• Eventual consistency for position\n• City/zone fault isolation\n• Explainable dispatch decisions\n• Graceful hotspot degradation\n• Privacy + audited operator access\n• Replayable state and recovery",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nNon-functional requirements\n\n• Safety > utilization\n• Strong consistency for ownership\n• Eventual consistency for position\n• City/zone fault isolation\n• Explainable dispatch decisions\n• Graceful hotspot degradation\n• Privacy + audited operator access\n• Replayable state and recovery",
      "autoResize": true,
      "lineHeight": 1.25
    },
