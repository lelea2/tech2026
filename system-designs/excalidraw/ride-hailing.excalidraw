    {
      "id": "jXBYiKUepWqUudhR0Qdnk",
      "type": "text",
      "x": -6351.808979114191,
      "y": -15162.071877163013,
      "width": 400.79974365234375,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
