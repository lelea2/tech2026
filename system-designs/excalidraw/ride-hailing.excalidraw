      "boundElements": null,
      "updated": 1786035707616,
      "link": null,
      "locked": false,
      "text": "2) Dispatch Algorithm",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Dispatch Algorithm",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KN5dFyoXr-gazolIoWg77",
      "type": "text",
      "x": -5662.210942756295,
      "y": -13221.553182461645,
      "width": 740.8472900390625,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0i",
      "roundness": null,
      "seed": 219325405,
      "version": 6,
      "versionNonce": 1412589565,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786035730131,
      "link": null,
      "locked": false,
      "text": "Greedy: lowest latency, simple fallback, locally optimal.\n\nMicro-batch 100–500 ms: better global assignment, \nfairness and utilization; adds delay and solver complexity.\n\nCost = pickup ETA + deadhead + battery risk + rider wait + fairness + future supply imbalance.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Greedy: lowest latency, simple fallback, locally optimal.\n\nMicro-batch 100–500 ms: better global assignment, \nfairness and utilization; adds delay and solver complexity.\n\nCost = pickup ETA + deadhead + battery risk + rider wait + fairness + future supply imbalance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ps5jUtfYCcnlVJpCgiS_h",
      "type": "text",
      "x": -6358.769470748758,
      "y": -12892.946003050421,
      "width": 153.18385314941406,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
