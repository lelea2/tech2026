      "isDeleted": false,
      "boundElements": null,
      "updated": 1786035443954,
      "link": null,
      "locked": false,
      "text": "On vehicle: perception, motion planning,\n collision avoidance, emergency braking, \nminimal-risk maneuver.\n\nCloud: marketplace, mission assignment, \ngeofence/policy, route updates, \nremote-assistance workflow.\n\nCloud loss must not make the AV unsafe. \nContinue only while local policy permits; \notherwise execute minimal-risk stop.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On vehicle: perception, motion planning,\n collision avoidance, emergency braking, \nminimal-risk maneuver.\n\nCloud: marketplace, mission assignment, \ngeofence/policy, route updates, \nremote-assistance workflow.\n\nCloud loss must not make the AV unsafe. \nContinue only while local policy permits; \notherwise execute minimal-risk stop.",
      "autoResize": true,
      "lineHeight": 1.25
    },
