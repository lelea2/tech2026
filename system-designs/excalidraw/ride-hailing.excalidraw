      "updated": 1786035756156,
      "link": null,
      "locked": false,
      "text": "3) Stadium hotspot",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3) Stadium hotspot",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mnADfYF6xHC0J0C1XNskS",
      "type": "text",
      "x": -6355.7374219934145,
      "y": -12869.700295926117,
      "width": 304.3357238769531,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0l",
      "roundness": null,
      "seed": 1349828445,
      "version": 4,
      "versionNonce": 1466257875,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786035768806,
      "link": null,
      "locked": false,
      "text": "• Pre-stage AVs from demand forecast\n• Designated pickup corridors\n• Dynamic micro-zones\n• Admission control / virtual queue\n• Batch matching\n• Hot-cell subsharding\n• Reduce noncritical map refresh\n• Protect safety/command traffic\n• Prefer honest ETA ranges",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Pre-stage AVs from demand forecast\n• Designated pickup corridors\n• Dynamic micro-zones\n• Admission control / virtual queue\n• Batch matching\n• Hot-cell subsharding\n• Reduce noncritical map refresh\n• Protect safety/command traffic\n• Prefer honest ETA ranges",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wPdQlwfuyo6GX09-ZAgvq",
      "type": "text",
      "x": -5888.801913670441,
      "y": -12887.178004050998,
      "width": 438.2555847167969,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
