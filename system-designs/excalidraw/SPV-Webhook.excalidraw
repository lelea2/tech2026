      "boundElements": [],
      "updated": 1782235877724,
      "link": null,
      "locked": false,
      "text": "Design principle: treat provider webhooks as at-least-once, duplicate-prone, out-of-order external events. Verify → persist raw → dedupe → queue → normalize → reconcile → signal workflow.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Design principle: treat provider webhooks as at-least-once, duplicate-prone, out-of-order external events. Verify → persist raw → dedupe → queue → normalize → reconcile → signal workflow.",
      "lineHeight": 1.25,
      "index": "a1",
      "autoResize": true
    },
