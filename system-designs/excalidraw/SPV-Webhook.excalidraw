      "text": "State transition guard\n\nUPDATE investor_onboarding\nSET status = 'KYC_APPROVED'\nWHERE id = :investor_id\n  AND status = 'KYC_PENDING';\n\nIf 0 rows updated: duplicate, stale, or invalid transition. Store event, do not corrupt state.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "State transition guard\n\nUPDATE investor_onboarding\nSET status = 'KYC_APPROVED'\nWHERE id = :investor_id\n  AND status = 'KYC_PENDING';\n\nIf 0 rows updated: duplicate, stale, or invalid transition. Store event, do not corrupt state.",
      "lineHeight": 1.25,
      "index": "b0H",
      "autoResize": true
    },
