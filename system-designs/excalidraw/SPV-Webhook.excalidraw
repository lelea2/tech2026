      "link": null,
      "locked": false,
      "text": "Failure Handling + Replay Tool\n\nRetry transient failures with backoff\nDLQ permanent failures\nAdmin UI: inspect raw payload, failure reason, replay after bug fix, mark ignored\nRBAC + audit every replay",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Failure Handling + Replay Tool\n\nRetry transient failures with backoff\nDLQ permanent failures\nAdmin UI: inspect raw payload, failure reason, replay after bug fix, mark ignored\nRBAC + audit every replay",
      "lineHeight": 1.25,
      "index": "ao",
      "autoResize": true
