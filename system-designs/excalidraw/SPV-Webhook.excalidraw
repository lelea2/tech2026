      "boundElements": [],
      "updated": 1782236141731,
      "link": null,
      "locked": false,
      "text": "Security Controls\n\n- Separate endpoint secret per provider\n- Secret rotation via Vault / AWS Secrets Manager\n- WAF + request limits + IP allowlist when supported\n- Encrypt S3 + Postgres\n- Avoid raw PII in application logs",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Security Controls\n\n- Separate endpoint secret per provider\n- Secret rotation via Vault / AWS Secrets Manager\n- WAF + request limits + IP allowlist when supported\n- Encrypt S3 + Postgres\n- Avoid raw PII in application logs",
      "lineHeight": 1.25,
      "index": "av",
      "autoResize": true
    },
