      "text": "Postgres schema highlights\n\nraw_webhook_events(id, provider, provider_event_id, provider_object_id, event_type, raw_payload_uri, headers_jsonb, signature_verified, status, received_at, processed_at)\n\nUNIQUE(provider, provider_event_id)\n\nprovider_object_mappings(provider, object_type, provider_object_id, internal_entity_type, internal_entity_id)",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Postgres schema highlights\n\nraw_webhook_events(id, provider, provider_event_id, provider_object_id, event_type, raw_payload_uri, headers_jsonb, signature_verified, status, received_at, processed_at)\n\nUNIQUE(provider, provider_event_id)\n\nprovider_object_mappings(provider, object_type, provider_object_id, internal_entity_type, internal_entity_id)",
