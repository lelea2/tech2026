      "seed": 1800619577,
      "version": 218,
      "versionNonce": 1762913977,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786898884136,
      "link": null,
      "locked": false,
      "text": "This is heavy, we need restraint. Eg: only support sliding window for\nlast hour, while tumbling window as the window get larger",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is heavy, we need restraint. Eg: only support sliding window for last hour, while tumbling window as the window get larger",
      "autoResize": false,
      "lineHeight": 1.25
    },
