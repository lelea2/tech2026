    {
      "id": "NIbvGnjQI3psQisHGYZ_c",
      "type": "text",
      "x": 305,
      "y": 1136.5,
      "width": 480.47967529296875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bvO",
      "roundness": null,
      "seed": 1374620953,
      "version": 218,
      "versionNonce": 180987289,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786897351304,
      "link": null,
      "locked": false,
      "text": "* Sliding widow: last hour is [T-1hour] and [T].\nEg: if current time is 10:06, window is 9:06-10:06\n* Tumbling widow: last hour is full hour\n[Floor(T - 1 hour, 'hour')] and [Floor(T, 'hour')]\nEg: if current time is 10:06, then window is\n9-10\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Sliding widow: last hour is [T-1hour] and [T].\nEg: if current time is 10:06, window is 9:06-10:06\n* Tumbling widow: last hour is full hour\n[Floor(T - 1 hour, 'hour')] and [Floor(T, 'hour')]\nEg: if current time is 10:06, then window is\n9-10\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
