    {
      "id": "Sygy4xvxMzV6Ehrn-MKtq",
      "type": "text",
      "x": 871,
      "y": 1487.5,
      "width": 247.79983520507812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
