    {
      "id": "mSz9VP0vsDxMRiZWcA2qF",
      "type": "text",
      "x": 1029.8255811750528,
      "y": 2476.8655819822416,
      "width": 160.29986572265625,
      "height": 25,
      "angle": 0,
