    {
      "id": "MM6c_QCUpJEFbNYVoZhHP",
      "type": "text",
      "x": 378,
      "y": 384.5,
      "width": 474.979736328125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7C",
