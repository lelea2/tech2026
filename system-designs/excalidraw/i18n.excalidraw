    {
      "id": "9i0Myd6a3VhWczfbyKObo",
      "type": "text",
      "x": 1133.8518190674065,
      "y": 1807.3734621791739,
      "width": 814.0194091796875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6o",
      "roundness": null,
      "seed": 1432012133,
      "version": 446,
      "versionNonce": 1330869765,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781903383653,
      "link": null,
      "locked": false,
      "text": "* Keep log of individual request timestamp for each user\n* Remove all timestamp older than your current sliding window.\nCons:\n* memory usage, for user making ~1000 request per miniute,\nneed to store 1000 timstamp. Scaling to larger audience require much bigger memory\n==> computational overhead",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Keep log of individual request timestamp for each user\n* Remove all timestamp older than your current sliding window.\nCons:\n* memory usage, for user making ~1000 request per miniute,\nneed to store 1000 timstamp. Scaling to larger audience require much bigger memory\n==> computational overhead",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wAvki_JNL_gZzv5ngC-7w",
      "type": "text",
      "x": 320.0659463169497,
      "y": 2059.705112052152,
      "width": 944.579345703125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6p",
      "roundness": null,
      "seed": 1210343947,
      "version": 106,
      "versionNonce": 441096395,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781903383653,
      "link": null,
      "locked": false,
      "text": "==> Hybrid option: Sliding window counter\n-- maintain counters for the current window and the previous window. When a request arrives, \nyou estimate how many requests the user \"should have\" made in a true sliding window \nby weighing the previous and current windows based on how far you are into the current window.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "==> Hybrid option: Sliding window counter\n-- maintain counters for the current window and the previous window. When a request arrives, \nyou estimate how many requests the user \"should have\" made in a true sliding window \nby weighing the previous and current windows based on how far you are into the current window.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FOGiAN-ZqKMh-_8ErQ-6T",
      "type": "text",
      "x": 293.41300825136386,
      "y": 2185.955871310191,
      "width": 1036.8194580078125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6q",
      "roundness": null,
      "seed": 1413127883,
      "version": 436,
      "versionNonce": 2011196773,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781903383653,
      "link": null,
      "locked": false,
      "text": "Chosen: Token bucket algorithm\n-- Balance between simplicity, memory efficiency and handling real-world traffic patterns\n-- Token refilled at a rate/second, remove token per each request, if there is no token ==> reject request\n-- Token bucket needs to track 2 data: 1) current token count 2) last refill timestamp\n-- Response format\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Chosen: Token bucket algorithm\n-- Balance between simplicity, memory efficiency and handling real-world traffic patterns\n-- Token refilled at a rate/second, remove token per each request, if there is no token ==> reject request\n-- Token bucket needs to track 2 data: 1) current token count 2) last refill timestamp\n-- Response format\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
