      "updated": 1781893028523,
      "link": null,
      "locked": false,
      "text": "// -> updateLastSeen\n{\n    \"targetUserId\": \"\",\n    \"reporter\": \"DATABASE\" | \"SERVER\",\n    \"lastSeen\": \"ONLINE\" | \"$DATE\"\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// -> updateLastSeen\n{\n    \"targetUserId\": \"\",\n    \"reporter\": \"DATABASE\" | \"SERVER\",\n    \"lastSeen\": \"ONLINE\" | \"$DATE\"\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tOQcYcgUqGyV5D1fv5AJh",
      "type": "text",
      "x": 347.671875,
      "y": -166.77734375,
      "width": 119.95989990234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
