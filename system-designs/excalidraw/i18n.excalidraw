    {
      "id": "NAObPoXukA4Tn6OEhz2f3",
      "type": "text",
      "x": 1664.067583386253,
      "y": 655.9547255259943,
      "width": 428.2397155761719,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7j",
      "roundness": null,
      "seed": 751549829,
      "version": 383,
      "versionNonce": 671225835,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781904801076,
      "link": null,
      "locked": false,
      "text": "fallback: check locale graph,\ncheck if every key in root (en)\nexists in hi_IN, if not then hi, then take en\n- validate ICU syntax\n- compile it into functions\n- update the manifest/en.json\nin S3\n- can either manual purge\nmanifest.json or make it have a small TTL\n(refetch it on READ)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fallback: check locale graph,\ncheck if every key in root (en)\nexists in hi_IN, if not then hi, then take en\n- validate ICU syntax\n- compile it into functions\n- update the manifest/en.json\nin S3\n- can either manual purge\nmanifest.json or make it have a small TTL\n(refetch it on READ)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VGYpzF4rX5ewevV_XybEg",
      "type": "text",
