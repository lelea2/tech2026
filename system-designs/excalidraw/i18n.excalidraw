    {
      "id": "G5WzBw2fy7lgdgHIf_Lyi",
      "type": "text",
      "x": 301.829725535233,
      "y": 1744.078213907056,
      "width": 680.259521484375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
