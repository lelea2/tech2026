    {
      "id": "OXVSg-IMQWhH_hCCmhFdh",
      "type": "text",
      "x": 313.640625,
      "y": 279.5,
      "width": 485.2396240234375,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6U",
      "roundness": null,
      "seed": 1397632715,
      "version": 570,
      "versionNonce": 1142731051,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781903383653,
      "link": null,
      "locked": false,
      "text": "Functional Requirement\n-- identify user by id, ip or api_key\n-- limit requests based on configurable rules\n-- return proper error headers and status codes\n==========\n-- complex querying or analytics on rate limit data\n-- long term persistence of rate limiting data\nNon-functional requirements\n-- low latency check ( < 10ms)\n-- availability > consistency\n- Scale to 1M rsp\n==========\n-- strong consistency guranteed across all nodes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement\n-- identify user by id, ip or api_key\n-- limit requests based on configurable rules\n-- return proper error headers and status codes\n==========\n-- complex querying or analytics on rate limit data\n-- long term persistence of rate limiting data\nNon-functional requirements\n-- low latency check ( < 10ms)\n-- availability > consistency\n- Scale to 1M rsp\n==========\n-- strong consistency guranteed across all nodes",
      "autoResize": true,
      "lineHeight": 1.25
    },
