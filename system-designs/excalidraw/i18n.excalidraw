    {
      "id": "V1et7X8pvHDLURvmQgRnj",
      "type": "text",
      "x": 1460.5311382812292,
      "y": 2049.885608554303,
      "width": 400.03973388671875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
