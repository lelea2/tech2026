      "seed": 2000245797,
      "version": 269,
      "versionNonce": 388616203,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781903758658,
      "link": null,
      "locked": false,
      "text": "Non-functional requirements\n1. High available. Okey with eventual consistency\n2. Low latency for rendering local text <= 100ms\n3. Scalability: can be used across regions\nand more than 100 languages",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
