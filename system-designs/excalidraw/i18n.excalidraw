    {
      "id": "oqcP9if4pmG294GUrIKku",
      "type": "text",
      "x": 1323,
      "y": 786.5,
      "width": 639.0995483398438,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6e",
      "roundness": null,
      "seed": 139045637,
      "version": 502,
      "versionNonce": 1969643653,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781903383653,
      "link": null,
      "locked": false,
      "text": "Option1:\n-- Introduce new single point of failure checking for Rate limiter\n-- Additional latency checking for rate limiting\n-- Operational complexity\nOption2: API gateway/Load balancer\n-- Most production approach\n-- Limitation on context, only have information available in header\n--> so deeper business logic for rate limiter could be complex\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Option1:\n-- Introduce new single point of failure checking for Rate limiter\n-- Additional latency checking for rate limiting\n-- Operational complexity\nOption2: API gateway/Load balancer\n-- Most production approach\n-- Limitation on context, only have information available in header\n--> so deeper business logic for rate limiter could be complex\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DSkk5LmD06j-FQXAJZ3E4",
      "type": "text",
      "x": 1117.1171875,
      "y": 1028.5,
      "width": 922.1993408203125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6f",
      "roundness": null,
      "seed": 526539403,
      "version": 66,
      "versionNonce": 1125226059,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781903383653,
      "link": null,
      "locked": false,
      "text": "*** How to identify client\n-- User ID: Perfect for authenticated APIs. \nEach logged-in user gets their own rate limit allocation. \nThis is typically present in the Authorization header as a JWT token.\n-- IP Address: Good for public APIs or when you don't have user accounts. \nBut watch out for users behind NATs or corporate firewalls. \nThe IP address is typically present in the X-Forwarded-For header.\n-- API Key: Common for developer APIs. \nEach key holder gets their own limits. Most typically, this is denoted in the X-API-Key header.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** How to identify client\n-- User ID: Perfect for authenticated APIs. \nEach logged-in user gets their own rate limit allocation. \nThis is typically present in the Authorization header as a JWT token.\n-- IP Address: Good for public APIs or when you don't have user accounts. \nBut watch out for users behind NATs or corporate firewalls. \nThe IP address is typically present in the X-Forwarded-For header.\n-- API Key: Common for developer APIs. \nEach key holder gets their own limits. Most typically, this is denoted in the X-API-Key header.",
      "autoResize": true,
      "lineHeight": 1.25
    },
