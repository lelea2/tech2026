      "seed": 778832043,
      "version": 193,
      "versionNonce": 429047691,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1781903383653,
      "link": null,
      "locked": false,
      "text": "{\n  \"alice:12:00:00\": 100,\n  \"alice:12:01:00\": 5,\n  \"bob:12:00:00\": 20,\n  \"charlie:12:00:00\": 0,\n  \"dave:12:00:00\": 54,\n  \"eve:12:00:00\": 0,\n  \"frank:12:00:00\": 12,\n}\nPros: Simple\nCons: Boundary effects. User can make 100 request at 12:00:50 and \nanother 100 request at 12:01:00 ~ 200 request in 2 second. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n  \"alice:12:00:00\": 100,\n  \"alice:12:01:00\": 5,\n  \"bob:12:00:00\": 20,\n  \"charlie:12:00:00\": 0,\n  \"dave:12:00:00\": 54,\n  \"eve:12:00:00\": 0,\n  \"frank:12:00:00\": 12,\n}\nPros: Simple\nCons: Boundary effects. User can make 100 request at 12:00:50 and \nanother 100 request at 12:01:00 ~ 200 request in 2 second. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
