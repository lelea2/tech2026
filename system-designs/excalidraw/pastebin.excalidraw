    {
      "id": "N6lkpUDZ3AnGhzkt02kLQ",
      "type": "text",
      "x": 300,
      "y": 140.5,
      "width": 620.4595336914062,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
