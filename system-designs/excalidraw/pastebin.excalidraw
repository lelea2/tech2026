      "isDeleted": false,
      "boundElements": [],
      "updated": 1782940193736,
      "link": null,
      "locked": false,
      "text": "Non-functional\n- scalability >> availability (99.9)\n- latency: reading snippet should be near real-time. Creation/update/\ndeletion of snippet should be executed swiftly to ensure responsive\nuser experience\n- consistency.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional\n- scalability >> availability (99.9)\n- latency: reading snippet should be near real-time. Creation/update/\ndeletion of snippet should be executed swiftly to ensure responsive\nuser experience\n- consistency.",
      "autoResize": true,
      "lineHeight": 1.25
    },
