    {
      "id": "_k_v597RopeAPN-xkCBBN",
      "type": "text",
      "x": 322,
      "y": 1026.5,
      "width": 853.8392944335938,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 132303175,
      "version": 15,
      "versionNonce": 1557475591,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786326246740,
      "link": null,
      "locked": false,
      "text": "1. Web crawlers and Chrome extension collect current prices from Amazon product pages\n2. Price data is validated and stored in our price database\n3. Price changes trigger events for notification processing\n4. User receives email notification when price drops below threshold\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Web crawlers and Chrome extension collect current prices from Amazon product pages\n2. Price data is validated and stored in our price database\n3. Price changes trigger events for notification processing\n4. User receives email notification when price drops below threshold\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
