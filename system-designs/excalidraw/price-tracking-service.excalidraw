    {
      "id": "aDcAIYJV9tAxQNCygR_MA",
      "type": "text",
      "x": 1321.1990209639403,
      "y": 1402.7224252969636,
      "width": 409.0797119140625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
