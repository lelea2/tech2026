      "isDeleted": false,
      "boundElements": null,
      "updated": 1786327651074,
      "link": null,
      "locked": false,
      "text": "1) How to serve fast price history queries",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) How to serve fast price history queries",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Z-ePI52JO9AYA1SWVHrnB",
      "type": "text",
      "x": 1321.9743727521231,
      "y": 1437.840323074584,
      "width": 1033.05908203125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 2080549929,
      "version": 228,
      "versionNonce": 424575079,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786328072696,
      "link": null,
      "locked": false,
      "text": "- TimescaleDB for Real-time Price analytics, this is needed when \nwe need to support for user request a 2-year price chart, and have to\naggregate data into long time bucket\n- perform real-time aggregations directly without any pre-computation. \nWhen a user requests a 6-month price chart, we run a query like \n`SELECT time_bucket('1 day', timestamp), avg(price) FROM prices WHERE product_id = ? GROUP BY 1` \nand get results in milliseconds even with billions of price records. TimescaleDB's automatic partitioning \nand compression make these aggregations incredibly fast while maintaining PostgreSQL's familiar interface.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- TimescaleDB for Real-time Price analytics, this is needed when \nwe need to support for user request a 2-year price chart, and have to\naggregate data into long time bucket\n- perform real-time aggregations directly without any pre-computation. \nWhen a user requests a 6-month price chart, we run a query like \n`SELECT time_bucket('1 day', timestamp), avg(price) FROM prices WHERE product_id = ? GROUP BY 1` \nand get results in milliseconds even with billions of price records. TimescaleDB's automatic partitioning \nand compression make these aggregations incredibly fast while maintaining PostgreSQL's familiar interface.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
