      "seed": 799091080,
      "version": 408,
      "versionNonce": 1207247496,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786731784298,
      "link": null,
      "locked": false,
      "text": "Features:\n1) Activity patterns\n- time between posts\n- time of actions (click/views)\n- typo/error rate\n2) Content signal\n- entropy\n- distance to previously removed account content\n3) Network topology features\n- Growth rate, connections to removed bot acccounts\n4) Account Metadata\n5) Realtime behavioral signals\n- Flag from different models (spam, ponography)\n- Appeal behavior",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Features:\n1) Activity patterns\n- time between posts\n- time of actions (click/views)\n- typo/error rate\n2) Content signal\n- entropy\n- distance to previously removed account content\n3) Network topology features\n- Growth rate, connections to removed bot acccounts\n4) Account Metadata\n5) Realtime behavioral signals\n- Flag from different models (spam, ponography)\n- Appeal behavior",
      "autoResize": true,
      "lineHeight": 1.25
    },
