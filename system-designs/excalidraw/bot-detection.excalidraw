      "seed": 831862664,
      "version": 314,
      "versionNonce": 646052744,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786730389698,
      "link": null,
      "locked": false,
      "text": "Questions:\n1) What is the base prevalence of bot posts on the platform? - 50%?\n2) What happen if we wrongly classify real user as bot?\n3) How quickly do we need to detect bot activity?\n4) Scale of the problems?\n5) Are there any tell-tale signs of bot activity?\n6) Golden truth whether account is bot or not?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Questions:\n1) What is the base prevalence of bot posts on the platform? - 50%?\n2) What happen if we wrongly classify real user as bot?\n3) How quickly do we need to detect bot activity?\n4) Scale of the problems?\n5) Are there any tell-tale signs of bot activity?\n6) Golden truth whether account is bot or not?",
      "autoResize": true,
      "lineHeight": 1.25
    },
