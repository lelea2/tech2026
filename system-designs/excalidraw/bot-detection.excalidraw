      "boundElements": [],
      "updated": 1786730458661,
      "link": null,
      "locked": false,
      "text": "Requirements\n1) Detect automated bot/accounts\n2) 500M DAU, 1-2 sessions/day\n3) Inhuman behaviors (fast clicks, weird hours)\n4) Low-level of prevalence (<1%)\n5) Investigator labels, low volume and $$$",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements\n1) Detect automated bot/accounts\n2) 500M DAU, 1-2 sessions/day\n3) Inhuman behaviors (fast clicks, weird hours)\n4) Low-level of prevalence (<1%)\n5) Investigator labels, low volume and $$$",
      "autoResize": true,
      "lineHeight": 1.25
