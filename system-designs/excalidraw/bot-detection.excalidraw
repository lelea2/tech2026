      "isDeleted": false,
      "boundElements": [],
      "updated": 1786731395609,
      "link": null,
      "locked": false,
      "text": "Business objective\n- Minimize impact of bot activity on legitimate user experience,\nsubject to guardrails\n- Impact measure: spam impression rate or reject friend request\nmarked as spam. ==> require careful metrics design and need\nconstant envolment as bot tactics evolve\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Business objective\n- Minimize impact of bot activity on legitimate user experience,\nsubject to guardrails\n- Impact measure: spam impression rate or reject friend request\nmarked as spam. ==> require careful metrics design and need\nconstant envolment as bot tactics evolve\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
