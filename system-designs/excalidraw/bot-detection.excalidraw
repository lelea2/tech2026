      "boundElements": [],
      "updated": 1786922080459,
      "link": null,
      "locked": false,
      "text": "- Our loss function for this model is a simple weighted binary cross-\nentropy. We'll use a weight for each training sample that reflects how\nmany real users could have been bothered by that account. We'll want to\ncap the weights to avoid runaway gradients: even if a bot made a super\nviral spam post, we don't want our model to be incentivized to over-\npredict on that.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Our loss function for this model is a simple weighted binary cross-entropy. We'll use a weight for each training sample that reflects how many real users could have been bothered by that account. We'll want to cap the weights to avoid runaway gradients: even if a bot made a super viral spam post, we don't want our model to be incentivized to over-predict on that.\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
