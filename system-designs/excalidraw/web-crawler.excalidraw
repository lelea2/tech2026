    {
      "id": "hX5AOSCI7PyAPcsV8Ihqg",
      "type": "text",
      "x": 316.87890625,
      "y": 696.5,
      "width": 556.9196166992188,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
