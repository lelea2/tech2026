    {
      "id": "OKM_Y1wXHvMMGblhBVwTw",
      "type": "text",
      "x": 617.56640625,
      "y": 1227.984375,
      "width": 197.31996154785156,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
