      "id": "t98",
      "type": "text",
      "x": 64,
      "y": 3584,
      "width": 472,
      "height": 312,
      "text": "SCALE\n\nNormal request:\nlocal signature verify\n+ local cache\n+ local policy\n\nCentral control plane:\nissue / refresh / exchange\nrevoke / security state\npolicy / delegation\n\nPartition metadata by:\ntenant or hash(principalId)\n\nMulti-region:\nglobal invalidation topic",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCALE\n\nNormal request:\nlocal signature verify\n+ local cache\n+ local policy\n\nCentral control plane:\nissue / refresh / exchange\nrevoke / security state\npolicy / delegation\n\nPartition metadata by:\ntenant or hash(principalId)\n\nMulti-region:\nglobal invalidation topic",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "a97",
      "roundness": null
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
