      "id": "t102",
      "type": "text",
      "x": 1164,
      "y": 3584,
      "width": 442,
      "height": 312,
      "text": "NEVER DO\n\n❌ 500K permanent keys\n❌ shared CI secret\n❌ agent = invisible human\n❌ compromised token rotates itself\n❌ raw token in logs\n❌ prompt = authorization\n❌ DB lookup on every request\n❌ 24h privileged bearer token",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NEVER DO\n\n❌ 500K permanent keys\n❌ shared CI secret\n❌ agent = invisible human\n❌ compromised token rotates itself\n❌ raw token in logs\n❌ prompt = authorization\n❌ DB lookup on every request\n❌ 24h privileged bearer token",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "aB",
      "roundness": null
    },
    {
