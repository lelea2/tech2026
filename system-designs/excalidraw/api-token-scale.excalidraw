      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "9. 500K TOKEN SCALE + TRADEOFFS",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "a95",
      "roundness": null
    },
    {
