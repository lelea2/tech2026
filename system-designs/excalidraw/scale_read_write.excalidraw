      "link": null,
      "locked": false,
      "text": "-- Intermediate processing,\nLike batching read number of event, tabulate the changes to count of like\nthen forward to db in single window",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
