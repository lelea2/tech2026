    },
    {
      "id": "-UnRYIbFpdRCMzHJiu3O1",
      "type": "text",
      "x": -1063.7865383475075,
      "y": 2407.715710172597,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5Z",
      "roundness": null,
      "seed": 1436523005,
      "version": 4,
      "versionNonce": 1768598835,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785693402089,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 20,
      "fontFamily": 5,
