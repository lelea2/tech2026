    {
      "id": "BaQCA74V-g6ME7Q7oK1Av",
      "type": "text",
      "x": -1012.1900907382923,
      "y": 593.4827777616364,
      "width": 840.5595703125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5O",
      "roundness": null,
      "seed": 966275613,
      "version": 38,
      "versionNonce": 2036134077,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785643310333,
      "link": null,
      "locked": false,
      "text": "CREATE TABLE posts (\n    id SERIAL PRIMARY KEY,\n    user_id INT,\n    title TEXT,\n    content TEXT,\n    likes INT,\n    created_at TIMESTAMP\n);\n\n-- Regular index\nCREATE INDEX idx_user_time ON posts(user_id, created_at);\n\n-- Covering index includes likes column\nCREATE INDEX idx_user_time_likes ON posts(user_id, created_at) INCLUDE (likes);",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CREATE TABLE posts (\n    id SERIAL PRIMARY KEY,\n    user_id INT,\n    title TEXT,\n    content TEXT,\n    likes INT,\n    created_at TIMESTAMP\n);\n\n-- Regular index\nCREATE INDEX idx_user_time ON posts(user_id, created_at);\n\n-- Covering index includes likes column\nCREATE INDEX idx_user_time_likes ON posts(user_id, created_at) INCLUDE (likes);",
      "autoResize": true,
      "lineHeight": 1.25
    },
