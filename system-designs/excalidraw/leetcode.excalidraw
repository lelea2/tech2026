    {
      "id": "RRA5OPxpMP0897oFfGGnv",
      "type": "text",
      "x": 454.61408650404917,
      "y": 2442.6406861402024,
      "width": 809.3994140625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
