    {
      "id": "F3kGlkVMQTulrmD4CrN8S",
      "type": "text",
      "x": 380.5965327084841,
      "y": -633.3042536292514,
      "width": 700.7794799804688,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
