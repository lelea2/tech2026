      "seed": 998102702,
      "version": 410,
      "versionNonce": 1273679306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786471717709,
      "link": null,
      "locked": false,
      "text": "Non-functional requirements\n\n1) Latency ~200ms for 99th percentile\n2) Availability: 99% uptime, horizontal scalability to handle traffic spike\n3) Fault tolerence ensures graceful degration when component fails,\nGDPR, CCPA compliance protect user information\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-functional requirements\n\n1) Latency ~200ms for 99th percentile\n2) Availability: 99% uptime, horizontal scalability to handle traffic spike\n3) Fault tolerence ensures graceful degration when component fails,\nGDPR, CCPA compliance protect user information\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
