    },
    {
      "id": "WbD7yLMf10XrUTnFehIWL",
      "type": "text",
      "x": 340.2877907271468,
      "y": -1111.9953820409228,
      "width": 1252.6317138671875,
      "height": 331.6640624999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 241288937,
      "version": 604,
      "versionNonce": 512607690,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786471714430,
      "link": null,
      "locked": false,
      "text": "A recommendation system suggests relevant content to users based on their preferences, behavior, and historical interactions. \nYou encounter these systems constantly when Netflix recommends a movie, Amazon suggests products, \nSpotify creates personalized playlists, or LinkedIn surfaces people you may know. \nThe core challenge is delivering personalized, relevant items efficiently at massive scale while maintaining latency under 200 milliseconds.\n\n\nFunctional Requirements\n\n1) provide personalized recommendations to users and support multiple recommendation types,\n including similar items, trending products, and frequently bought together suggestions. \n2) update recommendations in near real time as user behavior changes \nand allow A/B testing of different algorithms. \n3) handle various surfaces including homepage recommendations, \nproduct detail pages, cart pages, and email campaigns.",
      "fontSize": 18.95223214285713,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A recommendation system suggests relevant content to users based on their preferences, behavior, and historical interactions. \nYou encounter these systems constantly when Netflix recommends a movie, Amazon suggests products, \nSpotify creates personalized playlists, or LinkedIn surfaces people you may know. \nThe core challenge is delivering personalized, relevant items efficiently at massive scale while maintaining latency under 200 milliseconds.\n\n\nFunctional Requirements\n\n1) provide personalized recommendations to users and support multiple recommendation types,\n including similar items, trending products, and frequently bought together suggestions. \n2) update recommendations in near real time as user behavior changes \nand allow A/B testing of different algorithms. \n3) handle various surfaces including homepage recommendations, \nproduct detail pages, cart pages, and email campaigns.",
      "autoResize": true,
      "lineHeight": 1.25
    },
