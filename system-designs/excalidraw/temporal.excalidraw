      "isDeleted": true,
      "boundElements": null,
      "updated": 1785708142025,
      "link": null,
      "locked": false,
      "text": "1. Simple direct upload with presigned URL (like S3), upload load\nto S3/blobs storage\n2. Simple direct download also with presigned URL from S3,\ndownload from blobs/CDN\n3. Handle chunk for upload large file\n4. State synchronization\n\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Simple direct upload with presigned URL (like S3), upload load\nto S3/blobs storage\n2. Simple direct download also with presigned URL from S3,\ndownload from blobs/CDN\n3. Handle chunk for upload large file\n4. State synchronization\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
