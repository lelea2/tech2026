    {
      "id": "45zwcFl4TuGAKgZ88EMSY",
      "type": "text",
      "x": 520,
      "y": 66.5,
      "width": 282.4638977050781,
      "height": 35,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
