    },
    {
      "id": "decision_body",
      "type": "text",
      "x": 90.12109375,
      "y": 1845.12109375,
      "width": 1770,
      "height": 200,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1090238095,
      "version": 4,
      "versionNonce": 1252130131,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785704654764,
      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 1,
      "text": "Use direct-to-blob upload when files are large, bandwidth is high, or clients need resumability. Keep structured metadata and authorization in the database/API layer. Use multipart or resumable sessions, storage events as the primary completion signal, and reconciliation as the safety net. Put untrusted uploads in quarantine and expose only processed objects through a CDN with signed access and HTTP Range support.\n\nDo not overuse this pattern for tiny payloads, strict synchronous inspection, or workflows where policy requires all bytes to pass through a certified proxy. The exact size threshold is workload-specific; explain the trade-off rather than treating 10 MB as a universal law.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Use direct-to-blob upload when files are large, bandwidth is high, or clients need resumability. Keep structured metadata and authorization in the database/API layer. Use multipart or resumable sessions, storage events as the primary completion signal, and reconciliation as the safety net. Put untrusted uploads in quarantine and expose only processed objects through a CDN with signed access and HTTP Range support.\n\nDo not overuse this pattern for tiny payloads, strict synchronous inspection, or workflows where policy requires all bytes to pass through a certified proxy. The exact size threshold is workload-specific; explain the trade-off rather than treating 10 MB as a universal law.",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "b0j"
    },
