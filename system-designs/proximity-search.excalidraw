    {
      "id": "J9WOiyQ-fWhvkbfZsDhiK",
      "type": "text",
      "x": 259.76171875,
      "y": 575,
      "width": 980.4951782226562,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 1656303307,
      "version": 107,
      "versionNonce": 164525797,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786026927141,
      "link": null,
      "locked": false,
      "text": "Geohash works beautifully for a single city, but it starts to hurt across the whole globe, \nbecause it treats latitude and longitude as a flat rectangle and the earth isn't flat. \n\n* Google (S2)\nspherical cousin of geohash. It wraps the globe in a cube and projects onto the six faces, \nwhich lets it carve out cells that stay roughly the same size anywhere on earth, \neach with a 64-bit hierarchical ID you can truncate to get a parent cell. \nBecause S2 actually understands the sphere, it handles cases a flat grid mangles\n\n* Uber (H3)\nH3 differs in one way that matters. Geohash and S2 lay their cells along a space-filling curve, \nso a numeric range scan sweeps up a neighborhood in one shot. H3 doesn't, so close IDs aren't reliably close on the map.\nInstead it hands you cheap grid math to compute the ring of cells around any cell directly, and you look those exact IDs up.\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Geohash works beautifully for a single city, but it starts to hurt across the whole globe, \nbecause it treats latitude and longitude as a flat rectangle and the earth isn't flat. \n\n* Google (S2)\nspherical cousin of geohash. It wraps the globe in a cube and projects onto the six faces, \nwhich lets it carve out cells that stay roughly the same size anywhere on earth, \neach with a 64-bit hierarchical ID you can truncate to get a parent cell. \nBecause S2 actually understands the sphere, it handles cases a flat grid mangles\n\n* Uber (H3)\nH3 differs in one way that matters. Geohash and S2 lay their cells along a space-filling curve, \nso a numeric range scan sweeps up a neighborhood in one shot. H3 doesn't, so close IDs aren't reliably close on the map.\nInstead it hands you cheap grid math to compute the ring of cells around any cell directly, and you look those exact IDs up.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EMNJNSVUGKTEpySFR_i8b",
      "type": "text",
      "x": 876,
      "y": 104,
      "width": 829.1353759765625,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 111712675,
      "version": 47,
      "versionNonce": 1315911245,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786029270931,
      "link": null,
      "locked": false,
      "text": "Reach for a custom spatial tree when your data is geometric, \nfull of polygons, roads, delivery zones, and questions of containment or intersection. \nYou need the database to understand shapes, and you're willing to pay for a spatial extension \nand pricier writes to get it. PostGIS, with its R-tree-style GiST index, is the usual default, a\nnd an R-tree handles points, lines, and polygons alike. The catch is writes. \nRebalancing rectangles is real work, and the BKD variant Elasticsearch uses is essentially write-once, \nso neither loves data that churns.\n\n*** When to use encoded keys\nReach for encoded cells when your data is mostly points that move constantly, \nlike drivers, users, devices, or live locations. Here you care far more about cheap writes \nand fast candidate generation than about polygon math, and a geohash, S2, \nor H3 value on an ordinary index gives you exactly that. A\n moving driver is a single integer update, which is why this approach scales to millions of writes a second. \nThe price you pay is that you're mostly limited to points, \nand the cell boundaries mean you always query a ring of neighbors rather than one exact cell.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reach for a custom spatial tree when your data is geometric, \nfull of polygons, roads, delivery zones, and questions of containment or intersection. \nYou need the database to understand shapes, and you're willing to pay for a spatial extension \nand pricier writes to get it. PostGIS, with its R-tree-style GiST index, is the usual default, a\nnd an R-tree handles points, lines, and polygons alike. The catch is writes. \nRebalancing rectangles is real work, and the BKD variant Elasticsearch uses is essentially write-once, \nso neither loves data that churns.\n\n*** When to use encoded keys\nReach for encoded cells when your data is mostly points that move constantly, \nlike drivers, users, devices, or live locations. Here you care far more about cheap writes \nand fast candidate generation than about polygon math, and a geohash, S2, \nor H3 value on an ordinary index gives you exactly that. A\n moving driver is a single integer update, which is why this approach scales to millions of writes a second. \nThe price you pay is that you're mostly limited to points, \nand the cell boundaries mean you always query a ring of neighbors rather than one exact cell.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
