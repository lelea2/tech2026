    },
    {
      "id": "id8073977",
      "type": "text",
      "x": 879.6953125,
      "y": 1065.18359375,
      "width": 720,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 2627478,
      "version": 111,
      "versionNonce": 1120327755,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784077975077,
      "link": null,
      "locked": false,
      "text": "Critical path\n• identity, owner, health, last activity, primary action\n\nDefer\n• lineage graph\n• long history\n• expensive charts\n• expanded metadata\n• rarely used tabs\n\nTechniques\n• route prefetch for likely next navigation\n• Suspense boundaries per section\n• IntersectionObserver for data + code loading\n• dynamic import for chart and lineage bundles\n• stale-while-revalidate cache\n• preload on hover or intent\n• skeletons matching final layout to avoid CLS",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Critical path\n• identity, owner, health, last activity, primary action\n\nDefer\n• lineage graph\n• long history\n• expensive charts\n• expanded metadata\n• rarely used tabs\n\nTechniques\n• route prefetch for likely next navigation\n• Suspense boundaries per section\n• IntersectionObserver for data + code loading\n• dynamic import for chart and lineage bundles\n• stale-while-revalidate cache\n• preload on hover or intent\n• skeletons matching final layout to avoid CLS",
      "autoResize": true,
      "lineHeight": 1.25
    },
