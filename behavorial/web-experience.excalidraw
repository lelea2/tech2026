      "boundElements": [],
      "updated": 1784077686501,
      "link": null,
      "locked": false,
      "text": "type HealthState =\n  | { kind: \"healthy\"; measuredAt: string }\n  | { kind: \"stale\"; measuredAt: string }\n  | { kind: \"unknown\"; reason: \"request_failed\" }\n  | { kind: \"unavailable\"; reason: \"not_configured\" };",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "type HealthState =\n  | { kind: \"healthy\"; measuredAt: string }\n  | { kind: \"stale\"; measuredAt: string }\n  | { kind: \"unknown\"; reason: \"request_failed\" }\n  | { kind: \"unavailable\"; reason: \"not_configured\" };",
      "autoResize": true,
      "lineHeight": 1.25
    },
