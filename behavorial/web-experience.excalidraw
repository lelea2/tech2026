    },
    {
      "id": "id2057850",
      "type": "text",
      "x": 34.88671875,
      "y": 1076.29296875,
      "width": 740,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 2280648,
      "version": 76,
      "versionNonce": 207800965,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784077681352,
      "link": null,
      "locked": false,
      "text": "• Section-level error boundaries\n• Abort stale searches and obsolete requests\n• Retry idempotent reads with exponential backoff + jitter\n• Preserve successful sections when one dependency fails\n• Validate API contracts at runtime\n• Track request IDs and source freshness\n• Feature-flag risky platform migrations\n• Canary rollout + automatic rollback thresholds\n• Distinguish:\n  healthy / degraded / unhealthy / stale / unavailable / unknown\n\nKey interview line\n“Unhealthy is a domain result. Unknown is a system result.\nCombining them causes users to act on false information.”",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Section-level error boundaries\n• Abort stale searches and obsolete requests\n• Retry idempotent reads with exponential backoff + jitter\n• Preserve successful sections when one dependency fails\n• Validate API contracts at runtime\n• Track request IDs and source freshness\n• Feature-flag risky platform migrations\n• Canary rollout + automatic rollback thresholds\n• Distinguish:\n  healthy / degraded / unhealthy / stale / unavailable / unknown\n\nKey interview line\n“Unhealthy is a domain result. Unknown is a system result.\nCombining them causes users to act on false information.”",
      "autoResize": true,
      "lineHeight": 1.25
    },
