    },
    {
      "id": "id5402078",
      "type": "text",
      "x": 52.42578125,
      "y": 472.203125,
      "width": 523.5147094726562,
      "height": 446.25,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 104691,
      "version": 135,
      "versionNonce": 719232107,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784077328329,
      "link": null,
      "locked": false,
      "text": "User / product metrics\n• Time to identify unhealthy model or feature (MTTR, MTTD)\n• Time to remediation\n• Search success and task completion\n• Support-ticket reduction\n• Shareable investigation links opened successfully\n\nPerformance metrics\n• LCP, INP, CLS, TTFB\n• Time to critical summary\n• API waterfall duration\n• JS execution / long tasks\n• Chart render duration\n\nReliability metrics\n• Route and section availability\n• JS error rate by release\n• Retry recovery rate\n• Stale-data rate\n• Contract-validation failures\n• Frontend SLO: critical identity + health within 5s",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User / product metrics\n• Time to identify unhealthy model or feature (MTTR, MTTD)\n• Time to remediation\n• Search success and task completion\n• Support-ticket reduction\n• Shareable investigation links opened successfully\n\nPerformance metrics\n• LCP, INP, CLS, TTFB\n• Time to critical summary\n• API waterfall duration\n• JS execution / long tasks\n• Chart render duration\n\nReliability metrics\n• Route and section availability\n• JS error rate by release\n• Retry recovery rate\n• Stale-data rate\n• Contract-validation failures\n• Frontend SLO: critical identity + health within 5s",
      "autoResize": true,
      "lineHeight": 1.25
    },
