    {
      "id": "gOrNe17zbrTzCX2rXkTfO",
      "type": "text",
      "x": 71.01488879002795,
      "y": 4557.549254246627,
      "width": 681.07958984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
