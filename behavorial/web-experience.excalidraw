      "type": "text",
      "x": 1137.4646677129917,
      "y": 4714.402200251898,
      "width": 300.73125916447736,
      "height": 89.01897065301733,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
