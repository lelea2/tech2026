    },
    {
      "id": "id3977608",
      "type": "text",
      "x": 1697.19921875,
      "y": -108.99609375,
      "width": 678.6761273304621,
      "height": 408.140625,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 9599657,
      "version": 166,
      "versionNonce": 1278384427,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784077098770,
      "link": null,
      "locked": false,
      "text": "Cross-functional partners\n• MLOps platform, Data Quality, AIM, MDE, DI, CRT\n• Legal / RAIG / compliance\n• CI / GitHub Actions / Ambry / Flyte / Observe\n\nWhat to emphasize\n• Defined shared contracts, ownership boundaries, and rollout plans\n• Turned incident lessons into platform safeguards\n• Balanced near-term feature delivery with reusable infrastructure\n• Used reference consumers before generalizing abstractions\n• Created migration paths instead of forcing rewrites\n• Measured adoption and regression, not just delivery\n\nStaff-level statement\n“The shared component is successful only when teams adopt it\nbecause it is easier, safer, and faster than rebuilding it.”",
      "fontSize": 20.40703124999999,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cross-functional partners\n• MLOps platform, Data Quality, AIM, MDE, DI, CRT\n• Legal / RAIG / compliance\n• CI / GitHub Actions / Ambry / Flyte / Observe\n\nWhat to emphasize\n• Defined shared contracts, ownership boundaries, and rollout plans\n• Turned incident lessons into platform safeguards\n• Balanced near-term feature delivery with reusable infrastructure\n• Used reference consumers before generalizing abstractions\n• Created migration paths instead of forcing rewrites\n• Measured adoption and regression, not just delivery\n\nStaff-level statement\n“The shared component is successful only when teams adopt it\nbecause it is easier, safer, and faster than rebuilding it.”",
      "autoResize": true,
      "lineHeight": 1.25
    },
