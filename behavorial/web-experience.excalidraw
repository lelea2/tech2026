      "lineHeight": 1.25
    },
    {
      "id": "id8603212",
      "type": "text",
      "x": 1714.80648858405,
      "y": 439.7351444305282,
      "width": 651.3046875,
      "height": 494.75451450340466,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 6177234,
      "version": 165,
      "versionNonce": 1021476709,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784089832730,
      "link": null,
      "locked": false,
      "text": "const queryRef = loadQuery(env, ModelPageQuery, { id });\n\nfunction ModelPage({ queryRef }) {\n  const data = usePreloadedQuery(ModelPageQuery, queryRef);\n\n  return (\n    <>\n      <ModelHeader model={data.model} />\n      <Suspense fallback={<ChartSkeleton />}>\n        <ModelMetrics modelRef={data.model} />\n      </Suspense>\n    </>\n  );\n}\n\nconst fragment = graphql`\n  fragment ModelMetrics_model on Model {\n    id\n    metrics(first: 500) { edges { node { ts value } } }\n  }\n`;",
      "fontSize": 18.84779102870113,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const queryRef = loadQuery(env, ModelPageQuery, { id });\n\nfunction ModelPage({ queryRef }) {\n  const data = usePreloadedQuery(ModelPageQuery, queryRef);\n\n  return (\n    <>\n      <ModelHeader model={data.model} />\n      <Suspense fallback={<ChartSkeleton />}>\n        <ModelMetrics modelRef={data.model} />\n      </Suspense>\n    </>\n  );\n}\n\nconst fragment = graphql`\n  fragment ModelMetrics_model on Model {\n    id\n    metrics(first: 500) { edges { node { ts value } } }\n  }\n`;",
      "autoResize": true,
      "lineHeight": 1.25
    },
