    {
      "id": "Kf_5jZatxBFpy8hrTMxjF",
      "type": "text",
      "x": 110.02095913666861,
      "y": 3761.527193580699,
      "width": 464.0797424316406,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
