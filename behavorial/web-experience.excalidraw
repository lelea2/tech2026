      "seed": 1053849563,
      "version": 5,
      "versionNonce": 19422101,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784130003053,
      "link": null,
      "locked": false,
      "text": "Data API\n   |\n   v\nRaw 50K Points\n   |\n   v\nVisible Range Filter\n   |\n   v\nResolution Selector\n   |-----------------------------|\n   v                             v\nMin/Max or LTTB             Server Aggregation\n   |                             |\n   |-------------|---------------|\n                 v\n            Web Worker\n                 |\n                 v\n         Canvas / WebGL Renderer\n                 |\n       |---------|----------|\n       v                    v\nAxes / Labels          Tooltip Index\nHTML / SVG        Binary Search / Quadtree",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data API\n   |\n   v\nRaw 50K Points\n   |\n   v\nVisible Range Filter\n   |\n   v\nResolution Selector\n   |-----------------------------|\n   v                             v\nMin/Max or LTTB             Server Aggregation\n   |                             |\n   |-------------|---------------|\n                 v\n            Web Worker\n                 |\n                 v\n         Canvas / WebGL Renderer\n                 |\n       |---------|----------|\n       v                    v\nAxes / Labels          Tooltip Index\nHTML / SVG        Binary Search / Quadtree",
      "autoResize": true,
      "lineHeight": 1.25
    },
