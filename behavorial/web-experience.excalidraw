    {
      "id": "6rEDgcJoMhbl8O9QwM3d2",
      "type": "text",
      "x": 57.396862237264656,
      "y": 3719.916949500433,
      "width": 382.6597900390625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 842830101,
      "version": 57,
      "versionNonce": 2092947195,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784130000321,
      "link": null,
      "locked": false,
      "text": "*** How to handle 50k data points ***",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** How to handle 50k data points ***",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OCMgoPsso3htyy4tHYibY",
      "type": "rectangle",
      "x": 44.86008013835368,
      "y": 3706.272741284579,
      "width": 1463.3159621871434,
      "height": 817.0250575080711,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": {
        "type": 3
      },
      "seed": 742675675,
      "version": 164,
      "versionNonce": 2092415643,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784130244171,
      "link": null,
      "locked": false
    },
    {
      "id": "Tq1Wsy5jnOoz8vwDf4KoB",
      "type": "text",
      "x": 660.4344552836501,
      "y": 3810.8192201533593,
      "width": 799.0794067382812,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 935353819,
      "version": 180,
      "versionNonce": 565618773,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784130234911,
      "link": null,
      "locked": false,
      "text": "*** Core Approach: avoid rendering 50K SVG elements directly.\n- Use Canvas for tens of thousands of points.\n- Use WebGL for hundreds of thousands or millions.\n- Keep SVG or HTML for axes, labels, legends, and accessibility.\n\n*** Downsampling: The screen cannot visually display all 50K points independently.\nReduce the visible data to roughly 1–4 points per horizontal pixel using:\n- Min/max bucket aggregation to preserve spikes\n- LTTB (Largest Triangle Three Buckets) to preserve the overall line shape\n\n\n\n- Server-side time-window aggregation for very large datasets\n\n*** Performance Optimizations\n- Store data in typed arrays instead of React component state.\n- Use a Web Worker for parsing, sorting, aggregation, and downsampling.\n- Use requestAnimationFrame for drawing and pointer interactions.\n- Avoid one event listener per point.\n- Use binary search for time-series tooltips.\n- Use a quadtree or spatial index for scatter plots.\n\n*** Progressive Loading\n1. Render axes and coarse aggregated data first.\n2. Load detailed data after the initial chart is usable.\n3. Fetch higher-resolution data when the user zooms.\n4. Cancel obsolete requests during rapid navigation.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*** Core Approach: avoid rendering 50K SVG elements directly.\n- Use Canvas for tens of thousands of points.\n- Use WebGL for hundreds of thousands or millions.\n- Keep SVG or HTML for axes, labels, legends, and accessibility.\n\n*** Downsampling: The screen cannot visually display all 50K points independently.\nReduce the visible data to roughly 1–4 points per horizontal pixel using:\n- Min/max bucket aggregation to preserve spikes\n- LTTB (Largest Triangle Three Buckets) to preserve the overall line shape\n\n\n\n- Server-side time-window aggregation for very large datasets\n\n*** Performance Optimizations\n- Store data in typed arrays instead of React component state.\n- Use a Web Worker for parsing, sorting, aggregation, and downsampling.\n- Use requestAnimationFrame for drawing and pointer interactions.\n- Avoid one event listener per point.\n- Use binary search for time-series tooltips.\n- Use a quadtree or spatial index for scatter plots.\n\n*** Progressive Loading\n1. Render axes and coarse aggregated data first.\n2. Load detailed data after the initial chart is usable.\n3. Fetch higher-resolution data when the user zooms.\n4. Cancel obsolete requests during rapid navigation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nxKvggaYTzS2-JkBSfwBq",
      "type": "text",
      "x": 661.6994406250847,
      "y": 3709.9666737421076,
      "width": 626.219482421875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
      "roundness": null,
      "seed": 401020891,
      "version": 8,
      "versionNonce": 538544859,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784130153152,
      "link": null,
      "locked": false,
      "text": "The goal is not to display every raw point. \nThe goal is to preserve the important visual information \nwhile maintaining smooth rendering, interaction, and accessibility.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The goal is not to display every raw point. \nThe goal is to preserve the important visual information \nwhile maintaining smooth rendering, interaction, and accessibility.",
      "autoResize": true,
      "lineHeight": 1.25
    },
