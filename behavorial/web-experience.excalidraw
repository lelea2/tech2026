      "text": "3. Organizational Depth & Influence",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Organizational Depth & Influence",
      "autoResize": true,
