    {
      "id": "id1683153",
      "type": "text",
      "x": 2595.484375,
      "y": 1056.62109375,
      "width": 740,
      "height": 260,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 8161071,
      "version": 71,
      "versionNonce": 1544529867,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784077412984,
      "link": null,
      "locked": false,
      "text": "const visible = useInView(chartRef);\nconst deferredRange = useDeferredValue(range);\n\nconst series = useMemo(\n  () => downsample(rawPoints, 1500),\n  [rawPoints]\n);\n\nreturn visible ? (\n  <CanvasChart points={series} />\n) : (\n  <ChartPlaceholder summary={summary} />\n);",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const visible = useInView(chartRef);\nconst deferredRange = useDeferredValue(range);\n\nconst series = useMemo(\n  () => downsample(rawPoints, 1500),\n  [rawPoints]\n);\n\nreturn visible ? (\n  <CanvasChart points={series} />\n) : (\n  <ChartPlaceholder summary={summary} />\n);",
      "autoResize": true,
      "lineHeight": 1.25
    },
