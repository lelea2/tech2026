      "index": "b0C",
      "roundness": null,
      "seed": 1431678971,
      "version": 186,
      "versionNonce": 1719108213,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784130842057,
      "link": null,
      "locked": false,
      "text": "const [loadChart, queryRef] = useQueryLoader(ChartQuery);\n\nuseEffect(() => {\n  if (isVisible && !queryRef) {\n    loadChart({ modelId, range });\n  }\n}, [isVisible, modelId, range]);",
      "fontSize": 10.17359664605912,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const [loadChart, queryRef] = useQueryLoader(ChartQuery);\n\nuseEffect(() => {\n  if (isVisible && !queryRef) {\n    loadChart({ modelId, range });\n  }\n}, [isVisible, modelId, range]);",
      "autoResize": true,
      "lineHeight": 1.25
    }
