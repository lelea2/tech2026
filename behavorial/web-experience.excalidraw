    {
      "id": "id4555920",
      "type": "text",
      "x": 59.5234375,
      "y": 1874.25390625,
      "width": 560,
      "height": 361.25,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 4979271,
      "version": 71,
      "versionNonce": 684183429,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784077941865,
      "link": null,
      "locked": false,
      "text": "Good shared abstractions\n• EntityHeader / EntityHealthSummary\n• StatusBadge with semantic tones\n• FreshnessIndicator\n• AsyncSection with loading/error/retry states\n• URL-backed FilterBar\n• Searchable / sortable / paginated DataTable\n• ChartShell with summary, fallback, accessibility, and telemetry\n\nAPI principles\n• Domain-neutral display props\n• No hidden data fetching\n• Composition over dozens of flags\n• Semantic status values, not raw colors\n• Accessibility and analytics built in\n• Reference consumers before platform generalization\n• Storybook, tests, migration docs, versioning, codemods",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Good shared abstractions\n• EntityHeader / EntityHealthSummary\n• StatusBadge with semantic tones\n• FreshnessIndicator\n• AsyncSection with loading/error/retry states\n• URL-backed FilterBar\n• Searchable / sortable / paginated DataTable\n• ChartShell with summary, fallback, accessibility, and telemetry\n\nAPI principles\n• Domain-neutral display props\n• No hidden data fetching\n• Composition over dozens of flags\n• Semantic status values, not raw colors\n• Accessibility and analytics built in\n• Reference consumers before platform generalization\n• Storybook, tests, migration docs, versioning, codemods",
      "autoResize": true,
      "lineHeight": 1.25
    },
