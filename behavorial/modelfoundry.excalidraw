    {
      "id": "efd2feb3f22c4629",
      "type": "text",
      "x": 52,
      "y": 1470,
      "width": 706,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 1063421998,
      "version": 3,
      "versionNonce": 203070786,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784146807635,
      "link": null,
      "locked": false,
      "text": "DEEP DIVE: LLM ROLE\n\nGood uses:\n• Parse user intent\n• Resolve ambiguous terminology\n• Choose tools\n• Correlate health signals\n• Explain facts in plain language\n• Generate investigation steps\n\nNot allowed:\n• Invent values\n• Compute source-of-truth metrics\n• Authorize access\n• Execute writes directly",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEEP DIVE: LLM ROLE\n\nGood uses:\n• Parse user intent\n• Resolve ambiguous terminology\n• Choose tools\n• Correlate health signals\n• Explain facts in plain language\n• Generate investigation steps\n\nNot allowed:\n• Invent values\n• Compute source-of-truth metrics\n• Authorize access\n• Execute writes directly",
      "autoResize": false,
      "lineHeight": 1.25
    },
