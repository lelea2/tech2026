      "updated": 1784146805020,
      "link": null,
      "locked": false,
      "text": "POSSIBLE APIs\n\nPOST /v1/agent/conversations/:id/messages\nGET  /v1/agent/runs/:runId/events\nGET  /v1/models/:id/health\nGET  /v1/models/:id/versions/:version/metrics\nGET  /v1/features/:id/availability\nGET  /v1/features/:id/drift\nGET  /v1/datasets/:id/freshness\nGET  /v1/models/:id/lineage\nGET  /v1/models/:id/compliance\nPOST /v1/health/detect\nPOST /v1/approvals/:id/approve\nPOST /v1/incidents",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POSSIBLE APIs\n\nPOST /v1/agent/conversations/:id/messages\nGET  /v1/agent/runs/:runId/events\nGET  /v1/models/:id/health\nGET  /v1/models/:id/versions/:version/metrics\nGET  /v1/features/:id/availability\nGET  /v1/features/:id/drift\nGET  /v1/datasets/:id/freshness\nGET  /v1/models/:id/lineage\nGET  /v1/models/:id/compliance\nPOST /v1/health/detect\nPOST /v1/approvals/:id/approve\nPOST /v1/incidents",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
