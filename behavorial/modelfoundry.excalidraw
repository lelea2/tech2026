    {
      "id": "4a3f46412c104cf3",
      "type": "text",
      "x": 1622,
      "y": 1470,
      "width": 736,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
