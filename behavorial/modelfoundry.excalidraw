      "index": "at",
      "roundness": null,
      "seed": 1592419967,
      "version": 3,
      "versionNonce": 717624322,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784146809392,
      "link": null,
      "locked": false,
      "text": "DEEP DIVE: SAFETY + RELIABILITY\n\nPermission filtering before retrieval\nTool allowlist and schema validation\nShort-lived delegated credentials\nApproval token required for writes\nIdempotency key for actions\nResume from durable checkpoints\nReconnect with runId + event sequence\nMark missing/stale data explicitly\nAudit every tool call and action",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEEP DIVE: SAFETY + RELIABILITY\n\nPermission filtering before retrieval\nTool allowlist and schema validation\nShort-lived delegated credentials\nApproval token required for writes\nIdempotency key for actions\nResume from durable checkpoints\nReconnect with runId + event sequence\nMark missing/stale data explicitly\nAudit every tool call and action",
      "autoResize": false,
      "lineHeight": 1.25
    },
