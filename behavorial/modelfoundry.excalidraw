      "index": "ar",
      "roundness": null,
      "seed": 789137839,
      "version": 3,
      "versionNonce": 1934782558,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784146808368,
      "link": null,
      "locked": false,
      "text": "DEEP DIVE: DETECTION\n\nLatency regression:\ncurrent P95 > baseline × 1.3\n\nTraffic drop:\ncurrent count < baseline × 0.5\n\nDataset stale:\nage > configured SLA\n\nFeature unhealthy:\navailability below threshold or PSI above limit\n\nDetector returns facts + evidence; LLM explains.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DEEP DIVE: DETECTION\n\nLatency regression:\ncurrent P95 > baseline × 1.3\n\nTraffic drop:\ncurrent count < baseline × 0.5\n\nDataset stale:\nage > configured SLA\n\nFeature unhealthy:\navailability below threshold or PSI above limit\n\nDetector returns facts + evidence; LLM explains.",
      "autoResize": false,
      "lineHeight": 1.25
    },
