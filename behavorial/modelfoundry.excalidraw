    {
      "id": "633fa67414a34fd9",
      "type": "text",
      "x": 822,
      "y": 1470,
      "width": 736,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
